<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderProcessingToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_OrderProcessingToBe" name="Xử lý Đơn hàng Online TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Checkout</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Pay</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmReceipt</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_ValidateOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LockInventory</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SellerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_2h</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoAccept</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ConfirmResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SellerAccepted</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_GenerateLabelQR</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoPickupSched</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AI_ETA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_ETA30</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PreDeliveryContact</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_TrackDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DeliverySuccess</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BuyerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_7d</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReleasePayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoCancel</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyCancel</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReleasePayment_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AutoCancel_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_ConfirmOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PackageGoods</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_3PL" name="3PL/Shipper">
        <ns0:flowNodeRef>Task_Pickup</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DeliverAttempt</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_DeliverAttempt_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_DeliverAttempt_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Payment" name="Payment Gateway">
        <ns0:flowNodeRef>Task_VerifyPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ExecuteRefund</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Checkout" name="Yêu cầu đặt hàng">
      <ns0:outgoing>Flow_Checkout_Validate</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_Pay" name="Thanh toán đơn hàng (COD / Thẻ / Ví / Chuyển khoản)">
      <ns0:incoming>Flow_Validate_Pay</ns0:incoming>
      <ns0:outgoing>Flow_Pay_Verify</ns0:outgoing>
    </ns0:userTask>
    <ns0:task id="Task_ReceiveGoods" name="Nhận hàng từ shipper">
      <ns0:incoming>Flow_Deliver_Success</ns0:incoming>
      <ns0:outgoing>Flow_Receive_Confirm</ns0:outgoing>
    </ns0:task>
    <ns0:userTask id="Task_ConfirmReceipt" name="Xác nhận đã nhận hàng">
      <ns0:incoming>Flow_Receive_Confirm</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ValidateOrder" name="Tự động xác thực thông tin đơn">
      <ns0:incoming>Flow_Checkout_Validate</ns0:incoming>
      <ns0:outgoing>Flow_Validate_Pay</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LockInventory" name="Khóa tồn kho + tạo đơn">
      <ns0:incoming>Flow_Verify_Process</ns0:incoming>
      <ns0:outgoing>Flow_Lock_SellerConfirm</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_2h" name="Hết 2h SLA - chờ phản hồi Seller">
      <ns0:incoming>Flow_GateSeller_Timer</ns0:incoming>
      <ns0:outgoing>Flow_Timer_AutoAccept</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerDef_2h">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:serviceTask id="Task_AutoAccept" name="Tự động chấp nhận đơn sau 2h">
      <ns0:incoming>Flow_Timer_AutoAccept</ns0:incoming>
      <ns0:outgoing>Flow_AutoAccept_Merge</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_GenerateLabelQR" name="Tạo nhãn vận đơn QR số hóa">
      <ns0:incoming>Flow_Package_Label</ns0:incoming>
      <ns0:outgoing>Flow_Label_PickupSched</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoPickupSched" name="Tự động lên lịch lấy hàng với 3PL">
      <ns0:incoming>Flow_Label_PickupSched</ns0:incoming>
      <ns0:outgoing>Flow_PickupSched_Pickup</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AI_ETA" name="Dự đoán thời gian giao (AI ETA)">
      <ns0:incoming>Flow_Pickup_ETA</ns0:incoming>
      <ns0:outgoing>Flow_ETA_Timer</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_ETA30" name="Trước giao 30 phút">
      <ns0:incoming>Flow_ETA_Timer</ns0:incoming>
      <ns0:outgoing>Flow_Timer_Contact</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerDef_ETA30">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:serviceTask id="Task_PreDeliveryContact" name="Liên hệ trước giao hàng (gọi/nhắn 30 phút)">
      <ns0:incoming>Flow_Timer_Contact</ns0:incoming>
      <ns0:outgoing>Flow_Contact_Track</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_TrackDelivery" name="Cập nhật định vị đơn hàng realtime">
      <ns0:incoming>Flow_Contact_Track</ns0:incoming>
      <ns0:outgoing>Flow_Track_Deliver</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_7d" name="Hết 7 ngày SLA - xác nhận nhận hàng">
      <ns0:incoming>Flow_Buyer_Timer</ns0:incoming>
      <ns0:outgoing>Flow_Timer_AutoConfirm</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerDef_7d">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P7D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:serviceTask id="Task_AutoConfirm" name="Tự động xác nhận đã nhận hàng">
      <ns0:incoming>Flow_Timer_AutoConfirm</ns0:incoming>
      <ns0:outgoing>Flow_AutoConfirm_Release</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ReleasePayment" name="Giải ngân cho Seller">
      <ns0:outgoing>Flow_Release_End</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ReleasePayment_1_to_Task_ReleasePayment</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoCancel" name="Tự động hủy đơn">
      <ns0:outgoing>Flow_Cancel_Notify</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_AutoCancel_2_to_Task_AutoCancel</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyCancel" name="Thông báo hủy đơn">
      <ns0:incoming>Flow_Cancel_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Notify_Refund</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoRefund" name="Tự động hoàn tiền Buyer">
      <ns0:incoming>Flow_Notify_Refund</ns0:incoming>
      <ns0:outgoing>Flow_Refund_Execute</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_ConfirmOrder" name="Xác nhận đơn (thủ công)">
      <ns0:incoming>Flow_GateSeller_Manual</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Result</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PackageGoods" name="Đóng gói hàng">
      <ns0:incoming>Flow_SellerAccepted_Package</ns0:incoming>
      <ns0:outgoing>Flow_Package_Label</ns0:outgoing>
    </ns0:userTask>
    <ns0:task id="Task_Pickup" name="3PL lấy hàng (theo lịch tự động)">
      <ns0:incoming>Flow_PickupSched_Pickup</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_ETA</ns0:outgoing>
    </ns0:task>
    <ns0:userTask id="Task_DeliverAttempt" name="Giao hàng (attempt)">
      <ns0:incoming>Flow_Join_Task_DeliverAttempt_3_to_Task_DeliverAttempt</ns0:incoming>
      <ns0:outgoing>Flow_Task_DeliverAttempt_to_Split_Task_DeliverAttempt_1</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_VerifyPayment" name="Gateway verify thanh toán">
      <ns0:incoming>Flow_Pay_Verify</ns0:incoming>
      <ns0:outgoing>Flow_Verify_Process</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ExecuteRefund" name="Cổng thanh toán xử lý hoàn tiền">
      <ns0:incoming>Flow_Refund_Execute</ns0:incoming>
      <ns0:outgoing>Flow_Refund_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_SellerConfirm" name="Seller phản hồi?" default="Flow_GateSeller_Timer">
      <ns0:incoming>Flow_Lock_SellerConfirm</ns0:incoming>
      <ns0:outgoing>Flow_GateSeller_Manual</ns0:outgoing>
      <ns0:outgoing>Flow_GateSeller_Timer</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_ConfirmResult" name="Chấp nhận đơn?" default="Flow_ConfirmResult_Refuse">
      <ns0:incoming>Flow_Confirm_Result</ns0:incoming>
      <ns0:outgoing>Flow_ConfirmResult_Accept</ns0:outgoing>
      <ns0:outgoing>Flow_ConfirmResult_Refuse</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SellerAccepted" name="Đã chấp nhận">
      <ns0:incoming>Flow_ConfirmResult_Accept</ns0:incoming>
      <ns0:incoming>Flow_AutoAccept_Merge</ns0:incoming>
      <ns0:outgoing>Flow_SellerAccepted_Package</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_DeliverySuccess" name="Giao thành công?" default="Flow_Fail_Cancel">
      <ns0:incoming>Flow_Deliver_Fail</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Deliver</ns0:outgoing>
      <ns0:outgoing>Flow_Fail_Cancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_BuyerConfirm" name="Buyer đã xác nhận?" default="Flow_Buyer_Timer">
      <ns0:incoming>Flow_Confirm_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Buyer_Release</ns0:outgoing>
      <ns0:outgoing>Flow_Buyer_Timer</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Delivered" name="Đơn hàng đã hoàn tất">
      <ns0:incoming>Flow_Release_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <ns0:incoming>Flow_Refund_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Checkout_Validate" sourceRef="StartEvent_Checkout" targetRef="Task_ValidateOrder" />
    <ns0:sequenceFlow id="Flow_Validate_Pay" sourceRef="Task_ValidateOrder" targetRef="Task_Pay" />
    <ns0:sequenceFlow id="Flow_Pay_Verify" sourceRef="Task_Pay" targetRef="Task_VerifyPayment" />
    <ns0:sequenceFlow id="Flow_Verify_Process" sourceRef="Task_VerifyPayment" targetRef="Task_LockInventory" />
    <ns0:sequenceFlow id="Flow_Lock_SellerConfirm" sourceRef="Task_LockInventory" targetRef="Gate_SellerConfirm" />
    <ns0:sequenceFlow id="Flow_GateSeller_Manual" sourceRef="Gate_SellerConfirm" targetRef="Task_ConfirmOrder" name="Chưa phản hồi trong 2h">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${sellerResponded}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_GateSeller_Timer" sourceRef="Gate_SellerConfirm" targetRef="Timer_2h" name="Đã quá 2h SLA" />
    <ns0:sequenceFlow id="Flow_Confirm_Result" sourceRef="Task_ConfirmOrder" targetRef="Gate_ConfirmResult" />
    <ns0:sequenceFlow id="Flow_ConfirmResult_Accept" sourceRef="Gate_ConfirmResult" targetRef="Gate_SellerAccepted" name="Chấp nhận">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_ConfirmResult_Refuse" sourceRef="Gate_ConfirmResult" targetRef="Join_Task_AutoCancel_2" name="Từ chối" />
    <ns0:sequenceFlow id="Flow_Timer_AutoAccept" sourceRef="Timer_2h" targetRef="Task_AutoAccept" />
    <ns0:sequenceFlow id="Flow_AutoAccept_Merge" sourceRef="Task_AutoAccept" targetRef="Gate_SellerAccepted" />
    <ns0:sequenceFlow id="Flow_SellerAccepted_Package" sourceRef="Gate_SellerAccepted" targetRef="Task_PackageGoods" />
    <ns0:sequenceFlow id="Flow_Package_Label" sourceRef="Task_PackageGoods" targetRef="Task_GenerateLabelQR" />
    <ns0:sequenceFlow id="Flow_Label_PickupSched" sourceRef="Task_GenerateLabelQR" targetRef="Task_AutoPickupSched" />
    <ns0:sequenceFlow id="Flow_PickupSched_Pickup" sourceRef="Task_AutoPickupSched" targetRef="Task_Pickup" />
    <ns0:sequenceFlow id="Flow_Pickup_ETA" sourceRef="Task_Pickup" targetRef="Task_AI_ETA" />
    <ns0:sequenceFlow id="Flow_ETA_Timer" sourceRef="Task_AI_ETA" targetRef="Timer_ETA30" />
    <ns0:sequenceFlow id="Flow_Timer_Contact" sourceRef="Timer_ETA30" targetRef="Task_PreDeliveryContact" />
    <ns0:sequenceFlow id="Flow_Contact_Track" sourceRef="Task_PreDeliveryContact" targetRef="Task_TrackDelivery" />
    <ns0:sequenceFlow id="Flow_Track_Deliver" sourceRef="Task_TrackDelivery" targetRef="Join_Task_DeliverAttempt_3" />
    <ns0:sequenceFlow id="Flow_Deliver_Success" sourceRef="Split_Task_DeliverAttempt_1" targetRef="Task_ReceiveGoods" name="Giao thành công" />
    <ns0:sequenceFlow id="Flow_Deliver_Fail" sourceRef="Split_Task_DeliverAttempt_1" targetRef="Gate_DeliverySuccess" name="Giao thất bại" />
    <ns0:sequenceFlow id="Flow_Retry_Deliver" sourceRef="Gate_DeliverySuccess" targetRef="Join_Task_DeliverAttempt_3" name="Giao thất bại (≤3 lần)">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts &lt; maxAttempts}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Fail_Cancel" sourceRef="Gate_DeliverySuccess" targetRef="Join_Task_AutoCancel_2" name="Giao thất bại hết giới hạn" />
    <ns0:sequenceFlow id="Flow_Receive_Confirm" sourceRef="Task_ReceiveGoods" targetRef="Task_ConfirmReceipt" />
    <ns0:sequenceFlow id="Flow_Confirm_Gate" sourceRef="Task_ConfirmReceipt" targetRef="Gate_BuyerConfirm" />
    <ns0:sequenceFlow id="Flow_Buyer_Release" sourceRef="Gate_BuyerConfirm" targetRef="Join_Task_ReleasePayment_1" name="Buyer xác nhận / quá hạn">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${buyerConfirmed}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Buyer_Timer" sourceRef="Gate_BuyerConfirm" targetRef="Timer_7d" name="Đã quá 7 ngày xác nhận" />
    <ns0:sequenceFlow id="Flow_Timer_AutoConfirm" sourceRef="Timer_7d" targetRef="Task_AutoConfirm" />
    <ns0:sequenceFlow id="Flow_AutoConfirm_Release" sourceRef="Task_AutoConfirm" targetRef="Join_Task_ReleasePayment_1" />
    <ns0:sequenceFlow id="Flow_Release_End" sourceRef="Task_ReleasePayment" targetRef="End_Delivered" />
    <ns0:sequenceFlow id="Flow_Cancel_Notify" sourceRef="Task_AutoCancel" targetRef="Task_NotifyCancel" />
    <ns0:sequenceFlow id="Flow_Notify_Refund" sourceRef="Task_NotifyCancel" targetRef="Task_AutoRefund" />
    <ns0:sequenceFlow id="Flow_Refund_Execute" sourceRef="Task_AutoRefund" targetRef="Task_ExecuteRefund" />
    <ns0:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ExecuteRefund" targetRef="End_Refunded" />
    <ns0:exclusiveGateway id="Join_Task_ReleasePayment_1" name="Gom luồng trước khi Giải ngân cho Seller">
      <ns0:incoming>Flow_Buyer_Release</ns0:incoming>
      <ns0:incoming>Flow_AutoConfirm_Release</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReleasePayment_1_to_Task_ReleasePayment</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ReleasePayment_1_to_Task_ReleasePayment" sourceRef="Join_Task_ReleasePayment_1" targetRef="Task_ReleasePayment" />
    <ns0:exclusiveGateway id="Join_Task_AutoCancel_2" name="Gom luồng trước khi Tự động hủy đơn">
      <ns0:incoming>Flow_ConfirmResult_Refuse</ns0:incoming>
      <ns0:incoming>Flow_Fail_Cancel</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AutoCancel_2_to_Task_AutoCancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AutoCancel_2_to_Task_AutoCancel" sourceRef="Join_Task_AutoCancel_2" targetRef="Task_AutoCancel" />
    <ns0:exclusiveGateway id="Join_Task_DeliverAttempt_3" name="Gom luồng trước khi Giao hàng (attempt)">
      <ns0:incoming>Flow_Track_Deliver</ns0:incoming>
      <ns0:incoming>Flow_Retry_Deliver</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_DeliverAttempt_3_to_Task_DeliverAttempt</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_DeliverAttempt_3_to_Task_DeliverAttempt" sourceRef="Join_Task_DeliverAttempt_3" targetRef="Task_DeliverAttempt" />
    <ns0:exclusiveGateway id="Split_Task_DeliverAttempt_1" name="Phân luồng sau Giao hàng (attempt)">
      <ns0:outgoing>Flow_Deliver_Success</ns0:outgoing>
      <ns0:outgoing>Flow_Deliver_Fail</ns0:outgoing>
      <ns0:incoming>Flow_Task_DeliverAttempt_to_Split_Task_DeliverAttempt_1</ns0:incoming>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_DeliverAttempt_to_Split_Task_DeliverAttempt_1" sourceRef="Task_DeliverAttempt" targetRef="Split_Task_DeliverAttempt_1" />
  </ns0:process>
