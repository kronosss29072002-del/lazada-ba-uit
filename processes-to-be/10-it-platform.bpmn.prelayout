<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ITPlatformTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_ITPlatformTOBE" name="Quy trình Vận hành Nền tảng Công nghệ TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PO" name="Product Owner">
        <bpmn:flowNodeRef>StartEvent_FeatureReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UserStory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PrioritizeOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Demo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DemoOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_CollectReq_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI DevX / Copilot">
        <bpmn:flowNodeRef>Task_AISuggestDesign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AICodeGen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AICodeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_AIFixOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AITestGen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_AICodeGen_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_AISuggestDesign_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="Dev Team">
        <bpmn:flowNodeRef>Task_DesignReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DesignReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnitTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_UnitTestPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Integrate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="QA / Tester">
        <bpmn:flowNodeRef>Task_SIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_QAPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_UATPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_UAT_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevOps" name="DevOps / AIOps">
        <bpmn:flowNodeRef>Task_CICDAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CanaryDeploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_HealthOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Autoscale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PredictIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_IncidentFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelfHeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RecoverOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Deployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_Rollback_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_FeatureReq" name="Yêu cầu tính năng / cải tiến mới">
      <bpmn:outgoing>Flow_S1_Collect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Join_Task_CollectReq_1" name="Gom luồng trước khi Thu thập &amp; phân tích yêu cầu nghiệp vụ">
      <bpmn:incoming>Flow_S1_Collect</bpmn:incoming>
      <bpmn:incoming>Flow_PrioNo_Backlog</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_CollectReq_1_to_Task_CollectReq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CollectReq" name="Thu thập &amp; phân tích yêu cầu nghiệp vụ">
      <bpmn:incoming>Flow_Join_Task_CollectReq_1_to_Task_CollectReq</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_Story</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UserStory" name="Viết User Story + tiêu chí chấp nhận">
      <bpmn:incoming>Flow_Collect_Story</bpmn:incoming>
      <bpmn:outgoing>Flow_Story_GatePriority</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PrioritizeOK" name="Đủ ưu tiên để phát triển?">
      <bpmn:incoming>Flow_Story_GatePriority</bpmn:incoming>
      <bpmn:outgoing>Flow_PrioYes_Design</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrioNo_Backlog</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Demo" name="Demo tính năng cho PO &amp; stakeholder">
      <bpmn:incoming>Flow_UATOK_Demo</bpmn:incoming>
      <bpmn:outgoing>Flow_Demo_GateOK</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DemoOK" name="Demo đạt yêu cầu?">
      <bpmn:incoming>Flow_Demo_GateOK</bpmn:incoming>
      <bpmn:outgoing>Flow_DemoYes_Deploy</bpmn:outgoing>
      <bpmn:outgoing>Flow_DemoNo_UAT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_AISuggestDesign_1" name="Gom luồng trước khi AI gợi ý thiết kế &amp; ước lượng effort">
      <bpmn:incoming>Flow_PrioYes_Design</bpmn:incoming>
      <bpmn:incoming>Flow_DesignNo_AISuggest</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_AISuggestDesign_1_to_Task_AISuggestDesign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AISuggestDesign" name="AI gợi ý thiết kế &amp; ước lượng effort">
      <bpmn:incoming>Flow_Join_Task_AISuggestDesign_1_to_Task_AISuggestDesign</bpmn:incoming>
      <bpmn:outgoing>Flow_AI_DesignReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_Task_AICodeGen_1" name="Gom luồng trước khi AI sinh code theo user story (Copilot)">
      <bpmn:incoming>Flow_DesignOK_AIGen</bpmn:incoming>
      <bpmn:incoming>Flow_AIFixNo_Regen</bpmn:incoming>
      <bpmn:incoming>Flow_UnitFail_AIGen</bpmn:incoming>
      <bpmn:incoming>Flow_QAFail_AIGen</bpmn:incoming>
      <bpmn:incoming>Flow_UATFail_AIGen</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_AICodeGen_1_to_Task_AICodeGen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AICodeGen" name="AI sinh code theo user story (Copilot)">
      <bpmn:incoming>Flow_Join_Task_AICodeGen_1_to_Task_AICodeGen</bpmn:incoming>
      <bpmn:outgoing>Flow_AIGen_AICodeRev</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AICodeReview" name="AI tự động review code + phát hiện lỗi">
      <bpmn:incoming>Flow_AIGen_AICodeRev</bpmn:incoming>
      <bpmn:outgoing>Flow_AICodeRev_GateFix</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_AIFixOK" name="AI review pass?">
      <bpmn:incoming>Flow_AICodeRev_GateFix</bpmn:incoming>
      <bpmn:outgoing>Flow_AIFixOK_Test</bpmn:outgoing>
      <bpmn:outgoing>Flow_AIFixNo_Regen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AITestGen" name="AI tự sinh test case &amp; data test">
      <bpmn:incoming>Flow_AIFixOK_Test</bpmn:incoming>
      <bpmn:outgoing>Flow_AITest_Unit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DesignReview" name="Dev xác nhận thiết kế kỹ thuật">
      <bpmn:incoming>Flow_AI_DesignReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Design_GateOK</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DesignReview" name="Thiết kế được duyệt?">
      <bpmn:incoming>Flow_Design_GateOK</bpmn:incoming>
      <bpmn:outgoing>Flow_DesignOK_AIGen</bpmn:outgoing>
      <bpmn:outgoing>Flow_DesignNo_AISuggest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UnitTest" name="Chạy unit test + coverage tự động">
      <bpmn:incoming>Flow_AITest_Unit</bpmn:incoming>
      <bpmn:outgoing>Flow_Unit_GatePass</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_UnitTestPass" name="Unit test pass ≥ 90%?">
      <bpmn:incoming>Flow_Unit_GatePass</bpmn:incoming>
      <bpmn:outgoing>Flow_UnitOK_Integrate</bpmn:outgoing>
      <bpmn:outgoing>Flow_UnitFail_AIGen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_UAT_1" name="Gom luồng trước khi User Acceptance Testing với nghiệp vụ">
      <bpmn:incoming>Flow_QAPass_UAT</bpmn:incoming>
      <bpmn:incoming>Flow_DemoNo_UAT</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_UAT_1_to_Task_UAT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Integrate" name="Tích hợp module &amp; build tự động">
      <bpmn:incoming>Flow_UnitOK_Integrate</bpmn:incoming>
      <bpmn:outgoing>Flow_Integrate_SIT</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SIT" name="Kiểm thử tích hợp hệ thống (SIT) tự động">
      <bpmn:incoming>Flow_Integrate_SIT</bpmn:incoming>
      <bpmn:outgoing>Flow_SIT_GateQA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_QAPass" name="QA pass?">
      <bpmn:incoming>Flow_SIT_GateQA</bpmn:incoming>
      <bpmn:outgoing>Flow_QAPass_UAT</bpmn:outgoing>
      <bpmn:outgoing>Flow_QAFail_AIGen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UAT" name="User Acceptance Testing với nghiệp vụ">
      <bpmn:incoming>Flow_Join_Task_UAT_1_to_Task_UAT</bpmn:incoming>
      <bpmn:outgoing>Flow_UAT_GatePass</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_UATPass" name="UAT đạt?">
      <bpmn:incoming>Flow_UAT_GatePass</bpmn:incoming>
      <bpmn:outgoing>Flow_UATOK_Demo</bpmn:outgoing>
      <bpmn:outgoing>Flow_UATFail_AIGen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CICDAuto" name="Chạy pipeline CI/CD tự động hóa">
      <bpmn:incoming>Flow_DemoYes_Deploy</bpmn:incoming>
      <bpmn:outgoing>Flow_CICD_Canary</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CanaryDeploy" name="Triển khai Canary 10% → 100%">
      <bpmn:incoming>Flow_CICD_Canary</bpmn:incoming>
      <bpmn:outgoing>Flow_Canary_GateHealth</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_HealthOK" name="Health check sau deploy ổn?">
      <bpmn:incoming>Flow_Canary_GateHealth</bpmn:incoming>
      <bpmn:outgoing>Flow_HealthOK_AutoScale</bpmn:outgoing>
      <bpmn:outgoing>Flow_HealthFail_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Autoscale" name="Tự động mở rộng tài nguyên (K8s HPA)">
      <bpmn:incoming>Flow_HealthOK_AutoScale</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoScale_Monitor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PredictIncident" name="AI giám sát &amp; dự đoán sự cố (AIOps)">
      <bpmn:incoming>Flow_AutoScale_Monitor</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitor_GateIncident</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_Task_Rollback_1" name="Gom luồng trước khi Rollback về version ổn định">
      <bpmn:incoming>Flow_HealthFail_Rollback</bpmn:incoming>
      <bpmn:incoming>Flow_RecoverFail_Rollback</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Rollback_1_to_Task_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_IncidentFound" name="Phát hiện bất thường?">
      <bpmn:incoming>Flow_Monitor_GateIncident</bpmn:incoming>
      <bpmn:outgoing>Flow_IncidentNo_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_IncidentYes_SelfHeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SelfHeal" name="Tự phục hồi / khởi động lại pod tự động">
      <bpmn:incoming>Flow_IncidentYes_SelfHeal</bpmn:incoming>
      <bpmn:outgoing>Flow_SelfHeal_GateRecover</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_RecoverOK" name="Phục hồi thành công?">
      <bpmn:incoming>Flow_SelfHeal_GateRecover</bpmn:incoming>
      <bpmn:outgoing>Flow_RecoverOK_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_RecoverFail_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Rollback" name="Rollback về version ổn định">
      <bpmn:incoming>Flow_Join_Task_Rollback_1_to_Task_Rollback</bpmn:incoming>
      <bpmn:outgoing>Flow_Rollback_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_End_Event_Deployed_1" name="Gom nhánh kết thúc">
      <bpmn:incoming>Flow_IncidentNo_End</bpmn:incoming>
      <bpmn:incoming>Flow_RecoverOK_End</bpmn:incoming>
      <bpmn:incoming>Flow_Rollback_End</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_Event_Deployed_1_to_EndEvent_Deployed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Deployed" name="Dự án đã triển khai hoàn tất">
      <bpmn:incoming>Flow_Join_End_Event_Deployed_1_to_EndEvent_Deployed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S1_Collect" sourceRef="StartEvent_FeatureReq" targetRef="Join_Task_CollectReq_1" />
    <bpmn:sequenceFlow id="Flow_Collect_Story" sourceRef="Task_CollectReq" targetRef="Task_UserStory" />
    <bpmn:sequenceFlow id="Flow_Story_GatePriority" sourceRef="Task_UserStory" targetRef="Gate_PrioritizeOK" />
    <bpmn:sequenceFlow id="Flow_PrioYes_Design" name="Đủ ưu tiên" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_AISuggestDesign_1" />
    <bpmn:sequenceFlow id="Flow_PrioNo_Backlog" name="Chờ — về backlog" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_CollectReq_1" />
    <bpmn:sequenceFlow id="Flow_AI_DesignReview" sourceRef="Task_AISuggestDesign" targetRef="Task_DesignReview" />
    <bpmn:sequenceFlow id="Flow_Design_GateOK" sourceRef="Task_DesignReview" targetRef="Gate_DesignReview" />
    <bpmn:sequenceFlow id="Flow_DesignOK_AIGen" name="Duyệt" sourceRef="Gate_DesignReview" targetRef="Join_Task_AICodeGen_1" />
    <bpmn:sequenceFlow id="Flow_DesignNo_AISuggest" name="Sửa thiết kế" sourceRef="Gate_DesignReview" targetRef="Join_Task_AISuggestDesign_1" />
    <bpmn:sequenceFlow id="Flow_AIGen_AICodeRev" sourceRef="Task_AICodeGen" targetRef="Task_AICodeReview" />
    <bpmn:sequenceFlow id="Flow_AICodeRev_GateFix" sourceRef="Task_AICodeReview" targetRef="Gate_AIFixOK" />
    <bpmn:sequenceFlow id="Flow_AIFixOK_Test" name="Pass" sourceRef="Gate_AIFixOK" targetRef="Task_AITestGen" />
    <bpmn:sequenceFlow id="Flow_AIFixNo_Regen" name="Có lỗi — sinh lại code" sourceRef="Gate_AIFixOK" targetRef="Join_Task_AICodeGen_1" />
    <bpmn:sequenceFlow id="Flow_AITest_Unit" sourceRef="Task_AITestGen" targetRef="Task_UnitTest" />
    <bpmn:sequenceFlow id="Flow_Unit_GatePass" sourceRef="Task_UnitTest" targetRef="Gate_UnitTestPass" />
    <bpmn:sequenceFlow id="Flow_UnitOK_Integrate" name="Pass" sourceRef="Gate_UnitTestPass" targetRef="Task_Integrate" />
    <bpmn:sequenceFlow id="Flow_UnitFail_AIGen" name="Fail — sửa code" sourceRef="Gate_UnitTestPass" targetRef="Join_Task_AICodeGen_1" />
    <bpmn:sequenceFlow id="Flow_Integrate_SIT" sourceRef="Task_Integrate" targetRef="Task_SIT" />
    <bpmn:sequenceFlow id="Flow_SIT_GateQA" sourceRef="Task_SIT" targetRef="Gate_QAPass" />
    <bpmn:sequenceFlow id="Flow_QAPass_UAT" name="Pass" sourceRef="Gate_QAPass" targetRef="Join_Task_UAT_1" />
    <bpmn:sequenceFlow id="Flow_QAFail_AIGen" name="Fail — fix bug" sourceRef="Gate_QAPass" targetRef="Join_Task_AICodeGen_1" />
    <bpmn:sequenceFlow id="Flow_UAT_GatePass" sourceRef="Task_UAT" targetRef="Gate_UATPass" />
    <bpmn:sequenceFlow id="Flow_UATOK_Demo" name="Pass" sourceRef="Gate_UATPass" targetRef="Task_Demo" />
    <bpmn:sequenceFlow id="Flow_UATFail_AIGen" name="Fail — sửa theo nghiệp vụ" sourceRef="Gate_UATPass" targetRef="Join_Task_AICodeGen_1" />
    <bpmn:sequenceFlow id="Flow_Demo_GateOK" sourceRef="Task_Demo" targetRef="Gate_DemoOK" />
    <bpmn:sequenceFlow id="Flow_DemoYes_Deploy" name="Đạt" sourceRef="Gate_DemoOK" targetRef="Task_CICDAuto" />
    <bpmn:sequenceFlow id="Flow_DemoNo_UAT" name="Chưa đạt — UAT lại" sourceRef="Gate_DemoOK" targetRef="Join_Task_UAT_1" />
    <bpmn:sequenceFlow id="Flow_CICD_Canary" sourceRef="Task_CICDAuto" targetRef="Task_CanaryDeploy" />
    <bpmn:sequenceFlow id="Flow_Canary_GateHealth" sourceRef="Task_CanaryDeploy" targetRef="Gate_HealthOK" />
    <bpmn:sequenceFlow id="Flow_HealthOK_AutoScale" name="Ổn định" sourceRef="Gate_HealthOK" targetRef="Task_Autoscale" />
    <bpmn:sequenceFlow id="Flow_HealthFail_Rollback" name="Bất thường" sourceRef="Gate_HealthOK" targetRef="Join_Task_Rollback_1" />
    <bpmn:sequenceFlow id="Flow_AutoScale_Monitor" sourceRef="Task_Autoscale" targetRef="Task_PredictIncident" />
    <bpmn:sequenceFlow id="Flow_Monitor_GateIncident" sourceRef="Task_PredictIncident" targetRef="Gate_IncidentFound" />
    <bpmn:sequenceFlow id="Flow_IncidentNo_End" name="Bình thường" sourceRef="Gate_IncidentFound" targetRef="Join_End_Event_Deployed_1" />
    <bpmn:sequenceFlow id="Flow_IncidentYes_SelfHeal" name="Bất thường" sourceRef="Gate_IncidentFound" targetRef="Task_SelfHeal" />
    <bpmn:sequenceFlow id="Flow_SelfHeal_GateRecover" sourceRef="Task_SelfHeal" targetRef="Gate_RecoverOK" />
    <bpmn:sequenceFlow id="Flow_RecoverOK_End" name="Thành công" sourceRef="Gate_RecoverOK" targetRef="Join_End_Event_Deployed_1" />
    <bpmn:sequenceFlow id="Flow_RecoverFail_Rollback" name="Thất bại" sourceRef="Gate_RecoverOK" targetRef="Join_Task_Rollback_1" />
    <bpmn:sequenceFlow id="Flow_Rollback_End" sourceRef="Task_Rollback" targetRef="Join_End_Event_Deployed_1" />
    <bpmn:sequenceFlow id="Flow_Join_End_Event_Deployed_1_to_EndEvent_Deployed" sourceRef="Join_End_Event_Deployed_1" targetRef="EndEvent_Deployed" name="" />
    <bpmn:sequenceFlow id="Flow_Join_Task_AICodeGen_1_to_Task_AICodeGen" sourceRef="Join_Task_AICodeGen_1" targetRef="Task_AICodeGen" name="" />
    <bpmn:sequenceFlow id="Flow_Join_Task_AISuggestDesign_1_to_Task_AISuggestDesign" sourceRef="Join_Task_AISuggestDesign_1" targetRef="Task_AISuggestDesign" name="" />
    <bpmn:sequenceFlow id="Flow_Join_Task_CollectReq_1_to_Task_CollectReq" sourceRef="Join_Task_CollectReq_1" targetRef="Task_CollectReq" name="" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Rollback_1_to_Task_Rollback" sourceRef="Join_Task_Rollback_1" targetRef="Task_Rollback" name="" />
    <bpmn:sequenceFlow id="Flow_Join_Task_UAT_1_to_Task_UAT" sourceRef="Join_Task_UAT_1" targetRef="Task_UAT" name="" />
  </bpmn:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
    <ns1:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITPlatformTOBE">
      <ns1:BPMNShape id="Lane_PO_di" bpmnElement="Lane_PO">
        <ns2:Bounds x="30" y="0" width="7846" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI">
        <ns2:Bounds x="30" y="200" width="7846" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Dev_di" bpmnElement="Lane_Dev">
        <ns2:Bounds x="30" y="400" width="7846" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_QA_di" bpmnElement="Lane_QA">
