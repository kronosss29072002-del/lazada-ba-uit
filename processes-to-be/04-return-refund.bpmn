<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReturnRefund_TOBE" targetNamespace="http://bpmn.io/schema/bpmn">
  <ns0:process id="Process_ReturnRefund_TOBE" name="Hoàn trả &amp; Refund TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Request</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SubmitRequest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UploadEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_HandoverReturn</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_HandoverReturn_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_CheckEligibility</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AITriage</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AIEvidenceVerify</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_InstantRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DynamicPickup</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AIInspection</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ProcessRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyStatus</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_RefundSLA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Eligible</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_LowRisk</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_AIPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ProcessRefund_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_CS" name="CS Agent">
        <ns0:flowNodeRef>Task_CSReview</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Warehouse" name="3PL/Warehouse">
        <ns0:flowNodeRef>Task_PickupReturn</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Payment" name="Payment Gateway">
        <ns0:flowNodeRef>Task_ExecuteRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ExecuteRefund_3</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Request" name="Yêu cầu hoàn trả hàng">
      <ns0:outgoing>Flow_Start_Submit</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_SubmitRequest" name="Submit yêu cầu + lý do">
      <ns0:incoming>Flow_Start_Submit</ns0:incoming>
      <ns0:outgoing>Flow_Submit_Eligibility</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_UploadEvidence" name="Upload evidence (ảnh/video)">
      <ns0:incoming>Flow_Eligible_Upload</ns0:incoming>
      <ns0:outgoing>Flow_Upload_Triage</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_HandoverReturn" name="Bàn giao hàng trả cho LEX / 3PL">
      <ns0:incoming>Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn</ns0:incoming>
      <ns0:outgoing>Flow_Handover_Pickup</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_CheckEligibility" name="Check eligibility tự động">
      <ns0:incoming>Flow_Submit_Eligibility</ns0:incoming>
      <ns0:outgoing>Flow_Eligibility_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AITriage" name="AI phân loại rủi ro khiếu nại">
      <ns0:incoming>Flow_Upload_Triage</ns0:incoming>
      <ns0:outgoing>Flow_Triage_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AIEvidenceVerify" name="AI Vision thẩm định lỗi bao bì/sản phẩm">
      <ns0:incoming>Flow_Gate_LowRisk</ns0:incoming>
      <ns0:outgoing>Flow_AI_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_InstantRefund" name="Instant refund (return-less)">
      <ns0:incoming>Flow_AI_Pass</ns0:incoming>
      <ns0:outgoing>Flow_Instant_Execute</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_DynamicPickup" name="Lên lịch thu hồi hàng thông minh">
      <ns0:incoming>Flow_Handover_Pickup</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_Schedule</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AIInspection" name="AI image analysis inspection">
      <ns0:incoming>Flow_Pickup_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Inspection_Notify</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ProcessRefund" name="Xử lý lệnh hoàn tiền tự động">
      <ns0:incoming>Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund</ns0:incoming>
      <ns0:outgoing>Flow_Refund_Execute</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyStatus" name="Auto-notify từng bước">
      <ns0:incoming>Flow_Payout_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Notify_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_RefundSLA" name="Kích hoạt hoàn tiền tự động trong 24h">
      <ns0:timerEventDefinition id="TimerDef_24h_Refund">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</ns0:timeDuration>
      </ns0:timerEventDefinition>
      <ns0:incoming>Flow_Gate_Timer</ns0:incoming>
      <ns0:outgoing>Flow_Timer_Refund</ns0:outgoing>
    </ns0:intermediateCatchEvent>
    <ns0:userTask id="Task_CSReview" name="CS review (khi AI không chắc)">
      <ns0:incoming>Flow_AI_Uncertain</ns0:incoming>
      <ns0:outgoing>Flow_CS_Handover</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReschedulePickup" name="Đặt lại lịch pickup">
      <ns0:incoming>Flow_Pickup_No</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Pickup</ns0:outgoing>
    </ns0:userTask>
    <ns0:task id="Task_PickupReturn" name="LEX / 3PL pickup hàng trả">
      <ns0:incoming>Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_Gate</ns0:outgoing>
    </ns0:task>
    <ns0:serviceTask id="Task_ExecuteRefund" name="Cổng thanh toán giải ngân tiền hoàn">
      <ns0:incoming>Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund</ns0:incoming>
      <ns0:outgoing>Flow_Execute_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_RetryPayout" name="Thử lại giải ngân (tự động)">
      <ns0:incoming>Flow_Payout_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Execute</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_Eligible" name="Hợp lệ?">
      <ns0:incoming>Flow_Eligibility_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Eligible_Upload</ns0:outgoing>
      <ns0:outgoing>Flow_Eligible_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_LowRisk" name="Đơn giá trị &lt;200k &amp; Buyer tín nhiệm cao?">
      <ns0:incoming>Flow_Triage_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_LowRisk</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Handover</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_AIPass" name="AI xác thực lỗi đạt độ tin cậy &gt;95%?">
      <ns0:incoming>Flow_AI_Gate</ns0:incoming>
      <ns0:outgoing>Flow_AI_Pass</ns0:outgoing>
      <ns0:outgoing>Flow_AI_Uncertain</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Timer</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_PickupRetry" name="Pickup thành công?">
      <ns0:incoming>Flow_Pickup_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Pickup_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_PayoutSuccess" name="Giải ngân thành công?">
      <ns0:incoming>Flow_Execute_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Payout_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Payout_Retry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_PickupReturn_4" name="Gom luồng trước khi LEX / 3PL pickup hàng trả">
      <ns0:incoming>Flow_Pickup_Schedule</ns0:incoming>
      <ns0:incoming>Flow_Retry_Pickup</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <ns0:incoming>Flow_Notify_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Rejected" name="Yêu cầu hoàn trả đã bị từ chối">
      <ns0:incoming>Flow_Eligible_Reject</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_Request" targetRef="Task_SubmitRequest" />
    <ns0:sequenceFlow id="Flow_Submit_Eligibility" sourceRef="Task_SubmitRequest" targetRef="Task_CheckEligibility" />
    <ns0:sequenceFlow id="Flow_Eligibility_Gate" sourceRef="Task_CheckEligibility" targetRef="Gate_Eligible" />
    <ns0:sequenceFlow id="Flow_Eligible_Upload" sourceRef="Gate_Eligible" targetRef="Task_UploadEvidence" name="Hồ sơ hợp lệ" />
    <ns0:sequenceFlow id="Flow_Eligible_Reject" sourceRef="Gate_Eligible" targetRef="End_Rejected" name="Không hợp lệ" />
    <ns0:sequenceFlow id="Flow_Upload_Triage" sourceRef="Task_UploadEvidence" targetRef="Task_AITriage" />
    <ns0:sequenceFlow id="Flow_Triage_Gate" sourceRef="Task_AITriage" targetRef="Gate_LowRisk" />
    <ns0:sequenceFlow id="Flow_Gate_LowRisk" sourceRef="Gate_LowRisk" targetRef="Task_AIEvidenceVerify" name="Rủi ro thấp" />
    <ns0:sequenceFlow id="Flow_Gate_Handover" sourceRef="Gate_LowRisk" targetRef="Join_Task_HandoverReturn_1" name="Rủi ro cao" />
    <ns0:sequenceFlow id="Flow_AI_Gate" sourceRef="Task_AIEvidenceVerify" targetRef="Gate_AIPass" />
    <ns0:sequenceFlow id="Flow_AI_Pass" sourceRef="Gate_AIPass" targetRef="Task_InstantRefund" name="Đạt (&gt;95%)" />
    <ns0:sequenceFlow id="Flow_AI_Uncertain" sourceRef="Gate_AIPass" targetRef="Task_CSReview" name="Chưa đạt" />
    <ns0:sequenceFlow id="Flow_Gate_Timer" sourceRef="Gate_AIPass" targetRef="Timer_RefundSLA" name="Hết thời gian chờ" />
    <ns0:sequenceFlow id="Flow_Instant_Execute" sourceRef="Task_InstantRefund" targetRef="Join_Task_ExecuteRefund_3" />
    <ns0:sequenceFlow id="Flow_CS_Handover" sourceRef="Task_CSReview" targetRef="Join_Task_HandoverReturn_1" />
    <ns0:sequenceFlow id="Flow_Handover_Pickup" sourceRef="Task_HandoverReturn" targetRef="Task_DynamicPickup" />
    <ns0:sequenceFlow id="Flow_Pickup_Schedule" sourceRef="Task_DynamicPickup" targetRef="Join_Task_PickupReturn_4" />
    <ns0:sequenceFlow id="Flow_Pickup_Gate" sourceRef="Task_PickupReturn" targetRef="Gate_PickupRetry" />
    <ns0:sequenceFlow id="Flow_Pickup_Yes" sourceRef="Gate_PickupRetry" targetRef="Task_AIInspection" name="Pickup thành công" />
    <ns0:sequenceFlow id="Flow_Pickup_No" sourceRef="Gate_PickupRetry" targetRef="Task_ReschedulePickup" name="Pickup thất bại" />
    <ns0:sequenceFlow id="Flow_Retry_Pickup" sourceRef="Task_ReschedulePickup" targetRef="Join_Task_PickupReturn_4" />
    <ns0:sequenceFlow id="Flow_Inspection_Notify" sourceRef="Task_AIInspection" targetRef="Join_Task_ProcessRefund_2" />
    <ns0:sequenceFlow id="Flow_Timer_Refund" sourceRef="Timer_RefundSLA" targetRef="Join_Task_ProcessRefund_2" />
    <ns0:sequenceFlow id="Flow_Refund_Execute" sourceRef="Task_ProcessRefund" targetRef="Join_Task_ExecuteRefund_3" />
    <ns0:sequenceFlow id="Flow_Execute_Gate" sourceRef="Task_ExecuteRefund" targetRef="Gate_PayoutSuccess" />
    <ns0:sequenceFlow id="Flow_Payout_Yes" sourceRef="Gate_PayoutSuccess" targetRef="Task_NotifyStatus" name="Giải ngân thành công" />
    <ns0:sequenceFlow id="Flow_Payout_Retry" sourceRef="Gate_PayoutSuccess" targetRef="Task_RetryPayout" name="Giải ngân thất bại" />
    <ns0:sequenceFlow id="Flow_Retry_Execute" sourceRef="Task_RetryPayout" targetRef="Join_Task_ExecuteRefund_3" />
    <ns0:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifyStatus" targetRef="End_Refunded" />
    <ns0:exclusiveGateway id="Join_Task_HandoverReturn_1" name="Gom luồng trước khi Bàn giao hàng trả cho LEX / 3PL">
      <ns0:incoming>Flow_Gate_Handover</ns0:incoming>
      <ns0:incoming>Flow_CS_Handover</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn" sourceRef="Join_Task_HandoverReturn_1" targetRef="Task_HandoverReturn" />
    <ns0:exclusiveGateway id="Join_Task_ProcessRefund_2" name="Gom luồng trước khi Xử lý lệnh hoàn tiền tự động">
      <ns0:incoming>Flow_Inspection_Notify</ns0:incoming>
      <ns0:incoming>Flow_Timer_Refund</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund" sourceRef="Join_Task_ProcessRefund_2" targetRef="Task_ProcessRefund" />
    <ns0:exclusiveGateway id="Join_Task_ExecuteRefund_3" name="Gom luồng trước khi Cổng thanh toán giải ngân tiền hoàn">
      <ns0:incoming>Flow_Instant_Execute</ns0:incoming>
      <ns0:incoming>Flow_Refund_Execute</ns0:incoming>
      <ns0:incoming>Flow_Retry_Execute</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund" sourceRef="Join_Task_ExecuteRefund_3" targetRef="Task_ExecuteRefund" />
    <ns0:sequenceFlow id="Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn" sourceRef="Join_Task_PickupReturn_4" targetRef="Task_PickupReturn" />
  </ns0:process>
  <ns2:BPMNDiagram id="BPMNDiagram_1">
    <ns2:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ReturnRefund_TOBE"><ns2:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer"><ns3:Bounds x="30" y="140" width="5900" height="252" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_System_di" bpmnElement="Lane_System"><ns3:Bounds x="30" y="392" width="5900" height="252" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_CS_di" bpmnElement="Lane_CS"><ns3:Bounds x="30" y="644" width="5900" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse"><ns3:Bounds x="30" y="854" width="5900" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment"><ns3:Bounds x="30" y="1064" width="5900" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="StartEvent_Request_di" bpmnElement="StartEvent_Request"><ns3:Bounds x="212" y="200" width="36" height="36" /></ns2:BPMNShape><ns2:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest"><ns3:Bounds x="408" y="182" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_UploadEvidence_di" bpmnElement="Task_UploadEvidence"><ns3:Bounds x="1128" y="278" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_HandoverReturn_di" bpmnElement="Task_HandoverReturn"><ns3:Bounds x="2808" y="182" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_CheckEligibility_di" bpmnElement="Task_CheckEligibility"><ns3:Bounds x="648" y="434" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_AITriage_di" bpmnElement="Task_AITriage"><ns3:Bounds x="1368" y="434" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_AIEvidenceVerify_di" bpmnElement="Task_AIEvidenceVerify"><ns3:Bounds x="1848" y="434" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_InstantRefund_di" bpmnElement="Task_InstantRefund"><ns3:Bounds x="2328" y="434" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_DynamicPickup_di" bpmnElement="Task_DynamicPickup"><ns3:Bounds x="3048"