<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomerServiceTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_CustomerServiceTOBE" name="Cham soc Khach hang TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCSAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CustomerRespond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ConfirmResolved_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chatbot" name="Chatbot/AI">
        <bpmn:flowNodeRef>Task_ClassifyIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SentimentAnalyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KBAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Confident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tier1" name="CS Tier 1">
        <bpmn:flowNodeRef>Task_T1Handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_T1Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_T1Handle_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tier2" name="CS Tier 2">
        <bpmn:flowNodeRef>Task_T2Handle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_T2Handle_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_ProactiveOutreach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_NeedMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Angry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySupervisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSATAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogSession</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Contact" name="Yêu cầu hỗ trợ từ khách hàng">
      <bpmn:outgoing>Flow_Start_Contact</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Menu" name="Chọn chủ đề trợ giúp thông minh">
      <bpmn:incoming>Flow_Split_Main</bpmn:incoming>
      <bpmn:outgoing>Flow_Menu_Classify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmResolved" name="Khách hàng bấm xác nhận hoàn tất hỗ trợ">
      <bpmn:incoming>Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_CSAT</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RateCSAT" name="Khảo sát nhanh 2 câu hỏi CSAT / CES">
      <bpmn:incoming>Flow_CSAT_Rate</bpmn:incoming>
      <bpmn:outgoing>Flow_Rate_Log</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CustomerRespond" name="Nhập nội dung cần hỗ trợ">
      <bpmn:incoming>Flow_Outreach_Respond</bpmn:incoming>
      <bpmn:outgoing>Flow_Respond_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ClassifyIntent" name="AI LLM hiểu ngữ cảnh &amp; phân tích cảm xúc">
      <bpmn:incoming>Flow_Menu_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_Sentiment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SentimentAnalyze" name="Đo lường mức độ hài lòng / bức xúc">
      <bpmn:incoming>Flow_Classify_Sentiment</bpmn:incoming>
      <bpmn:outgoing>Flow_Sentiment_GateAngry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_KBAnswer" name="GenAI trả lời tức thì từ Knowledge Base">
      <bpmn:incoming>Flow_Confident_KB</bpmn:incoming>
      <bpmn:outgoing>Flow_KB_Confirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_T1Handle" name="CS Tier 1 xử lý nhanh với gợi ý từ Copilot">
      <bpmn:incoming>Flow_Join_Task_T1Handle_2_to_Task_T1Handle</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_T1Resolved" name="Kết quả xử lý của CS Tier 1?">
      <bpmn:incoming>Flow_T1_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_Timeout</bpmn:outgoing>
      <bpmn:outgoing>Flow_T1_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_T1_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_T2Handle" name="CS Tier 2 xử lý nghiệp vụ phức tạp">
      <bpmn:incoming>Flow_Join_Task_T2Handle_3_to_Task_T2Handle</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_T2Resolved" name="Kết quả xử lý của CS Tier 2?">
      <bpmn:incoming>Flow_T2_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_T2_Timeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_ContactSource" name="Kênh tương tác?">
      <bpmn:incoming>Flow_Start_Contact</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Main</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_Proactive</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ProactiveOutreach" name="AI chủ động gửi tin nhắn hỗ trợ trước">
      <bpmn:incoming>Flow_Split_Proactive</bpmn:incoming>
      <bpmn:outgoing>Flow_Outreach_Respond</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_NeedMore" name="Khách cần gặp tư vấn viên?">
      <bpmn:incoming>Flow_Respond_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedMore_T1</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedMore_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FetchContext" name="Tu dong lay context don hang (khong hoi lai)">
      <bpmn:incoming>Flow_Angry_Fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_Fetch_Confident</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Angry" name="Khach dang tuc gian?">
      <bpmn:incoming>Flow_Sentiment_GateAngry</bpmn:incoming>
      <bpmn:outgoing>Flow_Angry_T2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Angry_Fetch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_Confident" name="Chatbot AI tự tin xử lý (≥80%)?">
      <bpmn:incoming>Flow_Fetch_Confident</bpmn:incoming>
      <bpmn:outgoing>Flow_Confident_KB</bpmn:outgoing>
      <bpmn:outgoing>Flow_Confident_T1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifySupervisor" name="Cảnh báo tự động Supervisor khi trễ hạn">
      <bpmn:incoming>Flow_T2_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Confirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CSATAuto" name="Hệ thống tự động gửi form đánh giá">
      <bpmn:incoming>Flow_Confirm_CSAT</bpmn:incoming>
      <bpmn:outgoing>Flow_CSAT_Rate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LogSession" name="Lưu log &amp; tự động chấm điểm QA bằng AI">
      <bpmn:incoming>Flow_Rate_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Resolved" name="Phiên hỗ trợ đã kết thúc thành công">
      <bpmn:incoming>Flow_Log_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Proactive" name="Đã chủ động thông báo kết quả cho khách hàng">
      <bpmn:incoming>Flow_NeedMore_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Contact" sourceRef="StartEvent_Contact" targetRef="Gate_ContactSource" />
    <bpmn:sequenceFlow id="Flow_Split_Main" sourceRef="Gate_ContactSource" targetRef="Task_Menu" name="Khách hàng chủ động chat/gọi" />
    <bpmn:sequenceFlow id="Flow_Split_Proactive" sourceRef="Gate_ContactSource" targetRef="Task_ProactiveOutreach" name="Hệ thống AI chủ động rà soát đơn rủi ro" />
    <bpmn:sequenceFlow id="Flow_Menu_Classify" sourceRef="Task_Menu" targetRef="Task_ClassifyIntent" />
    <bpmn:sequenceFlow id="Flow_Classify_Sentiment" sourceRef="Task_ClassifyIntent" targetRef="Task_SentimentAnalyze" />
    <bpmn:sequenceFlow id="Flow_Sentiment_GateAngry" sourceRef="Task_SentimentAnalyze" targetRef="Gate_Angry" />
    <bpmn:sequenceFlow id="Flow_Angry_T2" sourceRef="Gate_Angry" targetRef="Join_Task_T2Handle_3" name="Tuc gian → Tier 2 uu tien" />
    <bpmn:sequenceFlow id="Flow_Angry_Fetch" sourceRef="Gate_Angry" targetRef="Task_FetchContext" name="Trạng thái cảm xúc bình thường" />
    <bpmn:sequenceFlow id="Flow_Fetch_Confident" sourceRef="Task_FetchContext" targetRef="Gate_Confident" />
    <bpmn:sequenceFlow id="Flow_Confident_KB" sourceRef="Gate_Confident" targetRef="Task_KBAnswer" name="80% Chatbot tu xu ly" />
    <bpmn:sequenceFlow id="Flow_Confident_T1" sourceRef="Gate_Confident" targetRef="Join_Task_T1Handle_2" name="Chuyển tư vấn viên khi vượt khả năng AI" />
    <bpmn:sequenceFlow id="Flow_KB_Confirm" sourceRef="Task_KBAnswer" targetRef="Join_Task_ConfirmResolved_1" />
    <bpmn:sequenceFlow id="Flow_T1_Gate" sourceRef="Task_T1Handle" targetRef="Gate_T1Resolved" />
    <bpmn:sequenceFlow id="Flow_T1_Timeout" sourceRef="Gate_T1Resolved" targetRef="Join_Task_T2Handle_3" name="Vuot SLA Tier 1 (15p)" />
    <bpmn:sequenceFlow id="Flow_T1_Confirm" sourceRef="Gate_T1Resolved" targetRef="Join_Task_ConfirmResolved_1" name="Da giai quyet" />
    <bpmn:sequenceFlow id="Flow_T1_Escalate" sourceRef="Gate_T1Resolved" targetRef="Join_Task_T2Handle_3" name="Chuyen Tier 2" />
    <bpmn:sequenceFlow id="Flow_T2_Gate" sourceRef="Task_T2Handle" targetRef="Gate_T2Resolved" />
    <bpmn:sequenceFlow id="Flow_T2_Confirm" sourceRef="Gate_T2Resolved" targetRef="Join_Task_ConfirmResolved_1" name="Da giai quyet" />
    <bpmn:sequenceFlow id="Flow_T2_Timeout" sourceRef="Gate_T2Resolved" targetRef="Task_NotifySupervisor" name="Vuot SLA Tier 2 (30p)" />
    <bpmn:sequenceFlow id="Flow_Notify_Confirm" sourceRef="Task_NotifySupervisor" targetRef="Join_Task_ConfirmResolved_1" />
    <bpmn:sequenceFlow id="Flow_Confirm_CSAT" sourceRef="Task_ConfirmResolved" targetRef="Task_CSATAuto" />
    <bpmn:sequenceFlow id="Flow_CSAT_Rate" sourceRef="Task_CSATAuto" targetRef="Task_RateCSAT" />
    <bpmn:sequenceFlow id="Flow_Rate_Log" sourceRef="Task_RateCSAT" targetRef="Task_LogSession" />
    <bpmn:sequenceFlow id="Flow_Log_End" sourceRef="Task_LogSession" targetRef="End_Resolved" />
    <bpmn:sequenceFlow id="Flow_Outreach_Respond" sourceRef="Task_ProactiveOutreach" targetRef="Task_CustomerRespond" />
    <bpmn:sequenceFlow id="Flow_Respond_Gate" sourceRef="Task_CustomerRespond" targetRef="Gate_NeedMore" />
    <bpmn:sequenceFlow id="Flow_NeedMore_T1" sourceRef="Gate_NeedMore" targetRef="Join_Task_T1Handle_2" name="Yêu cầu chuyển gặp chuyên viên" />
    <bpmn:sequenceFlow id="Flow_NeedMore_End" sourceRef="Gate_NeedMore" targetRef="End_Proactive" name="Het van de" />
    <bpmn:exclusiveGateway id="Join_Task_ConfirmResolved_1" name="Gom luồng trước khi Khách hàng bấm xác nhận hoàn tất hỗ trợ">
      <bpmn:incoming>Flow_KB_Confirm</bpmn:incoming>
      <bpmn:incoming>Flow_T1_Confirm</bpmn:incoming>
      <bpmn:incoming>Flow_T2_Confirm</bpmn:incoming>
      <bpmn:incoming>Flow_Notify_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved" sourceRef="Join_Task_ConfirmResolved_1" targetRef="Task_ConfirmResolved" />
    <bpmn:exclusiveGateway id="Join_Task_T1Handle_2" name="Gom luồng trước khi CS Tier 1 xử lý nhanh với gợi ý từ Copilot">
      <bpmn:incoming>Flow_Confident_T1</bpmn:incoming>
      <bpmn:incoming>Flow_NeedMore_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_T1Handle_2_to_Task_T1Handle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_T1Handle_2_to_Task_T1Handle" sourceRef="Join_Task_T1Handle_2" targetRef="Task_T1Handle" />
    <bpmn:exclusiveGateway id="Join_Task_T2Handle_3" name="Gom luồng trước khi CS Tier 2 xử lý nghiệp vụ phức tạp">
      <bpmn:incoming>Flow_Angry_T2</bpmn:incoming>
      <bpmn:incoming>Flow_T1_Timeout</bpmn:incoming>
      <bpmn:incoming>Flow_T1_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_T2Handle_3_to_Task_T2Handle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_T2Handle_3_to_Task_T2Handle" sourceRef="Join_Task_T2Handle_3" targetRef="Task_T2Handle" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_CustomerServiceTOBE"><bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer"><dc:Bounds x="30" y="140" width="5180" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Chatbot_di" bpmnElement="Lane_Chatbot"><dc:Bounds x="30" y="350" width="5180" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Tier1_di" bpmnElement="Lane_Tier1"><dc:Bounds x="30" y="560" width="5180" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Tier2_di" bpmnElement="Lane_Tier2"><dc:Bounds x="30" y="770" width="5180" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System"><dc:Bounds x="30" y="980" width="5180" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="StartEvent_Contact_di" bpmnElement="StartEvent_Contact"><dc:Bounds x="212" y="227" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Menu_di" bpmnElement="Task_Menu"><dc:Bounds x="648" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConfirmResolved_di" bpmnElement="Task_ConfirmResolved"><dc:Bounds x="4008" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RateCSAT_di" bpmnElement="Task_RateCSAT"><dc:Bounds x="4488" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CustomerRespond_di" bpmnElement="Task_CustomerRespond"><dc:Bounds x="888" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ClassifyIntent_di" bpmnElement="Task_ClassifyIntent"><dc:Bounds x="888" y="419" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SentimentAnalyze_di" bpmnElement="Task_SentimentAnalyze"><dc:Bounds x="1128" y="419" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_KBAnswer_di" bpmnElement="Task_KBAnswer"><dc:Bounds x="2088" y="419" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_T1Handle_di" bpmnElement