<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SellerMgmt_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_SellerMgmt_TOBE" name="Quản lý Nhà bán hàng TO-BE" isExecutable="true">
    <bpmn:laneSet id="LS1">
      <bpmn:lane id="L_Seller" name="Seller">
        <bpmn:flowNodeRef>SE_Reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Appr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_DocReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="Lazada System (AI &amp; Automation)">
        <bpmn:flowNodeRef>T_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AI_Doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AutoAppr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_T_Notify_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_T_Notify_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DocVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_KYC_Pass</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Comp" name="Compliance Team">
        <bpmn:flowNodeRef>Timer_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_T_Manual_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Legal" name="Legal / Giám sát Chế tài">
        <bpmn:flowNodeRef>G_Viol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Suspend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Susp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Ban</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_Reg" name="Yêu cầu đăng ký gian hàng">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Reg" name="Điền thông tin định danh Seller">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Upload" name="Upload CCCD &amp; GPKD (Smart Scan)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Validate" name="Validate tự động qua API">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_AI_Doc" name="AI OCR &amp; Chống giấy tờ giả">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_KYC" name="Real-time eKYC sinh trắc học">
      <bpmn:incoming>F_DocVerify_Pass</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Risk" name="AI Risk Scoring tự động">
      <bpmn:incoming>F_KYC_Pass_OK</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Risk" name="Mức độ rủi ro?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_AutoAppr" name="Tự động kích hoạt (Low-risk 3s)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_SLA" name="Hạn chót SLA 24h">
      <bpmn:timerEventDefinition id="TD1">
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Manual" name="Compliance review hồ sơ nghi vấn">
      <bpmn:incoming>Flow_Join_T_Manual_1_to_T_Manual</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Notify" name="Thông báo kết quả tức thì">
      <bpmn:incoming>Flow_Join_T_Notify_2_to_T_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Notify_to_Split_T_Notify_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Monitor" name="Giám sát vi phạm AI realtime">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Viol" name="Mức độ vi phạm?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Warn" name="Gửi cảnh cáo &amp; trừ điểm sao">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Suspend" name="Tạm khóa gian hàng (7 ngày)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Ban" name="Khóa vĩnh viễn gian hàng">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE_Appr" name="Gian hàng Lazada đã được kích hoạt">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_Warn" name="Gian hàng đã bị cảnh cáo">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_Susp" name="Gian hàng đã bị tạm khóa">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE_Ban" name="Gian hàng đã bị khóa vĩnh viễn">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="SE_Reg" targetRef="T_Reg" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Reg" targetRef="T_Upload" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Upload" targetRef="T_Validate" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Validate" targetRef="T_AI_Doc" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_AI_Doc" targetRef="G_DocVerify" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_KYC" targetRef="G_KYC_Pass" />
    <bpmn:sequenceFlow id="F_DocVerify_Pass" name="Giấy tờ hợp lệ" sourceRef="G_DocVerify" targetRef="T_KYC" />
    <bpmn:sequenceFlow id="F_DocVerify_Fail" name="Giấy tờ nghi vấn" sourceRef="G_DocVerify" targetRef="EE_DocReject" />
    <bpmn:sequenceFlow id="F_KYC_Pass_Fail" name="eKYC thất bại" sourceRef="G_KYC_Pass" targetRef="Join_T_Manual_1" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Risk" targetRef="G_Risk" />
    <bpmn:sequenceFlow id="F8" name="Low-risk (&gt;90%)" sourceRef="G_Risk" targetRef="T_AutoAppr" />
    <bpmn:sequenceFlow id="F9" name="Nghi vấn (&lt;10%)" sourceRef="G_Risk" targetRef="Join_T_Manual_1" />
    <bpmn:sequenceFlow id="F10" name="Timeout" sourceRef="G_Risk" targetRef="Timer_SLA" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_AutoAppr" targetRef="Join_T_Notify_2" />
    <bpmn:sequenceFlow id="F12" sourceRef="Timer_SLA" targetRef="Join_T_Manual_1" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Manual" targetRef="Join_T_Notify_2" />
    <bpmn:sequenceFlow id="F14" sourceRef="Split_T_Notify_1" targetRef="T_Monitor" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_Monitor" targetRef="G_Viol" />
    <bpmn:sequenceFlow id="F16" name="Nhẹ" sourceRef="G_Viol" targetRef="T_Warn" />
    <bpmn:sequenceFlow id="F17" name="Trung bình" sourceRef="G_Viol" targetRef="T_Suspend" />
    <bpmn:sequenceFlow id="F18" name="Nặng" sourceRef="G_Viol" targetRef="T_Ban" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Warn" targetRef="EE_Warn" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_Suspend" targetRef="EE_Susp" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_Ban" targetRef="EE_Ban" />
    <bpmn:sequenceFlow id="F22" sourceRef="Split_T_Notify_1" targetRef="EE_Appr" />
    <bpmn:exclusiveGateway id="Join_T_Manual_1" name="Gom luồng trước khi Compliance review hồ sơ nghi vấn">
      <bpmn:incoming>F_KYC_Pass_Fail</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_T_Manual_1_to_T_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_T_Manual_1_to_T_Manual" sourceRef="Join_T_Manual_1" targetRef="T_Manual" />
    <bpmn:exclusiveGateway id="Join_T_Notify_2" name="Gom luồng trước khi Thông báo kết quả tức thì">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_T_Notify_2_to_T_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_T_Notify_2_to_T_Notify" sourceRef="Join_T_Notify_2" targetRef="T_Notify" />
    <bpmn:exclusiveGateway id="Split_T_Notify_1" name="Phân luồng sau Thông báo kết quả tức thì">
      <bpmn:incoming>Flow_T_Notify_to_Split_T_Notify_1</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_T_Notify_to_Split_T_Notify_1" sourceRef="T_Notify" targetRef="Split_T_Notify_1" />
    <bpmn:exclusiveGateway id="G_DocVerify" name="Giấy tờ hợp lệ?">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F_DocVerify_Pass</bpmn:outgoing>
      <bpmn:outgoing>F_DocVerify_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_KYC_Pass" name="eKYC sinh trắc học thành công?">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F_KYC_Pass_Fail</bpmn:outgoing>
      <bpmn:outgoing>F_KYC_Pass_OK</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE_DocReject" name="Hồ sơ đã bị từ chối do giấy tờ nghi vấn">
      <bpmn:incoming>F_DocVerify_Fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_KYC_Pass_OK" name="eKYC thành công" sourceRef="G_KYC_Pass" targetRef="T_Risk" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SellerMgmt_TOBE">
