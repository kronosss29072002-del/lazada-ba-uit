<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SellerMgmt_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_SellerMgmt_TOBE" name="Quản lý Nhà bán hàng TO-BE" isExecutable="true">
    <ns0:laneSet id="LS1">
      <ns0:lane id="L_Seller" name="Seller">
        <ns0:flowNodeRef>SE_Reg</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Reg</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Upload</ns0:flowNodeRef>
        <ns0:flowNodeRef>EE_Appr</ns0:flowNodeRef>
        <ns0:flowNodeRef>EE_DocReject</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="L_Sys" name="Lazada System (AI &amp; Automation)">
        <ns0:flowNodeRef>T_Validate</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_AI_Doc</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_KYC</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Risk</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_Risk</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_AutoAppr</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Notify</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Monitor</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_T_Notify_2</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_T_Notify_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_DocVerify</ns0:flowNodeRef>
        <ns0:flowNodeRef>G_KYC_Pass</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="L_Comp" name="Compliance Team">
        <ns0:flowNodeRef>Timer_SLA</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Manual</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_T_Manual_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="L_Legal" name="Legal / Giám sát Chế tài">
        <ns0:flowNodeRef>G_Viol</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Warn</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Suspend</ns0:flowNodeRef>
        <ns0:flowNodeRef>T_Ban</ns0:flowNodeRef>
        <ns0:flowNodeRef>EE_Warn</ns0:flowNodeRef>
        <ns0:flowNodeRef>EE_Susp</ns0:flowNodeRef>
        <ns0:flowNodeRef>EE_Ban</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="SE_Reg" name="Yêu cầu đăng ký gian hàng">
      <ns0:outgoing>F1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="T_Reg" name="Điền thông tin định danh Seller">
      <ns0:incoming>F1</ns0:incoming>
      <ns0:outgoing>F2</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="T_Upload" name="Upload CCCD &amp; GPKD (Smart Scan)">
      <ns0:incoming>F2</ns0:incoming>
      <ns0:outgoing>F3</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="T_Validate" name="Validate tự động qua API">
      <ns0:incoming>F3</ns0:incoming>
      <ns0:outgoing>F4</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="T_AI_Doc" name="AI OCR &amp; Chống giấy tờ giả">
      <ns0:incoming>F4</ns0:incoming>
      <ns0:outgoing>F23</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="T_KYC" name="Real-time eKYC sinh trắc học">
      <ns0:incoming>F_DocVerify_Pass</ns0:incoming>
      <ns0:outgoing>F24</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="T_Risk" name="AI Risk Scoring tự động">
      <ns0:incoming>F_KYC_Pass_OK</ns0:incoming>
      <ns0:outgoing>F7</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="G_Risk" name="Mức độ rủi ro?">
      <ns0:incoming>F7</ns0:incoming>
      <ns0:outgoing>F8</ns0:outgoing>
      <ns0:outgoing>F9</ns0:outgoing>
      <ns0:outgoing>F10</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="T_AutoAppr" name="Tự động kích hoạt (Low-risk 3s)">
      <ns0:incoming>F8</ns0:incoming>
      <ns0:outgoing>F11</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_SLA" name="Hạn chót SLA 24h">
      <ns0:timerEventDefinition id="TD1">
        <ns0:timeDuration>PT24H</ns0:timeDuration>
      </ns0:timerEventDefinition>
      <ns0:incoming>F10</ns0:incoming>
      <ns0:outgoing>F12</ns0:outgoing>
    </ns0:intermediateCatchEvent>
    <ns0:userTask id="T_Manual" name="Compliance review hồ sơ nghi vấn">
      <ns0:incoming>Flow_Join_T_Manual_1_to_T_Manual</ns0:incoming>
      <ns0:outgoing>F13</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="T_Notify" name="Thông báo kết quả tức thì">
      <ns0:incoming>Flow_Join_T_Notify_2_to_T_Notify</ns0:incoming>
      <ns0:outgoing>Flow_T_Notify_to_Split_T_Notify_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="T_Monitor" name="Giám sát vi phạm AI realtime">
      <ns0:incoming>F14</ns0:incoming>
      <ns0:outgoing>F15</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="G_Viol" name="Mức độ vi phạm?">
      <ns0:incoming>F15</ns0:incoming>
      <ns0:outgoing>F16</ns0:outgoing>
      <ns0:outgoing>F17</ns0:outgoing>
      <ns0:outgoing>F18</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="T_Warn" name="Gửi cảnh cáo &amp; trừ điểm sao">
      <ns0:incoming>F16</ns0:incoming>
      <ns0:outgoing>F19</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="T_Suspend" name="Tạm khóa gian hàng (7 ngày)">
      <ns0:incoming>F17</ns0:incoming>
      <ns0:outgoing>F20</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="T_Ban" name="Khóa vĩnh viễn gian hàng">
      <ns0:incoming>F18</ns0:incoming>
      <ns0:outgoing>F21</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="EE_Appr" name="Gian hàng Lazada đã được kích hoạt">
      <ns0:incoming>F22</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EE_Warn" name="Gian hàng đã bị cảnh cáo">
      <ns0:incoming>F19</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EE_Susp" name="Gian hàng đã bị tạm khóa">
      <ns0:incoming>F20</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EE_Ban" name="Gian hàng đã bị khóa vĩnh viễn">
      <ns0:incoming>F21</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="F1" sourceRef="SE_Reg" targetRef="T_Reg" />
    <ns0:sequenceFlow id="F2" sourceRef="T_Reg" targetRef="T_Upload" />
    <ns0:sequenceFlow id="F3" sourceRef="T_Upload" targetRef="T_Validate" />
    <ns0:sequenceFlow id="F4" sourceRef="T_Validate" targetRef="T_AI_Doc" />
    <ns0:sequenceFlow id="F23" sourceRef="T_AI_Doc" targetRef="G_DocVerify" />
    <ns0:sequenceFlow id="F24" sourceRef="T_KYC" targetRef="G_KYC_Pass" />
    <ns0:sequenceFlow id="F_DocVerify_Pass" name="Giấy tờ hợp lệ" sourceRef="G_DocVerify" targetRef="T_KYC" />
    <ns0:sequenceFlow id="F_DocVerify_Fail" name="Giấy tờ nghi vấn" sourceRef="G_DocVerify" targetRef="EE_DocReject" />
    <ns0:sequenceFlow id="F_KYC_Pass_Fail" name="eKYC thất bại" sourceRef="G_KYC_Pass" targetRef="Join_T_Manual_1" />
    <ns0:sequenceFlow id="F7" sourceRef="T_Risk" targetRef="G_Risk" />
    <ns0:sequenceFlow id="F8" name="Low-risk (&gt;90%)" sourceRef="G_Risk" targetRef="T_AutoAppr" />
    <ns0:sequenceFlow id="F9" name="Nghi vấn (&lt;10%)" sourceRef="G_Risk" targetRef="Join_T_Manual_1" />
    <ns0:sequenceFlow id="F10" name="Timeout" sourceRef="G_Risk" targetRef="Timer_SLA" />
    <ns0:sequenceFlow id="F11" sourceRef="T_AutoAppr" targetRef="Join_T_Notify_2" />
    <ns0:sequenceFlow id="F12" sourceRef="Timer_SLA" targetRef="Join_T_Manual_1" />
    <ns0:sequenceFlow id="F13" sourceRef="T_Manual" targetRef="Join_T_Notify_2" />
    <ns0:sequenceFlow id="F14" sourceRef="Split_T_Notify_1" targetRef="T_Monitor" name="Giám sát vi phạm AI" />
    <ns0:sequenceFlow id="F15" sourceRef="T_Monitor" targetRef="G_Viol" />
    <ns0:sequenceFlow id="F16" name="Nhẹ" sourceRef="G_Viol" targetRef="T_Warn" />
    <ns0:sequenceFlow id="F17" name="Trung bình" sourceRef="G_Viol" targetRef="T_Suspend" />
    <ns0:sequenceFlow id="F18" name="Nặng" sourceRef="G_Viol" targetRef="T_Ban" />
    <ns0:sequenceFlow id="F19" sourceRef="T_Warn" targetRef="EE_Warn" />
    <ns0:sequenceFlow id="F20" sourceRef="T_Suspend" targetRef="EE_Susp" />
    <ns0:sequenceFlow id="F21" sourceRef="T_Ban" targetRef="EE_Ban" />
    <ns0:sequenceFlow id="F22" sourceRef="Split_T_Notify_1" targetRef="EE_Appr" name="Kích hoạt gian hàng" />
    <ns0:exclusiveGateway id="Join_T_Manual_1" name="Gom luồng trước khi Compliance review hồ sơ nghi vấn">
      <ns0:incoming>F_KYC_Pass_Fail</ns0:incoming>
      <ns0:incoming>F9</ns0:incoming>
      <ns0:incoming>F12</ns0:incoming>
      <ns0:outgoing>Flow_Join_T_Manual_1_to_T_Manual</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_T_Manual_1_to_T_Manual" sourceRef="Join_T_Manual_1" targetRef="T_Manual" />
    <ns0:exclusiveGateway id="Join_T_Notify_2" name="Gom luồng trước khi Thông báo kết quả tức thì">
      <ns0:incoming>F11</ns0:incoming>
      <ns0:incoming>F13</ns0:incoming>
      <ns0:outgoing>Flow_Join_T_Notify_2_to_T_Notify</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_T_Notify_2_to_T_Notify" sourceRef="Join_T_Notify_2" targetRef="T_Notify" />
    <ns0:exclusiveGateway id="Split_T_Notify_1" name="Phân luồng sau Thông báo kết quả tức thì">
      <ns0:incoming>Flow_T_Notify_to_Split_T_Notify_1</ns0:incoming>
      <ns0:outgoing>F14</ns0:outgoing>
      <ns0:outgoing>F22</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_T_Notify_to_Split_T_Notify_1" sourceRef="T_Notify" targetRef="Split_T_Notify_1" />
    <ns0:exclusiveGateway id="G_DocVerify" name="Giấy tờ hợp lệ?">
      <ns0:incoming>F23</ns0:incoming>
      <ns0:outgoing>F_DocVerify_Pass</ns0:outgoing>
      <ns0:outgoing>F_DocVerify_Fail</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="G_KYC_Pass" name="eKYC sinh trắc học thành công?">
      <ns0:incoming>F24</ns0:incoming>
      <ns0:outgoing>F_KYC_Pass_Fail</ns0:outgoing>
      <ns0:outgoing>F_KYC_Pass_OK</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="EE_DocReject" name="Hồ sơ đã bị từ chối do giấy tờ nghi vấn">
      <ns0:incoming>F_DocVerify_Fail</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="F_KYC_Pass_OK" name="eKYC thành công" sourceRef="G_KYC_Pass" targetRef="T_Risk" />
  </ns0:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
    <ns1:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SellerMgmt_TOBE"><ns1:BPMNShape id="L_Seller_di" bpmnElement="L_Seller"><ns2:Bounds x="30" y="140" width="4940" height="210" /></ns1:BPMNShape><ns1:BPMNShape id="L_Sys_di" bpmnElement="L_Sys"><ns2:Bounds x="30" y="350" width="4940" height="210" /></ns1:BPMNShape><ns1:BPMNShape id="L_Comp_di" bpmnElement="L_Comp"><ns2:Bounds x="30" y="560" width="4940" height="210" /></ns1:BPMNShape><ns1:BPMNShape id="L_Legal_di" bpmnElement="L_Legal"><ns2:Bounds x="30" y="770" width="4940" height="348" /></ns1:BPMNShape><ns1:BPMNShape id="SE_Reg_di" bpmnElement="SE_Reg"><ns2:Bounds x="212" y="227" width="36" height="36" /></ns1:BPMNShape><ns1:BPMNShape id="T_Reg_di" bpmnElement="T_Reg"><ns2:Bounds x="408" y="209" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_Upload_di" bpmnElement="T_Upload"><ns2:Bounds x="648" y="209" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_Validate_di" bpmnElement="T_Validate"><ns2:Bounds x="888" y="419" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_AI_Doc_di" bpmnElement="T_AI_Doc"><ns2:Bounds x="1128" y="419" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_KYC_di" bpmnElement="T_KYC"><ns2:Bounds x="1608" y="419" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_Risk_di" bpmnElement="T_Risk"><ns2:Bounds x="2088" y="419" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="G_Risk_di" bpmnElement="G_Risk"><ns2:Bounds x="2365" y="430" width="50" height="50" /></ns1:BPMNShape><ns1:BPMNShape id="T_AutoAppr_di" bpmnElement="T_AutoAppr"><ns2:Bounds x="2568" y="419" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="Timer_SLA_di" bpmnElement="Timer_SLA"><ns2:Bounds x="2612" y="647" width="36" height="36" /></ns1:BPMNShape><ns1:BPMNShape id="T_Manual_di" bpmnElement="T_Manual"><ns2:Bounds x="3048" y="629" width="124" height="72" /></ns1:BPMNShape><ns1:BPMNShape id="T_Notify_di" bpmnElement="T_Notify"><ns2:Bounds x=