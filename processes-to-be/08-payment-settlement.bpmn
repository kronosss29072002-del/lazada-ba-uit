<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentSettlementTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_PaymentSettlementTOBE" name="Quy trình Thanh toán &amp; Đối soát TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PaymentType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_CODVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRefund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI Fraud Detection System">
        <bpmn:flowNodeRef>Task_RiskScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_HighRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BlockTransaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FraudAlert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Escrow)">
        <bpmn:flowNodeRef>Task_HoldEscrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstantSettle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SellerTrust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoReconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ReconcileOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcCommission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateWallet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Settled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Refunded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_HoldEscrow_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_AutoReconcile_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_CalcCommission_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_UpdateWallet_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_SendStatement_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Task_CheckWallet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BankOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_Withdraw_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Checkout" name="Thanh toán đơn hàng">
      <bpmn:outgoing>Flow_S1_Select</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectPayment" name="Chọn phương thức thanh toán (COD/Online/Ví)">
      <bpmn:incoming>Flow_S1_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_GateType</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PaymentType" name="Phương thức thanh toán?">
      <bpmn:incoming>Flow_Select_GateType</bpmn:incoming>
      <bpmn:outgoing>Flow_TypeCOD_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_TypeOnline_Pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PayCOD" name="Thanh toán COD khi nhận hàng">
      <bpmn:incoming>Flow_TypeCOD_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_COD_Receive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PayOnline" name="Thanh toán online qua cổng thanh toán">
      <bpmn:incoming>Flow_TypeOnline_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Online_RiskScore</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveGoods" name="Buyer nhận hàng &amp; xác nhận COD">
      <bpmn:incoming>Flow_COD_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_GateCOD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_CODVerify" name="COD xác nhận đã thu tiền?">
      <bpmn:incoming>Flow_Receive_GateCOD</bpmn:incoming>
      <bpmn:outgoing>Flow_CODYes_Reconcile</bpmn:outgoing>
      <bpmn:outgoing>Flow_CODNo_Flag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReceiveRefund" name="Buyer nhận hoàn tiền tự động">
      <bpmn:incoming>Flow_RefundOK_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RiskScore" name="AI tính điểm rủi ro giao dịch real-time">
      <bpmn:incoming>Flow_Online_RiskScore</bpmn:incoming>
      <bpmn:outgoing>Flow_Risk_GateRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_HighRisk" name="Giao dịch rủi ro cao (score ≥ 80)?">
      <bpmn:incoming>Flow_Risk_GateRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskYes_Block</bpmn:outgoing>
      <bpmn:outgoing>Flow_RiskNo_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BlockTransaction" name="Chặn giao dịch — yêu cầu xác minh bổ sung">
      <bpmn:incoming>Flow_RiskYes_Block</bpmn:incoming>
      <bpmn:outgoing>Flow_Block_FraudAlert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ApproveAuto" name="Phê duyệt tự động (AI xác nhận an toàn)">
      <bpmn:incoming>Flow_RiskNo_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Hold</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FraudAlert" name="Cảnh báo gian lận đến CS-terminal">
      <bpmn:incoming>Flow_Block_FraudAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_Fraud_Block</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_HoldEscrow" name="Giữ tiền trong Escrow Blockchain">
      <bpmn:outgoing>Flow_Hold_GateTrust</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_SellerTrust" name="Seller thuộc nhóm Trusted (đủ điều kiện)?">
      <bpmn:incoming>Flow_Hold_GateTrust</bpmn:incoming>
      <bpmn:outgoing>Flow_TrustYes_Instant</bpmn:outgoing>
      <bpmn:outgoing>Flow_TrustNo_Standard</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_InstantSettle" name="Giải ngân tức thì cho Seller (trusted)">
      <bpmn:incoming>Flow_TrustYes_Instant</bpmn:incoming>
      <bpmn:outgoing>Flow_Instant_Wallet</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoReconcile" name="Đối soát tự động COD/Online end-of-day">
      <bpmn:outgoing>Flow_Reconcile_GateOK</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_ReconcileOK" name="Đối soát khớp 100%?">
      <bpmn:incoming>Flow_Reconcile_GateOK</bpmn:incoming>
      <bpmn:outgoing>Flow_OK_Commission</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotOK_Flag</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refund_Auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_RefundOK" name="Hoàn tiền được chấp thuận?">
      <bpmn:incoming>Flow_Refund_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundOK_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundNo_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalcCommission" name="Tính hoa hồng &amp; phí tự động">
      <bpmn:outgoing>Flow_Commission_Wallet</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateWallet" name="Cập nhật số dư Ví Seller + Push notification">
      <bpmn:incoming>Flow_Commission_Wallet</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendStatement" name="Gửi bảng đối soát điện tử tự động hàng tháng">
      <bpmn:outgoing>Flow_Statement_End</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_SendStatement_1_to_Task_SendStatement</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_End_Event_Settled_1" name="Gom nhánh kết thúc">
      <bpmn:incoming>Flow_Statement_End</bpmn:incoming>
      <bpmn:incoming>Flow_BankYes_End</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_Event_Settled_1_to_EndEvent_Settled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Settled" name="Đối soát đã hoàn tất">
      <bpmn:incoming>Flow_Join_End_Event_Settled_1_to_EndEvent_Settled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Refunded" name="Đã hoàn tiền tự động về Buyer">
      <bpmn:incoming>Flow_Refund_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_CheckWallet" name="Seller nhận Push notification số dư Ví">
      <bpmn:incoming>Flow_Wallet_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Withdraw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Withdraw" name="Rút tiền từ Ví về tài khoản ngân hàng">
      <bpmn:outgoing>Flow_Withdraw_GateBank</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_Withdraw_1_to_Task_Withdraw</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_BankOK" name="Chuyển khoản thành công?">
      <bpmn:incoming>Flow_Withdraw_GateBank</bpmn:incoming>
      <bpmn:outgoing>Flow_BankYes_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_BankNo_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S1_Select" sourceRef="StartEvent_Checkout" targetRef="Task_SelectPayment" />
    <bpmn:sequenceFlow id="Flow_Select_GateType" sourceRef="Task_SelectPayment" targetRef="Gate_PaymentType" />
    <bpmn:sequenceFlow id="Flow_TypeCOD_Pay" name="COD" sourceRef="Gate_PaymentType" targetRef="Task_PayCOD" />
    <bpmn:sequenceFlow id="Flow_TypeOnline_Pay" name="Online" sourceRef="Gate_PaymentType" targetRef="Task_PayOnline" />
    <bpmn:sequenceFlow id="Flow_Online_RiskScore" sourceRef="Task_PayOnline" targetRef="Task_RiskScore" />
    <bpmn:sequenceFlow id="Flow_Risk_GateRisk" sourceRef="Task_RiskScore" targetRef="Gate_HighRisk" />
    <bpmn:sequenceFlow id="Flow_RiskYes_Block" name="Rủi ro cao" sourceRef="Gate_HighRisk" targetRef="Task_BlockTransaction" />
    <bpmn:sequenceFlow id="Flow_RiskNo_Approve" name="An toàn" sourceRef="Gate_HighRisk" targetRef="Task_ApproveAuto" />
    <bpmn:sequenceFlow id="Flow_Block_FraudAlert" sourceRef="Task_BlockTransaction" targetRef="Task_FraudAlert" />
    <bpmn:sequenceFlow id="Flow_Approve_Hold" sourceRef="Task_ApproveAuto" targetRef="Join_Task_HoldEscrow_1" />
    <bpmn:sequenceFlow id="Flow_Fraud_Block" sourceRef="Task_FraudAlert" targetRef="Join_Task_HoldEscrow_1" />
    <bpmn:sequenceFlow id="Flow_Hold_GateTrust" sourceRef="Task_HoldEscrow" targetRef="Gate_SellerTrust" />
    <bpmn:sequenceFlow id="Flow_TrustYes_Instant" name="Trusted seller" sourceRef="Gate_SellerTrust" targetRef="Task_InstantSettle" />
    <bpmn:sequenceFlow id="Flow_TrustNo_Standard" name="Standard (L+2)" sourceRef="Gate_SellerTrust" targetRef="Join_Task_AutoReconcile_1" />
    <bpmn:sequenceFlow id="Flow_Instant_Wallet" sourceRef="Task_InstantSettle" targetRef="Join_Task_CalcCommission_1" />
    <bpmn:sequenceFlow id="Flow_COD_Receive" sourceRef="Task_PayCOD" targetRef="Task_ReceiveGoods" />
    <bpmn:sequenceFlow id="Flow_Receive_GateCOD" sourceRef="Task_ReceiveGoods" targetRef="Gate_CODVerify" />
    <bpmn:sequenceFlow id="Flow_CODYes_Reconcile" name="COD đã thu" sourceRef="Gate_CODVerify" targetRef="Join_Task_AutoReconcile_1" />
    <bpmn:sequenceFlow id="Flow_CODNo_Flag" name="Chưa thu — đánh dấu" sourceRef="Gate_CODVerify" targetRef="Join_Task_AutoReconcile_1" />
    <bpmn:sequenceFlow id="Flow_Reconcile_GateOK" sourceRef="Task_AutoReconcile" targetRef="Gate_ReconcileOK" />
    <bpmn:sequenceFlow id="Flow_OK_Commission" name="Khớp" sourceRef="Gate_ReconcileOK" targetRef="Join_Task_CalcCommission_1" />
    <bpmn:sequenceFlow id="Flow_NotOK_Flag" name="Lệch — đánh dấu" sourceRef="Gate_ReconcileOK" targetRef="Join_Task_CalcCommission_1" />
    <bpmn:sequenceFlow id="Flow_Commission_Wallet" sourceRef="Task_CalcCommission" targetRef="Task_UpdateWallet" />
    <bpmn:sequenceFlow id="Flow_Wallet_Statement" sourceRef="Split_Task_UpdateWallet_1" targetRef="Join_Task_SendStatement_1" />
    <bpmn:sequenceFlow id="Flow_Wallet_Check" sourceRef="Split_Task_UpdateWallet_1" targetRef="Task_CheckWallet" />
    <bpmn:sequenceFlow id="Flow_Statement_End" sourceRef="Task_SendStatement" targetRef="Join_End_Event_Settled_1" />
    <bpmn:sequenceFlow id="Flow_Check_Withdraw" sourceRef="Task_CheckWallet" targetRef="Join_Task_Withdraw_1" />
    <bpmn:sequenceFlow id="Flow_Withdraw_GateBank" sourceRef="Task_Withdraw" targetRef="Gate_BankOK" />
    <bpmn:sequenceFlow id="Flow_BankYes_End" name="Thành công" sourceRef="Gate_BankOK" targetRef="Join_End_Event_Settled_1" />
    <bpmn:sequenceFlow id="Flow_BankNo_Retry" name="Thất bại — retry" sourceRef="Gate_BankOK" targetRef="Join_Task_Withdraw_1" />
    <bpmn:sequenceFlow id="Flow_Refund_Auto" name="Yêu cầu hoàn tiền" sourceRef="Gate_ReconcileOK" targetRef="Gate_RefundOK" />
    <bpmn:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ReceiveRefund" targetRef="EndEvent_Refunded" />
    <bpmn:sequenceFlow id="Flow_RefundOK_Auto" name="Chấp thuận" sourceRef="Gate_RefundOK" targetRef="Task_ReceiveRefund" />
    <bpmn:sequenceFlow id="Flow_RefundNo_Manual" name="Từ chối — xử lý thủ công" sourceRef="Gate_RefundOK" targetRef="Join_Task_SendStatement_1" />
    <bpmn:sequenceFlow id="Flow_Join_End_Event_Settled_1_to_EndEvent_Settled" sourceRef="Join_End_Event_Settled_1" targetRef="EndEvent_Settled" name="" />
    <bpmn:exclusiveGateway id="Join_Task_HoldEscrow_1" name="Gom luồng trước khi Giữ tiền trong Escrow Blockchain">
      <bpmn:incoming>Flow_Approve_Hold</bpmn:incoming>
      <bpmn:incoming>Flow_Fraud_Block</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow" sourceRef="Join_Task_HoldEscrow_1" targetRef="Task_HoldEscrow" />
    <bpmn:exclusiveGateway id="Join_Task_AutoReconcile_1" name="Gom luồng trước khi Đối soát tự động COD/Online end-of-day">
      <bpmn:incoming>Flow_TrustNo_Standard</bpmn:incoming>
      <bpmn:incoming>Flow_CODYes_Reconcile</bpmn:incoming>
      <bpmn:incoming>Flow_CODNo_Flag</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile" sourceRef="Join_Task_AutoReconcile_1" targetRef="Task_AutoReconcile" />
    <bpmn:exclusiveGateway id="Join_Task_CalcCommission_1" name="Gom luồng trước khi Tính hoa hồng &amp; phí tự động">
      <bpmn:incoming>Flow_Instant_Wallet</bpmn:incoming>
      <bpmn:incoming>Flow_OK_Commission</bpmn:incoming>
      <bpmn:incoming>Flow_NotOK_Flag</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission" sourceRef="Join_Task_CalcCommission_1" targetRef="Task_CalcCommission" />
    <bpmn:exclusiveGateway id="Split_Task_UpdateWallet_1" name="Phân luồng sau Cập nhật số dư Ví Seller + Push notification">
      <bpmn:incoming>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Wallet_Statement</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wallet_Check</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1" sourceRef="Task_UpdateWallet" targetRef="Split_Task_UpdateWallet_1" />
    <bpmn:exclusiveGateway id="Join_Task_SendStatement_1" name="Gom luồng trước khi Gửi bảng đối soát điện tử tự động hàng tháng">
      <bpmn:incoming>Flow_Wallet_Statement</bpmn:incoming>
      <bpmn:incoming>Flow_RefundNo_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_SendStatement_1_to_Task_SendStatement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_SendStatement_1_to_Task_SendStatement" sourceRef="Join_Task_SendStatement_1" targetRef="Task_SendStatement" />
    <bpmn:exclusiveGateway id="Join_Task_Withdraw_1" name="Gom luồng trước khi Rút tiền từ Ví về tài khoản ngân hàng">
      <bpmn:incoming>Flow_Check_Withdraw</bpmn:incoming>
      <bpmn:incoming>Flow_BankNo_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Withdraw_1_to_Task_Withdraw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_Withdraw_1_to_Task_Withdraw" sourceRef="Join_Task_Withdraw_1" targetRef="Task_Withdraw" />
  </bpmn:process>
