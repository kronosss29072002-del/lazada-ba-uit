<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentSettlementTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_PaymentSettlementTOBE" name="Quy trình Thanh toán &amp; Đối soát TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Checkout</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SelectPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PaymentType</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PayCOD</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PayOnline</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_CODVerify</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveRefund</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_AI" name="AI Fraud Detection System">
        <ns0:flowNodeRef>Task_RiskScore</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_HighRisk</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_BlockTransaction</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ApproveAuto</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FraudAlert</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Escrow)">
        <ns0:flowNodeRef>Task_HoldEscrow</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_InstantSettle</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SellerTrust</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoReconcile</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ReconcileOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CalcCommission</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UpdateWallet</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SendStatement</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Settled</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Refunded</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_HoldEscrow_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AutoReconcile_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_CalcCommission_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_UpdateWallet_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_SendStatement_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_CheckWallet</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Withdraw</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BankOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_Withdraw_1</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Checkout" name="Thanh toán đơn hàng">
      <ns0:outgoing>Flow_S1_Select</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_SelectPayment" name="Chọn phương thức thanh toán (COD/Online/Ví)">
      <ns0:incoming>Flow_S1_Select</ns0:incoming>
      <ns0:outgoing>Flow_Select_GateType</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PaymentType" name="Phương thức thanh toán?">
      <ns0:incoming>Flow_Select_GateType</ns0:incoming>
      <ns0:outgoing>Flow_TypeCOD_Pay</ns0:outgoing>
      <ns0:outgoing>Flow_TypeOnline_Pay</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_PayCOD" name="Thanh toán COD khi nhận hàng">
      <ns0:incoming>Flow_TypeCOD_Pay</ns0:incoming>
      <ns0:outgoing>Flow_COD_Receive</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PayOnline" name="Thanh toán online qua cổng thanh toán">
      <ns0:incoming>Flow_TypeOnline_Pay</ns0:incoming>
      <ns0:outgoing>Flow_Online_RiskScore</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReceiveGoods" name="Buyer nhận hàng &amp; xác nhận COD">
      <ns0:incoming>Flow_COD_Receive</ns0:incoming>
      <ns0:outgoing>Flow_Receive_GateCOD</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_CODVerify" name="COD xác nhận đã thu tiền?">
      <ns0:incoming>Flow_Receive_GateCOD</ns0:incoming>
      <ns0:outgoing>Flow_CODYes_Reconcile</ns0:outgoing>
      <ns0:outgoing>Flow_CODNo_Flag</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ReceiveRefund" name="Buyer nhận hoàn tiền tự động">
      <ns0:incoming>Flow_RefundOK_Auto</ns0:incoming>
      <ns0:outgoing>Flow_Refund_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_RiskScore" name="AI tính điểm rủi ro giao dịch real-time">
      <ns0:incoming>Flow_Online_RiskScore</ns0:incoming>
      <ns0:outgoing>Flow_Risk_GateRisk</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_HighRisk" name="Giao dịch rủi ro cao (score ≥ 80)?">
      <ns0:incoming>Flow_Risk_GateRisk</ns0:incoming>
      <ns0:outgoing>Flow_RiskYes_Block</ns0:outgoing>
      <ns0:outgoing>Flow_RiskNo_Approve</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_BlockTransaction" name="Chặn giao dịch — yêu cầu xác minh bổ sung">
      <ns0:incoming>Flow_RiskYes_Block</ns0:incoming>
      <ns0:outgoing>Flow_Block_FraudAlert</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ApproveAuto" name="Phê duyệt tự động (AI xác nhận an toàn)">
      <ns0:incoming>Flow_RiskNo_Approve</ns0:incoming>
      <ns0:outgoing>Flow_Approve_Hold</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_FraudAlert" name="Cảnh báo gian lận đến CS-terminal">
      <ns0:incoming>Flow_Block_FraudAlert</ns0:incoming>
      <ns0:outgoing>Flow_Fraud_Block</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_HoldEscrow" name="Giữ tiền trong Escrow Blockchain">
      <ns0:outgoing>Flow_Hold_GateTrust</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow</ns0:incoming>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_SellerTrust" name="Seller thuộc nhóm Trusted (đủ điều kiện)?">
      <ns0:incoming>Flow_Hold_GateTrust</ns0:incoming>
      <ns0:outgoing>Flow_TrustYes_Instant</ns0:outgoing>
      <ns0:outgoing>Flow_TrustNo_Standard</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_InstantSettle" name="Giải ngân tức thì cho Seller (trusted)">
      <ns0:incoming>Flow_TrustYes_Instant</ns0:incoming>
      <ns0:outgoing>Flow_Instant_Wallet</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoReconcile" name="Đối soát tự động COD/Online end-of-day">
      <ns0:outgoing>Flow_Reconcile_GateOK</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile</ns0:incoming>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_ReconcileOK" name="Đối soát khớp 100%?">
      <ns0:incoming>Flow_Reconcile_GateOK</ns0:incoming>
      <ns0:outgoing>Flow_OK_Commission</ns0:outgoing>
      <ns0:outgoing>Flow_NotOK_Flag</ns0:outgoing>
      <ns0:outgoing>Flow_Refund_Auto</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_RefundOK" name="Hoàn tiền được chấp thuận?">
      <ns0:incoming>Flow_Refund_Auto</ns0:incoming>
      <ns0:outgoing>Flow_RefundOK_Auto</ns0:outgoing>
      <ns0:outgoing>Flow_RefundNo_Manual</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_CalcCommission" name="Tính hoa hồng &amp; phí tự động">
      <ns0:outgoing>Flow_Commission_Wallet</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_UpdateWallet" name="Cập nhật số dư Ví Seller + Push notification">
      <ns0:incoming>Flow_Commission_Wallet</ns0:incoming>
      <ns0:outgoing>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_SendStatement" name="Gửi bảng đối soát điện tử tự động hàng tháng">
      <ns0:outgoing>Flow_Statement_End</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_SendStatement_1_to_Task_SendStatement</ns0:incoming>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Join_End_Event_Settled_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_Statement_End</ns0:incoming>
      <ns0:incoming>Flow_BankYes_End</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_Event_Settled_1_to_EndEvent_Settled</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="EndEvent_Settled" name="Đối soát đã hoàn tất">
      <ns0:incoming>Flow_Join_End_Event_Settled_1_to_EndEvent_Settled</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EndEvent_Refunded" name="Đã hoàn tiền tự động về Buyer">
      <ns0:incoming>Flow_Refund_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Task_CheckWallet" name="Seller nhận Push notification số dư Ví">
      <ns0:incoming>Flow_Wallet_Check</ns0:incoming>
      <ns0:outgoing>Flow_Check_Withdraw</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Withdraw" name="Rút tiền từ Ví về tài khoản ngân hàng">
      <ns0:outgoing>Flow_Withdraw_GateBank</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_Withdraw_1_to_Task_Withdraw</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_BankOK" name="Chuyển khoản thành công?">
      <ns0:incoming>Flow_Withdraw_GateBank</ns0:incoming>
      <ns0:outgoing>Flow_BankYes_End</ns0:outgoing>
      <ns0:outgoing>Flow_BankNo_Retry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_S1_Select" sourceRef="StartEvent_Checkout" targetRef="Task_SelectPayment" />
    <ns0:sequenceFlow id="Flow_Select_GateType" sourceRef="Task_SelectPayment" targetRef="Gate_PaymentType" />
    <ns0:sequenceFlow id="Flow_TypeCOD_Pay" name="COD" sourceRef="Gate_PaymentType" targetRef="Task_PayCOD" />
    <ns0:sequenceFlow id="Flow_TypeOnline_Pay" name="Online" sourceRef="Gate_PaymentType" targetRef="Task_PayOnline" />
    <ns0:sequenceFlow id="Flow_Online_RiskScore" sourceRef="Task_PayOnline" targetRef="Task_RiskScore" />
    <ns0:sequenceFlow id="Flow_Risk_GateRisk" sourceRef="Task_RiskScore" targetRef="Gate_HighRisk" />
    <ns0:sequenceFlow id="Flow_RiskYes_Block" name="Rủi ro cao" sourceRef="Gate_HighRisk" targetRef="Task_BlockTransaction" />
    <ns0:sequenceFlow id="Flow_RiskNo_Approve" name="An toàn" sourceRef="Gate_HighRisk" targetRef="Task_ApproveAuto" />
    <ns0:sequenceFlow id="Flow_Block_FraudAlert" sourceRef="Task_BlockTransaction" targetRef="Task_FraudAlert" />
    <ns0:sequenceFlow id="Flow_Approve_Hold" sourceRef="Task_ApproveAuto" targetRef="Join_Task_HoldEscrow_1" />
    <ns0:sequenceFlow id="Flow_Fraud_Block" sourceRef="Task_FraudAlert" targetRef="Join_Task_HoldEscrow_1" />
    <ns0:sequenceFlow id="Flow_Hold_GateTrust" sourceRef="Task_HoldEscrow" targetRef="Gate_SellerTrust" />
    <ns0:sequenceFlow id="Flow_TrustYes_Instant" name="Trusted seller" sourceRef="Gate_SellerTrust" targetRef="Task_InstantSettle" />
    <ns0:sequenceFlow id="Flow_TrustNo_Standard" name="Standard (L+2)" sourceRef="Gate_SellerTrust" targetRef="Join_Task_AutoReconcile_1" />
    <ns0:sequenceFlow id="Flow_Instant_Wallet" sourceRef="Task_InstantSettle" targetRef="Join_Task_CalcCommission_1" />
    <ns0:sequenceFlow id="Flow_COD_Receive" sourceRef="Task_PayCOD" targetRef="Task_ReceiveGoods" />
    <ns0:sequenceFlow id="Flow_Receive_GateCOD" sourceRef="Task_ReceiveGoods" targetRef="Gate_CODVerify" />
    <ns0:sequenceFlow id="Flow_CODYes_Reconcile" name="COD đã thu" sourceRef="Gate_CODVerify" targetRef="Join_Task_AutoReconcile_1" />
    <ns0:sequenceFlow id="Flow_CODNo_Flag" name="Chưa thu — đánh dấu" sourceRef="Gate_CODVerify" targetRef="Join_Task_AutoReconcile_1" />
    <ns0:sequenceFlow id="Flow_Reconcile_GateOK" sourceRef="Task_AutoReconcile" targetRef="Gate_ReconcileOK" />
    <ns0:sequenceFlow id="Flow_OK_Commission" name="Khớp" sourceRef="Gate_ReconcileOK" targetRef="Join_Task_CalcCommission_1" />
    <ns0:sequenceFlow id="Flow_NotOK_Flag" name="Lệch — đánh dấu" sourceRef="Gate_ReconcileOK" targetRef="Join_Task_CalcCommission_1" />
    <ns0:sequenceFlow id="Flow_Commission_Wallet" sourceRef="Task_CalcCommission" targetRef="Task_UpdateWallet" />
    <ns0:sequenceFlow id="Flow_Wallet_Statement" sourceRef="Split_Task_UpdateWallet_1" targetRef="Join_Task_SendStatement_1" name="Gửi bảng đối soát" />
    <ns0:sequenceFlow id="Flow_Wallet_Check" sourceRef="Split_Task_UpdateWallet_1" targetRef="Task_CheckWallet" name="Seller kiểm tra Ví" />
    <ns0:sequenceFlow id="Flow_Statement_End" sourceRef="Task_SendStatement" targetRef="Join_End_Event_Settled_1" />
    <ns0:sequenceFlow id="Flow_Check_Withdraw" sourceRef="Task_CheckWallet" targetRef="Join_Task_Withdraw_1" />
    <ns0:sequenceFlow id="Flow_Withdraw_GateBank" sourceRef="Task_Withdraw" targetRef="Gate_BankOK" />
    <ns0:sequenceFlow id="Flow_BankYes_End" name="Thành công" sourceRef="Gate_BankOK" targetRef="Join_End_Event_Settled_1" />
    <ns0:sequenceFlow id="Flow_BankNo_Retry" name="Thất bại — retry" sourceRef="Gate_BankOK" targetRef="Join_Task_Withdraw_1" />
    <ns0:sequenceFlow id="Flow_Refund_Auto" name="Yêu cầu hoàn tiền" sourceRef="Gate_ReconcileOK" targetRef="Gate_RefundOK" />
    <ns0:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ReceiveRefund" targetRef="EndEvent_Refunded" />
    <ns0:sequenceFlow id="Flow_RefundOK_Auto" name="Chấp thuận" sourceRef="Gate_RefundOK" targetRef="Task_ReceiveRefund" />
    <ns0:sequenceFlow id="Flow_RefundNo_Manual" name="Từ chối — xử lý thủ công" sourceRef="Gate_RefundOK" targetRef="Join_Task_SendStatement_1" />
    <ns0:sequenceFlow id="Flow_Join_End_Event_Settled_1_to_EndEvent_Settled" sourceRef="Join_End_Event_Settled_1" targetRef="EndEvent_Settled" name="" />
    <ns0:exclusiveGateway id="Join_Task_HoldEscrow_1" name="Gom luồng trước khi Giữ tiền trong Escrow Blockchain">
      <ns0:incoming>Flow_Approve_Hold</ns0:incoming>
      <ns0:incoming>Flow_Fraud_Block</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_HoldEscrow_1_to_Task_HoldEscrow" sourceRef="Join_Task_HoldEscrow_1" targetRef="Task_HoldEscrow" />
    <ns0:exclusiveGateway id="Join_Task_AutoReconcile_1" name="Gom luồng trước khi Đối soát tự động COD/Online end-of-day">
      <ns0:incoming>Flow_TrustNo_Standard</ns0:incoming>
      <ns0:incoming>Flow_CODYes_Reconcile</ns0:incoming>
      <ns0:incoming>Flow_CODNo_Flag</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AutoReconcile_1_to_Task_AutoReconcile" sourceRef="Join_Task_AutoReconcile_1" targetRef="Task_AutoReconcile" />
    <ns0:exclusiveGateway id="Join_Task_CalcCommission_1" name="Gom luồng trước khi Tính hoa hồng &amp; phí tự động">
      <ns0:incoming>Flow_Instant_Wallet</ns0:incoming>
      <ns0:incoming>Flow_OK_Commission</ns0:incoming>
      <ns0:incoming>Flow_NotOK_Flag</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_CalcCommission_1_to_Task_CalcCommission" sourceRef="Join_Task_CalcCommission_1" targetRef="Task_CalcCommission" />
    <ns0:exclusiveGateway id="Split_Task_UpdateWallet_1" name="Phân luồng sau Cập nhật số dư Ví Seller + Push notification">
      <ns0:incoming>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</ns0:incoming>
      <ns0:outgoing>Flow_Wallet_Statement</ns0:outgoing>
      <ns0:outgoing>Flow_Wallet_Check</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1" sourceRef="Task_UpdateWallet" targetRef="Split_Task_UpdateWallet_1" />
    <ns0:exclusiveGateway id="Join_Task_SendStatement_1" name="Gom luồng trước khi Gửi bảng đối soát điện tử tự động hàng tháng">
      <ns0:incoming>Flow_Wallet_Statement</ns0:incoming>
      <ns0:incoming>Flow_RefundNo_Manual</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_SendStatement_1_to_Task_SendStatement</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_SendStatement_1_to_Task_SendStatement" sourceRef="Join_Task_SendStatement_1" targetRef="Task_SendStatement" />
    <ns0:exclusiveGateway id="Join_Task_Withdraw_1" name="Gom luồng trước khi Rút tiền từ Ví về tài khoản ngân hàng">
      <ns0:incoming>Flow_Check_Withdraw</ns0:incoming>
      <ns0:incoming>Flow_BankNo_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Withdraw_1_to_Task_Withdraw</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_Withdraw_1_to_Task_Withdraw" sourceRef="Join_Task_Withdraw_1" targetRef="Task_Withdraw" />
  </ns0:process>
