<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LogisticsDeliveryTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_LogisticsDeliveryTOBE" name="Quy trình Logistics &amp; Giao nhận TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>StartEvent_OrderConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PickupResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_PackGoods_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_SchedulePickup_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI Route &amp; Fleet System">
        <bpmn:flowNodeRef>Task_RouteOptimize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PredictDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DroneEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DroneDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StandardRouting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_DroneDelivery_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_RouteOptimize_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3PL" name="LEX / 3PL Partner">
        <bpmn:flowNodeRef>Task_SortHub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_HubSortOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OutForDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DeliveryAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_OutForDelivery_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_SortHub_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_Transit_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>Task_ReceiveDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_AcceptGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmAccept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ReceiveDelivery_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System">
        <bpmn:flowNodeRef>Task_GenerateAWB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RealTimeTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyBuyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToSeller</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RetryLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_GenerateAWB_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_NotifyBuyer_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_RealTimeTracking_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_OrderConfirmed" name="Đơn hàng đã được xác nhận">
      <bpmn:outgoing>Flow_S1_Pack</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Join_Task_PackGoods_1" name="Gom luồng trước khi Đóng gói hàng hóa đạt chuẩn">
      <bpmn:incoming>Flow_S1_Pack</bpmn:incoming>
      <bpmn:incoming>Flow_Rework_Pack</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_PackGoods_1_to_Task_PackGoods</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_SchedulePickup_1" name="Gom luồng trước khi Yêu cầu auto-scheduling lấy hàng">
      <bpmn:incoming>Flow_Pack_Schedule</bpmn:incoming>
      <bpmn:incoming>Flow_RetryNo_Reschedule</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_SchedulePickup_1_to_Task_SchedulePickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PackGoods" name="Đóng gói hàng hóa đạt chuẩn">
      <bpmn:incoming>Flow_Join_Task_PackGoods_1_to_Task_PackGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_Pack_Schedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SchedulePickup" name="Yêu cầu auto-scheduling lấy hàng">
      <bpmn:incoming>Flow_Join_Task_SchedulePickup_1_to_Task_SchedulePickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Schedule_PickupGate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PickupResult" name="Lấy hàng thành công?">
      <bpmn:incoming>Flow_Schedule_PickupGate</bpmn:incoming>
      <bpmn:outgoing>Flow_PickupYes_Route</bpmn:outgoing>
      <bpmn:outgoing>Flow_PickupNo_Rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReworkPackage" name="Đóng gói lại / đính chính thông tin">
      <bpmn:incoming>Flow_PickupNo_Rework</bpmn:incoming>
      <bpmn:outgoing>Flow_Rework_Pack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Split_Task_RouteOptimize_1" name="Phân luồng sau AI tối ưu lộ trình giao hàng real-time">
      <bpmn:incoming>Flow_Task_RouteOptimize_to_Split_Task_RouteOptimize_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Predict</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_GenAWB</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RouteOptimize" name="AI tối ưu lộ trình giao hàng real-time">
      <bpmn:incoming>Flow_PickupYes_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RouteOptimize_to_Split_Task_RouteOptimize_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PredictDelivery" name="Dự báo thời gian giao hàng chính xác (ETA ML)">
      <bpmn:incoming>Flow_Route_Predict</bpmn:incoming>
      <bpmn:outgoing>Flow_Predict_GateDrone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_Task_SortHub_1" name="Gom luồng trước khi Phân loại hàng tại Hub trung chuyển">
      <bpmn:incoming>Flow_Drone_Sort</bpmn:incoming>
      <bpmn:incoming>Flow_Standard_Sort</bpmn:incoming>
      <bpmn:incoming>Flow_ReRouteNo_Resort</bpmn:incoming>
      <bpmn:incoming>Flow_GenAWB_Sort</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_SortHub_1_to_Task_SortHub</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_DroneEligible" name="Đủ điều kiện giao bằng Drone?">
      <bpmn:incoming>Flow_Predict_GateDrone</bpmn:incoming>
      <bpmn:outgoing>Flow_DroneYes_Drone</bpmn:outgoing>
      <bpmn:outgoing>Flow_DroneNo_Standard</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DroneDelivery" name="Phân bổ Drone Express giao hàng">
      <bpmn:incoming>Flow_DroneYes_Drone</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DroneDelivery_to_Split_Task_DroneDelivery_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_Task_Transit_1" name="Gom luồng trước khi Vận chuyển liên tỉnh / đường hàng không">
      <bpmn:incoming>Flow_SortOK_Transit</bpmn:incoming>
      <bpmn:incoming>Flow_ReRouteYes_Transit</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Transit_1_to_Task_Transit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Split_Task_DroneDelivery_1" name="Phân luồng sau Phân bổ Drone Express giao hàng">
      <bpmn:incoming>Flow_Task_DroneDelivery_to_Split_Task_DroneDelivery_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Drone_Sort</bpmn:outgoing>
      <bpmn:outgoing>Flow_Drone_Receive</bpmn:outgoing>
      <bpmn:outgoing>Flow_Drone_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_StandardRouting" name="Phân bổ tuyến đường 3PL tiêu chuẩn">
      <bpmn:incoming>Flow_DroneNo_Standard</bpmn:incoming>
      <bpmn:outgoing>Flow_Standard_Sort</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SortHub" name="Phân loại hàng tại Hub trung chuyển">
      <bpmn:incoming>Flow_Join_Task_SortHub_1_to_Task_SortHub</bpmn:incoming>
      <bpmn:outgoing>Flow_Sort_GateOK</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_HubSortOK" name="Phân loại đúng Hub?">
      <bpmn:incoming>Flow_Sort_GateOK</bpmn:incoming>
      <bpmn:outgoing>Flow_SortOK_Transit</bpmn:outgoing>
      <bpmn:outgoing>Flow_SortFail_ReRoute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_ReRoute" name="Có hub thay thế gần nhất?">
      <bpmn:incoming>Flow_SortFail_ReRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_ReRouteYes_Transit</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReRouteNo_Resort</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Transit" name="Vận chuyển liên tỉnh / đường hàng không">
      <bpmn:incoming>Flow_Join_Task_Transit_1_to_Task_Transit</bpmn:incoming>
      <bpmn:outgoing>Flow_Transit_Out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join_Task_ReceiveDelivery_1" name="Gom luồng trước khi Nhận hàng &amp; kiểm tra trực tiếp">
      <bpmn:incoming>Flow_AttemptOK_Receive</bpmn:incoming>
      <bpmn:incoming>Flow_Notify_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ReceiveDelivery_1_to_Task_ReceiveDelivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Split_Task_OutForDelivery_1" name="Phân luồng sau Shipper nhận kiện hàng — đi giao">
      <bpmn:incoming>Flow_Task_OutForDelivery_to_Split_Task_OutForDelivery_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Out_DeliverGate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Out_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_OutForDelivery" name="Shipper nhận kiện hàng — đi giao">
      <bpmn:incoming>Flow_Transit_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_OutForDelivery_to_Split_Task_OutForDelivery_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DeliveryAttempt" name="Giao hàng lần đầu thành công?">
      <bpmn:incoming>Flow_Out_DeliverGate</bpmn:incoming>
      <bpmn:outgoing>Flow_AttemptOK_Receive</bpmn:outgoing>
      <bpmn:outgoing>Flow_AttemptFail_RetryGate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReceiveDelivery" name="Nhận hàng &amp; kiểm tra trực tiếp">
      <bpmn:incoming>Flow_Join_Task_ReceiveDelivery_1_to_Task_ReceiveDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_GateAccept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_AcceptGoods" name="Buyer chấp nhận hàng?">
      <bpmn:incoming>Flow_Receive_GateAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_AcceptYes_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_AcceptNo_Report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmAccept" name="Xác nhận đã nhận hàng trên App">
      <bpmn:incoming>Flow_AcceptYes_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReportIssue" name="Báo lỗi / yêu cầu đổi trả">
      <bpmn:incoming>Flow_AcceptNo_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join_Task_RealTimeTracking_1" name="Gom luồng trước khi Cập nhật vị trí real-time GPS cho Buyer">
      <bpmn:incoming>Flow_GenAWB_Track</bpmn:incoming>
      <bpmn:incoming>Flow_Out_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_RealTimeTracking_1_to_Task_RealTimeTracking</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_End_Event_Delivered_1" name="Gom nhánh kết thúc">
      <bpmn:incoming>Flow_Confirm_End</bpmn:incoming>
      <bpmn:incoming>Flow_Report_End</bpmn:incoming>
      <bpmn:incoming>Flow_Drone_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_Event_Delivered_1_to_EndEvent_Delivered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Delivered" name="Đơn hàng đã giao thành công">
      <bpmn:incoming>Flow_Join_End_Event_Delivered_1_to_EndEvent_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Split_Task_GenerateAWB_1" name="Phân luồng sau Tạo AWB tự động + Push tracking info">
      <bpmn:incoming>Flow_Task_GenerateAWB_to_Split_Task_GenerateAWB_1</bpmn:incoming>
      <bpmn:outgoing>Flow_GenAWB_Sort</bpmn:outgoing>
      <bpmn:outgoing>Flow_GenAWB_Track</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_NotifyBuyer_1" name="Gom luồng trước khi Push thông báo lịch giao + SMS/In-app alert">
      <bpmn:incoming>Flow_Track_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Drone_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_NotifyBuyer_1_to_Task_NotifyBuyer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateAWB" name="Tạo AWB tự động + Push tracking info">
      <bpmn:incoming>Flow_Route_GenAWB</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_GenerateAWB_to_Split_Task_GenerateAWB_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RealTimeTracking" name="Cập nhật vị trí real-time GPS cho Buyer">
      <bpmn:incoming>Flow_Join_Task_RealTimeTracking_1_to_Task_RealTimeTracking</bpmn:incoming>
      <bpmn:outgoing>Flow_Track_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyBuyer" name="Push thông báo lịch giao + SMS/In-app alert">
      <bpmn:incoming>Flow_Join_Task_NotifyBuyer_1_to_Task_NotifyBuyer</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Receive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_RetryLimit" name="Đã thử giao ≥ 3 lần?">
      <bpmn:incoming>Flow_AttemptFail_RetryGate</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryNo_Reschedule</bpmn:outgoing>
      <bpmn:outgoing>Flow_RetryYes_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReturnToSeller" name="Hàng hoàn về kho — cập nhật hệ thống">
      <bpmn:incoming>Flow_RetryYes_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Returned" name="Đơn hàng đã hoàn về Seller">
      <bpmn:incoming>Flow_Return_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S1_Pack" sourceRef="StartEvent_OrderConfirmed" targetRef="Join_Task_PackGoods_1" />
    <bpmn:sequenceFlow id="Flow_Pack_Schedule" sourceRef="Task_PackGoods" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:sequenceFlow id="Flow_Schedule_PickupGate" sourceRef="Task_SchedulePickup" targetRef="Gate_PickupResult" />
    <bpmn:sequenceFlow id="Flow_PickupYes_Route" name="Thành công" sourceRef="Gate_PickupResult" targetRef="Task_RouteOptimize" />
    <bpmn:sequenceFlow id="Flow_PickupNo_Rework" name="Thất bại" sourceRef="Gate_PickupResult" targetRef="Task_ReworkPackage" />
    <bpmn:sequenceFlow id="Flow_Rework_Pack" sourceRef="Task_ReworkPackage" targetRef="Join_Task_PackGoods_1" />
    <bpmn:sequenceFlow id="Flow_Route_Predict" sourceRef="Split_Task_RouteOptimize_1" targetRef="Task_PredictDelivery" />
    <bpmn:sequenceFlow id="Flow_Predict_GateDrone" sourceRef="Task_PredictDelivery" targetRef="Gate_DroneEligible" />
    <bpmn:sequenceFlow id="Flow_DroneYes_Drone" name="Drone Express" sourceRef="Gate_DroneEligible" targetRef="Task_DroneDelivery" />
    <bpmn:sequenceFlow id="Flow_DroneNo_Standard" name="3PL tiêu chuẩn" sourceRef="Gate_DroneEligible" targetRef="Task_StandardRouting" />
    <bpmn:sequenceFlow id="Flow_Drone_Sort" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_Task_SortHub_1" />
    <bpmn:sequenceFlow id="Flow_Standard_Sort" sourceRef="Task_StandardRouting" targetRef="Join_Task_SortHub_1" />
    <bpmn:sequenceFlow id="Flow_Sort_GateOK" sourceRef="Task_SortHub" targetRef="Gate_HubSortOK" />
    <bpmn:sequenceFlow id="Flow_SortOK_Transit" name="Đúng Hub" sourceRef="Gate_HubSortOK" targetRef="Join_Task_Transit_1" />
    <bpmn:sequenceFlow id="Flow_SortFail_ReRoute" name="Sai Hub" sourceRef="Gate_HubSortOK" targetRef="Gate_ReRoute" />
    <bpmn:sequenceFlow id="Flow_ReRouteYes_Transit" name="Có hub khác" sourceRef="Gate_ReRoute" targetRef="Join_Task_Transit_1" />
    <bpmn:sequenceFlow id="Flow_ReRouteNo_Resort" name="Không — phân loại lại" sourceRef="Gate_ReRoute" targetRef="Join_Task_SortHub_1" />
    <bpmn:sequenceFlow id="Flow_Transit_Out" sourceRef="Task_Transit" targetRef="Task_OutForDelivery" />
    <bpmn:sequenceFlow id="Flow_Out_DeliverGate" sourceRef="Split_Task_OutForDelivery_1" targetRef="Gate_DeliveryAttempt" />
    <bpmn:sequenceFlow id="Flow_AttemptOK_Receive" name="Giao thành công" sourceRef="Gate_DeliveryAttempt" targetRef="Join_Task_ReceiveDelivery_1" />
    <bpmn:sequenceFlow id="Flow_AttemptFail_RetryGate" name="Giao thất bại" sourceRef="Gate_DeliveryAttempt" targetRef="Gate_RetryLimit" />
    <bpmn:sequenceFlow id="Flow_Receive_GateAccept" sourceRef="Task_ReceiveDelivery" targetRef="Gate_AcceptGoods" />
    <bpmn:sequenceFlow id="Flow_AcceptYes_Confirm" name="Chấp nhận" sourceRef="Gate_AcceptGoods" targetRef="Task_ConfirmAccept" />
    <bpmn:sequenceFlow id="Flow_AcceptNo_Report" name="Từ chối" sourceRef="Gate_AcceptGoods" targetRef="Task_ReportIssue" />
    <bpmn:sequenceFlow id="Flow_Confirm_End" sourceRef="Task_ConfirmAccept" targetRef="Join_End_Event_Delivered_1" />
    <bpmn:sequenceFlow id="Flow_Report_End" sourceRef="Task_ReportIssue" targetRef="Join_End_Event_Delivered_1" />
    <bpmn:sequenceFlow id="Flow_Drone_Receive" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_End_Event_Delivered_1" />
    <bpmn:sequenceFlow id="Flow_Route_GenAWB" sourceRef="Split_Task_RouteOptimize_1" targetRef="Task_GenerateAWB" />
    <bpmn:sequenceFlow id="Flow_GenAWB_Sort" sourceRef="Split_Task_GenerateAWB_1" targetRef="Join_Task_SortHub_1" />
    <bpmn:sequenceFlow id="Flow_GenAWB_Track" sourceRef="Split_Task_GenerateAWB_1" targetRef="Join_Task_RealTimeTracking_1" />
    <bpmn:sequenceFlow id="Flow_Out_Notify" sourceRef="Split_Task_OutForDelivery_1" targetRef="Join_Task_RealTimeTracking_1" />
    <bpmn:sequenceFlow id="Flow_Track_Notify" sourceRef="Task_RealTimeTracking" targetRef="Join_Task_NotifyBuyer_1" />
    <bpmn:sequenceFlow id="Flow_Drone_Notify" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_Task_NotifyBuyer_1" />
    <bpmn:sequenceFlow id="Flow_Notify_Receive" sourceRef="Task_NotifyBuyer" targetRef="Join_Task_ReceiveDelivery_1" />
    <bpmn:sequenceFlow id="Flow_RetryNo_Reschedule" name="Chưa đủ 3 lần — hẹn lại" sourceRef="Gate_RetryLimit" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:sequenceFlow id="Flow_RetryYes_Return" name="≥ 3 lần — hoàn hàng" sourceRef="Gate_RetryLimit" targetRef="Task_ReturnToSeller" />
