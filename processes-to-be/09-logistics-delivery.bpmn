<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LogisticsDeliveryTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_LogisticsDeliveryTOBE" name="Quy trình Logistics &amp; Giao nhận TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>StartEvent_OrderConfirmed</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PackGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SchedulePickup</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PickupResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReworkPackage</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_PackGoods_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_SchedulePickup_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_AI" name="AI Route &amp; Fleet System">
        <ns0:flowNodeRef>Task_RouteOptimize</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PredictDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DroneEligible</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DroneDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_StandardRouting</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_DroneDelivery_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_RouteOptimize_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_3PL" name="LEX / 3PL Partner">
        <ns0:flowNodeRef>Task_SortHub</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_HubSortOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Transit</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_OutForDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DeliveryAttempt</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_OutForDelivery_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_SortHub_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_Transit_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>Task_ReceiveDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_AcceptGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmAccept</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReportIssue</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Delivered</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReceiveDelivery_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System">
        <ns0:flowNodeRef>Task_GenerateAWB</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_RealTimeTracking</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyBuyer</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReturnToSeller</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_RetryLimit</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Returned</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_GenerateAWB_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_NotifyBuyer_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_RealTimeTracking_1</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_OrderConfirmed" name="Đơn hàng đã được xác nhận">
      <ns0:outgoing>Flow_S1_Pack</ns0:outgoing>
    </ns0:startEvent>
    <ns0:exclusiveGateway id="Join_Task_PackGoods_1" name="Gom luồng trước khi Đóng gói hàng hóa đạt chuẩn">
      <ns0:incoming>Flow_S1_Pack</ns0:incoming>
      <ns0:incoming>Flow_Rework_Pack</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_PackGoods_1_to_Task_PackGoods</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_SchedulePickup_1" name="Gom luồng trước khi Yêu cầu auto-scheduling lấy hàng">
      <ns0:incoming>Flow_Pack_Schedule</ns0:incoming>
      <ns0:incoming>Flow_RetryNo_Reschedule</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_SchedulePickup_1_to_Task_SchedulePickup</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_PackGoods" name="Đóng gói hàng hóa đạt chuẩn">
      <ns0:incoming>Flow_Join_Task_PackGoods_1_to_Task_PackGoods</ns0:incoming>
      <ns0:outgoing>Flow_Pack_Schedule</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SchedulePickup" name="Yêu cầu auto-scheduling lấy hàng">
      <ns0:incoming>Flow_Join_Task_SchedulePickup_1_to_Task_SchedulePickup</ns0:incoming>
      <ns0:outgoing>Flow_Schedule_PickupGate</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PickupResult" name="Lấy hàng thành công?">
      <ns0:incoming>Flow_Schedule_PickupGate</ns0:incoming>
      <ns0:outgoing>Flow_PickupYes_Route</ns0:outgoing>
      <ns0:outgoing>Flow_PickupNo_Rework</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ReworkPackage" name="Đóng gói lại / đính chính thông tin">
      <ns0:incoming>Flow_PickupNo_Rework</ns0:incoming>
      <ns0:outgoing>Flow_Rework_Pack</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Split_Task_RouteOptimize_1" name="Phân luồng sau AI tối ưu lộ trình giao hàng real-time">
      <ns0:incoming>Flow_Task_RouteOptimize_to_Split_Task_RouteOptimize_1</ns0:incoming>
      <ns0:outgoing>Flow_Route_Predict</ns0:outgoing>
      <ns0:outgoing>Flow_Route_GenAWB</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_RouteOptimize" name="AI tối ưu lộ trình giao hàng real-time">
      <ns0:incoming>Flow_PickupYes_Route</ns0:incoming>
      <ns0:outgoing>Flow_Task_RouteOptimize_to_Split_Task_RouteOptimize_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_PredictDelivery" name="Dự báo thời gian giao hàng chính xác (ETA ML)">
      <ns0:incoming>Flow_Route_Predict</ns0:incoming>
      <ns0:outgoing>Flow_Predict_GateDrone</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Join_Task_SortHub_1" name="Gom luồng trước khi Phân loại hàng tại Hub trung chuyển">
      <ns0:incoming>Flow_Drone_Sort</ns0:incoming>
      <ns0:incoming>Flow_Standard_Sort</ns0:incoming>
      <ns0:incoming>Flow_ReRouteNo_Resort</ns0:incoming>
      <ns0:incoming>Flow_GenAWB_Sort</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_SortHub_1_to_Task_SortHub</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_DroneEligible" name="Đủ điều kiện giao bằng Drone?">
      <ns0:incoming>Flow_Predict_GateDrone</ns0:incoming>
      <ns0:outgoing>Flow_DroneYes_Drone</ns0:outgoing>
      <ns0:outgoing>Flow_DroneNo_Standard</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_DroneDelivery" name="Phân bổ Drone Express giao hàng">
      <ns0:incoming>Flow_DroneYes_Drone</ns0:incoming>
      <ns0:outgoing>Flow_Task_DroneDelivery_to_Split_Task_DroneDelivery_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Join_Task_Transit_1" name="Gom luồng trước khi Vận chuyển liên tỉnh / đường hàng không">
      <ns0:incoming>Flow_SortOK_Transit</ns0:incoming>
      <ns0:incoming>Flow_ReRouteYes_Transit</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Transit_1_to_Task_Transit</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Split_Task_DroneDelivery_1" name="Phân luồng sau Phân bổ Drone Express giao hàng">
      <ns0:incoming>Flow_Task_DroneDelivery_to_Split_Task_DroneDelivery_1</ns0:incoming>
      <ns0:outgoing>Flow_Drone_Sort</ns0:outgoing>
      <ns0:outgoing>Flow_Drone_Receive</ns0:outgoing>
      <ns0:outgoing>Flow_Drone_Notify</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_StandardRouting" name="Phân bổ tuyến đường 3PL tiêu chuẩn">
      <ns0:incoming>Flow_DroneNo_Standard</ns0:incoming>
      <ns0:outgoing>Flow_Standard_Sort</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_SortHub" name="Phân loại hàng tại Hub trung chuyển">
      <ns0:incoming>Flow_Join_Task_SortHub_1_to_Task_SortHub</ns0:incoming>
      <ns0:outgoing>Flow_Sort_GateOK</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_HubSortOK" name="Phân loại đúng Hub?">
      <ns0:incoming>Flow_Sort_GateOK</ns0:incoming>
      <ns0:outgoing>Flow_SortOK_Transit</ns0:outgoing>
      <ns0:outgoing>Flow_SortFail_ReRoute</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_ReRoute" name="Có hub thay thế gần nhất?">
      <ns0:incoming>Flow_SortFail_ReRoute</ns0:incoming>
      <ns0:outgoing>Flow_ReRouteYes_Transit</ns0:outgoing>
      <ns0:outgoing>Flow_ReRouteNo_Resort</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_Transit" name="Vận chuyển liên tỉnh / đường hàng không">
      <ns0:incoming>Flow_Join_Task_Transit_1_to_Task_Transit</ns0:incoming>
      <ns0:outgoing>Flow_Transit_Out</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Join_Task_ReceiveDelivery_1" name="Gom luồng trước khi Nhận hàng &amp; kiểm tra trực tiếp">
      <ns0:incoming>Flow_AttemptOK_Receive</ns0:incoming>
      <ns0:incoming>Flow_Notify_Receive</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReceiveDelivery_1_to_Task_ReceiveDelivery</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Split_Task_OutForDelivery_1" name="Phân luồng sau Shipper nhận kiện hàng — đi giao">
      <ns0:incoming>Flow_Task_OutForDelivery_to_Split_Task_OutForDelivery_1</ns0:incoming>
      <ns0:outgoing>Flow_Out_DeliverGate</ns0:outgoing>
      <ns0:outgoing>Flow_Out_Notify</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_OutForDelivery" name="Shipper nhận kiện hàng — đi giao">
      <ns0:incoming>Flow_Transit_Out</ns0:incoming>
      <ns0:outgoing>Flow_Task_OutForDelivery_to_Split_Task_OutForDelivery_1</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_DeliveryAttempt" name="Giao hàng lần đầu thành công?">
      <ns0:incoming>Flow_Out_DeliverGate</ns0:incoming>
      <ns0:outgoing>Flow_AttemptOK_Receive</ns0:outgoing>
      <ns0:outgoing>Flow_AttemptFail_RetryGate</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ReceiveDelivery" name="Nhận hàng &amp; kiểm tra trực tiếp">
      <ns0:incoming>Flow_Join_Task_ReceiveDelivery_1_to_Task_ReceiveDelivery</ns0:incoming>
      <ns0:outgoing>Flow_Receive_GateAccept</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_AcceptGoods" name="Buyer chấp nhận hàng?">
      <ns0:incoming>Flow_Receive_GateAccept</ns0:incoming>
      <ns0:outgoing>Flow_AcceptYes_Confirm</ns0:outgoing>
      <ns0:outgoing>Flow_AcceptNo_Report</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ConfirmAccept" name="Xác nhận đã nhận hàng trên App">
      <ns0:incoming>Flow_AcceptYes_Confirm</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReportIssue" name="Báo lỗi / yêu cầu đổi trả">
      <ns0:incoming>Flow_AcceptNo_Report</ns0:incoming>
      <ns0:outgoing>Flow_Report_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Join_Task_RealTimeTracking_1" name="Gom luồng trước khi Cập nhật vị trí real-time GPS cho Buyer">
      <ns0:incoming>Flow_GenAWB_Track</ns0:incoming>
      <ns0:incoming>Flow_Out_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_RealTimeTracking_1_to_Task_RealTimeTracking</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_End_Event_Delivered_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_Confirm_End</ns0:incoming>
      <ns0:incoming>Flow_Report_End</ns0:incoming>
      <ns0:incoming>Flow_Drone_Receive</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_Event_Delivered_1_to_EndEvent_Delivered</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="EndEvent_Delivered" name="Đơn hàng đã giao thành công">
      <ns0:incoming>Flow_Join_End_Event_Delivered_1_to_EndEvent_Delivered</ns0:incoming>
    </ns0:endEvent>
    <ns0:exclusiveGateway id="Split_Task_GenerateAWB_1" name="Phân luồng sau Tạo AWB tự động + Push tracking info">
      <ns0:incoming>Flow_Task_GenerateAWB_to_Split_Task_GenerateAWB_1</ns0:incoming>
      <ns0:outgoing>Flow_GenAWB_Sort</ns0:outgoing>
      <ns0:outgoing>Flow_GenAWB_Track</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_NotifyBuyer_1" name="Gom luồng trước khi Push thông báo lịch giao + SMS/In-app alert">
      <ns0:incoming>Flow_Track_Notify</ns0:incoming>
      <ns0:incoming>Flow_Drone_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_NotifyBuyer_1_to_Task_NotifyBuyer</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_GenerateAWB" name="Tạo AWB tự động + Push tracking info">
      <ns0:incoming>Flow_Route_GenAWB</ns0:incoming>
      <ns0:outgoing>Flow_Task_GenerateAWB_to_Split_Task_GenerateAWB_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_RealTimeTracking" name="Cập nhật vị trí real-time GPS cho Buyer">
      <ns0:incoming>Flow_Join_Task_RealTimeTracking_1_to_Task_RealTimeTracking</ns0:incoming>
      <ns0:outgoing>Flow_Track_Notify</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyBuyer" name="Push thông báo lịch giao + SMS/In-app alert">
      <ns0:incoming>Flow_Join_Task_NotifyBuyer_1_to_Task_NotifyBuyer</ns0:incoming>
      <ns0:outgoing>Flow_Notify_Receive</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_RetryLimit" name="Đã thử giao ≥ 3 lần?">
      <ns0:incoming>Flow_AttemptFail_RetryGate</ns0:incoming>
      <ns0:outgoing>Flow_RetryNo_Reschedule</ns0:outgoing>
      <ns0:outgoing>Flow_RetryYes_Return</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_ReturnToSeller" name="Hàng hoàn về kho — cập nhật hệ thống">
      <ns0:incoming>Flow_RetryYes_Return</ns0:incoming>
      <ns0:outgoing>Flow_Return_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:endEvent id="EndEvent_Returned" name="Đơn hàng đã hoàn về Seller">
      <ns0:incoming>Flow_Return_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_S1_Pack" sourceRef="StartEvent_OrderConfirmed" targetRef="Join_Task_PackGoods_1" />
    <ns0:sequenceFlow id="Flow_Pack_Schedule" sourceRef="Task_PackGoods" targetRef="Join_Task_SchedulePickup_1" />
    <ns0:sequenceFlow id="Flow_Schedule_PickupGate" sourceRef="Task_SchedulePickup" targetRef="Gate_PickupResult" />
    <ns0:sequenceFlow id="Flow_PickupYes_Route" name="Thành công" sourceRef="Gate_PickupResult" targetRef="Task_RouteOptimize" />
    <ns0:sequenceFlow id="Flow_PickupNo_Rework" name="Thất bại" sourceRef="Gate_PickupResult" targetRef="Task_ReworkPackage" />
    <ns0:sequenceFlow id="Flow_Rework_Pack" sourceRef="Task_ReworkPackage" targetRef="Join_Task_PackGoods_1" />
    <ns0:sequenceFlow id="Flow_Route_Predict" sourceRef="Split_Task_RouteOptimize_1" targetRef="Task_PredictDelivery" name="Dự báo ETA" />
    <ns0:sequenceFlow id="Flow_Predict_GateDrone" sourceRef="Task_PredictDelivery" targetRef="Gate_DroneEligible" />
    <ns0:sequenceFlow id="Flow_DroneYes_Drone" name="Drone Express" sourceRef="Gate_DroneEligible" targetRef="Task_DroneDelivery" />
    <ns0:sequenceFlow id="Flow_DroneNo_Standard" name="3PL tiêu chuẩn" sourceRef="Gate_DroneEligible" targetRef="Task_StandardRouting" />
    <ns0:sequenceFlow id="Flow_Drone_Sort" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_Task_SortHub_1" name="Phân loại tại Hub" />
    <ns0:sequenceFlow id="Flow_Standard_Sort" sourceRef="Task_StandardRouting" targetRef="Join_Task_SortHub_1" />
    <ns0:sequenceFlow id="Flow_Sort_GateOK" sourceRef="Task_SortHub" targetRef="Gate_HubSortOK" />
    <ns0:sequenceFlow id="Flow_SortOK_Transit" name="Đúng Hub" sourceRef="Gate_HubSortOK" targetRef="Join_Task_Transit_1" />
    <ns0:sequenceFlow id="Flow_SortFail_ReRoute" name="Sai Hub" sourceRef="Gate_HubSortOK" targetRef="Gate_ReRoute" />
    <ns0:sequenceFlow id="Flow_ReRouteYes_Transit" name="Có hub khác" sourceRef="Gate_ReRoute" targetRef="Join_Task_Transit_1" />
    <ns0:sequenceFlow id="Flow_ReRouteNo_Resort" name="Không — phân loại lại" sourceRef="Gate_ReRoute" targetRef="Join_Task_SortHub_1" />
    <ns0:sequenceFlow id="Flow_Transit_Out" sourceRef="Task_Transit" targetRef="Task_OutForDelivery" />
    <ns0:sequenceFlow id="Flow_Out_DeliverGate" sourceRef="Split_Task_OutForDelivery_1" targetRef="Gate_DeliveryAttempt" name="Kiểm tra giao lần đầu" />
    <ns0:sequenceFlow id="Flow_AttemptOK_Receive" name="Giao thành công" sourceRef="Gate_DeliveryAttempt" targetRef="Join_Task_ReceiveDelivery_1" />
    <ns0:sequenceFlow id="Flow_AttemptFail_RetryGate" name="Giao thất bại" sourceRef="Gate_DeliveryAttempt" targetRef="Gate_RetryLimit" />
    <ns0:sequenceFlow id="Flow_Receive_GateAccept" sourceRef="Task_ReceiveDelivery" targetRef="Gate_AcceptGoods" />
    <ns0:sequenceFlow id="Flow_AcceptYes_Confirm" name="Chấp nhận" sourceRef="Gate_AcceptGoods" targetRef="Task_ConfirmAccept" />
    <ns0:sequenceFlow id="Flow_AcceptNo_Report" name="Từ chối" sourceRef="Gate_AcceptGoods" targetRef="Task_ReportIssue" />
    <ns0:sequenceFlow id="Flow_Confirm_End" sourceRef="Task_ConfirmAccept" targetRef="Join_End_Event_Delivered_1" />
    <ns0:sequenceFlow id="Flow_Report_End" sourceRef="Task_ReportIssue" targetRef="Join_End_Event_Delivered_1" />
    <ns0:sequenceFlow id="Flow_Drone_Receive" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_End_Event_Delivered_1" name="Drone nhận hàng" />
    <ns0:sequenceFlow id="Flow_Route_GenAWB" sourceRef="Split_Task_RouteOptimize_1" targetRef="Task_GenerateAWB" name="Tạo AWB" />
    <ns0:sequenceFlow id="Flow_GenAWB_Sort" sourceRef="Split_Task_GenerateAWB_1" targetRef="Join_Task_SortHub_1" name="Phân loại tại Hub" />
    <ns0:sequenceFlow id="Flow_GenAWB_Track" sourceRef="Split_Task_GenerateAWB_1" targetRef="Join_Task_RealTimeTracking_1" name="Push tracking" />
    <ns0:sequenceFlow id="Flow_Out_Notify" sourceRef="Split_Task_OutForDelivery_1" targetRef="Join_Task_RealTimeTracking_1" name="Cập nhật vị trí" />
    <ns0:sequenceFlow id="Flow_Track_Notify" sourceRef="Task_RealTimeTracking" targetRef="Join_Task_NotifyBuyer_1" />
    <ns0:sequenceFlow id="Flow_Drone_Notify" sourceRef="Split_Task_DroneDelivery_1" targetRef="Join_Task_NotifyBuyer_1" name="Thông báo lịch giao" />
    <ns0:sequenceFlow id="Flow_Notify_Receive" sourceRef="Task_NotifyBuyer" targetRef="Join_Task_ReceiveDelivery_1" />
    <ns0:sequenceFlow id="Flow_RetryNo_Reschedule" name="Chưa đủ 3 lần — hẹn lại" sourceRef="Gate_RetryLimit" targetRef="Join_Task_SchedulePickup_1" />
    <ns0:sequenceFlow id="Flow_RetryYes_Return" name="≥ 3 lần — hoàn hàng" sourceRef="Gate_RetryLimit" targetRef="Task_ReturnToSeller" />
    <ns0:sequenceFlow id="Flow_Return_End" sourceRef="Task_ReturnToSeller" targetRef="EndEvent_Returned" />
    <ns0:sequenceFlow id="Flow_Join_End_Event_Delivered_1_to_EndEvent_Delivered" sourceRef="Join_End_Event_Delivered_1" targetRef="EndEvent_Delivered" name="" />
    <ns0:sequenceFlow id="Flow_Task_DroneDelivery_to_Split_Task_DroneDelivery_1" sourceRef="Task_DroneDelivery" targetRef="Split_Task_DroneDelivery_1" name="" />
    <ns0:sequenceFlow id="Flow_Task_GenerateAWB_to_Split_Task_GenerateAWB_1" sourceRef="Task_GenerateAWB" targetRef="Split_Task_GenerateAWB_1" name="" />
    <ns0:sequenceFlow id="Flow_Join_Task_NotifyBuyer_1_to_Task_NotifyBuyer" sourceRef="Join_Task_NotifyBuyer_1" targetRef="Task_NotifyBuyer" name="" />
