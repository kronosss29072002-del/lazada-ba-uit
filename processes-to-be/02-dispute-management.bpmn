<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DisputeManagementToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_DisputeManagement" name="Quản lý Tranh chấp TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StructuredUpload</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Automated)">
        <bpmn:flowNodeRef>Task_CollectData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComputeDynamicSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_LowValue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Complexity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyParties</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SLA_Simple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_SLA_Complex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ESLA_24h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Settled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refunded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_NotifyParties_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_Settle_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_NotifyParties_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI Engine (Automated)">
        <bpmn:flowNodeRef>Task_AITriage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Task_SellerReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_SellerReply_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="CS Agent">
        <bpmn:flowNodeRef>Task_ReviewCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Escalation" name="Escalation Team">
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeniorReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SeniorDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Dispute" name="Tranh chấp mới phát sinh">
      <bpmn:outgoing>Flow_Start_Create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateDispute" name="Tạo tranh chấp + lý do">
      <bpmn:incoming>Flow_Start_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Upload</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_StructuredUpload" name="Upload evidence có cấu trúc (ảnh/video theo danh mục)">
      <bpmn:incoming>Flow_Create_Upload</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_Collect</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CollectData" name="Tự động thu thập dữ liệu đơn hàng">
      <bpmn:incoming>Flow_Upload_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_Triage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ComputeDynamicSLA" name="Tính SLA động theo độ phức tạp">
      <bpmn:incoming>Flow_LowValue_Compute</bpmn:incoming>
      <bpmn:outgoing>Flow_Compute_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_LowValue" name="Case rõ ràng &amp; giá trị &lt;200k?" default="Flow_LowValue_Refund">
      <bpmn:incoming>Flow_Triage_LowValue</bpmn:incoming>
      <bpmn:outgoing>Flow_LowValue_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_LowValue_Compute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoRefund" name="Tự động hoàn tiền (case rõ ràng &lt;200k)">
      <bpmn:incoming>Flow_LowValue_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Complexity" name="Độ phức tạp case?" default="Flow_Simple_Notify">
      <bpmn:incoming>Flow_Compute_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Simple_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complex_Notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyParties" name="Thông báo 2 bên kèm SLA động">
      <bpmn:incoming>Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_SLA_Simple" name="SLA 24h: case đơn giản">
      <bpmn:incoming>Flow_Simple_NotifyTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_Simple_TimerReply</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_SLA_Simple">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer_SLA_Complex" name="SLA 48h: case phức tạp">
      <bpmn:incoming>Flow_Complex_NotifyTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_Complex_TimerReply</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_SLA_Complex">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer_ESLA_24h" name="SLA &lt;24h: chờ xử lý escalation">
      <bpmn:incoming>Flow_Escalate_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_ESLA_Review</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ESLA_24h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Settle" name="Hoàn tất giải quyết (hoàn tiền/bồi thường)">
      <bpmn:incoming>Flow_Join_Task_Settle_2_to_Task_Settle</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AITriage" name="AI phân loại evidence (ảnh/video) tự động">
      <bpmn:incoming>Flow_Collect_Triage</bpmn:incoming>
      <bpmn:outgoing>Flow_Triage_LowValue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SellerReply" name="Seller phản hồi evidence trong SLA">
      <bpmn:incoming>Flow_Join_Task_SellerReply_3_to_Task_SellerReply</bpmn:incoming>
      <bpmn:outgoing>Flow_Reply_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewCase" name="CS review evidence đã được AI phân loại">
      <bpmn:incoming>Flow_Reply_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Decide</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Decide" name="CS đưa quyết định">
      <bpmn:incoming>Flow_Review_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_Decision" name="Kết quả xử lý?" default="Flow_Gate_Settle">
      <bpmn:incoming>Flow_Decide_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Settle</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Escalate" name="Chuyển lên escalation team">
      <bpmn:incoming>Flow_Gate_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_Timer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SeniorReview" name="Senior review + quyết định cuối">
      <bpmn:incoming>Flow_ESLA_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Senior_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_SeniorDecision" name="Quyết định senior?" default="Flow_Senior_Settle">
      <bpmn:incoming>Flow_Senior_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Senior_Settle</bpmn:outgoing>
      <bpmn:outgoing>Flow_Senior_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Settled" name="Tranh chấp đã được giải quyết">
      <bpmn:incoming>Flow_Settle_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Refunded" name="Đã tự động hoàn tiền thành công">
      <bpmn:incoming>Flow_Refund_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Join_End_Rejected_1" name="Gom nhánh kết thúc">
      <bpmn:incoming>Flow_Gate_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_Senior_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_Rejected_1_to_End_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Tranh chấp đã bị bác bỏ">
      <bpmn:incoming>Flow_Join_End_Rejected_1_to_End_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Create" sourceRef="StartEvent_Dispute" targetRef="Task_CreateDispute" />
    <bpmn:sequenceFlow id="Flow_Create_Upload" sourceRef="Task_CreateDispute" targetRef="Task_StructuredUpload" />
    <bpmn:sequenceFlow id="Flow_Upload_Collect" sourceRef="Task_StructuredUpload" targetRef="Task_CollectData" />
    <bpmn:sequenceFlow id="Flow_Collect_Triage" sourceRef="Task_CollectData" targetRef="Task_AITriage" />
    <bpmn:sequenceFlow id="Flow_Triage_LowValue" sourceRef="Task_AITriage" targetRef="Gate_LowValue" />
    <bpmn:sequenceFlow id="Flow_LowValue_Refund" sourceRef="Gate_LowValue" targetRef="Task_AutoRefund" name="Giá trị &lt; 200k &amp; rõ ràng" />
    <bpmn:sequenceFlow id="Flow_LowValue_Compute" sourceRef="Gate_LowValue" targetRef="Task_ComputeDynamicSLA" name="Không rõ ràng / ≥ 200k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${caseValue &gt;= 200000 or not clearCut}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refund_End" sourceRef="Task_AutoRefund" targetRef="End_Refunded" />
    <bpmn:sequenceFlow id="Flow_Compute_Gate" sourceRef="Task_ComputeDynamicSLA" targetRef="Gate_Complexity" />
    <bpmn:sequenceFlow id="Flow_Simple_Notify" sourceRef="Gate_Complexity" targetRef="Join_Task_NotifyParties_1" name="Case đơn giản" />
    <bpmn:sequenceFlow id="Flow_Complex_Notify" sourceRef="Gate_Complexity" targetRef="Join_Task_NotifyParties_1" name="Case phức tạp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${complex == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Simple_NotifyTimer" sourceRef="Split_Task_NotifyParties_1" targetRef="Timer_SLA_Simple" />
    <bpmn:sequenceFlow id="Flow_Complex_NotifyTimer" sourceRef="Split_Task_NotifyParties_1" targetRef="Timer_SLA_Complex" />
    <bpmn:sequenceFlow id="Flow_Simple_TimerReply" sourceRef="Timer_SLA_Simple" targetRef="Join_Task_SellerReply_3" />
    <bpmn:sequenceFlow id="Flow_Complex_TimerReply" sourceRef="Timer_SLA_Complex" targetRef="Join_Task_SellerReply_3" />
    <bpmn:sequenceFlow id="Flow_Reply_Review" sourceRef="Task_SellerReply" targetRef="Task_ReviewCase" />
    <bpmn:sequenceFlow id="Flow_Review_Decide" sourceRef="Task_ReviewCase" targetRef="Task_Decide" />
    <bpmn:sequenceFlow id="Flow_Decide_Gate" sourceRef="Task_Decide" targetRef="Gate_Decision" />
    <bpmn:sequenceFlow id="Flow_Gate_Settle" sourceRef="Gate_Decision" targetRef="Join_Task_Settle_2" name="Có cơ sở giải quyết" />
    <bpmn:sequenceFlow id="Flow_Gate_Reject" sourceRef="Gate_Decision" targetRef="Join_End_Rejected_1" name="Không đủ cơ sở → bác bỏ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "reject"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gate_Escalate" sourceRef="Gate_Decision" targetRef="Task_Escalate" name="Phức tạp → escalation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "escalate"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Escalate_Timer" sourceRef="Task_Escalate" targetRef="Timer_ESLA_24h" />
    <bpmn:sequenceFlow id="Flow_ESLA_Review" sourceRef="Timer_ESLA_24h" targetRef="Task_SeniorReview" />
    <bpmn:sequenceFlow id="Flow_Senior_Gate" sourceRef="Task_SeniorReview" targetRef="Gate_SeniorDecision" />
    <bpmn:sequenceFlow id="Flow_Senior_Settle" sourceRef="Gate_SeniorDecision" targetRef="Join_Task_Settle_2" name="Chấp thuận giải quyết" />
    <bpmn:sequenceFlow id="Flow_Senior_Reject" sourceRef="Gate_SeniorDecision" targetRef="Join_End_Rejected_1" name="Bác bỏ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "reject"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Settle_End" sourceRef="Task_Settle" targetRef="End_Settled" />
    <bpmn:exclusiveGateway id="Join_Task_NotifyParties_1" name="Gom luồng trước khi Thông báo 2 bên kèm SLA động">
      <bpmn:incoming>Flow_Simple_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Complex_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties" sourceRef="Join_Task_NotifyParties_1" targetRef="Task_NotifyParties" />
    <bpmn:exclusiveGateway id="Join_Task_Settle_2" name="Gom luồng trước khi Hoàn tất giải quyết (hoàn tiền/bồi thường)">
      <bpmn:incoming>Flow_Gate_Settle</bpmn:incoming>
      <bpmn:incoming>Flow_Senior_Settle</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Settle_2_to_Task_Settle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_Settle_2_to_Task_Settle" sourceRef="Join_Task_Settle_2" targetRef="Task_Settle" />
    <bpmn:exclusiveGateway id="Join_Task_SellerReply_3" name="Gom luồng trước khi Seller phản hồi evidence trong SLA">
      <bpmn:incoming>Flow_Simple_TimerReply</bpmn:incoming>
      <bpmn:incoming>Flow_Complex_TimerReply</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_SellerReply_3_to_Task_SellerReply</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_SellerReply_3_to_Task_SellerReply" sourceRef="Join_Task_SellerReply_3" targetRef="Task_SellerReply" />
    <bpmn:exclusiveGateway id="Split_Task_NotifyParties_1" name="Phân luồng sau Thông báo 2 bên kèm SLA động">
      <bpmn:incoming>Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Simple_NotifyTimer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complex_NotifyTimer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1" sourceRef="Task_NotifyParties" targetRef="Split_Task_NotifyParties_1" />
    <bpmn:sequenceFlow id="Flow_Join_End_Rejected_1_to_End_Rejected" sourceRef="Join_End_Rejected_1" targetRef="End_Rejected" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
