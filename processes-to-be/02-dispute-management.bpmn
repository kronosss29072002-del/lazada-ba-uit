<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DisputeManagementToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_DisputeManagement" name="Quản lý Tranh chấp TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Dispute</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CreateDispute</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_StructuredUpload</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_CollectData</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ComputeDynamicSLA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_LowValue</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Complexity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyParties</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_SLA_Simple</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_SLA_Complex</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_ESLA_24h</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Settle</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Settled</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Refunded</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_NotifyParties_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_Settle_2</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_NotifyParties_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_AI" name="AI Engine (Automated)">
        <ns0:flowNodeRef>Task_AITriage</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_SellerReply</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_SellerReply_3</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_CS" name="CS Agent">
        <ns0:flowNodeRef>Task_ReviewCase</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Decide</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Decision</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Rejected</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Escalation" name="Escalation Team">
        <ns0:flowNodeRef>Task_Escalate</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SeniorReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SeniorDecision</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Dispute" name="Tranh chấp mới phát sinh">
      <ns0:outgoing>Flow_Start_Create</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_CreateDispute" name="Tạo tranh chấp + lý do">
      <ns0:incoming>Flow_Start_Create</ns0:incoming>
      <ns0:outgoing>Flow_Create_Upload</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_StructuredUpload" name="Upload evidence có cấu trúc (ảnh/video theo danh mục)">
      <ns0:incoming>Flow_Create_Upload</ns0:incoming>
      <ns0:outgoing>Flow_Upload_Collect</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_CollectData" name="Tự động thu thập dữ liệu đơn hàng">
      <ns0:incoming>Flow_Upload_Collect</ns0:incoming>
      <ns0:outgoing>Flow_Collect_Triage</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ComputeDynamicSLA" name="Tính SLA động theo độ phức tạp">
      <ns0:incoming>Flow_LowValue_Compute</ns0:incoming>
      <ns0:outgoing>Flow_Compute_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_LowValue" name="Case rõ ràng &amp; giá trị &lt;200k?" default="Flow_LowValue_Refund">
      <ns0:incoming>Flow_Triage_LowValue</ns0:incoming>
      <ns0:outgoing>Flow_LowValue_Refund</ns0:outgoing>
      <ns0:outgoing>Flow_LowValue_Compute</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_AutoRefund" name="Tự động hoàn tiền (case rõ ràng &lt;200k)">
      <ns0:incoming>Flow_LowValue_Refund</ns0:incoming>
      <ns0:outgoing>Flow_Refund_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_Complexity" name="Độ phức tạp case?" default="Flow_Simple_Notify">
      <ns0:incoming>Flow_Compute_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Simple_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_Complex_Notify</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_NotifyParties" name="Thông báo 2 bên kèm SLA động">
      <ns0:incoming>Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties</ns0:incoming>
      <ns0:outgoing>Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:intermediateCatchEvent id="Timer_SLA_Simple" name="SLA 24h: case đơn giản">
      <ns0:incoming>Flow_Simple_NotifyTimer</ns0:incoming>
      <ns0:outgoing>Flow_Simple_TimerReply</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDefinition_SLA_Simple">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:intermediateCatchEvent id="Timer_SLA_Complex" name="SLA 48h: case phức tạp">
      <ns0:incoming>Flow_Complex_NotifyTimer</ns0:incoming>
      <ns0:outgoing>Flow_Complex_TimerReply</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDefinition_SLA_Complex">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:intermediateCatchEvent id="Timer_ESLA_24h" name="SLA &lt;24h: chờ xử lý escalation">
      <ns0:incoming>Flow_Escalate_Timer</ns0:incoming>
      <ns0:outgoing>Flow_ESLA_Review</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDefinition_ESLA_24h">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:serviceTask id="Task_Settle" name="Hoàn tất giải quyết (hoàn tiền/bồi thường)">
      <ns0:incoming>Flow_Join_Task_Settle_2_to_Task_Settle</ns0:incoming>
      <ns0:outgoing>Flow_Settle_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AITriage" name="AI phân loại evidence (ảnh/video) tự động">
      <ns0:incoming>Flow_Collect_Triage</ns0:incoming>
      <ns0:outgoing>Flow_Triage_LowValue</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_SellerReply" name="Seller phản hồi evidence trong SLA">
      <ns0:incoming>Flow_Join_Task_SellerReply_3_to_Task_SellerReply</ns0:incoming>
      <ns0:outgoing>Flow_Reply_Review</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReviewCase" name="CS review evidence đã được AI phân loại">
      <ns0:incoming>Flow_Reply_Review</ns0:incoming>
      <ns0:outgoing>Flow_Review_Decide</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Decide" name="CS đưa quyết định">
      <ns0:incoming>Flow_Review_Decide</ns0:incoming>
      <ns0:outgoing>Flow_Decide_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_Decision" name="Kết quả xử lý?" default="Flow_Gate_Settle">
      <ns0:incoming>Flow_Decide_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Settle</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Reject</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Escalate</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_Escalate" name="Chuyển lên escalation team">
      <ns0:incoming>Flow_Gate_Escalate</ns0:incoming>
      <ns0:outgoing>Flow_Escalate_Timer</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SeniorReview" name="Senior review + quyết định cuối">
      <ns0:incoming>Flow_ESLA_Review</ns0:incoming>
      <ns0:outgoing>Flow_Senior_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_SeniorDecision" name="Quyết định senior?" default="Flow_Senior_Settle">
      <ns0:incoming>Flow_Senior_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Senior_Settle</ns0:outgoing>
      <ns0:outgoing>Flow_Senior_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Settled" name="Tranh chấp đã được giải quyết">
      <ns0:incoming>Flow_Settle_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Refunded" name="Đã tự động hoàn tiền thành công">
      <ns0:incoming>Flow_Refund_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:exclusiveGateway id="Join_End_Rejected_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_Gate_Reject</ns0:incoming>
      <ns0:incoming>Flow_Senior_Reject</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_Rejected_1_to_End_Rejected</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Rejected" name="Tranh chấp đã bị bác bỏ">
      <ns0:incoming>Flow_Join_End_Rejected_1_to_End_Rejected</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Create" sourceRef="StartEvent_Dispute" targetRef="Task_CreateDispute" />
    <ns0:sequenceFlow id="Flow_Create_Upload" sourceRef="Task_CreateDispute" targetRef="Task_StructuredUpload" />
    <ns0:sequenceFlow id="Flow_Upload_Collect" sourceRef="Task_StructuredUpload" targetRef="Task_CollectData" />
    <ns0:sequenceFlow id="Flow_Collect_Triage" sourceRef="Task_CollectData" targetRef="Task_AITriage" />
    <ns0:sequenceFlow id="Flow_Triage_LowValue" sourceRef="Task_AITriage" targetRef="Gate_LowValue" />
    <ns0:sequenceFlow id="Flow_LowValue_Refund" sourceRef="Gate_LowValue" targetRef="Task_AutoRefund" name="Giá trị &lt; 200k &amp; rõ ràng" />
    <ns0:sequenceFlow id="Flow_LowValue_Compute" sourceRef="Gate_LowValue" targetRef="Task_ComputeDynamicSLA" name="Không rõ ràng / ≥ 200k">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${caseValue &gt;= 200000 or not clearCut}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Refund_End" sourceRef="Task_AutoRefund" targetRef="End_Refunded" />
    <ns0:sequenceFlow id="Flow_Compute_Gate" sourceRef="Task_ComputeDynamicSLA" targetRef="Gate_Complexity" />
    <ns0:sequenceFlow id="Flow_Simple_Notify" sourceRef="Gate_Complexity" targetRef="Join_Task_NotifyParties_1" name="Case đơn giản" />
    <ns0:sequenceFlow id="Flow_Complex_Notify" sourceRef="Gate_Complexity" targetRef="Join_Task_NotifyParties_1" name="Case phức tạp">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${complex == true}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Simple_NotifyTimer" sourceRef="Split_Task_NotifyParties_1" targetRef="Timer_SLA_Simple" name="Khiếu nại đơn giản" />
    <ns0:sequenceFlow id="Flow_Complex_NotifyTimer" sourceRef="Split_Task_NotifyParties_1" targetRef="Timer_SLA_Complex" name="Khiếu nại phức tạp" />
    <ns0:sequenceFlow id="Flow_Simple_TimerReply" sourceRef="Timer_SLA_Simple" targetRef="Join_Task_SellerReply_3" />
    <ns0:sequenceFlow id="Flow_Complex_TimerReply" sourceRef="Timer_SLA_Complex" targetRef="Join_Task_SellerReply_3" />
    <ns0:sequenceFlow id="Flow_Reply_Review" sourceRef="Task_SellerReply" targetRef="Task_ReviewCase" />
    <ns0:sequenceFlow id="Flow_Review_Decide" sourceRef="Task_ReviewCase" targetRef="Task_Decide" />
    <ns0:sequenceFlow id="Flow_Decide_Gate" sourceRef="Task_Decide" targetRef="Gate_Decision" />
    <ns0:sequenceFlow id="Flow_Gate_Settle" sourceRef="Gate_Decision" targetRef="Join_Task_Settle_2" name="Có cơ sở giải quyết" />
    <ns0:sequenceFlow id="Flow_Gate_Reject" sourceRef="Gate_Decision" targetRef="Join_End_Rejected_1" name="Không đủ cơ sở → bác bỏ">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "reject"}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Gate_Escalate" sourceRef="Gate_Decision" targetRef="Task_Escalate" name="Phức tạp → escalation">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "escalate"}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Escalate_Timer" sourceRef="Task_Escalate" targetRef="Timer_ESLA_24h" />
    <ns0:sequenceFlow id="Flow_ESLA_Review" sourceRef="Timer_ESLA_24h" targetRef="Task_SeniorReview" />
    <ns0:sequenceFlow id="Flow_Senior_Gate" sourceRef="Task_SeniorReview" targetRef="Gate_SeniorDecision" />
    <ns0:sequenceFlow id="Flow_Senior_Settle" sourceRef="Gate_SeniorDecision" targetRef="Join_Task_Settle_2" name="Chấp thuận giải quyết" />
    <ns0:sequenceFlow id="Flow_Senior_Reject" sourceRef="Gate_SeniorDecision" targetRef="Join_End_Rejected_1" name="Bác bỏ">
      <ns0:conditionExpression xsi:type="bpmn:tFormalExpression">${result == "reject"}</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Settle_End" sourceRef="Task_Settle" targetRef="End_Settled" />
    <ns0:exclusiveGateway id="Join_Task_NotifyParties_1" name="Gom luồng trước khi Thông báo 2 bên kèm SLA động">
      <ns0:incoming>Flow_Simple_Notify</ns0:incoming>
      <ns0:incoming>Flow_Complex_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_NotifyParties_1_to_Task_NotifyParties" sourceRef="Join_Task_NotifyParties_1" targetRef="Task_NotifyParties" />
    <ns0:exclusiveGateway id="Join_Task_Settle_2" name="Gom luồng trước khi Hoàn tất giải quyết (hoàn tiền/bồi thường)">
      <ns0:incoming>Flow_Gate_Settle</ns0:incoming>
      <ns0:incoming>Flow_Senior_Settle</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Settle_2_to_Task_Settle</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_Settle_2_to_Task_Settle" sourceRef="Join_Task_Settle_2" targetRef="Task_Settle" />
    <ns0:exclusiveGateway id="Join_Task_SellerReply_3" name="Gom luồng trước khi Seller phản hồi evidence trong SLA">
      <ns0:incoming>Flow_Simple_TimerReply</ns0:incoming>
      <ns0:incoming>Flow_Complex_TimerReply</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_SellerReply_3_to_Task_SellerReply</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_SellerReply_3_to_Task_SellerReply" sourceRef="Join_Task_SellerReply_3" targetRef="Task_SellerReply" />
    <ns0:exclusiveGateway id="Split_Task_NotifyParties_1" name="Phân luồng sau Thông báo 2 bên kèm SLA động">
      <ns0:incoming>Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1</ns0:incoming>
      <ns0:outgoing>Flow_Simple_NotifyTimer</ns0:outgoing>
      <ns0:outgoing>Flow_Complex_NotifyTimer</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_NotifyParties_to_Split_Task_NotifyParties_1" sourceRef="Task_NotifyParties" targetRef="Split_Task_NotifyParties_1" />
    <ns0:sequenceFlow id="Flow_Join_End_Rejected_1_to_End_Rejected" sourceRef="Join_End_Rejected_1" targetRef="End_Rejected" name="" />
  </ns0:process>
  <ns2:BPMNDiagram id="BPMNDiagram_1">
