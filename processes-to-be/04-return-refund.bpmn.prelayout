<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ReturnRefund_TOBE" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ReturnRefund_TOBE" name="Hoàn trả &amp; Refund TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_HandoverReturn_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Automated)">
        <bpmn:flowNodeRef>Task_CheckEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AITriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AIEvidenceVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InstantRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DynamicPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AIInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_RefundSLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_LowRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_AIPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ProcessRefund_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="CS Agent">
        <bpmn:flowNodeRef>Task_CSReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="3PL/Warehouse">
        <bpmn:flowNodeRef>Task_PickupReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Payment Gateway">
        <bpmn:flowNodeRef>Task_ExecuteRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ExecuteRefund_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Request" name="Yêu cầu hoàn trả hàng">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit yêu cầu + lý do">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Eligibility</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadEvidence" name="Upload evidence (ảnh/video)">
      <bpmn:incoming>Flow_Eligible_Upload</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_Triage</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HandoverReturn" name="Bàn giao hàng trả cho LEX / 3PL">
      <bpmn:incoming>Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_Handover_Pickup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckEligibility" name="Check eligibility tự động">
      <bpmn:incoming>Flow_Submit_Eligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligibility_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AITriage" name="AI phân loại rủi ro khiếu nại">
      <bpmn:incoming>Flow_Upload_Triage</bpmn:incoming>
      <bpmn:outgoing>Flow_Triage_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AIEvidenceVerify" name="AI Vision thẩm định lỗi bao bì/sản phẩm">
      <bpmn:incoming>Flow_Gate_LowRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_AI_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InstantRefund" name="Instant refund (return-less)">
      <bpmn:incoming>Flow_AI_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_Instant_Execute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DynamicPickup" name="Lên lịch thu hồi hàng thông minh">
      <bpmn:incoming>Flow_Handover_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Schedule</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AIInspection" name="AI image analysis inspection">
      <bpmn:incoming>Flow_Pickup_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspection_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProcessRefund" name="Xử lý lệnh hoàn tiền tự động">
      <bpmn:incoming>Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_Execute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyStatus" name="Auto-notify từng bước">
      <bpmn:incoming>Flow_Payout_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_RefundSLA" name="Kích hoạt hoàn tiền tự động trong 24h">
      <bpmn:timerEventDefinition id="TimerDef_24h_Refund">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:incoming>Flow_Gate_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Refund</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CSReview" name="CS review (khi AI không chắc)">
      <bpmn:incoming>Flow_AI_Uncertain</bpmn:incoming>
      <bpmn:outgoing>Flow_CS_Handover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReschedulePickup" name="Đặt lại lịch pickup">
      <bpmn:incoming>Flow_Pickup_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Pickup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_PickupReturn" name="LEX / 3PL pickup hàng trả">
      <bpmn:incoming>Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Gate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_ExecuteRefund" name="Cổng thanh toán giải ngân tiền hoàn">
      <bpmn:incoming>Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_Execute_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RetryPayout" name="Thử lại giải ngân (tự động)">
      <bpmn:incoming>Flow_Payout_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Execute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Eligible" name="Hợp lệ?">
      <bpmn:incoming>Flow_Eligibility_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Upload</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_LowRisk" name="Đơn giá trị &lt;200k &amp; Buyer tín nhiệm cao?">
      <bpmn:incoming>Flow_Triage_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_LowRisk</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Handover</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_AIPass" name="AI xác thực lỗi đạt độ tin cậy &gt;95%?">
      <bpmn:incoming>Flow_AI_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_AI_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_AI_Uncertain</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Timer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_PickupRetry" name="Pickup thành công?">
      <bpmn:incoming>Flow_Pickup_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pickup_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_PayoutSuccess" name="Giải ngân thành công?">
      <bpmn:incoming>Flow_Execute_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Payout_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Payout_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_PickupReturn_4" name="Gom luồng trước khi LEX / 3PL pickup hàng trả">
      <bpmn:incoming>Flow_Pickup_Schedule</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Yêu cầu hoàn trả đã bị từ chối">
      <bpmn:incoming>Flow_Eligible_Reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_Request" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_Submit_Eligibility" sourceRef="Task_SubmitRequest" targetRef="Task_CheckEligibility" />
    <bpmn:sequenceFlow id="Flow_Eligibility_Gate" sourceRef="Task_CheckEligibility" targetRef="Gate_Eligible" />
    <bpmn:sequenceFlow id="Flow_Eligible_Upload" sourceRef="Gate_Eligible" targetRef="Task_UploadEvidence" />
    <bpmn:sequenceFlow id="Flow_Eligible_Reject" sourceRef="Gate_Eligible" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Upload_Triage" sourceRef="Task_UploadEvidence" targetRef="Task_AITriage" />
    <bpmn:sequenceFlow id="Flow_Triage_Gate" sourceRef="Task_AITriage" targetRef="Gate_LowRisk" />
    <bpmn:sequenceFlow id="Flow_Gate_LowRisk" sourceRef="Gate_LowRisk" targetRef="Task_AIEvidenceVerify" />
    <bpmn:sequenceFlow id="Flow_Gate_Handover" sourceRef="Gate_LowRisk" targetRef="Join_Task_HandoverReturn_1" />
    <bpmn:sequenceFlow id="Flow_AI_Gate" sourceRef="Task_AIEvidenceVerify" targetRef="Gate_AIPass" />
    <bpmn:sequenceFlow id="Flow_AI_Pass" sourceRef="Gate_AIPass" targetRef="Task_InstantRefund" />
    <bpmn:sequenceFlow id="Flow_AI_Uncertain" sourceRef="Gate_AIPass" targetRef="Task_CSReview" />
    <bpmn:sequenceFlow id="Flow_Gate_Timer" sourceRef="Gate_AIPass" targetRef="Timer_RefundSLA" />
    <bpmn:sequenceFlow id="Flow_Instant_Execute" sourceRef="Task_InstantRefund" targetRef="Join_Task_ExecuteRefund_3" />
    <bpmn:sequenceFlow id="Flow_CS_Handover" sourceRef="Task_CSReview" targetRef="Join_Task_HandoverReturn_1" />
    <bpmn:sequenceFlow id="Flow_Handover_Pickup" sourceRef="Task_HandoverReturn" targetRef="Task_DynamicPickup" />
    <bpmn:sequenceFlow id="Flow_Pickup_Schedule" sourceRef="Task_DynamicPickup" targetRef="Join_Task_PickupReturn_4" />
    <bpmn:sequenceFlow id="Flow_Pickup_Gate" sourceRef="Task_PickupReturn" targetRef="Gate_PickupRetry" />
    <bpmn:sequenceFlow id="Flow_Pickup_Yes" sourceRef="Gate_PickupRetry" targetRef="Task_AIInspection" />
    <bpmn:sequenceFlow id="Flow_Pickup_No" sourceRef="Gate_PickupRetry" targetRef="Task_ReschedulePickup" />
    <bpmn:sequenceFlow id="Flow_Retry_Pickup" sourceRef="Task_ReschedulePickup" targetRef="Join_Task_PickupReturn_4" />
    <bpmn:sequenceFlow id="Flow_Inspection_Notify" sourceRef="Task_AIInspection" targetRef="Join_Task_ProcessRefund_2" />
    <bpmn:sequenceFlow id="Flow_Timer_Refund" sourceRef="Timer_RefundSLA" targetRef="Join_Task_ProcessRefund_2" />
    <bpmn:sequenceFlow id="Flow_Refund_Execute" sourceRef="Task_ProcessRefund" targetRef="Join_Task_ExecuteRefund_3" />
    <bpmn:sequenceFlow id="Flow_Execute_Gate" sourceRef="Task_ExecuteRefund" targetRef="Gate_PayoutSuccess" />
    <bpmn:sequenceFlow id="Flow_Payout_Yes" sourceRef="Gate_PayoutSuccess" targetRef="Task_NotifyStatus" />
    <bpmn:sequenceFlow id="Flow_Payout_Retry" sourceRef="Gate_PayoutSuccess" targetRef="Task_RetryPayout" />
    <bpmn:sequenceFlow id="Flow_Retry_Execute" sourceRef="Task_RetryPayout" targetRef="Join_Task_ExecuteRefund_3" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifyStatus" targetRef="End_Refunded" />
    <bpmn:exclusiveGateway id="Join_Task_HandoverReturn_1" name="Gom luồng trước khi Bàn giao hàng trả cho LEX / 3PL">
      <bpmn:incoming>Flow_Gate_Handover</bpmn:incoming>
      <bpmn:incoming>Flow_CS_Handover</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_HandoverReturn_1_to_Task_HandoverReturn" sourceRef="Join_Task_HandoverReturn_1" targetRef="Task_HandoverReturn" />
    <bpmn:exclusiveGateway id="Join_Task_ProcessRefund_2" name="Gom luồng trước khi Xử lý lệnh hoàn tiền tự động">
      <bpmn:incoming>Flow_Inspection_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ProcessRefund_2_to_Task_ProcessRefund" sourceRef="Join_Task_ProcessRefund_2" targetRef="Task_ProcessRefund" />
    <bpmn:exclusiveGateway id="Join_Task_ExecuteRefund_3" name="Gom luồng trước khi Cổng thanh toán giải ngân tiền hoàn">
      <bpmn:incoming>Flow_Instant_Execute</bpmn:incoming>
      <bpmn:incoming>Flow_Refund_Execute</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Execute</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ExecuteRefund_3_to_Task_ExecuteRefund" sourceRef="Join_Task_ExecuteRefund_3" targetRef="Task_ExecuteRefund" />
    <bpmn:sequenceFlow id="Flow_Join_Task_PickupReturn_4_to_Task_PickupReturn" sourceRef="Join_Task_PickupReturn_4" targetRef="Task_PickupReturn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ReturnRefund_TOBE">
      <bpmndi:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer">
        <dc:Bounds x="30" y="0" width="4546" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System">
        <dc:Bounds x="30" y="200" width="4546" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CS_di" bpmnElement="Lane_CS">
        <dc:Bounds x="30" y="400" width="4546" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse">
        <dc:Bounds x="30" y="600" width="4546" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Payment_di" bpmnElement="Lane_Payment">
        <dc:Bounds x="30" y="800" width="4546" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Request_di" bpmnElement="StartEvent_Request">
        <dc:Bounds x="80" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <dc:Bounds x="300" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UploadEvidence_di" bpmnElement="Task_UploadEvidence">
        <dc:Bounds x="960" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandoverReturn_di" bpmnElement="Task_HandoverReturn">
        <dc:Bounds x="2500" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckEligibility_di" bpmnElement="Task_CheckEligibility">
        <dc:Bounds x="520" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AITriage_di" bpmnElement="Task_AITriage">
        <dc:Bounds x="1180" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AIEvidenceVerify_di" bpmnElement="Task_AIEvidenceVerify">
        <dc:Bounds x="1620" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InstantRefund_di" bpmnElement="Task_InstantRefund">
        <dc:Bounds x="2060" y="222" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_RefundSLA_di" bpmnElement="Timer_RefundSLA">
        <dc:Bounds x="2060" y="324" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DynamicPickup_di" bpmnElement="Task_DynamicPickup">
        <dc:Bounds x="2720" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AIInspection_di" bpmnElement="Task_AIInspection">
        <dc:Bounds x="3160" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessRefund_di" bpmnElement="Task_ProcessRefund">
        <dc:Bounds x="3600" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyStatus_di" bpmnElement="Task_NotifyStatus">
        <dc:Bounds x="4260" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CSReview_di" bpmnElement="Task_CSReview">
        <dc:Bounds x="2060" y="465" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PickupReturn_di" bpmnElement="Task_PickupReturn">
        <dc:Bounds x="2940" y="665" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_Task_PickupReturn_4_di" bpmnElement="Join_Task_PickupReturn_4">
        <dc:Bounds x="2850" y="677" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_PickupRetry_di" bpmnElement="Gate_PickupRetry">
        <dc:Bounds x="3080" y="677" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReschedulePickup_di" bpmnElement="Task_ReschedulePickup">
        <dc:Bounds x="3060" y="790" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteRefund_di" bpmnElement="Task_ExecuteRefund">
        <dc:Bounds x="4040" y="865" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_PayoutSuccess_di" bpmnElement="Gate_PayoutSuccess">
        <dc:Bounds x="4225" y="877" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetryPayout_di" bpmnElement="Task_RetryPayout">
        <dc:Bounds x="4195" y="990" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_Eligible_di" bpmnElement="Gate_Eligible">
        <dc:Bounds x="740" y="277" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_LowRisk_di" bpmnElement="Gate_LowRisk">
        <dc:Bounds x="1400" y="277" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_AIPass_di" bpmnElement="Gate_AIPass">
        <dc:Bounds x="1840" y="277" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Refunded_di" bpmnElement="End_Refunded">
        <dc:Bounds x="4480" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="960" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_Task_HandoverReturn_1_di" bpmnElement="Join_Task_HandoverReturn_1">
        <dc:Bounds x="2280" y="77" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_Task_ProcessRefund_2_di" bpmnElement="Join_Task_ProcessRefund_2">
        <dc:Bounds x="3380" y="277" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_Task_ExecuteRefund_3_di" bpmnElement="Join_Task_ExecuteRefund_3">
