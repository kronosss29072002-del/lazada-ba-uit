<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Marketing_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_Marketing" name="Marketing &amp; Khuyến mãi TO-BE" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Marketing" name="Marketing Team">
        <bpmn:flowNodeRef>StartEvent_Idea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Research</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignConcept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonitorLive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_CampaignEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI Engine">
        <bpmn:flowNodeRef>Task_AIBudgetAlloc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AIPersonalInvite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MLInsights</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_AIPersonalInvite_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approval" name="Approval">
        <bpmn:flowNodeRef>Gate_BudgetTier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DirectorApprove</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System">
        <bpmn:flowNodeRef>Task_ConfigTemplate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoQA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_QAPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ROASDashboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CampaignDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ConfigTemplate_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Sellers">
        <bpmn:flowNodeRef>Task_SellerRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SellerPrepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_InviteSLA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buyer" name="Buyers">
        <bpmn:flowNodeRef>Task_BuyerBrowse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyerPurchase</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Idea" name="Ý tưởng chiến dịch mới">
      <bpmn:outgoing>Flow_Start_Research</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Research" name="Nghiên cứu thị trường + brief">
      <bpmn:incoming>Flow_Start_Research</bpmn:incoming>
      <bpmn:outgoing>Flow_Research_Design</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DesignConcept" name="Thiết kế concept + kế hoạch">
      <bpmn:incoming>Flow_Research_Design</bpmn:incoming>
      <bpmn:outgoing>Flow_Design_Budget</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MonitorLive" name="Giám sát ROAS dashboard real-time">
      <bpmn:incoming>Flow_Dashboard_Monitor</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitor_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_AIBudgetAlloc" name="AI phân bổ ngân sách">
      <bpmn:incoming>Flow_Design_Budget</bpmn:incoming>
      <bpmn:outgoing>Flow_Budget_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AIPersonalInvite" name="Cá nhân hóa lời mời seller">
      <bpmn:outgoing>Flow_Invite_Split</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gate_InviteSplit" name="Tách luồng chuẩn bị">
      <bpmn:incoming>Flow_Invite_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Invite_Config</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invite_Register</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_MLInsights" name="Sinh insight ML từ dữ liệu">
      <bpmn:incoming>Flow_End_ML</bpmn:incoming>
      <bpmn:outgoing>Flow_ML_Report</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DirectorApprove" name="Giám đốc phê duyệt (ngân sách lớn)">
      <bpmn:incoming>Flow_Gate_Large</bpmn:incoming>
      <bpmn:outgoing>Flow_Director_Invite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ConfigTemplate" name="Config campaign tự động từ template">
      <bpmn:outgoing>Flow_Config_QA</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoQA" name="Auto-QA checklist">
      <bpmn:incoming>Flow_Config_QA</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Launch" name="Kích hoạt Chiến dịch 12.12 Siêu Hội Mua Sắm">
      <bpmn:incoming>Flow_Ready_Launch</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_Split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gate_LaunchSplit" name="Tách luồng vận hành &amp; mua sắm">
      <bpmn:incoming>Flow_Launch_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_Dashboard</bpmn:outgoing>
      <bpmn:outgoing>Flow_Launch_Browse</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_ROASDashboard" name="Cập nhật ROAS dashboard real-time">
      <bpmn:incoming>Flow_Launch_Dashboard</bpmn:incoming>
      <bpmn:outgoing>Flow_Dashboard_Monitor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoReport" name="Auto-report sau chiến dịch + ML insight">
      <bpmn:incoming>Flow_ML_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SellerRegister" name="Seller đăng ký tham gia">
      <bpmn:incoming>Flow_Invite_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Prepare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SellerPrepare" name="Seller chuẩn bị sản phẩm + voucher">
      <bpmn:incoming>Flow_Register_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_SLA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BuyerBrowse" name="Buyer xem khuyến mãi">
      <bpmn:incoming>Flow_Launch_Browse</bpmn:incoming>
      <bpmn:outgoing>Flow_Browse_Purchase</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BuyerPurchase" name="Buyer mua hàng">
      <bpmn:incoming>Flow_Browse_Purchase</bpmn:incoming>
      <bpmn:outgoing>Flow_Purchase_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Timer_InviteSLA" name="SLA chuẩn bị của seller (48h)">
      <bpmn:incoming>Flow_Prepare_SLA</bpmn:incoming>
      <bpmn:outgoing>Flow_SLA_Ready</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_InviteSLA">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-08-15T00:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Timer_CampaignEnd" name="Hết thời gian chiến dịch">
      <bpmn:incoming>Flow_Monitor_End</bpmn:incoming>
      <bpmn:outgoing>Flow_End_ML</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CampaignEnd">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2026-08-19T00:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gate_BudgetTier" name="Ngân sách vượt ngưỡng?">
      <bpmn:incoming>Flow_Budget_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Small</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Large</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_QAPass" name="Đạt chuẩn kiểm toán sau chiến dịch?">
      <bpmn:incoming>Flow_QA_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_QA_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gate_Ready" name="Sẵn sàng launch?" gatewayDirection="Converging">
      <bpmn:incoming>Flow_QA_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_SLA_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Launch</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gate_CampaignJoin" name="Đồng bộ kết thúc chiến dịch" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Report_End</bpmn:incoming>
      <bpmn:incoming>Flow_Purchase_End</bpmn:incoming>
      <bpmn:outgoing>Flow_Final_Done</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_CampaignDone" name="Chiến dịch đã hoàn tất">
      <bpmn:incoming>Flow_Final_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Research" sourceRef="StartEvent_Idea" targetRef="Task_Research" />
    <bpmn:sequenceFlow id="Flow_Research_Design" sourceRef="Task_Research" targetRef="Task_DesignConcept" />
    <bpmn:sequenceFlow id="Flow_Design_Budget" sourceRef="Task_DesignConcept" targetRef="Task_AIBudgetAlloc" />
    <bpmn:sequenceFlow id="Flow_Budget_Gate" sourceRef="Task_AIBudgetAlloc" targetRef="Gate_BudgetTier" />
    <bpmn:sequenceFlow id="Flow_Gate_Small" sourceRef="Gate_BudgetTier" targetRef="Join_Task_AIPersonalInvite_1" />
    <bpmn:sequenceFlow id="Flow_Gate_Large" sourceRef="Gate_BudgetTier" targetRef="Task_DirectorApprove" />
    <bpmn:sequenceFlow id="Flow_Director_Invite" sourceRef="Task_DirectorApprove" targetRef="Join_Task_AIPersonalInvite_1" />
    <bpmn:sequenceFlow id="Flow_Invite_Split" sourceRef="Task_AIPersonalInvite" targetRef="Gate_InviteSplit" />
    <bpmn:sequenceFlow id="Flow_Invite_Config" sourceRef="Gate_InviteSplit" targetRef="Join_Task_ConfigTemplate_2" />
    <bpmn:sequenceFlow id="Flow_Invite_Register" sourceRef="Gate_InviteSplit" targetRef="Task_SellerRegister" />
    <bpmn:sequenceFlow id="Flow_Register_Prepare" sourceRef="Task_SellerRegister" targetRef="Task_SellerPrepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_SLA" sourceRef="Task_SellerPrepare" targetRef="Timer_InviteSLA" />
    <bpmn:sequenceFlow id="Flow_SLA_Ready" sourceRef="Timer_InviteSLA" targetRef="Gate_Ready" />
    <bpmn:sequenceFlow id="Flow_Config_QA" sourceRef="Task_ConfigTemplate" targetRef="Task_AutoQA" />
    <bpmn:sequenceFlow id="Flow_QA_Gate" sourceRef="Task_AutoQA" targetRef="Gate_QAPass" />
    <bpmn:sequenceFlow id="Flow_QA_Yes" sourceRef="Gate_QAPass" targetRef="Gate_Ready" />
    <bpmn:sequenceFlow id="Flow_QA_No" sourceRef="Gate_QAPass" targetRef="Join_Task_ConfigTemplate_2" />
    <bpmn:sequenceFlow id="Flow_Ready_Launch" sourceRef="Gate_Ready" targetRef="Task_Launch" />
    <bpmn:sequenceFlow id="Flow_Launch_Split" sourceRef="Task_Launch" targetRef="Gate_LaunchSplit" />
    <bpmn:sequenceFlow id="Flow_Launch_Dashboard" sourceRef="Gate_LaunchSplit" targetRef="Task_ROASDashboard" />
    <bpmn:sequenceFlow id="Flow_Launch_Browse" sourceRef="Gate_LaunchSplit" targetRef="Task_BuyerBrowse" />
    <bpmn:sequenceFlow id="Flow_Dashboard_Monitor" sourceRef="Task_ROASDashboard" targetRef="Task_MonitorLive" />
    <bpmn:sequenceFlow id="Flow_Monitor_End" sourceRef="Task_MonitorLive" targetRef="Timer_CampaignEnd" />
    <bpmn:sequenceFlow id="Flow_End_ML" sourceRef="Timer_CampaignEnd" targetRef="Task_MLInsights" />
    <bpmn:sequenceFlow id="Flow_ML_Report" sourceRef="Task_MLInsights" targetRef="Task_AutoReport" />
    <bpmn:sequenceFlow id="Flow_Report_End" sourceRef="Task_AutoReport" targetRef="Gate_CampaignJoin" />
    <bpmn:sequenceFlow id="Flow_Browse_Purchase" sourceRef="Task_BuyerBrowse" targetRef="Task_BuyerPurchase" />
    <bpmn:sequenceFlow id="Flow_Purchase_End" sourceRef="Task_BuyerPurchase" targetRef="Gate_CampaignJoin" />
    <bpmn:sequenceFlow id="Flow_Final_Done" sourceRef="Gate_CampaignJoin" targetRef="End_CampaignDone" />
    <bpmn:exclusiveGateway id="Join_Task_AIPersonalInvite_1" name="Gom luồng trước khi Cá nhân hóa lời mời seller">
      <bpmn:incoming>Flow_Gate_Small</bpmn:incoming>
      <bpmn:incoming>Flow_Director_Invite</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite" sourceRef="Join_Task_AIPersonalInvite_1" targetRef="Task_AIPersonalInvite" />
    <bpmn:exclusiveGateway id="Join_Task_ConfigTemplate_2" name="Gom luồng trước khi Config campaign tự động từ template">
      <bpmn:incoming>Flow_Invite_Config</bpmn:incoming>
      <bpmn:incoming>Flow_QA_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate" sourceRef="Join_Task_ConfigTemplate_2" targetRef="Task_ConfigTemplate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Marketing"><bpmndi:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing"><dc:Bounds x="30" y="140" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI"><dc:Bounds x="30" y="350" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Approval_di" bpmnElement="Lane_Approval"><dc:Bounds x="30" y="560" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System"><dc:Bounds x="30" y="770" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Seller_di" bpmnElement="Lane_Seller"><dc:Bounds x="30" y="980" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer"><dc:Bounds x="30" y="1190" width="5660" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="StartEvent_Idea_di" bpmnElement="StartEvent_Idea"><dc:Bounds x="212" y="227" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Research_di" bpmnElement="Task_Research"><dc:Bounds x="408" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_DesignConcept_di" bpmnElement="Task_DesignConcept"><dc:Bounds x="648" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_MonitorLive_di" bpmnElement="Task_MonitorLive"><dc:Bounds x="4248" y="209" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AIBudgetAlloc_di" bpmnElement="Task_AIBudgetAlloc"><dc:Bounds x="888" y="419" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_AIPersonalInvite_di" bpmnElement="Task_AIPersonalInvite"><dc:Bounds x="1848" y="419" width="124" height="72" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gate_InviteSplit_di" bpmnElement="Gate_InviteSplit"><dc:Bounds x="2125" y="220" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_MLInsights_di" bpmnElement="Task_MLInsights"><