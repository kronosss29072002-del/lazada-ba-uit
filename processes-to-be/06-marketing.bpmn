<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Marketing_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_Marketing" name="Marketing &amp; Khuyến mãi TO-BE" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Marketing" name="Marketing Team">
        <ns0:flowNodeRef>StartEvent_Idea</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Research</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DesignConcept</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_MonitorLive</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_CampaignEnd</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_AI" name="AI Engine">
        <ns0:flowNodeRef>Task_AIBudgetAlloc</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AIPersonalInvite</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_MLInsights</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AIPersonalInvite_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Approval" name="Approval">
        <ns0:flowNodeRef>Gate_BudgetTier</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DirectorApprove</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System">
        <ns0:flowNodeRef>Task_ConfigTemplate</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoQA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_QAPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Ready</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Launch</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ROASDashboard</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoReport</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_CampaignDone</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ConfigTemplate_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Sellers">
        <ns0:flowNodeRef>Task_SellerRegister</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SellerPrepare</ns0:flowNodeRef>
        <ns0:flowNodeRef>Timer_InviteSLA</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Buyer" name="Buyers">
        <ns0:flowNodeRef>Task_BuyerBrowse</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_BuyerPurchase</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Idea" name="Ý tưởng chiến dịch mới">
      <ns0:outgoing>Flow_Start_Research</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_Research" name="Nghiên cứu thị trường + brief">
      <ns0:incoming>Flow_Start_Research</ns0:incoming>
      <ns0:outgoing>Flow_Research_Design</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_DesignConcept" name="Thiết kế concept + kế hoạch">
      <ns0:incoming>Flow_Research_Design</ns0:incoming>
      <ns0:outgoing>Flow_Design_Budget</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_MonitorLive" name="Giám sát ROAS dashboard real-time">
      <ns0:incoming>Flow_Dashboard_Monitor</ns0:incoming>
      <ns0:outgoing>Flow_Monitor_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_AIBudgetAlloc" name="AI phân bổ ngân sách">
      <ns0:incoming>Flow_Design_Budget</ns0:incoming>
      <ns0:outgoing>Flow_Budget_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AIPersonalInvite" name="Cá nhân hóa lời mời seller">
      <ns0:outgoing>Flow_Invite_Split</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite</ns0:incoming>
    </ns0:serviceTask>
    <ns0:parallelGateway id="Gate_InviteSplit" name="Tách luồng chuẩn bị">
      <ns0:incoming>Flow_Invite_Split</ns0:incoming>
      <ns0:outgoing>Flow_Invite_Config</ns0:outgoing>
      <ns0:outgoing>Flow_Invite_Register</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:serviceTask id="Task_MLInsights" name="Sinh insight ML từ dữ liệu">
      <ns0:incoming>Flow_End_ML</ns0:incoming>
      <ns0:outgoing>Flow_ML_Report</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_DirectorApprove" name="Giám đốc phê duyệt (ngân sách lớn)">
      <ns0:incoming>Flow_Gate_Large</ns0:incoming>
      <ns0:outgoing>Flow_Director_Invite</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ConfigTemplate" name="Config campaign tự động từ template">
      <ns0:outgoing>Flow_Config_QA</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoQA" name="Auto-QA checklist">
      <ns0:incoming>Flow_Config_QA</ns0:incoming>
      <ns0:outgoing>Flow_QA_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_Launch" name="Kích hoạt Chiến dịch 12.12 Siêu Hội Mua Sắm">
      <ns0:incoming>Flow_Ready_Launch</ns0:incoming>
      <ns0:outgoing>Flow_Launch_Split</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:parallelGateway id="Gate_LaunchSplit" name="Tách luồng vận hành &amp; mua sắm">
      <ns0:incoming>Flow_Launch_Split</ns0:incoming>
      <ns0:outgoing>Flow_Launch_Dashboard</ns0:outgoing>
      <ns0:outgoing>Flow_Launch_Browse</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:serviceTask id="Task_ROASDashboard" name="Cập nhật ROAS dashboard real-time">
      <ns0:incoming>Flow_Launch_Dashboard</ns0:incoming>
      <ns0:outgoing>Flow_Dashboard_Monitor</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoReport" name="Auto-report sau chiến dịch + ML insight">
      <ns0:incoming>Flow_ML_Report</ns0:incoming>
      <ns0:outgoing>Flow_Report_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_SellerRegister" name="Seller đăng ký tham gia">
      <ns0:incoming>Flow_Invite_Register</ns0:incoming>
      <ns0:outgoing>Flow_Register_Prepare</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SellerPrepare" name="Seller chuẩn bị sản phẩm + voucher">
      <ns0:incoming>Flow_Register_Prepare</ns0:incoming>
      <ns0:outgoing>Flow_Prepare_SLA</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_BuyerBrowse" name="Buyer xem khuyến mãi">
      <ns0:incoming>Flow_Launch_Browse</ns0:incoming>
      <ns0:outgoing>Flow_Browse_Purchase</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_BuyerPurchase" name="Buyer mua hàng">
      <ns0:incoming>Flow_Browse_Purchase</ns0:incoming>
      <ns0:outgoing>Flow_Purchase_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:intermediateCatchEvent id="Timer_InviteSLA" name="SLA chuẩn bị của seller (48h)">
      <ns0:incoming>Flow_Prepare_SLA</ns0:incoming>
      <ns0:outgoing>Flow_SLA_Ready</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerDef_InviteSLA">
        <ns0:timeDate xsi:type="bpmn:tFormalExpression">2026-08-15T00:00:00Z</ns0:timeDate>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:intermediateCatchEvent id="Timer_CampaignEnd" name="Hết thời gian chiến dịch">
      <ns0:incoming>Flow_Monitor_End</ns0:incoming>
      <ns0:outgoing>Flow_End_ML</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerDef_CampaignEnd">
        <ns0:timeDate xsi:type="bpmn:tFormalExpression">2026-08-19T00:00:00Z</ns0:timeDate>
      </ns0:timerEventDefinition>
    </ns0:intermediateCatchEvent>
    <ns0:exclusiveGateway id="Gate_BudgetTier" name="Ngân sách vượt ngưỡng?">
      <ns0:incoming>Flow_Budget_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Small</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Large</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_QAPass" name="Đạt chuẩn kiểm toán sau chiến dịch?">
      <ns0:incoming>Flow_QA_Gate</ns0:incoming>
      <ns0:outgoing>Flow_QA_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_QA_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:parallelGateway id="Gate_Ready" name="Sẵn sàng launch?" gatewayDirection="Converging">
      <ns0:incoming>Flow_QA_Yes</ns0:incoming>
      <ns0:incoming>Flow_SLA_Ready</ns0:incoming>
      <ns0:outgoing>Flow_Ready_Launch</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:parallelGateway id="Gate_CampaignJoin" name="Đồng bộ kết thúc chiến dịch" gatewayDirection="Converging">
      <ns0:incoming>Flow_Report_End</ns0:incoming>
      <ns0:incoming>Flow_Purchase_End</ns0:incoming>
      <ns0:outgoing>Flow_Final_Done</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:endEvent id="End_CampaignDone" name="Chiến dịch đã hoàn tất">
      <ns0:incoming>Flow_Final_Done</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Research" sourceRef="StartEvent_Idea" targetRef="Task_Research" />
    <ns0:sequenceFlow id="Flow_Research_Design" sourceRef="Task_Research" targetRef="Task_DesignConcept" />
    <ns0:sequenceFlow id="Flow_Design_Budget" sourceRef="Task_DesignConcept" targetRef="Task_AIBudgetAlloc" />
    <ns0:sequenceFlow id="Flow_Budget_Gate" sourceRef="Task_AIBudgetAlloc" targetRef="Gate_BudgetTier" />
    <ns0:sequenceFlow id="Flow_Gate_Small" sourceRef="Gate_BudgetTier" targetRef="Join_Task_AIPersonalInvite_1" name="Trong hạn mức" />
    <ns0:sequenceFlow id="Flow_Gate_Large" sourceRef="Gate_BudgetTier" targetRef="Task_DirectorApprove" name="Vượt hạn mức" />
    <ns0:sequenceFlow id="Flow_Director_Invite" sourceRef="Task_DirectorApprove" targetRef="Join_Task_AIPersonalInvite_1" />
    <ns0:sequenceFlow id="Flow_Invite_Split" sourceRef="Task_AIPersonalInvite" targetRef="Gate_InviteSplit" />
    <ns0:sequenceFlow id="Flow_Invite_Config" sourceRef="Gate_InviteSplit" targetRef="Join_Task_ConfigTemplate_2" name="Cấu hình campaign" />
    <ns0:sequenceFlow id="Flow_Invite_Register" sourceRef="Gate_InviteSplit" targetRef="Task_SellerRegister" name="Seller đăng ký" />
    <ns0:sequenceFlow id="Flow_Register_Prepare" sourceRef="Task_SellerRegister" targetRef="Task_SellerPrepare" />
    <ns0:sequenceFlow id="Flow_Prepare_SLA" sourceRef="Task_SellerPrepare" targetRef="Timer_InviteSLA" />
    <ns0:sequenceFlow id="Flow_SLA_Ready" sourceRef="Timer_InviteSLA" targetRef="Gate_Ready" />
    <ns0:sequenceFlow id="Flow_Config_QA" sourceRef="Task_ConfigTemplate" targetRef="Task_AutoQA" />
    <ns0:sequenceFlow id="Flow_QA_Gate" sourceRef="Task_AutoQA" targetRef="Gate_QAPass" />
    <ns0:sequenceFlow id="Flow_QA_Yes" sourceRef="Gate_QAPass" targetRef="Gate_Ready" name="Đạt chuẩn" />
    <ns0:sequenceFlow id="Flow_QA_No" sourceRef="Gate_QAPass" targetRef="Join_Task_ConfigTemplate_2" name="Chưa đạt chuẩn" />
    <ns0:sequenceFlow id="Flow_Ready_Launch" sourceRef="Gate_Ready" targetRef="Task_Launch" />
    <ns0:sequenceFlow id="Flow_Launch_Split" sourceRef="Task_Launch" targetRef="Gate_LaunchSplit" />
    <ns0:sequenceFlow id="Flow_Launch_Dashboard" sourceRef="Gate_LaunchSplit" targetRef="Task_ROASDashboard" name="Vận hành &amp; theo dõi" />
    <ns0:sequenceFlow id="Flow_Launch_Browse" sourceRef="Gate_LaunchSplit" targetRef="Task_BuyerBrowse" name="Buyer mua sắm" />
    <ns0:sequenceFlow id="Flow_Dashboard_Monitor" sourceRef="Task_ROASDashboard" targetRef="Task_MonitorLive" />
    <ns0:sequenceFlow id="Flow_Monitor_End" sourceRef="Task_MonitorLive" targetRef="Timer_CampaignEnd" />
    <ns0:sequenceFlow id="Flow_End_ML" sourceRef="Timer_CampaignEnd" targetRef="Task_MLInsights" />
    <ns0:sequenceFlow id="Flow_ML_Report" sourceRef="Task_MLInsights" targetRef="Task_AutoReport" />
    <ns0:sequenceFlow id="Flow_Report_End" sourceRef="Task_AutoReport" targetRef="Gate_CampaignJoin" />
    <ns0:sequenceFlow id="Flow_Browse_Purchase" sourceRef="Task_BuyerBrowse" targetRef="Task_BuyerPurchase" />
    <ns0:sequenceFlow id="Flow_Purchase_End" sourceRef="Task_BuyerPurchase" targetRef="Gate_CampaignJoin" />
    <ns0:sequenceFlow id="Flow_Final_Done" sourceRef="Gate_CampaignJoin" targetRef="End_CampaignDone" />
    <ns0:exclusiveGateway id="Join_Task_AIPersonalInvite_1" name="Gom luồng trước khi Cá nhân hóa lời mời seller">
      <ns0:incoming>Flow_Gate_Small</ns0:incoming>
      <ns0:incoming>Flow_Director_Invite</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AIPersonalInvite_1_to_Task_AIPersonalInvite" sourceRef="Join_Task_AIPersonalInvite_1" targetRef="Task_AIPersonalInvite" />
    <ns0:exclusiveGateway id="Join_Task_ConfigTemplate_2" name="Gom luồng trước khi Config campaign tự động từ template">
      <ns0:incoming>Flow_Invite_Config</ns0:incoming>
      <ns0:incoming>Flow_QA_No</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ConfigTemplate_2_to_Task_ConfigTemplate" sourceRef="Join_Task_ConfigTemplate_2" targetRef="Task_ConfigTemplate" />
  </ns0:process>
  <ns2:BPMNDiagram id="BPMNDiagram_1">
    <ns2:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Marketing"><ns2:BPMNShape id="Lane_Marketing_di" bpmnElement="Lane_Marketing"><ns3:Bounds x="30" y="140" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI"><ns3:Bounds x="30" y="350" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_Approval_di" bpmnElement="Lane_Approval"><ns3:Bounds x="30" y="560" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_System_di" bpmnElement="Lane_System"><ns3:Bounds x="30" y="770" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_Seller_di" bpmnElement="Lane_Seller"><ns3:Bounds x="30" y="980" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer"><ns3:Bounds x="30" y="1190" width="5660" height="210" /></ns2:BPMNShape><ns2:BPMNShape id="StartEvent_Idea_di" bpmnElement="StartEvent_Idea"><ns3:Bounds x="212" y="227" width="36" height="36" /></ns2:BPMNShape><ns2:BPMNShape id="Task_Research_di" bpmnElement="Task_Research"><ns3:Bounds x="408" y="209" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_DesignConcept_di" bpmnElement="Task_DesignConcept"><ns3:Bounds x="648" y="209" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_MonitorLive_di" bpmnElement="Task_MonitorLive"><ns3:Bounds x="4248" y="209" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_AIBudgetAlloc_di" bpmnElement="Task_AIBudgetAlloc"><ns3:Bounds x="888" y="419" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Task_AIPersonalInvite_di" bpmnElement="Task_AIPersonalInvite"><ns3:Bounds x="1848" y="419" width="124" height="72" /></ns2:BPMNShape><ns2:BPMNShape id="Gate_InviteSplit_di" bpmnElement="Gate_InviteSplit"><ns3:Bounds x="2125" y="220" width="50" height="50" /></ns2:BPMNShape><ns2:BPMNShape id="Task_MLInsights_di" bpmnElement="Task_MLInsights"><ns3:Bounds x="4728" y="419" width="124" height="72" /></ns2:BPMNShape><