<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomerService" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_CustomerService" name="Quy trình Chăm sóc Khách hàng" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Customer" name="Customer">
        <ns0:flowNodeRef>StartEvent_Contact</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DescribeIssue</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ProvideInfo</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmResolved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Feedback</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_WaitResponse</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_CSAT</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ConfirmResolved_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Chatbot" name="Chatbot/AI">
        <ns0:flowNodeRef>Task_ClassifyIntent</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoResolve</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CheckSLA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BotCanHandle</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BotSuccess</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SLAValid</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Tier1" name="CS Tier 1">
        <ns0:flowNodeRef>Task_T1VerifyIdentity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_T1Review</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_T1Resolve</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_VerifyOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_RepeatContact</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_T1Resolved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Timeout</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_QualityFollowUp</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_T1Review_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Tier2" name="CS Tier 2">
        <ns0:flowNodeRef>Task_T2Review</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_T2Resolve</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="System">
        <ns0:flowNodeRef>Task_CheckContextHistory</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FetchContext</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LogSession</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SendReminder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_LogSession_3</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Contact" name="Yêu cầu hỗ trợ từ khách hàng">
      <ns0:outgoing>Flow_Start_Describe</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_DescribeIssue" name="Mô tả chi tiết vấn đề cần hỗ trợ">
      <ns0:incoming>Flow_Start_Describe</ns0:incoming>
      <ns0:outgoing>Flow_Describe_Context</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ProvideInfo" name="Cung cấp thêm thông tin chứng từ">
      <ns0:incoming>Flow_T1_ProvideInfo</ns0:incoming>
      <ns0:outgoing>Flow_Provide_Wait</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ConfirmResolved" name="Khách hàng bấm xác nhận hoàn tất hỗ trợ">
      <ns0:outgoing>Flow_Confirm_Feedback</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved</ns0:incoming>
    </ns0:userTask>
    <ns0:userTask id="Task_Feedback" name="Khách hàng chấm điểm khảo sát CSAT">
      <ns0:incoming>Flow_Confirm_Feedback</ns0:incoming>
      <ns0:outgoing>Flow_Feedback_CSAT</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_WaitResponse" name="Chờ phản hồi từ tư vấn viên">
      <ns0:incoming>Flow_Provide_Wait</ns0:incoming>
      <ns0:outgoing>Flow_Wait_Timeout</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ClassifyIntent" name="AI NLP phân loại ý định &amp; mức độ khẩn cấp">
      <ns0:incoming>Flow_Describe_Context</ns0:incoming>
      <ns0:outgoing>Flow_Classify_SLA</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoResolve" name="Chatbot (Lazada Assistant) tự động giải đáp">
      <ns0:incoming>Flow_Gate_BotYes</ns0:incoming>
      <ns0:outgoing>Flow_BotResolve_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_CheckSLA" name="Hệ thống kiểm tra SLA xử lý ticket">
      <ns0:incoming>Flow_Classify_SLA</ns0:incoming>
      <ns0:outgoing>Flow_SLA_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_T1VerifyIdentity" name="Xác minh danh tính khách hàng">
      <ns0:incoming>Flow_Gate_BotNo</ns0:incoming>
      <ns0:outgoing>Flow_Verify_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_T1Review" name="Tư vấn viên Tier 1 tiếp nhận &amp; hỗ trợ">
      <ns0:outgoing>Flow_T1_Resolve</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_T1Review_2_to_Task_T1Review</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_RepeatContact" name="Khách liên hệ lại lần 2?">
      <ns0:incoming>Flow_Verify_Pass</ns0:incoming>
      <ns0:outgoing>Flow_Repeat_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Repeat_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_CheckContextHistory" name="Lấy lịch sử tương tác (auto)">
      <ns0:incoming>Flow_Repeat_No</ns0:incoming>
      <ns0:outgoing>Flow_History_T1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_T1Resolve" name="Tư vấn viên Tier 1 đưa giải pháp xử lý">
      <ns0:incoming>Flow_T1_Resolve</ns0:incoming>
      <ns0:outgoing>Flow_T1_Resolve_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_T2Review" name="Chuyên viên Tier 2 thẩm định chuyên sâu">
      <ns0:incoming>Flow_T1_Escalate</ns0:incoming>
      <ns0:outgoing>Flow_T2_Resolve</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_T2Resolve" name="Chuyên viên Tier 2 xử lý dứt điểm">
      <ns0:incoming>Flow_T2_Resolve</ns0:incoming>
      <ns0:outgoing>Flow_T2_Resolve_Confirm</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_FetchContext" name="Hệ thống trích xuất thông tin đơn &amp; tài khoản">
      <ns0:incoming>Flow_SLA_Valid</ns0:incoming>
      <ns0:outgoing>Flow_Fetch_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LogSession" name="Ghi nhận nhật ký phiên &amp; điểm CSAT">
      <ns0:outgoing>Flow_Log_End</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_LogSession_3_to_Task_LogSession</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_SendReminder" name="Gửi nhắc nhở phản hồi cho khách hàng">
      <ns0:incoming>Flow_Timeout_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Reminder_T1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_BotSuccess" name="Chatbot giải quyết thành công?">
      <ns0:incoming>Flow_BotResolve_Gate</ns0:incoming>
      <ns0:outgoing>Flow_BotSuccess_Confirm</ns0:outgoing>
      <ns0:outgoing>Flow_BotSuccess_T1</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SLAValid" name="SLA còn thời hạn xử lý?">
      <ns0:incoming>Flow_SLA_Gate</ns0:incoming>
      <ns0:outgoing>Flow_SLA_Valid</ns0:outgoing>
      <ns0:outgoing>Flow_SLA_Expired</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_VerifyOK" name="Xác minh danh tính thành công?">
      <ns0:incoming>Flow_Verify_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Verify_Pass</ns0:outgoing>
      <ns0:outgoing>Flow_Verify_Fail</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_BotCanHandle" name="Chatbot có sẵn kịch bản trả lời?">
      <ns0:incoming>Flow_Fetch_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_BotYes</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_BotNo</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_T1Resolved" name="Tier 1 giải quyết thành công?">
      <ns0:incoming>Flow_T1_Resolve_Gate</ns0:incoming>
      <ns0:outgoing>Flow_T1_Resolve_Confirm</ns0:outgoing>
      <ns0:outgoing>Flow_T1_Escalate</ns0:outgoing>
      <ns0:outgoing>Flow_T1_ProvideInfo</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_Timeout" name="Quá thời gian chờ phản hồi?">
      <ns0:incoming>Flow_Wait_Timeout</ns0:incoming>
      <ns0:outgoing>Flow_Timeout_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Timeout_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_CSAT" name="Đánh giá CSAT ≥ 4 sao?">
      <ns0:incoming>Flow_Feedback_CSAT</ns0:incoming>
      <ns0:outgoing>Flow_CSAT_Good</ns0:outgoing>
      <ns0:outgoing>Flow_CSAT_Bad</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_QualityFollowUp" name="Khảo sát đánh giá chất lượng (QA Follow-up)">
      <ns0:incoming>Flow_CSAT_Bad</ns0:incoming>
      <ns0:outgoing>Flow_Quality_Log</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="End_Resolved" name="Phiên hỗ trợ đã kết thúc thành công">
      <ns0:incoming>Flow_Log_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_SLAExpired" name="Ticket hỗ trợ đã quá hạn SLA">
      <ns0:incoming>Flow_SLA_Expired</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_VerifyFail" name="Xác minh danh tính đã thất bại">
      <ns0:incoming>Flow_Verify_Fail</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Describe" sourceRef="StartEvent_Contact" targetRef="Task_DescribeIssue" />
    <ns0:sequenceFlow id="Flow_Describe_Context" sourceRef="Task_DescribeIssue" targetRef="Task_ClassifyIntent" />
    <ns0:sequenceFlow id="Flow_Classify_SLA" sourceRef="Task_ClassifyIntent" targetRef="Task_CheckSLA" />
    <ns0:sequenceFlow id="Flow_SLA_Gate" sourceRef="Task_CheckSLA" targetRef="Gate_SLAValid" />
    <ns0:sequenceFlow id="Flow_SLA_Valid" sourceRef="Gate_SLAValid" targetRef="Task_FetchContext" name="Còn hạn SLA" />
    <ns0:sequenceFlow id="Flow_SLA_Expired" sourceRef="Gate_SLAValid" targetRef="End_SLAExpired" name="Quá hạn SLA" />
    <ns0:sequenceFlow id="Flow_Fetch_Gate" sourceRef="Task_FetchContext" targetRef="Gate_BotCanHandle" />
    <ns0:sequenceFlow id="Flow_Gate_BotYes" sourceRef="Gate_BotCanHandle" targetRef="Task_AutoResolve" name="Bot có kịch bản" />
    <ns0:sequenceFlow id="Flow_Gate_BotNo" sourceRef="Gate_BotCanHandle" targetRef="Task_T1VerifyIdentity" name="Bot không xử lý được" />
    <ns0:sequenceFlow id="Flow_BotResolve_Gate" sourceRef="Task_AutoResolve" targetRef="Gate_BotSuccess" />
    <ns0:sequenceFlow id="Flow_BotSuccess_Confirm" sourceRef="Gate_BotSuccess" targetRef="Join_Task_ConfirmResolved_1" name="Bot giải quyết xong" />
    <ns0:sequenceFlow id="Flow_BotSuccess_T1" sourceRef="Gate_BotSuccess" targetRef="Join_Task_T1Review_2" name="Chuyển Tier 1" />
    <ns0:sequenceFlow id="Flow_Verify_Gate" sourceRef="Task_T1VerifyIdentity" targetRef="Gate_VerifyOK" />
    <ns0:sequenceFlow id="Flow_Verify_Pass" sourceRef="Gate_VerifyOK" targetRef="Gate_RepeatContact" name="Xác minh thành công" />
    <ns0:sequenceFlow id="Flow_Verify_Fail" sourceRef="Gate_VerifyOK" targetRef="End_VerifyFail" name="Xác minh thất bại" />
    <ns0:sequenceFlow id="Flow_Repeat_Yes" sourceRef="Gate_RepeatContact" targetRef="Join_Task_T1Review_2" name="Khách liên hệ lại" />
    <ns0:sequenceFlow id="Flow_Repeat_No" sourceRef="Gate_RepeatContact" targetRef="Task_CheckContextHistory" name="Không liên hệ lại" />
    <ns0:sequenceFlow id="Flow_History_T1" sourceRef="Task_CheckContextHistory" targetRef="Join_Task_T1Review_2" />
    <ns0:sequenceFlow id="Flow_T1_Resolve" sourceRef="Task_T1Review" targetRef="Task_T1Resolve" />
    <ns0:sequenceFlow id="Flow_T1_Resolve_Gate" sourceRef="Task_T1Resolve" targetRef="Gate_T1Resolved" />
    <ns0:sequenceFlow id="Flow_T1_Resolve_Confirm" sourceRef="Gate_T1Resolved" targetRef="Join_Task_ConfirmResolved_1" name="Tier 1 giải quyết xong" />
    <ns0:sequenceFlow id="Flow_T1_Escalate" sourceRef="Gate_T1Resolved" targetRef="Task_T2Review" name="Escalate Tier 2" />
    <ns0:sequenceFlow id="Flow_T1_ProvideInfo" sourceRef="Gate_T1Resolved" targetRef="Task_ProvideInfo" name="Cần thêm thông tin" />
    <ns0:sequenceFlow id="Flow_Provide_Wait" sourceRef="Task_ProvideInfo" targetRef="Task_WaitResponse" />
    <ns0:sequenceFlow id="Flow_Wait_Timeout" sourceRef="Task_WaitResponse" targetRef="Gate_Timeout" />
    <ns0:sequenceFlow id="Flow_Timeout_Yes" sourceRef="Gate_Timeout" targetRef="Task_SendReminder" name="Quá thời gian chờ" />
    <ns0:sequenceFlow id="Flow_Timeout_No" sourceRef="Gate_Timeout" targetRef="Join_Task_T1Review_2" name="Còn thời gian chờ" />
    <ns0:sequenceFlow id="Flow_Reminder_T1" sourceRef="Task_SendReminder" targetRef="Join_Task_T1Review_2" />
    <ns0:sequenceFlow id="Flow_T2_Resolve" sourceRef="Task_T2Review" targetRef="Task_T2Resolve" />
    <ns0:sequenceFlow id="Flow_T2_Resolve_Confirm" sourceRef="Task_T2Resolve" targetRef="Join_Task_ConfirmResolved_1" />
    <ns0:sequenceFlow id="Flow_Confirm_Feedback" sourceRef="Task_ConfirmResolved" targetRef="Task_Feedback" />
    <ns0:sequenceFlow id="Flow_Feedback_CSAT" sourceRef="Task_Feedback" targetRef="Gate_CSAT" />
    <ns0:sequenceFlow id="Flow_CSAT_Good" sourceRef="Gate_CSAT" targetRef="Join_Task_LogSession_3" name="CSAT ≥ 4 sao" />
    <ns0:sequenceFlow id="Flow_CSAT_Bad" sourceRef="Gate_CSAT" targetRef="Task_QualityFollowUp" name="CSAT &lt; 4 sao" />
    <ns0:sequenceFlow id="Flow_Quality_Log" sourceRef="Task_QualityFollowUp" targetRef="Join_Task_LogSession_3" />
    <ns0:sequenceFlow id="Flow_Log_End" sourceRef="Task_LogSession" targetRef="End_Resolved" />
    <ns0:exclusiveGateway id="Join_Task_ConfirmResolved_1" name="Gom luồng trước khi Khách hàng bấm xác nhận hoàn tất hỗ trợ">
      <ns0:incoming>Flow_BotSuccess_Confirm</ns0:incoming>
      <ns0:incoming>Flow_T1_Resolve_Confirm</ns0:incoming>
      <ns0:incoming>Flow_T2_Resolve_Confirm</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ConfirmResolved_1_to_Task_ConfirmResolved" sourceRef="Join_Task_ConfirmResolved_1" targetRef="Task_ConfirmResolved" />
    <ns0:exclusiveGateway id="Join_Task_T1Review_2" name="Gom luồng trước khi Tư vấn viên Tier 1 tiếp nhận &amp; hỗ trợ">
      <ns0:incoming>Flow_BotSuccess_T1</ns0:incoming>
      <ns0:incoming>Flow_Repeat_Yes</ns0:incoming>
      <ns0:incoming>Flow_History_T1</ns0:incoming>
      <ns0:incoming>Flow_Timeout_No</ns0:incoming>
      <ns0:incoming>Flow_Reminder_T1</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_T1Review_2_to_Task_T1Review</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_T1Review_2_to_Task_T1Review" sourceRef="Join_Task_T1Review_2" targetRef="Task_T1Review" />
    <ns0:exclusiveGateway id="Join_Task_LogSession_3" name="Gom luồng trước khi Ghi nhận nhật ký phiên &amp; điểm CSAT">
      <ns0:incoming>Flow_CSAT_Good</ns0:incoming>
      <ns0:incoming>Flow_Quality_Log</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_LogSession_3_to_Task_LogSession</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_LogSession_3_to_Task_LogSession" sourceRef="Join_Task_LogSession_3" targetRef="Task_LogSession" />
  </ns0:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
