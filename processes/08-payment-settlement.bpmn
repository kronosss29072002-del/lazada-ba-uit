<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentSettlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_PaymentSettlement" name="Quy trình Thanh toán &amp; Đối soát" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Checkout</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ChooseMethod</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Method</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PayCOD</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmOnline</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveRefund</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_PaymentGW" name="Payment Gateway (VNPay/MoMo/ZaloPay)">
        <ns0:flowNodeRef>Task_ProcessPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_VerifyPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PaymentApproved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CheckIPN</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Escrow)">
        <ns0:flowNodeRef>Task_HoldEscrow</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_MatchOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_OrderCompleted</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReleaseFunds</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReconcileCOD</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReconcileDaily</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DiscrepancyFound</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CalculateCommission</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UpdateWallet</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Finance" name="Finance">
        <ns0:flowNodeRef>Task_HandleDiscrepancy</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DiscrepancyResolved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmStatement</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AdjustStatement</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_IssueInvoice</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_CheckWallet</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Withdraw</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BankReceived</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Checkout" name="Thanh toán đơn hàng">
      <ns0:outgoing>Flow_S1_Choose</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_ChooseMethod" name="Chọn phương thức thanh toán (COD/Online/Ví)">
      <ns0:incoming>Flow_S1_Choose</ns0:incoming>
      <ns0:outgoing>Flow_Choose_GateMethod</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PayCOD" name="Thanh toán COD khi nhận hàng">
      <ns0:incoming>Flow_MethodCOD_Pay</ns0:incoming>
      <ns0:outgoing>Flow_COD_Receive</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ConfirmOnline" name="Xác nhận thanh toán online qua cổng">
      <ns0:incoming>Flow_Join_Task_ConfirmOnline_in</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Process</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReceiveGoods" name="Buyer nhận hàng &amp; hoàn tất đơn">
      <ns0:incoming>Flow_COD_Receive</ns0:incoming>
      <ns0:outgoing>Flow_Receive_Reconcile</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReceiveRefund" name="Buyer nhận hoàn tiền khi hủy/hoàn trả">
      <ns0:incoming>Flow_Refund_Back</ns0:incoming>
      <ns0:outgoing>Flow_Refund_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ProcessPayment" name="Cổng thanh toán xử lý giao dịch">
      <ns0:incoming>Flow_Confirm_Process</ns0:incoming>
      <ns0:outgoing>Flow_Process_GatePay</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_PaymentApproved" name="Giao dịch thanh toán thành công?">
      <ns0:incoming>Flow_Process_GatePay</ns0:incoming>
      <ns0:outgoing>Flow_PayYes_Verify</ns0:outgoing>
      <ns0:outgoing>Flow_PayNo_Retry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_VerifyPayment" name="Xác minh chữ ký &amp; tính hợp lệ giao dịch">
      <ns0:incoming>Flow_PayYes_Verify</ns0:incoming>
      <ns0:outgoing>Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyResult" name="Gửi kết quả thanh toán về hệ thống">
      <ns0:incoming>Flow_ValidYes_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Notify_Hold</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_CheckIPN" name="Kiểm tra IPN/Webhook đối soát giao dịch">
      <ns0:incoming>Flow_Verify_GateIPN</ns0:incoming>
      <ns0:outgoing>Flow_IPN_Match</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_HoldEscrow" name="Hệ thống giữ tiền tạm thời trong Escrow">
      <ns0:incoming>Flow_Join_Task_HoldEscrow_in</ns0:incoming>
      <ns0:outgoing>Flow_Hold_Match</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_MatchOrder" name="Đối chiếu giao dịch với mã đơn hàng">
      <ns0:incoming>Flow_Join_Task_MatchOrder_in</ns0:incoming>
      <ns0:outgoing>Flow_Match_Complete</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_OrderCompleted" name="Đơn hàng hoàn tất giao dịch?">
      <ns0:incoming>Flow_Match_Complete</ns0:incoming>
      <ns0:outgoing>Flow_Completed_Release</ns0:outgoing>
      <ns0:outgoing>Flow_NotCompleted_Return</ns0:outgoing>
      <ns0:outgoing>Flow_Refund_Back</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_ReleaseFunds" name="Giải ngân tiền cho Seller (L+2 ngày)">
      <ns0:incoming>Flow_Completed_Release</ns0:incoming>
      <ns0:outgoing>Flow_Release_Commission</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ReconcileCOD" name="Đối soát COD với 3PL thu hộ">
      <ns0:incoming>Flow_Receive_Reconcile</ns0:incoming>
      <ns0:outgoing>Flow_COD_ReconcileDaily</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ReconcileDaily" name="Tổng hợp đối soát dòng tiền cuối ngày">
      <ns0:incoming>Flow_COD_ReconcileDaily</ns0:incoming>
      <ns0:outgoing>Flow_Reconcile_GateDisc</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_DiscrepancyFound" name="Phát hiện lệch dòng tiền?">
      <ns0:incoming>Flow_Reconcile_GateDisc</ns0:incoming>
      <ns0:outgoing>Flow_DiscYes_Handle</ns0:outgoing>
      <ns0:outgoing>Flow_DiscNo_Statement</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_CalculateCommission" name="Tính hoa hồng Lazada (1-8% theo danh mục)">
      <ns0:incoming>Flow_Release_Commission</ns0:incoming>
      <ns0:outgoing>Flow_Commission_Wallet</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_UpdateWallet" name="Cập nhật số dư Ví Seller">
      <ns0:incoming>Flow_Commission_Wallet</ns0:incoming>
      <ns0:outgoing>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_HandleDiscrepancy" name="Phòng Tài chính xử lý lệch dòng tiền">
      <ns0:incoming>Flow_Join_Task_HandleDiscrepancy_in</ns0:incoming>
      <ns0:outgoing>Flow_Handle_GateResolved</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_DiscrepancyResolved" name="Lệch dòng tiền đã xử lý xong?">
      <ns0:incoming>Flow_Handle_GateResolved</ns0:incoming>
      <ns0:outgoing>Flow_Resolved_Adjust</ns0:outgoing>
      <ns0:outgoing>Flow_NotResolved_Reopen</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ConfirmStatement" name="Xác nhận bảng đối soát cuối kỳ">
      <ns0:incoming>Flow_Join_Task_ConfirmStatement_in</ns0:incoming>
      <ns0:outgoing>Flow_Statement_Invoice</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_AdjustStatement" name="Điều chỉnh số liệu sai lệch trên bảng kê">
      <ns0:incoming>Flow_Resolved_Adjust</ns0:incoming>
      <ns0:outgoing>Flow_Adjust_Statement</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_IssueInvoice" name="Xuất hóa đơn &amp; báo cáo tài chính">
      <ns0:incoming>Flow_Join_Task_IssueInvoice_in</ns0:incoming>
      <ns0:outgoing>Flow_Invoice_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_CheckWallet" name="Seller kiểm tra số dư Ví trên Seller Centre">
      <ns0:incoming>Flow_Wallet_Check</ns0:incoming>
      <ns0:outgoing>Flow_Check_Withdraw</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Withdraw" name="Seller yêu cầu rút tiền về tài khoản ngân hàng">
      <ns0:incoming>Flow_Join_Task_Withdraw_in</ns0:incoming>
      <ns0:outgoing>Flow_Withdraw_GateBank</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_BankReceived" name="Tiền về tài khoản ngân hàng thành công?">
      <ns0:incoming>Flow_Withdraw_GateBank</ns0:incoming>
      <ns0:outgoing>Flow_BankYes_End</ns0:outgoing>
      <ns0:outgoing>Flow_BankNo_Retry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_Method" name="Chọn phương thức thanh toán?">
      <ns0:incoming>Flow_Choose_GateMethod</ns0:incoming>
      <ns0:outgoing>Flow_MethodCOD_Pay</ns0:outgoing>
      <ns0:outgoing>Flow_MethodOnline_Confirm</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_Valid" name="Giao dịch hợp lệ (chữ ký đúng)?">
      <ns0:incoming>Flow_Verify_GateValid</ns0:incoming>
      <ns0:outgoing>Flow_ValidYes_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_ValidNo_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_S1_Choose" sourceRef="StartEvent_Checkout" targetRef="Task_ChooseMethod" />
    <ns0:sequenceFlow id="Flow_Choose_GateMethod" sourceRef="Task_ChooseMethod" targetRef="Gate_Method" />
    <ns0:sequenceFlow id="Flow_MethodCOD_Pay" name="COD" sourceRef="Gate_Method" targetRef="Task_PayCOD" />
    <ns0:sequenceFlow id="Flow_MethodOnline_Confirm" name="Thanh toán online" sourceRef="Gate_Method" targetRef="Join_Task_ConfirmOnline_1" />
    <ns0:sequenceFlow id="Flow_COD_Receive" sourceRef="Task_PayCOD" targetRef="Task_ReceiveGoods" />
    <ns0:sequenceFlow id="Flow_Receive_Reconcile" sourceRef="Task_ReceiveGoods" targetRef="Task_ReconcileCOD" />
    <ns0:sequenceFlow id="Flow_Confirm_Process" sourceRef="Task_ConfirmOnline" targetRef="Task_ProcessPayment" />
    <ns0:sequenceFlow id="Flow_Process_GatePay" sourceRef="Task_ProcessPayment" targetRef="Gate_PaymentApproved" />
    <ns0:sequenceFlow id="Flow_PayYes_Verify" name="Thành công" sourceRef="Gate_PaymentApproved" targetRef="Task_VerifyPayment" />
    <ns0:sequenceFlow id="Flow_PayNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_PaymentApproved" targetRef="Join_Task_ConfirmOnline_1" />
    <ns0:sequenceFlow id="Flow_Verify_GateValid" sourceRef="Split_Task_VerifyPayment_1" targetRef="Gate_Valid" name="Giao dịch hợp lệ" />
    <ns0:sequenceFlow id="Flow_ValidYes_Notify" name="Hợp lệ" sourceRef="Gate_Valid" targetRef="Task_NotifyResult" />
    <ns0:sequenceFlow id="Flow_ValidNo_Reject" name="Không hợp lệ — từ chối" sourceRef="Gate_Valid" targetRef="Join_Task_ConfirmOnline_1" />
    <ns0:sequenceFlow id="Flow_Notify_Hold" sourceRef="Task_NotifyResult" targetRef="Join_Task_HoldEscrow_1" />
    <ns0:sequenceFlow id="Flow_Verify_GateIPN" sourceRef="Split_Task_VerifyPayment_1" targetRef="Task_CheckIPN" name="Đối soát IPN/Webhook" />
    <ns0:sequenceFlow id="Flow_IPN_Match" sourceRef="Task_CheckIPN" targetRef="Join_Task_MatchOrder_1" />
    <ns0:sequenceFlow id="Flow_Hold_Match" sourceRef="Task_HoldEscrow" targetRef="Join_Task_MatchOrder_1" />
    <ns0:sequenceFlow id="Flow_Match_Complete" sourceRef="Task_MatchOrder" targetRef="Gate_OrderCompleted" />
    <ns0:sequenceFlow id="Flow_Completed_Release" name="Hoàn tất" sourceRef="Gate_OrderCompleted" targetRef="Task_ReleaseFunds" />
    <ns0:sequenceFlow id="Flow_NotCompleted_Return" name="Chưa hoàn tất — giữ tiền" sourceRef="Gate_OrderCompleted" targetRef="Join_Task_HoldEscrow_1" />
    <ns0:sequenceFlow id="Flow_Release_Commission" sourceRef="Task_ReleaseFunds" targetRef="Task_CalculateCommission" />
    <ns0:sequenceFlow id="Flow_Commission_Wallet" sourceRef="Task_CalculateCommission" targetRef="Task_UpdateWallet" />
    <ns0:sequenceFlow id="Flow_Wallet_Invoice" sourceRef="Split_Task_UpdateWallet_1" targetRef="Join_Task_IssueInvoice_1" name="Xuất hóa đơn" />
    <ns0:sequenceFlow id="Flow_Wallet_Check" sourceRef="Split_Task_UpdateWallet_1" targetRef="Task_CheckWallet" name="Seller kiểm tra Ví" />
    <ns0:sequenceFlow id="Flow_Check_Withdraw" sourceRef="Task_CheckWallet" targetRef="Join_Task_Withdraw_1" />
    <ns0:sequenceFlow id="Flow_Withdraw_GateBank" sourceRef="Task_Withdraw" targetRef="Gate_BankReceived" />
    <ns0:sequenceFlow id="Flow_BankYes_End" name="Nhận được tiền" sourceRef="Gate_BankReceived" targetRef="EndEvent_Paid" />
    <ns0:sequenceFlow id="Flow_BankNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_BankReceived" targetRef="Join_Task_Withdraw_1" />
    <ns0:sequenceFlow id="Flow_COD_ReconcileDaily" sourceRef="Task_ReconcileCOD" targetRef="Task_ReconcileDaily" />
    <ns0:sequenceFlow id="Flow_Reconcile_GateDisc" sourceRef="Task_ReconcileDaily" targetRef="Gate_DiscrepancyFound" />
    <ns0:sequenceFlow id="Flow_DiscYes_Handle" name="Có lệch" sourceRef="Gate_DiscrepancyFound" targetRef="Join_Task_HandleDiscrepancy_1" />
    <ns0:sequenceFlow id="Flow_DiscNo_Statement" name="Khớp" sourceRef="Gate_DiscrepancyFound" targetRef="Join_Task_ConfirmStatement_1" />
    <ns0:sequenceFlow id="Flow_Handle_GateResolved" sourceRef="Task_HandleDiscrepancy" targetRef="Gate_DiscrepancyResolved" />
    <ns0:sequenceFlow id="Flow_Resolved_Adjust" name="Xử lý xong" sourceRef="Gate_DiscrepancyResolved" targetRef="Task_AdjustStatement" />
    <ns0:sequenceFlow id="Flow_NotResolved_Reopen" name="Chưa xong — xử lý tiếp" sourceRef="Gate_DiscrepancyResolved" targetRef="Join_Task_HandleDiscrepancy_1" />
    <ns0:sequenceFlow id="Flow_Adjust_Statement" sourceRef="Task_AdjustStatement" targetRef="Join_Task_ConfirmStatement_1" />
    <ns0:sequenceFlow id="Flow_Statement_Invoice" sourceRef="Task_ConfirmStatement" targetRef="Join_Task_IssueInvoice_1" />
    <ns0:sequenceFlow id="Flow_Invoice_End" sourceRef="Task_IssueInvoice" targetRef="EndEvent_Settled" />
    <ns0:sequenceFlow id="Flow_Refund_Back" sourceRef="Gate_OrderCompleted" targetRef="Task_ReceiveRefund" name="Hoàn tiền cho Buyer" />
    <ns0:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ReceiveRefund" targetRef="EndEvent_Refunded" />
    <ns0:sequenceFlow id="Flow_Join_Task_ConfirmOnline_in" sourceRef="Join_Task_ConfirmOnline_1" targetRef="Task_ConfirmOnline" />
    <ns0:sequenceFlow id="Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1" sourceRef="Task_VerifyPayment" targetRef="Split_Task_VerifyPayment_1" />
    <ns0:sequenceFlow id="Flow_Join_Task_HoldEscrow_in" sourceRef="Join_Task_HoldEscrow_1" targetRef="Task_HoldEscrow" />
    <ns0:sequenceFlow id="Flow_Join_Task_MatchOrder_in" sourceRef="Join_Task_MatchOrder_1" targetRef="Task_MatchOrder" />
    <ns0:sequenceFlow id="Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1" sourceRef="Task_UpdateWallet" targetRef="Split_Task_UpdateWallet_1" />
    <ns0:sequenceFlow id="Flow_Join_Task_HandleDiscrepancy_in" sourceRef="Join_Task_HandleDiscrepancy_1" targetRef="Task_HandleDiscrepancy" />
    <ns0:sequenceFlow id="Flow_Join_Task_ConfirmStatement_in" sourceRef="Join_Task_ConfirmStatement_1" targetRef="Task_ConfirmStatement" />
    <ns0:sequenceFlow id="Flow_Join_Task_IssueInvoice_in" sourceRef="Join_Task_IssueInvoice_1" targetRef="Task_IssueInvoice" />
    <ns0:sequenceFlow id="Flow_Join_Task_Withdraw_in" sourceRef="Join_Task_Withdraw_1" targetRef="Task_Withdraw" />
    <ns0:endEvent id="EndEvent_Paid" name="Seller đã nhận tiền thanh toán">
      <ns0:incoming>Flow_BankYes_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EndEvent_Settled" name="Đối soát đã hoàn tất">
      <ns0:incoming>Flow_Invoice_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EndEvent_Refunded" name="Đã hoàn tiền về Buyer">
      <ns0:incoming>Flow_Refund_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:exclusiveGateway id="Join_Task_ConfirmOnline_1" name="Gom luồn trước khi Xác nhận online">
      <ns0:incoming>Flow_MethodOnline_Confirm</ns0:incoming>
      <ns0:incoming>Flow_PayNo_Retry</ns0:incoming>
      <ns0:incoming>Flow_ValidNo_Reject</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ConfirmOnline_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:parallelGateway id="Split_Task_VerifyPayment_1" name="Phân luồn sau khi Xác minh">
      <ns0:incoming>Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1</ns0:incoming>
      <ns0:outgoing>Flow_Verify_GateValid</ns0:outgoing>
      <ns0:outgoing>Flow_Verify_GateIPN</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:exclusiveGateway id="Join_Task_HoldEscrow_1" name="Gom luồn trước khi giữ Escrow">
      <ns0:incoming>Flow_Notify_Hold</ns0:incoming>
      <ns0:incoming>Flow_NotCompleted_Return</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_HoldEscrow_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_MatchOrder_1" name="Gom luồn trước khi Đối chiếu">
      <ns0:incoming>Flow_IPN_Match</ns0:incoming>
      <ns0:incoming>Flow_Hold_Match</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_MatchOrder_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:parallelGateway id="Split_Task_UpdateWallet_1" name="Phân luồn sau khi Cập nhật Ví">
      <ns0:incoming>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</ns0:incoming>
      <ns0:outgoing>Flow_Wallet_Invoice</ns0:outgoing>
      <ns0:outgoing>Flow_Wallet_Check</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:exclusiveGateway id="Join_Task_HandleDiscrepancy_1" name="Gom luồn trước khi Xử lý lệch dòng tiền">
      <ns0:incoming>Flow_DiscYes_Handle</ns0:incoming>
      <ns0:incoming>Flow_NotResolved_Reopen</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_HandleDiscrepancy_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_ConfirmStatement_1" name="Gom luồn trước khi Xác nhận bảng đối soát">
      <ns0:incoming>Flow_DiscNo_Statement</ns0:incoming>
      <ns0:incoming>Flow_Adjust_Statement</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ConfirmStatement_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_IssueInvoice_1" name="Gom luồn trước khi Xuất hóa đơn">
      <ns0:incoming>Flow_Wallet_Invoice</ns0:incoming>
      <ns0:incoming>Flow_Statement_Invoice</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_IssueInvoice_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_Withdraw_1" name="Gom luồn trước khi Rút tiền">
      <ns0:incoming>Flow_Check_Withdraw</ns0:incoming>
      <ns0:incoming>Flow_BankNo_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Withdraw_in</ns0:outgoing>
    </ns0:exclusiveGateway>
  </ns0:process>
