<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_OrderProcessing" name="Xử lý Đơn hàng Online Lazada" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Automated)">
        <bpmn:flowNodeRef>Task_ValidateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LockInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FraudCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateWaybill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CountRetries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleasePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_FraudCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_InventoryCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SellerConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_CancelRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RetryLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BuyerConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_CancelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_LockInventory_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_TrackDelivery_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ReleasePayment_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_AutoCancel_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_Notify_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_CreateWaybill_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Task_ConfirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover3PL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_ConfirmOrder_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3PL" name="3PL/Shipper">
        <bpmn:flowNodeRef>Task_Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_DeliverAttempt_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_DeliverAttempt_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Payment Gateway">
        <bpmn:flowNodeRef>Task_VerifyPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Checkout" name="Yêu cầu đặt hàng">
      <bpmn:outgoing>Flow_Checkout_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ReviewOrder" name="Xem lại đơn hàng">
      <bpmn:incoming>Flow_Validate_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Pay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Pay" name="Thanh toán đơn hàng (COD / Thẻ / Ví / Chuyển khoản)">
      <bpmn:incoming>Flow_Review_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ReceiveGoods" name="Nhận hàng từ shipper">
      <bpmn:incoming>Flow_Deliver_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_Confirm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ConfirmReceipt" name="Xác nhận đã nhận hàng">
      <bpmn:incoming>Flow_Receive_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CancelOrder" name="Buyer hủy đơn">
      <bpmn:incoming>Flow_Cancel_Gate_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_Notify_Buyer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate thông tin đơn">
      <bpmn:incoming>Flow_Checkout_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LockInventory" name="Khóa tồn kho + tạo đơn">
      <bpmn:outgoing>Flow_Lock_Fraud</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_LockInventory_1_to_Task_LockInventory</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FraudCheck" name="Kiểm tra gian lận (AI)">
      <bpmn:incoming>Flow_Lock_Fraud</bpmn:incoming>
      <bpmn:outgoing>Flow_Fraud_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckInventory" name="Kiểm tra tồn kho">
      <bpmn:incoming>Flow_Fraud_Inventory</bpmn:incoming>
      <bpmn:outgoing>Flow_Inventory_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreateWaybill" name="Tạo vận đơn tự động (LEX / 3PL)">
      <bpmn:incoming>Flow_Package_Waybill</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_CreateWaybill_to_Split_Task_CreateWaybill_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TrackDelivery" name="Cập nhật định vị đơn hàng realtime">
      <bpmn:outgoing>Flow_Track_Deliver</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CountRetries" name="Đếm số lần giao lại">
      <bpmn:incoming>Flow_Deliver_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Count</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoConfirm" name="Auto-confirm (15 ngày)">
      <bpmn:incoming>Flow_GateConfirm_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_Release</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SellerTimeout" name="Hủy đơn do Seller quá hạn 48h">
      <bpmn:incoming>Flow_GateSeller_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_Timeout_Cancel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReleasePayment" name="Giải ngân cho Seller">
      <bpmn:outgoing>Flow_Release_End</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoCancel" name="Auto-cancel đơn">
      <bpmn:outgoing>Flow_Cancel_Split</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_AutoCancel_4_to_Task_AutoCancel</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notify" name="Thông báo hủy đơn">
      <bpmn:outgoing>Flow_Notify_Refund</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_Notify_5_to_Task_Notify</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AutoRefund" name="Tự động hoàn tiền cho Buyer">
      <bpmn:incoming>Flow_Notify_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_Execute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmOrder" name="Seller xác nhận đơn">
      <bpmn:incoming>Flow_GateSeller_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ConfirmOrder_to_Split_Task_ConfirmOrder_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PackageGoods" name="Seller đóng gói">
      <bpmn:incoming>Flow_Confirm_Package</bpmn:incoming>
      <bpmn:outgoing>Flow_Package_Waybill</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Handover3PL" name="Bàn giao hàng cho 3PL / LEX">
      <bpmn:incoming>Flow_Package3PL</bpmn:incoming>
      <bpmn:outgoing>Flow_3PL_Pickup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Pickup" name="LEX (Lazada Express) lấy hàng &amp; quét barcode tại kho">
      <bpmn:incoming>Flow_3PL_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_CancelGate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_DeliverAttempt" name="Giao hàng (attempt)">
      <bpmn:incoming>Flow_Join_Task_DeliverAttempt_6_to_Task_DeliverAttempt</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_DeliverAttempt_to_Split_Task_DeliverAttempt_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_VerifyPayment" name="Gateway verify thanh toán">
      <bpmn:incoming>Flow_Gate_Online</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_Process</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_HoldPayment" name="Giữ tiền tạm thời (COD)">
      <bpmn:incoming>Flow_Gate_COD</bpmn:incoming>
      <bpmn:outgoing>Flow_Hold_Process</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ExecuteRefund" name="Cổng thanh toán xử lý hoàn tiền">
      <bpmn:incoming>Flow_Refund_Execute</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_PaymentMethod" name="Phương thức thanh toán?">
      <bpmn:incoming>Flow_Pay_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Online</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_COD</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_FraudCheck" name="Gian lận?">
      <bpmn:incoming>Flow_Fraud_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Fraud_Inventory</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fraud_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_InventoryCheck" name="Còn hàng?">
      <bpmn:incoming>Flow_Inventory_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Inventory_Seller</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inventory_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_SellerConfirm" name="Seller phản hồi trong 48h?">
      <bpmn:incoming>Flow_Inventory_Seller</bpmn:incoming>
      <bpmn:outgoing>Flow_GateSeller_Confirm</bpmn:outgoing>
      <bpmn:outgoing>Flow_GateSeller_Timeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_CancelRequest" name="Buyer hủy?">
      <bpmn:incoming>Flow_Pickup_CancelGate</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_Gate_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel_Gate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_RetryLimit" name="Số lần thử lại ≤ 3 lần?">
      <bpmn:incoming>Flow_Retry_Count</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Deliver</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_BuyerConfirm" name="Buyer đã confirm?">
      <bpmn:incoming>Flow_Confirm_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_GateConfirm_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GateConfirm_Auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_CancelSplit" name="Đơn đã thanh toán online?">
      <bpmn:incoming>Flow_Cancel_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObject id="DataObject_RetryCount" name="retryCount">
      <bpmn:documentation>Biến đếm số lần giao lại. Khởi tạo = 0, tăng 1 mỗi lần Task_DeliverAttempt thất bại. Gate_RetryLimit kiểm tra retryCount &lt; 3 để quyết định Retry (tăng counter) hoặc AutoCancel. Đảm bảo retry loop là bounded (max 3 attempts).</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObjectReference id="DataObjectRef_RetryCount" name="retryCount" dataObjectRef="DataObject_RetryCount" />
    <bpmn:endEvent id="End_Delivered" name="Đơn hàng đã hoàn tất">
      <bpmn:incoming>Flow_Release_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <bpmn:incoming>Flow_Refund_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancelled" name="Đơn hàng đã bị hủy">
      <bpmn:incoming>Flow_Cancel_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Checkout_Validate" sourceRef="StartEvent_Checkout" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Review" sourceRef="Task_ValidateOrder" targetRef="Task_ReviewOrder" />
    <bpmn:sequenceFlow id="Flow_Review_Pay" sourceRef="Task_ReviewOrder" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_Pay_Gate" sourceRef="Task_Pay" targetRef="Gate_PaymentMethod" />
    <bpmn:sequenceFlow id="Flow_Gate_Online" sourceRef="Gate_PaymentMethod" targetRef="Task_VerifyPayment" />
    <bpmn:sequenceFlow id="Flow_Gate_COD" sourceRef="Gate_PaymentMethod" targetRef="Task_HoldPayment" />
    <bpmn:sequenceFlow id="Flow_Verify_Process" sourceRef="Task_VerifyPayment" targetRef="Join_Task_LockInventory_1" />
    <bpmn:sequenceFlow id="Flow_Hold_Process" sourceRef="Task_HoldPayment" targetRef="Join_Task_LockInventory_1" />
    <bpmn:sequenceFlow id="Flow_Lock_Fraud" sourceRef="Task_LockInventory" targetRef="Task_FraudCheck" />
    <bpmn:sequenceFlow id="Flow_Fraud_Gate" sourceRef="Task_FraudCheck" targetRef="Gate_FraudCheck" />
    <bpmn:sequenceFlow id="Flow_Fraud_Inventory" sourceRef="Gate_FraudCheck" targetRef="Task_CheckInventory" />
    <bpmn:sequenceFlow id="Flow_Fraud_Cancel" sourceRef="Gate_FraudCheck" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_Inventory_Gate" sourceRef="Task_CheckInventory" targetRef="Gate_InventoryCheck" />
    <bpmn:sequenceFlow id="Flow_Inventory_Seller" sourceRef="Gate_InventoryCheck" targetRef="Gate_SellerConfirm" />
    <bpmn:sequenceFlow id="Flow_Inventory_Cancel" sourceRef="Gate_InventoryCheck" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_GateSeller_Confirm" sourceRef="Gate_SellerConfirm" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_GateSeller_Timeout" sourceRef="Gate_SellerConfirm" targetRef="Task_SellerTimeout" />
    <bpmn:sequenceFlow id="Flow_Timeout_Cancel" sourceRef="Task_SellerTimeout" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_Confirm_Package" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Task_PackageGoods" />
    <bpmn:sequenceFlow id="Flow_Confirm_Refuse" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_Package_Waybill" sourceRef="Task_PackageGoods" targetRef="Task_CreateWaybill" />
    <bpmn:sequenceFlow id="Flow_Package3PL" sourceRef="Split_Task_CreateWaybill_1" targetRef="Task_Handover3PL" />
    <bpmn:sequenceFlow id="Flow_3PL_Pickup" sourceRef="Task_Handover3PL" targetRef="Task_Pickup" />
    <bpmn:sequenceFlow id="Flow_Pickup_CancelGate" sourceRef="Task_Pickup" targetRef="Gate_CancelRequest" />
    <bpmn:sequenceFlow id="Flow_Cancel_Gate_Yes" sourceRef="Gate_CancelRequest" targetRef="Task_CancelOrder" />
    <bpmn:sequenceFlow id="Flow_Cancel_Gate_No" sourceRef="Gate_CancelRequest" targetRef="Join_Task_TrackDelivery_2" />
    <bpmn:sequenceFlow id="Flow_Waybill_Track" sourceRef="Split_Task_CreateWaybill_1" targetRef="Join_Task_TrackDelivery_2" />
    <bpmn:sequenceFlow id="Flow_Track_Deliver" sourceRef="Task_TrackDelivery" targetRef="Join_Task_DeliverAttempt_6" />
    <bpmn:sequenceFlow id="Flow_Deliver_Success" sourceRef="Split_Task_DeliverAttempt_3" targetRef="Task_ReceiveGoods" />
    <bpmn:sequenceFlow id="Flow_Deliver_Fail" sourceRef="Split_Task_DeliverAttempt_3" targetRef="Task_CountRetries" />
    <bpmn:sequenceFlow id="Flow_Retry_Count" sourceRef="Task_CountRetries" targetRef="Gate_RetryLimit" />
    <bpmn:sequenceFlow id="Flow_Retry_Deliver" sourceRef="Gate_RetryLimit" targetRef="Join_Task_DeliverAttempt_6" />
    <bpmn:sequenceFlow id="Flow_Retry_Cancel" sourceRef="Gate_RetryLimit" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_Receive_Confirm" sourceRef="Task_ReceiveGoods" targetRef="Task_ConfirmReceipt" />
    <bpmn:sequenceFlow id="Flow_Confirm_Gate" sourceRef="Task_ConfirmReceipt" targetRef="Gate_BuyerConfirm" />
    <bpmn:sequenceFlow id="Flow_GateConfirm_Yes" sourceRef="Gate_BuyerConfirm" targetRef="Join_Task_ReleasePayment_3" />
    <bpmn:sequenceFlow id="Flow_GateConfirm_Auto" sourceRef="Gate_BuyerConfirm" targetRef="Task_AutoConfirm" />
    <bpmn:sequenceFlow id="Flow_Auto_Release" sourceRef="Task_AutoConfirm" targetRef="Join_Task_ReleasePayment_3" />
    <bpmn:sequenceFlow id="Flow_Release_End" sourceRef="Task_ReleasePayment" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="Flow_Refuse_Cancel" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Join_Task_AutoCancel_4" />
    <bpmn:sequenceFlow id="Flow_Cancel_Split" sourceRef="Task_AutoCancel" targetRef="Gate_CancelSplit" />
    <bpmn:sequenceFlow id="Flow_Cancel_Notify" sourceRef="Gate_CancelSplit" targetRef="Join_Task_Notify_5" />
    <bpmn:sequenceFlow id="Flow_Cancel_Notify_Buyer" sourceRef="Task_CancelOrder" targetRef="Join_Task_Notify_5" />
    <bpmn:sequenceFlow id="Flow_Notify_Refund" sourceRef="Task_Notify" targetRef="Task_AutoRefund" />
    <bpmn:sequenceFlow id="Flow_Refund_Execute" sourceRef="Task_AutoRefund" targetRef="Task_ExecuteRefund" />
    <bpmn:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ExecuteRefund" targetRef="End_Refunded" />
    <bpmn:sequenceFlow id="Flow_Cancel_End" sourceRef="Gate_CancelSplit" targetRef="End_Cancelled" />
    <bpmn:exclusiveGateway id="Join_Task_LockInventory_1" name="Gom luồng trước khi Khóa tồn kho + tạo đơn">
      <bpmn:incoming>Flow_Verify_Process</bpmn:incoming>
      <bpmn:incoming>Flow_Hold_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_LockInventory_1_to_Task_LockInventory</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_LockInventory_1_to_Task_LockInventory" sourceRef="Join_Task_LockInventory_1" targetRef="Task_LockInventory" />
    <bpmn:exclusiveGateway id="Join_Task_TrackDelivery_2" name="Gom luồng trước khi Cập nhật định vị đơn hàng realtime">
      <bpmn:incoming>Flow_Cancel_Gate_No</bpmn:incoming>
      <bpmn:incoming>Flow_Waybill_Track</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery" sourceRef="Join_Task_TrackDelivery_2" targetRef="Task_TrackDelivery" />
    <bpmn:exclusiveGateway id="Join_Task_ReleasePayment_3" name="Gom luồng trước khi Giải ngân cho Seller">
      <bpmn:incoming>Flow_GateConfirm_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Auto_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment" sourceRef="Join_Task_ReleasePayment_3" targetRef="Task_ReleasePayment" />
    <bpmn:exclusiveGateway id="Join_Task_AutoCancel_4" name="Gom luồng trước khi Auto-cancel đơn">
      <bpmn:incoming>Flow_Fraud_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_Inventory_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_Timeout_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_Confirm_Refuse</bpmn:incoming>
