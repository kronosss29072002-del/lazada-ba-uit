<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Marketing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_Marketing" name="Quy trình Marketing và Khuyến mãi" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Marketing" name="Marketing Team">
        <ns0:flowNodeRef>StartEvent_Idea</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Research</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DesignConcept</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_MonitorLive</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PostReport</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_DesignConcept_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Approval" name="Approval">
        <ns0:flowNodeRef>Task_ComplianceCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Compliance</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_BudgetReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BudgetTier</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DirectorApprove</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System">
        <ns0:flowNodeRef>Task_AutoInviteSellers</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfigCampaign</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoTestVoucher</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_VoucherTest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_QACampaign</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_QAPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LaunchCampaign</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoReport</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ReportReady</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ExtendData</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AutoInviteSellers_2</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ConfigCampaign_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AutoTestVoucher_4</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_AutoInviteSellers_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_LaunchCampaign_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Sellers">
        <ns0:flowNodeRef>Task_SellerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SellerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SellerRegister</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SellerPrepare</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Buyer" name="Buyers">
        <ns0:flowNodeRef>Task_BuyerBrowse</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_BuyerPurchase</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Idea" name="Ý tưởng chiến dịch mới">
      <ns0:outgoing>Flow_Idea_Research</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_Research" name="Nghiên cứu thị trường &amp; lập bản đề xuất">
      <ns0:incoming>Flow_Idea_Research</ns0:incoming>
      <ns0:outgoing>Flow_Research_Audience</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_AudienceFit" name="Đối tượng khách hàng phù hợp?">
      <ns0:incoming>Flow_Research_Audience</ns0:incoming>
      <ns0:outgoing>Flow_Audience_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Audience_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ReSegment" name="Phân khúc lại nhóm đối tượng mục tiêu">
      <ns0:incoming>Flow_Audience_No</ns0:incoming>
      <ns0:outgoing>Flow_ReSegment_Design</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_DesignConcept" name="Thiết kế concept &amp; lập kế hoạch chi tiết">
      <ns0:incoming>Flow_Join_Task_DesignConcept_1_to_Task_DesignConcept</ns0:incoming>
      <ns0:outgoing>Flow_Design_Compliance</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_MonitorLive" name="Theo dõi hiệu năng hệ thống &amp; doanh số realtime">
      <ns0:incoming>Flow_Launch_Monitor</ns0:incoming>
      <ns0:outgoing>Flow_Monitor_Report</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PostReport" name="Lập báo cáo tổng kết &amp; đánh giá ROI">
      <ns0:incoming>Flow_Report_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Report_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ComplianceCheck" name="Kiểm tra tính tuân thủ pháp lý khuyến mãi (Nghị định 81)">
      <ns0:incoming>Flow_Design_Compliance</ns0:incoming>
      <ns0:outgoing>Flow_Compliance_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_BudgetReview" name="Thẩm định ngân sách &amp; tỷ suất ROI">
      <ns0:incoming>Flow_Compliance_Pass</ns0:incoming>
      <ns0:outgoing>Flow_Budget_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_DirectorApprove" name="Giám đốc Khối phê duyệt ngân sách lớn">
      <ns0:incoming>Flow_Gate_Large</ns0:incoming>
      <ns0:outgoing>Flow_Director_Invite</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_AutoInviteSellers" name="Hệ thống gửi lời mời tham gia đến Sellers">
      <ns0:incoming>Flow_Join_Task_AutoInviteSellers_2_to_Task_AutoInviteSellers</ns0:incoming>
      <ns0:outgoing>Flow_Task_AutoInviteSellers_to_Split_Task_AutoInviteSellers_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ConfigCampaign" name="Cấu hình chiến dịch trên hệ thống">
      <ns0:incoming>Flow_Join_Task_ConfigCampaign_3_to_Task_ConfigCampaign</ns0:incoming>
      <ns0:outgoing>Flow_Config_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_PromoStack" name="Trùng lặp voucher hoặc sự kiện?">
      <ns0:incoming>Flow_Config_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Promo_No</ns0:outgoing>
      <ns0:outgoing>Flow_Promo_Yes</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_ResolveConflict" name="Tự động phân tách &amp; giải quyết xung đột mã">
      <ns0:incoming>Flow_Promo_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Resolve_Test</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoTestVoucher" name="Hệ thống kiểm tra &amp; giả lập áp mã voucher">
      <ns0:incoming>Flow_Join_Task_AutoTestVoucher_4_to_Task_AutoTestVoucher</ns0:incoming>
      <ns0:outgoing>Flow_Test_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_QACampaign" name="Kiểm toán QA toàn diện trước giờ G">
      <ns0:incoming>Flow_Test_Pass</ns0:incoming>
      <ns0:outgoing>Flow_QA_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LaunchCampaign" name="Kích hoạt Chiến dịch 12.12 Siêu Hội Mua Sắm">
      <ns0:incoming>Flow_Gate_QAYes</ns0:incoming>
      <ns0:outgoing>Flow_Task_LaunchCampaign_to_Split_Task_LaunchCampaign_2</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoReport" name="Hệ thống tự động xuất báo cáo sơ bộ">
      <ns0:incoming>Flow_Monitor_Report</ns0:incoming>
      <ns0:outgoing>Flow_Report_ReadyGate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ExtendData" name="Thu thập bổ sung số liệu đối soát">
      <ns0:incoming>Flow_Report_No</ns0:incoming>
      <ns0:outgoing>Flow_Report_Retry</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_ReportReady" name="Số liệu báo cáo đã đầy đủ?">
      <ns0:incoming>Flow_Report_ReadyGate</ns0:incoming>
      <ns0:incoming>Flow_Report_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Report_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Report_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_SellerConfirm" name="Seller xem xét thư mời chiến dịch">
      <ns0:incoming>Flow_Invite_Register</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SellerRegister" name="Seller xác nhận tham gia trên Seller Centre">
      <ns0:incoming>Flow_Confirm_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Register_Prepare</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SellerPrepare" name="Seller chuẩn bị tồn kho &amp; cài đặt giá sốc">
      <ns0:incoming>Flow_Register_Prepare</ns0:incoming>
      <ns0:outgoing>Flow_Prepare_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_BuyerBrowse" name="Buyer truy cập săn deal 12.12 Siêu Sale">
      <ns0:incoming>Flow_Launch_Browse</ns0:incoming>
      <ns0:outgoing>Flow_Browse_Purchase</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_BuyerPurchase" name="Buyer thanh toán áp mã FreeShip &amp; Lazada Voucher">
      <ns0:incoming>Flow_Browse_Purchase</ns0:incoming>
      <ns0:outgoing>Flow_Purchase_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_Compliance" name="Đạt chuẩn pháp lý &amp; chính sách sàn?">
      <ns0:incoming>Flow_Compliance_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Compliance_Pass</ns0:outgoing>
      <ns0:outgoing>Flow_Compliance_Fail</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_BudgetTier" name="Ngân sách có vượt hạn mức cơ bản?">
      <ns0:incoming>Flow_Budget_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Small</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Large</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_VoucherTest" name="Kiểm thử voucher thành công?">
      <ns0:incoming>Flow_Test_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Test_Pass</ns0:outgoing>
      <ns0:outgoing>Flow_Test_Fail</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_QAPass" name="Đạt chuẩn kiểm toán sau chiến dịch?">
      <ns0:incoming>Flow_QA_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_QAYes</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_QANo</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SellerConfirm" name="Seller đồng ý tham gia?">
      <ns0:incoming>Flow_Confirm_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Confirm_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_End_CampaignDone_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_Confirm_No</ns0:incoming>
      <ns0:incoming>Flow_Prepare_End</ns0:incoming>
      <ns0:incoming>Flow_Purchase_End</ns0:incoming>
      <ns0:incoming>Flow_Report_End</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_CampaignDone_1_to_End_CampaignDone</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_CampaignDone" name="Chiến dịch đã kết thúc thành công">
      <ns0:incoming>Flow_Join_End_CampaignDone_1_to_End_CampaignDone</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Idea_Research" sourceRef="StartEvent_Idea" targetRef="Task_Research" />
    <ns0:sequenceFlow id="Flow_Research_Audience" sourceRef="Task_Research" targetRef="Gate_AudienceFit" />
    <ns0:sequenceFlow id="Flow_Audience_Yes" sourceRef="Gate_AudienceFit" targetRef="Join_Task_DesignConcept_1" name="Đối tượng phù hợp" />
    <ns0:sequenceFlow id="Flow_Audience_No" sourceRef="Gate_AudienceFit" targetRef="Task_ReSegment" name="Chưa phù hợp" />
    <ns0:sequenceFlow id="Flow_ReSegment_Design" sourceRef="Task_ReSegment" targetRef="Join_Task_DesignConcept_1" />
    <ns0:sequenceFlow id="Flow_Design_Compliance" sourceRef="Task_DesignConcept" targetRef="Task_ComplianceCheck" />
    <ns0:sequenceFlow id="Flow_Compliance_Gate" sourceRef="Task_ComplianceCheck" targetRef="Gate_Compliance" />
    <ns0:sequenceFlow id="Flow_Compliance_Pass" sourceRef="Gate_Compliance" targetRef="Task_BudgetReview" name="Đạt tiêu chuẩn" />
    <ns0:sequenceFlow id="Flow_Compliance_Fail" sourceRef="Gate_Compliance" targetRef="Join_Task_DesignConcept_1" name="Chưa đạt" />
    <ns0:sequenceFlow id="Flow_Budget_Gate" sourceRef="Task_BudgetReview" targetRef="Gate_BudgetTier" />
    <ns0:sequenceFlow id="Flow_Gate_Small" sourceRef="Gate_BudgetTier" targetRef="Join_Task_AutoInviteSellers_2" name="Trong hạn mức" />
    <ns0:sequenceFlow id="Flow_Gate_Large" sourceRef="Gate_BudgetTier" targetRef="Task_DirectorApprove" name="Vượt hạn mức" />
    <ns0:sequenceFlow id="Flow_Director_Invite" sourceRef="Task_DirectorApprove" targetRef="Join_Task_AutoInviteSellers_2" />
    <ns0:sequenceFlow id="Flow_Invite_Config" sourceRef="Split_Task_AutoInviteSellers_1" targetRef="Join_Task_ConfigCampaign_3" name="Cấu hình campaign" />
    <ns0:sequenceFlow id="Flow_Invite_Register" sourceRef="Split_Task_AutoInviteSellers_1" targetRef="Task_SellerConfirm" name="Seller đăng ký" />
    <ns0:sequenceFlow id="Flow_Confirm_Gate" sourceRef="Task_SellerConfirm" targetRef="Gate_SellerConfirm" />
    <ns0:sequenceFlow id="Flow_Confirm_Yes" sourceRef="Gate_SellerConfirm" targetRef="Task_SellerRegister" name="Seller đồng ý" />
    <ns0:sequenceFlow id="Flow_Confirm_No" sourceRef="Gate_SellerConfirm" targetRef="Join_End_CampaignDone_1" name="Seller từ chối" />
    <ns0:sequenceFlow id="Flow_Register_Prepare" sourceRef="Task_SellerRegister" targetRef="Task_SellerPrepare" />
    <ns0:sequenceFlow id="Flow_Prepare_End" sourceRef="Task_SellerPrepare" targetRef="Join_End_CampaignDone_1" />
    <ns0:sequenceFlow id="Flow_Config_Gate" sourceRef="Task_ConfigCampaign" targetRef="Gate_PromoStack" />
    <ns0:sequenceFlow id="Flow_Promo_No" sourceRef="Gate_PromoStack" targetRef="Join_Task_AutoTestVoucher_4" name="Không trùng lặp" />
    <ns0:sequenceFlow id="Flow_Promo_Yes" sourceRef="Gate_PromoStack" targetRef="Task_ResolveConflict" name="Trùng lặp voucher" />
    <ns0:sequenceFlow id="Flow_Resolve_Test" sourceRef="Task_ResolveConflict" targetRef="Join_Task_AutoTestVoucher_4" />
    <ns0:sequenceFlow id="Flow_Test_Gate" sourceRef="Task_AutoTestVoucher" targetRef="Gate_VoucherTest" />
    <ns0:sequenceFlow id="Flow_Test_Pass" sourceRef="Gate_VoucherTest" targetRef="Task_QACampaign" name="Voucher hoạt động" />
    <ns0:sequenceFlow id="Flow_Test_Fail" sourceRef="Gate_VoucherTest" targetRef="Join_Task_ConfigCampaign_3" name="Voucher lỗi" />
    <ns0:sequenceFlow id="Flow_QA_Gate" sourceRef="Task_QACampaign" targetRef="Gate_QAPass" />
    <ns0:sequenceFlow id="Flow_Gate_QAYes" sourceRef="Gate_QAPass" targetRef="Task_LaunchCampaign" name="Đạt chuẩn QA" />
    <ns0:sequenceFlow id="Flow_Gate_QANo" sourceRef="Gate_QAPass" targetRef="Join_Task_ConfigCampaign_3" name="Chưa đạt QA" />
    <ns0:sequenceFlow id="Flow_Launch_Monitor" name="Theo dõi GMV realtime" sourceRef="Split_Task_LaunchCampaign_2" targetRef="Task_MonitorLive" />
    <ns0:sequenceFlow id="Flow_Launch_Browse" sourceRef="Split_Task_LaunchCampaign_2" targetRef="Task_BuyerBrowse" name="Buyer mua sắm" />
    <ns0:sequenceFlow id="Flow_Browse_Purchase" sourceRef="Task_BuyerBrowse" targetRef="Task_BuyerPurchase" />
    <ns0:sequenceFlow id="Flow_Purchase_End" sourceRef="Task_BuyerPurchase" targetRef="Join_End_CampaignDone_1" />
    <ns0:sequenceFlow id="Flow_Monitor_Report" sourceRef="Task_MonitorLive" targetRef="Task_AutoReport" />
    <ns0:sequenceFlow id="Flow_Report_ReadyGate" sourceRef="Task_AutoReport" targetRef="Gate_ReportReady" />
    <ns0:sequenceFlow id="Flow_Report_Yes" sourceRef="Gate_ReportReady" targetRef="Task_PostReport" name="Số liệu đầy đủ" />
    <ns0:sequenceFlow id="Flow_Report_No" sourceRef="Gate_ReportReady" targetRef="Task_ExtendData" name="Thiếu số liệu" />
    <ns0:sequenceFlow id="Flow_Report_Retry" sourceRef="Task_ExtendData" targetRef="Gate_ReportReady" />
    <ns0:sequenceFlow id="Flow_Report_End" sourceRef="Task_PostReport" targetRef="Join_End_CampaignDone_1" />
    <ns0:exclusiveGateway id="Join_Task_DesignConcept_1" name="Gom luồng trước khi Thiết kế concept &amp; lập kế hoạch chi tiết">
      <ns0:incoming>Flow_Audience_Yes</ns0:incoming>
      <ns0:incoming>Flow_ReSegment_Design</ns0:incoming>
      <ns0:incoming>Flow_Compliance_Fail</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_DesignConcept_1_to_Task_DesignConcept</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_DesignConcept_1_to_Task_DesignConcept" sourceRef="Join_Task_DesignConcept_1" targetRef="Task_DesignConcept" />
    <ns0:exclusiveGateway id="Join_Task_AutoInviteSellers_2" name="Gom luồng trước khi Hệ thống gửi lời mời tham gia đến Sellers">
      <ns0:incoming>Flow_Gate_Small</ns0:incoming>
      <ns0:incoming>Flow_Director_Invite</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AutoInviteSellers_2_to_Task_AutoInviteSellers</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AutoInviteSellers_2_to_Task_AutoInviteSellers" sourceRef="Join_Task_AutoInviteSellers_2" targetRef="Task_AutoInviteSellers" />
    <ns0:exclusiveGateway id="Join_Task_ConfigCampaign_3" name="Gom luồng trước khi Cấu hình chiến dịch trên hệ thống">
      <ns0:incoming>Flow_Invite_Config</ns0:incoming>
      <ns0:incoming>Flow_Test_Fail</ns0:incoming>
      <ns0:incoming>Flow_Gate_QANo</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ConfigCampaign_3_to_Task_ConfigCampaign</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ConfigCampaign_3_to_Task_ConfigCampaign" sourceRef="Join_Task_ConfigCampaign_3" targetRef="Task_ConfigCampaign" />
    <ns0:exclusiveGateway id="Join_Task_AutoTestVoucher_4" name="Gom luồng trước khi Hệ thống kiểm tra &amp; giả lập áp mã voucher">
      <ns0:incoming>Flow_Promo_No</ns0:incoming>
      <ns0:incoming>Flow_Resolve_Test</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AutoTestVoucher_4_to_Task_AutoTestVoucher</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AutoTestVoucher_4_to_Task_AutoTestVoucher" sourceRef="Join_Task_AutoTestVoucher_4" targetRef="Task_AutoTestVoucher" />
    <ns0:exclusiveGateway id="Split_Task_AutoInviteSellers_1" name="Phân luồng sau Hệ thống gửi lời mời tham gia đến Sellers">
      <ns0:incoming>Flow_Task_AutoInviteSellers_to_Split_Task_AutoInviteSellers_1</ns0:incoming>
      <ns0:outgoing>Flow_Invite_Config</ns0:outgoing>
      <ns0:outgoing>Flow_Invite_Register</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_AutoInviteSellers_to_Split_Task_AutoInviteSellers_1" sourceRef="Task_AutoInviteSellers" targetRef="Split_Task_AutoInviteSellers_1" />
    <ns0:exclusiveGateway id="Split_Task_LaunchCampaign_2" name="Phân luồng sau Kích hoạt Chiến dịch 12.12 Siêu Hội Mua Sắm">
      <ns0:incoming>Flow_Task_LaunchCampaign_to_Split_Task_LaunchCampaign_2</ns0:incoming>
      <ns0:outgoing>Flow_Launch_Monitor</ns0:outgoing>
      <ns0:outgoing>Flow_Launch_Browse</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_LaunchCampaign_to_Split_Task_LaunchCampaign_2" sourceRef="Task_LaunchCampaign" targetRef="Split_Task_LaunchCampaign_2" />
    <ns0:sequenceFlow id="Flow_Join_End_CampaignDone_1_to_End_CampaignDone" sourceRef="Join_End_CampaignDone_1" targetRef="End_CampaignDone" name="" />
