<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ITPlatform" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_ITPlatform" name="Quy trình Quản lý ICT &amp; Hạ tầng" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_PO" name="Product Owner">
        <ns0:flowNodeRef>StartEvent_FeatureReq</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CreateStory</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Prioritize</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PrioritizeOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DemoFeature</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Deployed</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Rollback</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Dev" name="Dev Team">
        <ns0:flowNodeRef>Task_Design</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DesignReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Code</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UnitTest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_UnitTestPass</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_QA" name="QA / Tester">
        <ns0:flowNodeRef>Task_ST</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_QAPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Bugfix</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PerfTest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PerfOK</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_DevOps" name="DevOps / CI-CD">
        <ns0:flowNodeRef>Task_PreStagingDeploy</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_StagingDeploy</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ProdDeploy</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Monitor</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_HealthOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Rollback</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ResolveIncident</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Security" name="Security">
        <ns0:flowNodeRef>Task_SecurityScan</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SecurityOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PatchSecurity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ApplyPatch</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PatchApplied</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_FeatureReq" name="Yêu cầu tính năng / sự cố mới">
      <ns0:outgoing>Flow_S1_Story</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_CreateStory" name="Tạo User Story &amp; acceptance criteria">
      <ns0:outgoing>Flow_Story_Prioritize</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_CreateStory_in</ns0:incoming>
    </ns0:userTask>
    <ns0:userTask id="Task_Prioritize" name="Ưu tiên backlog &amp; sprint planning">
      <ns0:incoming>Flow_Story_Prioritize</ns0:incoming>
      <ns0:outgoing>Flow_Prioritize_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PrioritizeOK" name="Yêu cầu được chấp nhận vào sprint?">
      <ns0:incoming>Flow_Prioritize_Gate</ns0:incoming>
      <ns0:outgoing>Flow_PrioYes_Design</ns0:outgoing>
      <ns0:outgoing>Flow_PrioNo_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_DemoFeature" name="Demo tính năng cho Stakeholder">
      <ns0:incoming>Flow_PerfYes_Demo</ns0:incoming>
      <ns0:outgoing>Flow_Demo_GateDemo</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_DemoOK" name="Stakeholder chấp nhận tính năng?">
      <ns0:incoming>Flow_Demo_GateDemo</ns0:incoming>
      <ns0:outgoing>Flow_DemoYes_Deploy</ns0:outgoing>
      <ns0:outgoing>Flow_DemoNo_Fix</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="EndEvent_Deployed" name="Tính năng đã deploy thành công">
      <ns0:incoming>Flow_MonitorOK_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EndEvent_Rollback" name="Đã rollback về version trước">
      <ns0:incoming>Flow_Rollback_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Task_Design" name="Thiết kế kiến trúc &amp; API cho tính năng">
      <ns0:outgoing>Flow_Design_GateReview</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_Design_in</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_DesignReview" name="Thiết kế được phê duyệt?">
      <ns0:incoming>Flow_Design_GateReview</ns0:incoming>
      <ns0:outgoing>Flow_DesignYes_Code</ns0:outgoing>
      <ns0:outgoing>Flow_DesignNo_Rework</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_Code" name="Viết code theo User Story &amp; unit test">
      <ns0:outgoing>Flow_Code_UnitTest</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_Code_in</ns0:incoming>
    </ns0:userTask>
    <ns0:userTask id="Task_UnitTest" name="Chạy unit test &amp; code review">
      <ns0:incoming>Flow_Code_UnitTest</ns0:incoming>
      <ns0:outgoing>Flow_Unit_GateTest</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_UnitTestPass" name="Unit test pass?">
      <ns0:incoming>Flow_Unit_GateTest</ns0:incoming>
      <ns0:outgoing>Flow_UnitYes_ST</ns0:outgoing>
      <ns0:outgoing>Flow_UnitNo_Fix</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ST" name="Thực hiện System Test &amp; Integration Test">
      <ns0:outgoing>Flow_ST_GateQA</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ST_in</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_QAPass" name="QA test pass?">
      <ns0:incoming>Flow_ST_GateQA</ns0:incoming>
      <ns0:outgoing>Flow_QAYes_Perf</ns0:outgoing>
      <ns0:outgoing>Flow_QANo_Bugfix</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_Bugfix" name="Sửa lỗi QA phát hiện &amp; regression test">
      <ns0:incoming>Flow_QANo_Bugfix</ns0:incoming>
      <ns0:outgoing>Flow_Task_Bugfix_to_Split_Task_Bugfix_1</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PerfTest" name="Performance test &amp; load test">
      <ns0:outgoing>Flow_Perf_GatePerf</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_PerfTest_in</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PerfOK" name="Performance test pass?">
      <ns0:incoming>Flow_Perf_GatePerf</ns0:incoming>
      <ns0:outgoing>Flow_PerfYes_Demo</ns0:outgoing>
      <ns0:outgoing>Flow_PerfNo_Optimize</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_PreStagingDeploy" name="Triển khai lên môi trường Pre-Staging">
      <ns0:incoming>Flow_DemoYes_Deploy</ns0:incoming>
      <ns0:outgoing>Flow_PreStaging_Staging</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_StagingDeploy" name="Triển khai lên môi trường Staging (UAT)">
      <ns0:incoming>Flow_PreStaging_Staging</ns0:incoming>
      <ns0:outgoing>Flow_Staging_Prod</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ProdDeploy" name="Triển khai lên Production (Blue-Green Deploy)">
      <ns0:incoming>Flow_Staging_Prod</ns0:incoming>
      <ns0:outgoing>Flow_Prod_Monitor</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_Monitor" name="Giám sát metrics sau deploy 30 phút">
      <ns0:incoming>Flow_Prod_Monitor</ns0:incoming>
      <ns0:outgoing>Flow_Monitor_GateHealth</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_HealthOK" name="Metrics hệ thống ổn định?">
      <ns0:incoming>Flow_Monitor_GateHealth</ns0:incoming>
      <ns0:outgoing>Flow_MonitorOK_End</ns0:outgoing>
      <ns0:outgoing>Flow_MonitorNo_Rollback</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_Rollback" name="Rollback về version trước — tạo Incident">
      <ns0:incoming>Flow_MonitorNo_Rollback</ns0:incoming>
      <ns0:outgoing>Flow_Rollback_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ResolveIncident" name="Xử lý sự cố infrastructure &amp; incident">
      <ns0:incoming>Flow_PerfNo_Optimize</ns0:incoming>
      <ns0:outgoing>Flow_Incident_Perf</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_SecurityScan" name="Quét lỗ hổng bảo mật (SAST/DAST)">
      <ns0:incoming>Flow_Bugfix_ST2</ns0:incoming>
      <ns0:outgoing>Flow_Scan_GateSec</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_SecurityOK" name="Không có lỗ hổng nghiêm trọng?">
      <ns0:incoming>Flow_Scan_GateSec</ns0:incoming>
      <ns0:outgoing>Flow_SecYes_Perf</ns0:outgoing>
      <ns0:outgoing>Flow_SecNo_Patch</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_PatchSecurity" name="Áp dụng bản vá bảo mật khẩn cấp">
      <ns0:incoming>Flow_SecNo_Patch</ns0:incoming>
      <ns0:outgoing>Flow_Patch_Apply</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ApplyPatch" name="Triển khai bản vá &amp; regression test">
      <ns0:outgoing>Flow_Apply_GateApplied</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ApplyPatch_in</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PatchApplied" name="Bản vá được áp dụng thành công?">
      <ns0:incoming>Flow_Apply_GateApplied</ns0:incoming>
      <ns0:outgoing>Flow_PatchYes_Story</ns0:outgoing>
      <ns0:outgoing>Flow_PatchNo_Retry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_S1_Story" sourceRef="StartEvent_FeatureReq" targetRef="Join_Task_CreateStory_1" />
    <ns0:sequenceFlow id="Flow_Story_Prioritize" sourceRef="Task_CreateStory" targetRef="Task_Prioritize" />
    <ns0:sequenceFlow id="Flow_Prioritize_Gate" sourceRef="Task_Prioritize" targetRef="Gate_PrioritizeOK" />
    <ns0:sequenceFlow id="Flow_PrioYes_Design" name="Chấp nhận" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_Design_1" />
    <ns0:sequenceFlow id="Flow_PrioNo_Reject" name="Từ chối" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_CreateStory_1" />
    <ns0:sequenceFlow id="Flow_Design_GateReview" sourceRef="Task_Design" targetRef="Gate_DesignReview" />
    <ns0:sequenceFlow id="Flow_DesignYes_Code" name="Phê duyệt" sourceRef="Gate_DesignReview" targetRef="Join_Task_Code_1" />
    <ns0:sequenceFlow id="Flow_DesignNo_Rework" name="Cần sửa" sourceRef="Gate_DesignReview" targetRef="Join_Task_Design_1" />
    <ns0:sequenceFlow id="Flow_Code_UnitTest" sourceRef="Task_Code" targetRef="Task_UnitTest" />
    <ns0:sequenceFlow id="Flow_Unit_GateTest" sourceRef="Task_UnitTest" targetRef="Gate_UnitTestPass" />
    <ns0:sequenceFlow id="Flow_UnitYes_ST" name="Pass" sourceRef="Gate_UnitTestPass" targetRef="Join_Task_ST_1" />
    <ns0:sequenceFlow id="Flow_UnitNo_Fix" name="Fail — sửa" sourceRef="Gate_UnitTestPass" targetRef="Join_Task_Code_1" />
    <ns0:sequenceFlow id="Flow_ST_GateQA" sourceRef="Task_ST" targetRef="Gate_QAPass" />
    <ns0:sequenceFlow id="Flow_QAYes_Perf" name="Pass" sourceRef="Gate_QAPass" targetRef="Join_Task_PerfTest_1" />
    <ns0:sequenceFlow id="Flow_QANo_Bugfix" name="Fail — sửa lỗi" sourceRef="Gate_QAPass" targetRef="Task_Bugfix" />
    <ns0:sequenceFlow id="Flow_Bugfix_ST" sourceRef="Split_Task_Bugfix_1" targetRef="Join_Task_ST_1" name="System Test &amp; Integration" />
    <ns0:sequenceFlow id="Flow_Bugfix_ST2" sourceRef="Split_Task_Bugfix_1" targetRef="Task_SecurityScan" name="Quét bảo mật SAST/DAST" />
    <ns0:sequenceFlow id="Flow_Perf_GatePerf" sourceRef="Task_PerfTest" targetRef="Gate_PerfOK" />
    <ns0:sequenceFlow id="Flow_PerfYes_Demo" name="Pass" sourceRef="Gate_PerfOK" targetRef="Task_DemoFeature" />
    <ns0:sequenceFlow id="Flow_PerfNo_Optimize" name="Fail — tối ưu" sourceRef="Gate_PerfOK" targetRef="Task_ResolveIncident" />
    <ns0:sequenceFlow id="Flow_Incident_Perf" sourceRef="Task_ResolveIncident" targetRef="Join_Task_PerfTest_1" />
    <ns0:sequenceFlow id="Flow_Demo_GateDemo" sourceRef="Task_DemoFeature" targetRef="Gate_DemoOK" />
    <ns0:sequenceFlow id="Flow_DemoYes_Deploy" name="Chấp nhận" sourceRef="Gate_DemoOK" targetRef="Task_PreStagingDeploy" />
    <ns0:sequenceFlow id="Flow_DemoNo_Fix" name="Yêu cầu sửa" sourceRef="Gate_DemoOK" targetRef="Join_Task_Code_1" />
    <ns0:sequenceFlow id="Flow_PreStaging_Staging" sourceRef="Task_PreStagingDeploy" targetRef="Task_StagingDeploy" />
    <ns0:sequenceFlow id="Flow_Staging_Prod" sourceRef="Task_StagingDeploy" targetRef="Task_ProdDeploy" />
    <ns0:sequenceFlow id="Flow_Prod_Monitor" sourceRef="Task_ProdDeploy" targetRef="Task_Monitor" />
    <ns0:sequenceFlow id="Flow_Monitor_GateHealth" sourceRef="Task_Monitor" targetRef="Gate_HealthOK" />
    <ns0:sequenceFlow id="Flow_MonitorOK_End" name="Ổn định" sourceRef="Gate_HealthOK" targetRef="EndEvent_Deployed" />
    <ns0:sequenceFlow id="Flow_MonitorNo_Rollback" name="Lỗi — Rollback" sourceRef="Gate_HealthOK" targetRef="Task_Rollback" />
    <ns0:sequenceFlow id="Flow_Rollback_End" sourceRef="Task_Rollback" targetRef="EndEvent_Rollback" />
    <ns0:sequenceFlow id="Flow_Scan_GateSec" sourceRef="Task_SecurityScan" targetRef="Gate_SecurityOK" />
    <ns0:sequenceFlow id="Flow_SecYes_Perf" name="An toàn" sourceRef="Gate_SecurityOK" targetRef="Join_Task_PerfTest_1" />
    <ns0:sequenceFlow id="Flow_SecNo_Patch" name="Có lỗ hổng" sourceRef="Gate_SecurityOK" targetRef="Task_PatchSecurity" />
    <ns0:sequenceFlow id="Flow_Patch_Apply" sourceRef="Task_PatchSecurity" targetRef="Join_Task_ApplyPatch_1" />
    <ns0:sequenceFlow id="Flow_Apply_GateApplied" sourceRef="Task_ApplyPatch" targetRef="Gate_PatchApplied" />
    <ns0:sequenceFlow id="Flow_PatchYes_Story" name="Thành công" sourceRef="Gate_PatchApplied" targetRef="Join_Task_CreateStory_1" />
    <ns0:sequenceFlow id="Flow_PatchNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_PatchApplied" targetRef="Join_Task_ApplyPatch_1" />
    <ns0:sequenceFlow id="Flow_Join_Task_CreateStory_in" sourceRef="Join_Task_CreateStory_1" targetRef="Task_CreateStory" />
    <ns0:sequenceFlow id="Flow_Join_Task_Design_in" sourceRef="Join_Task_Design_1" targetRef="Task_Design" />
    <ns0:sequenceFlow id="Flow_Join_Task_Code_in" sourceRef="Join_Task_Code_1" targetRef="Task_Code" />
    <ns0:sequenceFlow id="Flow_Join_Task_ST_in" sourceRef="Join_Task_ST_1" targetRef="Task_ST" />
    <ns0:sequenceFlow id="Flow_Join_Task_PerfTest_in" sourceRef="Join_Task_PerfTest_1" targetRef="Task_PerfTest" />
    <ns0:sequenceFlow id="Flow_Join_Task_ApplyPatch_in" sourceRef="Join_Task_ApplyPatch_1" targetRef="Task_ApplyPatch" />
    <ns0:sequenceFlow id="Flow_Task_Bugfix_to_Split_Task_Bugfix_1" sourceRef="Task_Bugfix" targetRef="Split_Task_Bugfix_1" />
    <ns0:exclusiveGateway id="Join_Task_CreateStory_1" name="Gom luồng trước khi Tạo User Story &amp; acceptance criteria">
      <ns0:incoming>Flow_S1_Story</ns0:incoming>
      <ns0:incoming>Flow_PrioNo_Reject</ns0:incoming>
      <ns0:incoming>Flow_PatchYes_Story</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_CreateStory_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_Design_1" name="Gom luồng trước khi Thiết kế kiến trúc &amp; API cho tính năng">
      <ns0:incoming>Flow_PrioYes_Design</ns0:incoming>
      <ns0:incoming>Flow_DesignNo_Rework</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Design_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_Code_1" name="Gom luồng trước khi Viết code theo User Story &amp; unit test">
      <ns0:incoming>Flow_DesignYes_Code</ns0:incoming>
      <ns0:incoming>Flow_UnitNo_Fix</ns0:incoming>
      <ns0:incoming>Flow_DemoNo_Fix</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Code_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_ST_1" name="Gom luồng trước khi Thực hiện System Test &amp; Integration Test">
      <ns0:incoming>Flow_UnitYes_ST</ns0:incoming>
      <ns0:incoming>Flow_Bugfix_ST</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ST_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_PerfTest_1" name="Gom luồng trước khi Performance test &amp; load test">
      <ns0:incoming>Flow_QAYes_Perf</ns0:incoming>
      <ns0:incoming>Flow_Incident_Perf</ns0:incoming>
      <ns0:incoming>Flow_SecYes_Perf</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_PerfTest_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_ApplyPatch_1" name="Gom luồng trước khi Triển khai bản vá &amp; regression test">
      <ns0:incoming>Flow_Patch_Apply</ns0:incoming>
      <ns0:incoming>Flow_PatchNo_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ApplyPatch_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Split_Task_Bugfix_1" name="Phân luồng sau khi Sửa lỗi QA phát hiện &amp; regression test">
      <ns0:outgoing>Flow_Bugfix_ST</ns0:outgoing>
      <ns0:outgoing>Flow_Bugfix_ST2</ns0:outgoing>
      <ns0:incoming>Flow_Task_Bugfix_to_Split_Task_Bugfix_1</ns0:incoming>
    </ns0:exclusiveGateway>
  </ns0:process>
