<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentSettlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_PaymentSettlement" name="Quy trình Thanh toán &amp; Đối soát" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Checkout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRefund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PaymentGW" name="Payment Gateway (VNPay/MoMo/ZaloPay)">
        <bpmn:flowNodeRef>Task_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PaymentApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckIPN</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Escrow)">
        <bpmn:flowNodeRef>Task_HoldEscrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MatchOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_OrderCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseFunds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReconcileCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReconcileDaily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DiscrepancyFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateCommission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateWallet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_HandleDiscrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DiscrepancyResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustStatement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueInvoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Task_CheckWallet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BankReceived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Checkout" name="Thanh toán đơn hàng">
      <bpmn:outgoing>Flow_S1_Choose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ChooseMethod" name="Chọn phương thức thanh toán (COD/Online/Ví)">
      <bpmn:incoming>Flow_S1_Choose</bpmn:incoming>
      <bpmn:outgoing>Flow_Choose_GateMethod</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PayCOD" name="Thanh toán COD khi nhận hàng">
      <bpmn:incoming>Flow_MethodCOD_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_COD_Receive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmOnline" name="Xác nhận thanh toán online qua cổng">
      <bpmn:incoming>Flow_Join_Task_ConfirmOnline_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Process</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveGoods" name="Buyer nhận hàng &amp; hoàn tất đơn">
      <bpmn:incoming>Flow_COD_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_Reconcile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveRefund" name="Buyer nhận hoàn tiền khi hủy/hoàn trả">
      <bpmn:incoming>Flow_Refund_Back</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ProcessPayment" name="Cổng thanh toán xử lý giao dịch">
      <bpmn:incoming>Flow_Confirm_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_GatePay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_PaymentApproved" name="Giao dịch thanh toán thành công?">
      <bpmn:incoming>Flow_Process_GatePay</bpmn:incoming>
      <bpmn:outgoing>Flow_PayYes_Verify</bpmn:outgoing>
      <bpmn:outgoing>Flow_PayNo_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyPayment" name="Xác minh chữ ký &amp; tính hợp lệ giao dịch">
      <bpmn:incoming>Flow_PayYes_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyResult" name="Gửi kết quả thanh toán về hệ thống">
      <bpmn:incoming>Flow_ValidYes_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Hold</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckIPN" name="Kiểm tra IPN/Webhook đối soát giao dịch">
      <bpmn:incoming>Flow_Verify_GateIPN</bpmn:incoming>
      <bpmn:outgoing>Flow_IPN_Match</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_HoldEscrow" name="Hệ thống giữ tiền tạm thời trong Escrow">
      <bpmn:incoming>Flow_Join_Task_HoldEscrow_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Hold_Match</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MatchOrder" name="Đối chiếu giao dịch với mã đơn hàng">
      <bpmn:incoming>Flow_Join_Task_MatchOrder_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Match_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_OrderCompleted" name="Đơn hàng hoàn tất giao dịch?">
      <bpmn:incoming>Flow_Match_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Completed_Release</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotCompleted_Return</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refund_Back</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReleaseFunds" name="Giải ngân tiền cho Seller (L+2 ngày)">
      <bpmn:incoming>Flow_Completed_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Release_Commission</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReconcileCOD" name="Đối soát COD với 3PL thu hộ">
      <bpmn:incoming>Flow_Receive_Reconcile</bpmn:incoming>
      <bpmn:outgoing>Flow_COD_ReconcileDaily</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReconcileDaily" name="Tổng hợp đối soát dòng tiền cuối ngày">
      <bpmn:incoming>Flow_COD_ReconcileDaily</bpmn:incoming>
      <bpmn:outgoing>Flow_Reconcile_GateDisc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_DiscrepancyFound" name="Phát hiện lệch dòng tiền?">
      <bpmn:incoming>Flow_Reconcile_GateDisc</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscYes_Handle</bpmn:outgoing>
      <bpmn:outgoing>Flow_DiscNo_Statement</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalculateCommission" name="Tính hoa hồng Lazada (1-8% theo danh mục)">
      <bpmn:incoming>Flow_Release_Commission</bpmn:incoming>
      <bpmn:outgoing>Flow_Commission_Wallet</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateWallet" name="Cập nhật số dư Ví Seller">
      <bpmn:incoming>Flow_Commission_Wallet</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_HandleDiscrepancy" name="Phòng Tài chính xử lý lệch dòng tiền">
      <bpmn:incoming>Flow_Join_Task_HandleDiscrepancy_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Handle_GateResolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DiscrepancyResolved" name="Lệch dòng tiền đã xử lý xong?">
      <bpmn:incoming>Flow_Handle_GateResolved</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolved_Adjust</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotResolved_Reopen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmStatement" name="Xác nhận bảng đối soát cuối kỳ">
      <bpmn:incoming>Flow_Join_Task_ConfirmStatement_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Statement_Invoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AdjustStatement" name="Điều chỉnh số liệu sai lệch trên bảng kê">
      <bpmn:incoming>Flow_Resolved_Adjust</bpmn:incoming>
      <bpmn:outgoing>Flow_Adjust_Statement</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IssueInvoice" name="Xuất hóa đơn &amp; báo cáo tài chính">
      <bpmn:incoming>Flow_Join_Task_IssueInvoice_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Invoice_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckWallet" name="Seller kiểm tra số dư Ví trên Seller Centre">
      <bpmn:incoming>Flow_Wallet_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Withdraw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Withdraw" name="Seller yêu cầu rút tiền về tài khoản ngân hàng">
      <bpmn:incoming>Flow_Join_Task_Withdraw_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Withdraw_GateBank</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_BankReceived" name="Tiền về tài khoản ngân hàng thành công?">
      <bpmn:incoming>Flow_Withdraw_GateBank</bpmn:incoming>
      <bpmn:outgoing>Flow_BankYes_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_BankNo_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_Method" name="Chọn phương thức thanh toán?">
      <bpmn:incoming>Flow_Choose_GateMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_MethodCOD_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_MethodOnline_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_Valid" name="Giao dịch hợp lệ (chữ ký đúng)?">
      <bpmn:incoming>Flow_Verify_GateValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidYes_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidNo_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S1_Choose" sourceRef="StartEvent_Checkout" targetRef="Task_ChooseMethod" />
    <bpmn:sequenceFlow id="Flow_Choose_GateMethod" sourceRef="Task_ChooseMethod" targetRef="Gate_Method" />
    <bpmn:sequenceFlow id="Flow_MethodCOD_Pay" name="COD" sourceRef="Gate_Method" targetRef="Task_PayCOD" />
    <bpmn:sequenceFlow id="Flow_MethodOnline_Confirm" name="Thanh toán online" sourceRef="Gate_Method" targetRef="Join_Task_ConfirmOnline_1" />
    <bpmn:sequenceFlow id="Flow_COD_Receive" sourceRef="Task_PayCOD" targetRef="Task_ReceiveGoods" />
    <bpmn:sequenceFlow id="Flow_Receive_Reconcile" sourceRef="Task_ReceiveGoods" targetRef="Task_ReconcileCOD" />
    <bpmn:sequenceFlow id="Flow_Confirm_Process" sourceRef="Task_ConfirmOnline" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_Process_GatePay" sourceRef="Task_ProcessPayment" targetRef="Gate_PaymentApproved" />
    <bpmn:sequenceFlow id="Flow_PayYes_Verify" name="Thành công" sourceRef="Gate_PaymentApproved" targetRef="Task_VerifyPayment" />
    <bpmn:sequenceFlow id="Flow_PayNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_PaymentApproved" targetRef="Join_Task_ConfirmOnline_1" />
    <bpmn:sequenceFlow id="Flow_Verify_GateValid" sourceRef="Split_Task_VerifyPayment_1" targetRef="Gate_Valid" />
    <bpmn:sequenceFlow id="Flow_ValidYes_Notify" name="Hợp lệ" sourceRef="Gate_Valid" targetRef="Task_NotifyResult" />
    <bpmn:sequenceFlow id="Flow_ValidNo_Reject" name="Không hợp lệ — từ chối" sourceRef="Gate_Valid" targetRef="Join_Task_ConfirmOnline_1" />
    <bpmn:sequenceFlow id="Flow_Notify_Hold" sourceRef="Task_NotifyResult" targetRef="Join_Task_HoldEscrow_1" />
    <bpmn:sequenceFlow id="Flow_Verify_GateIPN" sourceRef="Split_Task_VerifyPayment_1" targetRef="Task_CheckIPN" />
    <bpmn:sequenceFlow id="Flow_IPN_Match" sourceRef="Task_CheckIPN" targetRef="Join_Task_MatchOrder_1" />
    <bpmn:sequenceFlow id="Flow_Hold_Match" sourceRef="Task_HoldEscrow" targetRef="Join_Task_MatchOrder_1" />
    <bpmn:sequenceFlow id="Flow_Match_Complete" sourceRef="Task_MatchOrder" targetRef="Gate_OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_Completed_Release" name="Hoàn tất" sourceRef="Gate_OrderCompleted" targetRef="Task_ReleaseFunds" />
    <bpmn:sequenceFlow id="Flow_NotCompleted_Return" name="Chưa hoàn tất — giữ tiền" sourceRef="Gate_OrderCompleted" targetRef="Join_Task_HoldEscrow_1" />
    <bpmn:sequenceFlow id="Flow_Release_Commission" sourceRef="Task_ReleaseFunds" targetRef="Task_CalculateCommission" />
    <bpmn:sequenceFlow id="Flow_Commission_Wallet" sourceRef="Task_CalculateCommission" targetRef="Task_UpdateWallet" />
    <bpmn:sequenceFlow id="Flow_Wallet_Invoice" sourceRef="Split_Task_UpdateWallet_1" targetRef="Join_Task_IssueInvoice_1" />
    <bpmn:sequenceFlow id="Flow_Wallet_Check" sourceRef="Split_Task_UpdateWallet_1" targetRef="Task_CheckWallet" />
    <bpmn:sequenceFlow id="Flow_Check_Withdraw" sourceRef="Task_CheckWallet" targetRef="Join_Task_Withdraw_1" />
    <bpmn:sequenceFlow id="Flow_Withdraw_GateBank" sourceRef="Task_Withdraw" targetRef="Gate_BankReceived" />
    <bpmn:sequenceFlow id="Flow_BankYes_End" name="Nhận được tiền" sourceRef="Gate_BankReceived" targetRef="EndEvent_Paid" />
    <bpmn:sequenceFlow id="Flow_BankNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_BankReceived" targetRef="Join_Task_Withdraw_1" />
    <bpmn:sequenceFlow id="Flow_COD_ReconcileDaily" sourceRef="Task_ReconcileCOD" targetRef="Task_ReconcileDaily" />
    <bpmn:sequenceFlow id="Flow_Reconcile_GateDisc" sourceRef="Task_ReconcileDaily" targetRef="Gate_DiscrepancyFound" />
    <bpmn:sequenceFlow id="Flow_DiscYes_Handle" name="Có lệch" sourceRef="Gate_DiscrepancyFound" targetRef="Join_Task_HandleDiscrepancy_1" />
    <bpmn:sequenceFlow id="Flow_DiscNo_Statement" name="Khớp" sourceRef="Gate_DiscrepancyFound" targetRef="Join_Task_ConfirmStatement_1" />
    <bpmn:sequenceFlow id="Flow_Handle_GateResolved" sourceRef="Task_HandleDiscrepancy" targetRef="Gate_DiscrepancyResolved" />
    <bpmn:sequenceFlow id="Flow_Resolved_Adjust" name="Xử lý xong" sourceRef="Gate_DiscrepancyResolved" targetRef="Task_AdjustStatement" />
    <bpmn:sequenceFlow id="Flow_NotResolved_Reopen" name="Chưa xong — xử lý tiếp" sourceRef="Gate_DiscrepancyResolved" targetRef="Join_Task_HandleDiscrepancy_1" />
    <bpmn:sequenceFlow id="Flow_Adjust_Statement" sourceRef="Task_AdjustStatement" targetRef="Join_Task_ConfirmStatement_1" />
    <bpmn:sequenceFlow id="Flow_Statement_Invoice" sourceRef="Task_ConfirmStatement" targetRef="Join_Task_IssueInvoice_1" />
    <bpmn:sequenceFlow id="Flow_Invoice_End" sourceRef="Task_IssueInvoice" targetRef="EndEvent_Settled" />
    <bpmn:sequenceFlow id="Flow_Refund_Back" sourceRef="Gate_OrderCompleted" targetRef="Task_ReceiveRefund" />
    <bpmn:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ReceiveRefund" targetRef="EndEvent_Refunded" />
    <bpmn:sequenceFlow id="Flow_Join_Task_ConfirmOnline_in" sourceRef="Join_Task_ConfirmOnline_1" targetRef="Task_ConfirmOnline" />
    <bpmn:sequenceFlow id="Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1" sourceRef="Task_VerifyPayment" targetRef="Split_Task_VerifyPayment_1" />
    <bpmn:sequenceFlow id="Flow_Join_Task_HoldEscrow_in" sourceRef="Join_Task_HoldEscrow_1" targetRef="Task_HoldEscrow" />
    <bpmn:sequenceFlow id="Flow_Join_Task_MatchOrder_in" sourceRef="Join_Task_MatchOrder_1" targetRef="Task_MatchOrder" />
    <bpmn:sequenceFlow id="Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1" sourceRef="Task_UpdateWallet" targetRef="Split_Task_UpdateWallet_1" />
    <bpmn:sequenceFlow id="Flow_Join_Task_HandleDiscrepancy_in" sourceRef="Join_Task_HandleDiscrepancy_1" targetRef="Task_HandleDiscrepancy" />
    <bpmn:sequenceFlow id="Flow_Join_Task_ConfirmStatement_in" sourceRef="Join_Task_ConfirmStatement_1" targetRef="Task_ConfirmStatement" />
    <bpmn:sequenceFlow id="Flow_Join_Task_IssueInvoice_in" sourceRef="Join_Task_IssueInvoice_1" targetRef="Task_IssueInvoice" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Withdraw_in" sourceRef="Join_Task_Withdraw_1" targetRef="Task_Withdraw" />
    <bpmn:endEvent id="EndEvent_Paid" name="Seller đã nhận tiền thanh toán">
      <bpmn:incoming>Flow_BankYes_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Settled" name="Đối soát đã hoàn tất">
      <bpmn:incoming>Flow_Invoice_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Refunded" name="Đã hoàn tiền về Buyer">
      <bpmn:incoming>Flow_Refund_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Join_Task_ConfirmOnline_1" name="Gom luồn trước khi Xác nhận online">
      <bpmn:incoming>Flow_MethodOnline_Confirm</bpmn:incoming>
      <bpmn:incoming>Flow_PayNo_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_ValidNo_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ConfirmOnline_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split_Task_VerifyPayment_1" name="Phân luồn sau khi Xác minh">
      <bpmn:incoming>Flow_Task_VerifyPayment_to_Split_Task_VerifyPayment_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_GateValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Verify_GateIPN</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Join_Task_HoldEscrow_1" name="Gom luồn trước khi giữ Escrow">
      <bpmn:incoming>Flow_Notify_Hold</bpmn:incoming>
      <bpmn:incoming>Flow_NotCompleted_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_HoldEscrow_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_MatchOrder_1" name="Gom luồn trước khi Đối chiếu">
      <bpmn:incoming>Flow_IPN_Match</bpmn:incoming>
      <bpmn:incoming>Flow_Hold_Match</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_MatchOrder_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split_Task_UpdateWallet_1" name="Phân luồn sau khi Cập nhật Ví">
      <bpmn:incoming>Flow_Task_UpdateWallet_to_Split_Task_UpdateWallet_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Wallet_Invoice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wallet_Check</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Join_Task_HandleDiscrepancy_1" name="Gom luồn trước khi Xử lý lệch dòng tiền">
      <bpmn:incoming>Flow_DiscYes_Handle</bpmn:incoming>
      <bpmn:incoming>Flow_NotResolved_Reopen</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_HandleDiscrepancy_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_ConfirmStatement_1" name="Gom luồn trước khi Xác nhận bảng đối soát">
      <bpmn:incoming>Flow_DiscNo_Statement</bpmn:incoming>
      <bpmn:incoming>Flow_Adjust_Statement</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ConfirmStatement_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_IssueInvoice_1" name="Gom luồn trước khi Xuất hóa đơn">
      <bpmn:incoming>Flow_Wallet_Invoice</bpmn:incoming>
      <bpmn:incoming>Flow_Statement_Invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_IssueInvoice_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_Withdraw_1" name="Gom luồn trước khi Rút tiền">
      <bpmn:incoming>Flow_Check_Withdraw</bpmn:incoming>
      <bpmn:incoming>Flow_BankNo_Retry</bpmn:incoming>
