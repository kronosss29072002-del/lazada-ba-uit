<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ITPlatform" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_ITPlatform" name="Quy trình Quản lý ICT &amp; Hạ tầng" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PO" name="Product Owner">
        <bpmn:flowNodeRef>StartEvent_FeatureReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateStory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prioritize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PrioritizeOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DemoFeature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Deployed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rollback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="Dev Team">
        <bpmn:flowNodeRef>Task_Design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DesignReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnitTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_UnitTestPass</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="QA / Tester">
        <bpmn:flowNodeRef>Task_ST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_QAPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bugfix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerfTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PerfOK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DevOps" name="DevOps / CI-CD">
        <bpmn:flowNodeRef>Task_PreStagingDeploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StagingDeploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProdDeploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_HealthOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveIncident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security">
        <bpmn:flowNodeRef>Task_SecurityScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SecurityOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PatchSecurity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyPatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PatchApplied</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_FeatureReq" name="Yêu cầu tính năng / sự cố mới">
      <bpmn:outgoing>Flow_S1_Story</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateStory" name="Tạo User Story &amp; acceptance criteria">
      <bpmn:outgoing>Flow_Story_Prioritize</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_CreateStory_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Prioritize" name="Ưu tiên backlog &amp; sprint planning">
      <bpmn:incoming>Flow_Story_Prioritize</bpmn:incoming>
      <bpmn:outgoing>Flow_Prioritize_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PrioritizeOK" name="Yêu cầu được chấp nhận vào sprint?">
      <bpmn:incoming>Flow_Prioritize_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_PrioYes_Design</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrioNo_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DemoFeature" name="Demo tính năng cho Stakeholder">
      <bpmn:incoming>Flow_PerfYes_Demo</bpmn:incoming>
      <bpmn:outgoing>Flow_Demo_GateDemo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DemoOK" name="Stakeholder chấp nhận tính năng?">
      <bpmn:incoming>Flow_Demo_GateDemo</bpmn:incoming>
      <bpmn:outgoing>Flow_DemoYes_Deploy</bpmn:outgoing>
      <bpmn:outgoing>Flow_DemoNo_Fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Deployed" name="Tính năng đã deploy thành công">
      <bpmn:incoming>Flow_MonitorOK_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rollback" name="Đã rollback về version trước">
      <bpmn:incoming>Flow_Rollback_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Design" name="Thiết kế kiến trúc &amp; API cho tính năng">
      <bpmn:outgoing>Flow_Design_GateReview</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_Design_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DesignReview" name="Thiết kế được phê duyệt?">
      <bpmn:incoming>Flow_Design_GateReview</bpmn:incoming>
      <bpmn:outgoing>Flow_DesignYes_Code</bpmn:outgoing>
      <bpmn:outgoing>Flow_DesignNo_Rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Code" name="Viết code theo User Story &amp; unit test">
      <bpmn:outgoing>Flow_Code_UnitTest</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_Code_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UnitTest" name="Chạy unit test &amp; code review">
      <bpmn:incoming>Flow_Code_UnitTest</bpmn:incoming>
      <bpmn:outgoing>Flow_Unit_GateTest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_UnitTestPass" name="Unit test pass?">
      <bpmn:incoming>Flow_Unit_GateTest</bpmn:incoming>
      <bpmn:outgoing>Flow_UnitYes_ST</bpmn:outgoing>
      <bpmn:outgoing>Flow_UnitNo_Fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ST" name="Thực hiện System Test &amp; Integration Test">
      <bpmn:outgoing>Flow_ST_GateQA</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ST_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_QAPass" name="QA test pass?">
      <bpmn:incoming>Flow_ST_GateQA</bpmn:incoming>
      <bpmn:outgoing>Flow_QAYes_Perf</bpmn:outgoing>
      <bpmn:outgoing>Flow_QANo_Bugfix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Bugfix" name="Sửa lỗi QA phát hiện &amp; regression test">
      <bpmn:incoming>Flow_QANo_Bugfix</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Bugfix_to_Split_Task_Bugfix_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PerfTest" name="Performance test &amp; load test">
      <bpmn:outgoing>Flow_Perf_GatePerf</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_PerfTest_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PerfOK" name="Performance test pass?">
      <bpmn:incoming>Flow_Perf_GatePerf</bpmn:incoming>
      <bpmn:outgoing>Flow_PerfYes_Demo</bpmn:outgoing>
      <bpmn:outgoing>Flow_PerfNo_Optimize</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PreStagingDeploy" name="Triển khai lên môi trường Pre-Staging">
      <bpmn:incoming>Flow_DemoYes_Deploy</bpmn:incoming>
      <bpmn:outgoing>Flow_PreStaging_Staging</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StagingDeploy" name="Triển khai lên môi trường Staging (UAT)">
      <bpmn:incoming>Flow_PreStaging_Staging</bpmn:incoming>
      <bpmn:outgoing>Flow_Staging_Prod</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProdDeploy" name="Triển khai lên Production (Blue-Green Deploy)">
      <bpmn:incoming>Flow_Staging_Prod</bpmn:incoming>
      <bpmn:outgoing>Flow_Prod_Monitor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Monitor" name="Giám sát metrics sau deploy 30 phút">
      <bpmn:incoming>Flow_Prod_Monitor</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitor_GateHealth</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_HealthOK" name="Metrics hệ thống ổn định?">
      <bpmn:incoming>Flow_Monitor_GateHealth</bpmn:incoming>
      <bpmn:outgoing>Flow_MonitorOK_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_MonitorNo_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Rollback" name="Rollback về version trước — tạo Incident">
      <bpmn:incoming>Flow_MonitorNo_Rollback</bpmn:incoming>
      <bpmn:outgoing>Flow_Rollback_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ResolveIncident" name="Xử lý sự cố infrastructure &amp; incident">
      <bpmn:incoming>Flow_PerfNo_Optimize</bpmn:incoming>
      <bpmn:outgoing>Flow_Incident_Perf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SecurityScan" name="Quét lỗ hổng bảo mật (SAST/DAST)">
      <bpmn:incoming>Flow_Bugfix_ST2</bpmn:incoming>
      <bpmn:outgoing>Flow_Scan_GateSec</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_SecurityOK" name="Không có lỗ hổng nghiêm trọng?">
      <bpmn:incoming>Flow_Scan_GateSec</bpmn:incoming>
      <bpmn:outgoing>Flow_SecYes_Perf</bpmn:outgoing>
      <bpmn:outgoing>Flow_SecNo_Patch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PatchSecurity" name="Áp dụng bản vá bảo mật khẩn cấp">
      <bpmn:incoming>Flow_SecNo_Patch</bpmn:incoming>
      <bpmn:outgoing>Flow_Patch_Apply</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApplyPatch" name="Triển khai bản vá &amp; regression test">
      <bpmn:outgoing>Flow_Apply_GateApplied</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ApplyPatch_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PatchApplied" name="Bản vá được áp dụng thành công?">
      <bpmn:incoming>Flow_Apply_GateApplied</bpmn:incoming>
      <bpmn:outgoing>Flow_PatchYes_Story</bpmn:outgoing>
      <bpmn:outgoing>Flow_PatchNo_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S1_Story" sourceRef="StartEvent_FeatureReq" targetRef="Join_Task_CreateStory_1" />
    <bpmn:sequenceFlow id="Flow_Story_Prioritize" sourceRef="Task_CreateStory" targetRef="Task_Prioritize" />
    <bpmn:sequenceFlow id="Flow_Prioritize_Gate" sourceRef="Task_Prioritize" targetRef="Gate_PrioritizeOK" />
    <bpmn:sequenceFlow id="Flow_PrioYes_Design" name="Chấp nhận" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_Design_1" />
    <bpmn:sequenceFlow id="Flow_PrioNo_Reject" name="Từ chối" sourceRef="Gate_PrioritizeOK" targetRef="Join_Task_CreateStory_1" />
    <bpmn:sequenceFlow id="Flow_Design_GateReview" sourceRef="Task_Design" targetRef="Gate_DesignReview" />
    <bpmn:sequenceFlow id="Flow_DesignYes_Code" name="Phê duyệt" sourceRef="Gate_DesignReview" targetRef="Join_Task_Code_1" />
    <bpmn:sequenceFlow id="Flow_DesignNo_Rework" name="Cần sửa" sourceRef="Gate_DesignReview" targetRef="Join_Task_Design_1" />
    <bpmn:sequenceFlow id="Flow_Code_UnitTest" sourceRef="Task_Code" targetRef="Task_UnitTest" />
    <bpmn:sequenceFlow id="Flow_Unit_GateTest" sourceRef="Task_UnitTest" targetRef="Gate_UnitTestPass" />
    <bpmn:sequenceFlow id="Flow_UnitYes_ST" name="Pass" sourceRef="Gate_UnitTestPass" targetRef="Join_Task_ST_1" />
    <bpmn:sequenceFlow id="Flow_UnitNo_Fix" name="Fail — sửa" sourceRef="Gate_UnitTestPass" targetRef="Join_Task_Code_1" />
    <bpmn:sequenceFlow id="Flow_ST_GateQA" sourceRef="Task_ST" targetRef="Gate_QAPass" />
    <bpmn:sequenceFlow id="Flow_QAYes_Perf" name="Pass" sourceRef="Gate_QAPass" targetRef="Join_Task_PerfTest_1" />
    <bpmn:sequenceFlow id="Flow_QANo_Bugfix" name="Fail — sửa lỗi" sourceRef="Gate_QAPass" targetRef="Task_Bugfix" />
    <bpmn:sequenceFlow id="Flow_Bugfix_ST" sourceRef="Split_Task_Bugfix_1" targetRef="Join_Task_ST_1" />
    <bpmn:sequenceFlow id="Flow_Bugfix_ST2" sourceRef="Split_Task_Bugfix_1" targetRef="Task_SecurityScan" />
    <bpmn:sequenceFlow id="Flow_Perf_GatePerf" sourceRef="Task_PerfTest" targetRef="Gate_PerfOK" />
    <bpmn:sequenceFlow id="Flow_PerfYes_Demo" name="Pass" sourceRef="Gate_PerfOK" targetRef="Task_DemoFeature" />
    <bpmn:sequenceFlow id="Flow_PerfNo_Optimize" name="Fail — tối ưu" sourceRef="Gate_PerfOK" targetRef="Task_ResolveIncident" />
    <bpmn:sequenceFlow id="Flow_Incident_Perf" sourceRef="Task_ResolveIncident" targetRef="Join_Task_PerfTest_1" />
    <bpmn:sequenceFlow id="Flow_Demo_GateDemo" sourceRef="Task_DemoFeature" targetRef="Gate_DemoOK" />
    <bpmn:sequenceFlow id="Flow_DemoYes_Deploy" name="Chấp nhận" sourceRef="Gate_DemoOK" targetRef="Task_PreStagingDeploy" />
    <bpmn:sequenceFlow id="Flow_DemoNo_Fix" name="Yêu cầu sửa" sourceRef="Gate_DemoOK" targetRef="Join_Task_Code_1" />
    <bpmn:sequenceFlow id="Flow_PreStaging_Staging" sourceRef="Task_PreStagingDeploy" targetRef="Task_StagingDeploy" />
    <bpmn:sequenceFlow id="Flow_Staging_Prod" sourceRef="Task_StagingDeploy" targetRef="Task_ProdDeploy" />
    <bpmn:sequenceFlow id="Flow_Prod_Monitor" sourceRef="Task_ProdDeploy" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="Flow_Monitor_GateHealth" sourceRef="Task_Monitor" targetRef="Gate_HealthOK" />
    <bpmn:sequenceFlow id="Flow_MonitorOK_End" name="Ổn định" sourceRef="Gate_HealthOK" targetRef="EndEvent_Deployed" />
    <bpmn:sequenceFlow id="Flow_MonitorNo_Rollback" name="Lỗi — Rollback" sourceRef="Gate_HealthOK" targetRef="Task_Rollback" />
    <bpmn:sequenceFlow id="Flow_Rollback_End" sourceRef="Task_Rollback" targetRef="EndEvent_Rollback" />
    <bpmn:sequenceFlow id="Flow_Scan_GateSec" sourceRef="Task_SecurityScan" targetRef="Gate_SecurityOK" />
    <bpmn:sequenceFlow id="Flow_SecYes_Perf" name="An toàn" sourceRef="Gate_SecurityOK" targetRef="Join_Task_PerfTest_1" />
    <bpmn:sequenceFlow id="Flow_SecNo_Patch" name="Có lỗ hổng" sourceRef="Gate_SecurityOK" targetRef="Task_PatchSecurity" />
    <bpmn:sequenceFlow id="Flow_Patch_Apply" sourceRef="Task_PatchSecurity" targetRef="Join_Task_ApplyPatch_1" />
    <bpmn:sequenceFlow id="Flow_Apply_GateApplied" sourceRef="Task_ApplyPatch" targetRef="Gate_PatchApplied" />
    <bpmn:sequenceFlow id="Flow_PatchYes_Story" name="Thành công" sourceRef="Gate_PatchApplied" targetRef="Join_Task_CreateStory_1" />
    <bpmn:sequenceFlow id="Flow_PatchNo_Retry" name="Thất bại — thử lại" sourceRef="Gate_PatchApplied" targetRef="Join_Task_ApplyPatch_1" />
    <bpmn:sequenceFlow id="Flow_Join_Task_CreateStory_in" sourceRef="Join_Task_CreateStory_1" targetRef="Task_CreateStory" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Design_in" sourceRef="Join_Task_Design_1" targetRef="Task_Design" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Code_in" sourceRef="Join_Task_Code_1" targetRef="Task_Code" />
    <bpmn:sequenceFlow id="Flow_Join_Task_ST_in" sourceRef="Join_Task_ST_1" targetRef="Task_ST" />
    <bpmn:sequenceFlow id="Flow_Join_Task_PerfTest_in" sourceRef="Join_Task_PerfTest_1" targetRef="Task_PerfTest" />
    <bpmn:sequenceFlow id="Flow_Join_Task_ApplyPatch_in" sourceRef="Join_Task_ApplyPatch_1" targetRef="Task_ApplyPatch" />
    <bpmn:sequenceFlow id="Flow_Task_Bugfix_to_Split_Task_Bugfix_1" sourceRef="Task_Bugfix" targetRef="Split_Task_Bugfix_1" />
    <bpmn:exclusiveGateway id="Join_Task_CreateStory_1" name="Gom luồng trước khi Tạo User Story &amp; acceptance criteria">
      <bpmn:incoming>Flow_S1_Story</bpmn:incoming>
      <bpmn:incoming>Flow_PrioNo_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_PatchYes_Story</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_CreateStory_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_Design_1" name="Gom luồng trước khi Thiết kế kiến trúc &amp; API cho tính năng">
      <bpmn:incoming>Flow_PrioYes_Design</bpmn:incoming>
      <bpmn:incoming>Flow_DesignNo_Rework</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Design_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_Code_1" name="Gom luồng trước khi Viết code theo User Story &amp; unit test">
      <bpmn:incoming>Flow_DesignYes_Code</bpmn:incoming>
      <bpmn:incoming>Flow_UnitNo_Fix</bpmn:incoming>
      <bpmn:incoming>Flow_DemoNo_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Code_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_ST_1" name="Gom luồng trước khi Thực hiện System Test &amp; Integration Test">
      <bpmn:incoming>Flow_UnitYes_ST</bpmn:incoming>
      <bpmn:incoming>Flow_Bugfix_ST</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ST_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_PerfTest_1" name="Gom luồng trước khi Performance test &amp; load test">
      <bpmn:incoming>Flow_QAYes_Perf</bpmn:incoming>
      <bpmn:incoming>Flow_Incident_Perf</bpmn:incoming>
      <bpmn:incoming>Flow_SecYes_Perf</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_PerfTest_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_ApplyPatch_1" name="Gom luồng trước khi Triển khai bản vá &amp; regression test">
      <bpmn:incoming>Flow_Patch_Apply</bpmn:incoming>
      <bpmn:incoming>Flow_PatchNo_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ApplyPatch_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Split_Task_Bugfix_1" name="Phân luồng sau khi Sửa lỗi QA phát hiện &amp; regression test">
      <bpmn:outgoing>Flow_Bugfix_ST</bpmn:outgoing>
      <bpmn:outgoing>Flow_Bugfix_ST2</bpmn:outgoing>
      <bpmn:incoming>Flow_Task_Bugfix_to_Split_Task_Bugfix_1</bpmn:incoming>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
    <ns1:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ITPlatform">
      <ns1:BPMNShape id="Lane_PO_di" bpmnElement="Lane_PO">
        <ns2:Bounds x="30" y="0" width="6746" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Dev_di" bpmnElement="Lane_Dev">
        <ns2:Bounds x="30" y="200" width="6746" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_QA_di" bpmnElement="Lane_QA">
        <ns2:Bounds x="30" y="400" width="6746" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_DevOps_di" bpmnElement="Lane_DevOps">
        <ns2:Bounds x="30" y="600" width="6746" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Lane_Security_di" bpmnElement="Lane_Security">
        <ns2:Bounds x="30" y="800" width="6746" height="200" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="StartEvent_FeatureReq_di" bpmnElement="StartEvent_FeatureReq">
        <ns2:Bounds x="80" y="82" width="36" height="36" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Task_CreateStory_di" bpmnElement="Task_CreateStory">
        <ns2:Bounds x="520" y="65" width="110" height="70" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Task_Prioritize_di" bpmnElement="Task_Prioritize">
        <ns2:Bounds x="740" y="65" width="110" height="70" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Gate_PrioritizeOK_di" bpmnElement="Gate_PrioritizeOK">
        <ns2:Bounds x="960" y="77" width="46" height="46" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Task_DemoFeature_di" bpmnElement="Task_DemoFeature">
        <ns2:Bounds x="4920" y="65" width="110" height="70" />
      </ns1:BPMNShape>
      <ns1:BPMNShape id="Gate_DemoOK_di" bpmnElement="Gate_DemoOK">
        <ns2:Bounds x="5140" y="77" width="46" height="46" />
