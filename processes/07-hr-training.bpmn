<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HRTraining" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_HRTraining" name="Quy trình Quản lý Nhân sự &amp; Đào tạo" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_HR" name="HR Team">
        <bpmn:flowNodeRef>StartEvent_Q1Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PlanApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCertValidity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_CertValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogViolation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Violation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_University" name="Lazada University">
        <bpmn:flowNodeRef>Task_BuildContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ContentApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_EnrollmentOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueCert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Seller" name="Seller / Nhân viên">
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Study</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ExamPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinanceReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BudgetOK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Compliance">
        <bpmn:flowNodeRef>Task_AuditCompliance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ViolationFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SeverityHigh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnforceAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuspendSeller</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Q1Plan" name="Nhu cầu đào tạo đầu quý">
      <bpmn:outgoing>Flow_S1_Create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreatePlan" name="Lập kế hoạch đào tạo theo quý">
      <bpmn:incoming>Flow_Join_Task_CreatePlan_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SubmitPlan" name="Giám đốc HR phê duyệt kế hoạch đào tạo">
      <bpmn:incoming>Flow_Create_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_GatePlan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PlanApproved" name="Kế hoạch đào tạo được phê duyệt?">
      <bpmn:incoming>Flow_Submit_GatePlan</bpmn:incoming>
      <bpmn:outgoing>Flow_PlanYes_Budget</bpmn:outgoing>
      <bpmn:outgoing>Flow_PlanNo_Rewrite</bpmn:outgoing>
      <bpmn:outgoing>Flow_PlanYes_Budget2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckCertValidity" name="Kiểm tra chứng chỉ hiện tại còn hiệu lực?">
      <bpmn:incoming>Flow_BudgetYes_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_GateCert</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_CertValid" name="Chứng chỉ hiện tại còn hiệu lực?">
      <bpmn:incoming>Flow_Check_GateCert</bpmn:incoming>
      <bpmn:outgoing>Flow_CertYes_Skip</bpmn:outgoing>
      <bpmn:outgoing>Flow_CertNo_Update</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UpdateCert" name="Cập nhật chứng chỉ đào tạo cho nhân viên/Seller">
      <bpmn:incoming>Flow_Join_Task_UpdateCert_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_Evaluate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_LogViolation" name="Ghi nhận nhật ký vi phạm chính sách đào tạo">
      <bpmn:incoming>Flow_Join_Task_LogViolation_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_EndViolation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Evaluate" name="Đánh giá hiệu quả đào tạo sau khóa học">
      <bpmn:incoming>Flow_Update_Evaluate</bpmn:incoming>
      <bpmn:outgoing>Flow_Eval_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Complete" name="Chương trình đào tạo đã hoàn tất">
      <bpmn:incoming>Flow_Eval_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Violation" name="Vi phạm chính sách đã được xử lý">
      <bpmn:incoming>Flow_Log_EndViolation</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_BuildContent" name="Xây dựng nội dung khóa học (onboarding, nâng cao, compliance)">
      <bpmn:incoming>Flow_Join_Task_BuildContent_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Build_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewContent" name="Chuyên gia nội dung đánh giá &amp; phê duyệt khóa học">
      <bpmn:incoming>Flow_Build_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_GateContent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_ContentApproved" name="Nội dung khóa học đạt chuẩn?">
      <bpmn:incoming>Flow_Review_GateContent</bpmn:incoming>
      <bpmn:outgoing>Flow_ContentYes_Publish</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContentNo_Revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Publish" name="Publish khóa học lên Lazada University">
      <bpmn:incoming>Flow_Join_Task_Publish_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Publish_to_Split_Task_Publish_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_EnrollmentOK" name="Đủ số lượng người đăng ký tham gia?">
      <bpmn:incoming>Flow_Publish_GateEnroll</bpmn:incoming>
      <bpmn:outgoing>Flow_EnrollYes_Reg</bpmn:outgoing>
      <bpmn:outgoing>Flow_EnrollNo_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_IssueCert" name="Cấp chứng chỉ hoàn thành khóa học">
      <bpmn:incoming>Flow_ExamYes_Cert</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueCert_Update</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Register" name="Seller/Nhân viên đăng ký tham gia khóa học">
      <bpmn:incoming>Flow_EnrollYes_Reg</bpmn:incoming>
      <bpmn:outgoing>Flow_Reg_Study</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Study" name="Hoàn thành các module học tập trên hệ thống">
      <bpmn:incoming>Flow_Join_Task_Study_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Study_Exam</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Exam" name="Thi đánh giá kiến thức sau khóa học">
      <bpmn:incoming>Flow_Study_Exam</bpmn:incoming>
      <bpmn:outgoing>Flow_Exam_GatePass</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_ExamPass" name="Đạt điểm yêu cầu (≥70%)?">
      <bpmn:incoming>Flow_Exam_GatePass</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamYes_Cert</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExamNo_Retake</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FinanceReview" name="Phòng Tài chính duyệt ngân sách đào tạo">
      <bpmn:incoming>Flow_PlanYes_Budget2</bpmn:incoming>
      <bpmn:outgoing>Flow_Finance_GateBudget</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_BudgetOK" name="Ngân sách đào tạo được duyệt?">
      <bpmn:incoming>Flow_Finance_GateBudget</bpmn:incoming>
      <bpmn:outgoing>Flow_BudgetYes_Check</bpmn:outgoing>
      <bpmn:outgoing>Flow_BudgetNo_Hold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AuditCompliance" name="Kiểm tra tuân thủ chính sách đào tạo định kỳ">
      <bpmn:incoming>Flow_Publish_Compliance</bpmn:incoming>
      <bpmn:outgoing>Flow_Audit_GateViolation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_ViolationFound" name="Phát hiện vi phạm chính sách?">
      <bpmn:incoming>Flow_Audit_GateViolation</bpmn:incoming>
      <bpmn:outgoing>Flow_ViolYes_Severity</bpmn:outgoing>
      <bpmn:outgoing>Flow_ViolNo_Clear</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_SeverityHigh" name="Mức độ vi phạm nghiêm trọng?">
      <bpmn:incoming>Flow_ViolYes_Severity</bpmn:incoming>
      <bpmn:outgoing>Flow_SeverityHigh_Suspend</bpmn:outgoing>
      <bpmn:outgoing>Flow_SeverityLow_Enforce</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EnforceAction" name="Áp dụng biện pháp xử lý cảnh cáo">
      <bpmn:incoming>Flow_SeverityLow_Enforce</bpmn:incoming>
      <bpmn:outgoing>Flow_Enforce_Log</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SuspendSeller" name="Đình chỉ quyền truy cập Seller vi phạm nghiêm trọng">
      <bpmn:incoming>Flow_SeverityHigh_Suspend</bpmn:incoming>
      <bpmn:outgoing>Flow_Suspend_Log</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S1_Create" sourceRef="StartEvent_Q1Plan" targetRef="Join_Task_CreatePlan_1" />
    <bpmn:sequenceFlow id="Flow_Create_Submit" sourceRef="Task_CreatePlan" targetRef="Task_SubmitPlan" />
    <bpmn:sequenceFlow id="Flow_Submit_GatePlan" sourceRef="Task_SubmitPlan" targetRef="Gate_PlanApproved" />
    <bpmn:sequenceFlow id="Flow_PlanYes_Budget" name="Phê duyệt" sourceRef="Gate_PlanApproved" targetRef="Join_Task_BuildContent_1" />
    <bpmn:sequenceFlow id="Flow_PlanNo_Rewrite" name="Yêu cầu chỉnh sửa" sourceRef="Gate_PlanApproved" targetRef="Join_Task_CreatePlan_1" />
    <bpmn:sequenceFlow id="Flow_Build_Review" sourceRef="Task_BuildContent" targetRef="Task_ReviewContent" />
    <bpmn:sequenceFlow id="Flow_Review_GateContent" sourceRef="Task_ReviewContent" targetRef="Gate_ContentApproved" />
    <bpmn:sequenceFlow id="Flow_ContentYes_Publish" name="Đạt chuẩn" sourceRef="Gate_ContentApproved" targetRef="Join_Task_Publish_1" />
    <bpmn:sequenceFlow id="Flow_ContentNo_Revise" name="Cần chỉnh sửa" sourceRef="Gate_ContentApproved" targetRef="Join_Task_BuildContent_1" />
    <bpmn:sequenceFlow id="Flow_Publish_GateEnroll" sourceRef="Split_Task_Publish_1" targetRef="Gate_EnrollmentOK" />
    <bpmn:sequenceFlow id="Flow_Publish_Compliance" sourceRef="Split_Task_Publish_1" targetRef="Task_AuditCompliance" />
    <bpmn:sequenceFlow id="Flow_EnrollYes_Reg" name="Đủ đăng ký" sourceRef="Gate_EnrollmentOK" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_EnrollNo_Wait" name="Chưa đủ — chờ đăng ký thêm" sourceRef="Gate_EnrollmentOK" targetRef="Join_Task_Publish_1" />
    <bpmn:sequenceFlow id="Flow_Reg_Study" sourceRef="Task_Register" targetRef="Join_Task_Study_1" />
    <bpmn:sequenceFlow id="Flow_Study_Exam" sourceRef="Task_Study" targetRef="Task_Exam" />
    <bpmn:sequenceFlow id="Flow_Exam_GatePass" sourceRef="Task_Exam" targetRef="Gate_ExamPass" />
    <bpmn:sequenceFlow id="Flow_ExamYes_Cert" name="Đạt" sourceRef="Gate_ExamPass" targetRef="Task_IssueCert" />
    <bpmn:sequenceFlow id="Flow_ExamNo_Retake" name="Không đạt — học lại" sourceRef="Gate_ExamPass" targetRef="Join_Task_Study_1" />
    <bpmn:sequenceFlow id="Flow_IssueCert_Update" sourceRef="Task_IssueCert" targetRef="Join_Task_UpdateCert_1" />
    <bpmn:sequenceFlow id="Flow_Update_Evaluate" sourceRef="Task_UpdateCert" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_Eval_End" sourceRef="Task_Evaluate" targetRef="EndEvent_Complete" />
    <bpmn:sequenceFlow id="Flow_PlanYes_Budget2" name="Phê duyệt" sourceRef="Gate_PlanApproved" targetRef="Task_FinanceReview" />
    <bpmn:sequenceFlow id="Flow_Finance_GateBudget" sourceRef="Task_FinanceReview" targetRef="Gate_BudgetOK" />
    <bpmn:sequenceFlow id="Flow_BudgetYes_Check" name="Duyệt ngân sách" sourceRef="Gate_BudgetOK" targetRef="Task_CheckCertValidity" />
    <bpmn:sequenceFlow id="Flow_BudgetNo_Hold" name="Từ chối — tạm hoãn" sourceRef="Gate_BudgetOK" targetRef="Join_Task_CreatePlan_1" />
    <bpmn:sequenceFlow id="Flow_Check_GateCert" sourceRef="Task_CheckCertValidity" targetRef="Gate_CertValid" />
    <bpmn:sequenceFlow id="Flow_CertYes_Skip" name="Còn hiệu lực — bỏ qua" sourceRef="Gate_CertValid" targetRef="Join_Task_UpdateCert_1" />
    <bpmn:sequenceFlow id="Flow_CertNo_Update" name="Hết hạn — cập nhật mới" sourceRef="Gate_CertValid" targetRef="Join_Task_BuildContent_1" />
    <bpmn:sequenceFlow id="Flow_Audit_GateViolation" sourceRef="Task_AuditCompliance" targetRef="Gate_ViolationFound" />
    <bpmn:sequenceFlow id="Flow_ViolYes_Severity" name="Có vi phạm" sourceRef="Gate_ViolationFound" targetRef="Gate_SeverityHigh" />
    <bpmn:sequenceFlow id="Flow_ViolNo_Clear" name="Không vi phạm" sourceRef="Gate_ViolationFound" targetRef="Join_Task_UpdateCert_1" />
    <bpmn:sequenceFlow id="Flow_SeverityHigh_Suspend" name="Nghiêm trọng" sourceRef="Gate_SeverityHigh" targetRef="Task_SuspendSeller" />
    <bpmn:sequenceFlow id="Flow_SeverityLow_Enforce" name="Nhẹ — cảnh cáo" sourceRef="Gate_SeverityHigh" targetRef="Task_EnforceAction" />
    <bpmn:sequenceFlow id="Flow_Enforce_Log" sourceRef="Task_EnforceAction" targetRef="Join_Task_LogViolation_1" />
    <bpmn:sequenceFlow id="Flow_Suspend_Log" sourceRef="Task_SuspendSeller" targetRef="Join_Task_LogViolation_1" />
    <bpmn:sequenceFlow id="Flow_Log_EndViolation" sourceRef="Task_LogViolation" targetRef="EndEvent_Violation" />
    <bpmn:sequenceFlow id="Flow_Join_Task_CreatePlan_in" sourceRef="Join_Task_CreatePlan_1" targetRef="Task_CreatePlan" />
    <bpmn:sequenceFlow id="Flow_Join_Task_UpdateCert_in" sourceRef="Join_Task_UpdateCert_1" targetRef="Task_UpdateCert" />
    <bpmn:sequenceFlow id="Flow_Join_Task_LogViolation_in" sourceRef="Join_Task_LogViolation_1" targetRef="Task_LogViolation" />
    <bpmn:sequenceFlow id="Flow_Join_Task_BuildContent_in" sourceRef="Join_Task_BuildContent_1" targetRef="Task_BuildContent" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Publish_in" sourceRef="Join_Task_Publish_1" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_Task_Publish_to_Split_Task_Publish_1" sourceRef="Task_Publish" targetRef="Split_Task_Publish_1" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Study_in" sourceRef="Join_Task_Study_1" targetRef="Task_Study" />
    <bpmn:exclusiveGateway id="Join_Task_CreatePlan_1" name="Gom luồn trước khi Lập kế hoạch">
      <bpmn:incoming>Flow_S1_Create</bpmn:incoming>
      <bpmn:incoming>Flow_PlanNo_Rewrite</bpmn:incoming>
      <bpmn:incoming>Flow_BudgetNo_Hold</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_CreatePlan_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_UpdateCert_1" name="Gom luồn trước khi Cập nhật chứng chỉ">
      <bpmn:incoming>Flow_IssueCert_Update</bpmn:incoming>
      <bpmn:incoming>Flow_CertYes_Skip</bpmn:incoming>
      <bpmn:incoming>Flow_ViolNo_Clear</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_UpdateCert_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_LogViolation_1" name="Gom luồn trước khi Ghi nhận vi phạm">
      <bpmn:incoming>Flow_Enforce_Log</bpmn:incoming>
      <bpmn:incoming>Flow_Suspend_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_LogViolation_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_BuildContent_1" name="Gom luồn trước khi Xây dựng nội dung">
      <bpmn:incoming>Flow_PlanYes_Budget</bpmn:incoming>
      <bpmn:incoming>Flow_ContentNo_Revise</bpmn:incoming>
      <bpmn:incoming>Flow_CertNo_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_BuildContent_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_Publish_1" name="Gom luồn trước khi Publish khóa học">
      <bpmn:incoming>Flow_ContentYes_Publish</bpmn:incoming>
      <bpmn:incoming>Flow_EnrollNo_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Publish_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Split_Task_Publish_1" name="Phân luồn sau khi Publish khóa học">
      <bpmn:incoming>Flow_Task_Publish_to_Split_Task_Publish_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_GateEnroll</bpmn:outgoing>
      <bpmn:outgoing>Flow_Publish_Compliance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Join_Task_Study_1" name="Gom luồn trước khi Học tập">
      <bpmn:incoming>Flow_Reg_Study</bpmn:incoming>
      <bpmn:incoming>Flow_ExamNo_Retake</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Study_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
