<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HRTraining" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_HRTraining" name="Quy trình Quản lý Nhân sự &amp; Đào tạo" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_HR" name="HR Team">
        <ns0:flowNodeRef>StartEvent_Q1Plan</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CreatePlan</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SubmitPlan</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PlanApproved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CheckCertValidity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_CertValid</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UpdateCert</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LogViolation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Evaluate</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Complete</ns0:flowNodeRef>
        <ns0:flowNodeRef>EndEvent_Violation</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_University" name="Lazada University">
        <ns0:flowNodeRef>Task_BuildContent</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReviewContent</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ContentApproved</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Publish</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_EnrollmentOK</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_IssueCert</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller / Nhân viên">
        <ns0:flowNodeRef>Task_Register</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Study</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Exam</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ExamPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FinanceReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BudgetOK</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Compliance" name="Compliance">
        <ns0:flowNodeRef>Task_AuditCompliance</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ViolationFound</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SeverityHigh</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_EnforceAction</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SuspendSeller</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Q1Plan" name="Nhu cầu đào tạo đầu quý">
      <ns0:outgoing>Flow_S1_Create</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_CreatePlan" name="Lập kế hoạch đào tạo theo quý">
      <ns0:incoming>Flow_Join_Task_CreatePlan_in</ns0:incoming>
      <ns0:outgoing>Flow_Create_Submit</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SubmitPlan" name="Giám đốc HR phê duyệt kế hoạch đào tạo">
      <ns0:incoming>Flow_Create_Submit</ns0:incoming>
      <ns0:outgoing>Flow_Submit_GatePlan</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PlanApproved" name="Kế hoạch đào tạo được phê duyệt?">
      <ns0:incoming>Flow_Submit_GatePlan</ns0:incoming>
      <ns0:outgoing>Flow_PlanYes_Budget</ns0:outgoing>
      <ns0:outgoing>Flow_PlanNo_Rewrite</ns0:outgoing>
      <ns0:outgoing>Flow_PlanYes_Budget2</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_CheckCertValidity" name="Kiểm tra chứng chỉ hiện tại còn hiệu lực?">
      <ns0:incoming>Flow_BudgetYes_Check</ns0:incoming>
      <ns0:outgoing>Flow_Check_GateCert</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_CertValid" name="Chứng chỉ hiện tại còn hiệu lực?">
      <ns0:incoming>Flow_Check_GateCert</ns0:incoming>
      <ns0:outgoing>Flow_CertYes_Skip</ns0:outgoing>
      <ns0:outgoing>Flow_CertNo_Update</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_UpdateCert" name="Cập nhật chứng chỉ đào tạo cho nhân viên/Seller">
      <ns0:incoming>Flow_Join_Task_UpdateCert_in</ns0:incoming>
      <ns0:outgoing>Flow_Update_Evaluate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_LogViolation" name="Ghi nhận nhật ký vi phạm chính sách đào tạo">
      <ns0:incoming>Flow_Join_Task_LogViolation_in</ns0:incoming>
      <ns0:outgoing>Flow_Log_EndViolation</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Evaluate" name="Đánh giá hiệu quả đào tạo sau khóa học">
      <ns0:incoming>Flow_Update_Evaluate</ns0:incoming>
      <ns0:outgoing>Flow_Eval_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="EndEvent_Complete" name="Chương trình đào tạo đã hoàn tất">
      <ns0:incoming>Flow_Eval_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="EndEvent_Violation" name="Vi phạm chính sách đã được xử lý">
      <ns0:incoming>Flow_Log_EndViolation</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Task_BuildContent" name="Xây dựng nội dung khóa học (onboarding, nâng cao, compliance)">
      <ns0:incoming>Flow_Join_Task_BuildContent_in</ns0:incoming>
      <ns0:outgoing>Flow_Build_Review</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReviewContent" name="Chuyên gia nội dung đánh giá &amp; phê duyệt khóa học">
      <ns0:incoming>Flow_Build_Review</ns0:incoming>
      <ns0:outgoing>Flow_Review_GateContent</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_ContentApproved" name="Nội dung khóa học đạt chuẩn?">
      <ns0:incoming>Flow_Review_GateContent</ns0:incoming>
      <ns0:outgoing>Flow_ContentYes_Publish</ns0:outgoing>
      <ns0:outgoing>Flow_ContentNo_Revise</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_Publish" name="Publish khóa học lên Lazada University">
      <ns0:incoming>Flow_Join_Task_Publish_in</ns0:incoming>
      <ns0:outgoing>Flow_Task_Publish_to_Split_Task_Publish_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_EnrollmentOK" name="Đủ số lượng người đăng ký tham gia?">
      <ns0:incoming>Flow_Publish_GateEnroll</ns0:incoming>
      <ns0:outgoing>Flow_EnrollYes_Reg</ns0:outgoing>
      <ns0:outgoing>Flow_EnrollNo_Wait</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_IssueCert" name="Cấp chứng chỉ hoàn thành khóa học">
      <ns0:incoming>Flow_ExamYes_Cert</ns0:incoming>
      <ns0:outgoing>Flow_IssueCert_Update</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Register" name="Seller/Nhân viên đăng ký tham gia khóa học">
      <ns0:incoming>Flow_EnrollYes_Reg</ns0:incoming>
      <ns0:outgoing>Flow_Reg_Study</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Study" name="Hoàn thành các module học tập trên hệ thống">
      <ns0:incoming>Flow_Join_Task_Study_in</ns0:incoming>
      <ns0:outgoing>Flow_Study_Exam</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Exam" name="Thi đánh giá kiến thức sau khóa học">
      <ns0:incoming>Flow_Study_Exam</ns0:incoming>
      <ns0:outgoing>Flow_Exam_GatePass</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_ExamPass" name="Đạt điểm yêu cầu (≥70%)?">
      <ns0:incoming>Flow_Exam_GatePass</ns0:incoming>
      <ns0:outgoing>Flow_ExamYes_Cert</ns0:outgoing>
      <ns0:outgoing>Flow_ExamNo_Retake</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_FinanceReview" name="Phòng Tài chính duyệt ngân sách đào tạo">
      <ns0:incoming>Flow_PlanYes_Budget2</ns0:incoming>
      <ns0:outgoing>Flow_Finance_GateBudget</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_BudgetOK" name="Ngân sách đào tạo được duyệt?">
      <ns0:incoming>Flow_Finance_GateBudget</ns0:incoming>
      <ns0:outgoing>Flow_BudgetYes_Check</ns0:outgoing>
      <ns0:outgoing>Flow_BudgetNo_Hold</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_AuditCompliance" name="Kiểm tra tuân thủ chính sách đào tạo định kỳ">
      <ns0:incoming>Flow_Publish_Compliance</ns0:incoming>
      <ns0:outgoing>Flow_Audit_GateViolation</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_ViolationFound" name="Phát hiện vi phạm chính sách?">
      <ns0:incoming>Flow_Audit_GateViolation</ns0:incoming>
      <ns0:outgoing>Flow_ViolYes_Severity</ns0:outgoing>
      <ns0:outgoing>Flow_ViolNo_Clear</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SeverityHigh" name="Mức độ vi phạm nghiêm trọng?">
      <ns0:incoming>Flow_ViolYes_Severity</ns0:incoming>
      <ns0:outgoing>Flow_SeverityHigh_Suspend</ns0:outgoing>
      <ns0:outgoing>Flow_SeverityLow_Enforce</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_EnforceAction" name="Áp dụng biện pháp xử lý cảnh cáo">
      <ns0:incoming>Flow_SeverityLow_Enforce</ns0:incoming>
      <ns0:outgoing>Flow_Enforce_Log</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SuspendSeller" name="Đình chỉ quyền truy cập Seller vi phạm nghiêm trọng">
      <ns0:incoming>Flow_SeverityHigh_Suspend</ns0:incoming>
      <ns0:outgoing>Flow_Suspend_Log</ns0:outgoing>
    </ns0:userTask>
    <ns0:sequenceFlow id="Flow_S1_Create" sourceRef="StartEvent_Q1Plan" targetRef="Join_Task_CreatePlan_1" />
    <ns0:sequenceFlow id="Flow_Create_Submit" sourceRef="Task_CreatePlan" targetRef="Task_SubmitPlan" />
    <ns0:sequenceFlow id="Flow_Submit_GatePlan" sourceRef="Task_SubmitPlan" targetRef="Gate_PlanApproved" />
    <ns0:sequenceFlow id="Flow_PlanYes_Budget" name="Phê duyệt" sourceRef="Gate_PlanApproved" targetRef="Join_Task_BuildContent_1" />
    <ns0:sequenceFlow id="Flow_PlanNo_Rewrite" name="Yêu cầu chỉnh sửa" sourceRef="Gate_PlanApproved" targetRef="Join_Task_CreatePlan_1" />
    <ns0:sequenceFlow id="Flow_Build_Review" sourceRef="Task_BuildContent" targetRef="Task_ReviewContent" />
    <ns0:sequenceFlow id="Flow_Review_GateContent" sourceRef="Task_ReviewContent" targetRef="Gate_ContentApproved" />
    <ns0:sequenceFlow id="Flow_ContentYes_Publish" name="Đạt chuẩn" sourceRef="Gate_ContentApproved" targetRef="Join_Task_Publish_1" />
    <ns0:sequenceFlow id="Flow_ContentNo_Revise" name="Cần chỉnh sửa" sourceRef="Gate_ContentApproved" targetRef="Join_Task_BuildContent_1" />
    <ns0:sequenceFlow id="Flow_Publish_GateEnroll" sourceRef="Split_Task_Publish_1" targetRef="Gate_EnrollmentOK" name="Đủ số lượng đăng ký" />
    <ns0:sequenceFlow id="Flow_Publish_Compliance" sourceRef="Split_Task_Publish_1" targetRef="Task_AuditCompliance" name="Kiểm tra tuân thủ" />
    <ns0:sequenceFlow id="Flow_EnrollYes_Reg" name="Đủ đăng ký" sourceRef="Gate_EnrollmentOK" targetRef="Task_Register" />
    <ns0:sequenceFlow id="Flow_EnrollNo_Wait" name="Chưa đủ — chờ đăng ký thêm" sourceRef="Gate_EnrollmentOK" targetRef="Join_Task_Publish_1" />
    <ns0:sequenceFlow id="Flow_Reg_Study" sourceRef="Task_Register" targetRef="Join_Task_Study_1" />
    <ns0:sequenceFlow id="Flow_Study_Exam" sourceRef="Task_Study" targetRef="Task_Exam" />
    <ns0:sequenceFlow id="Flow_Exam_GatePass" sourceRef="Task_Exam" targetRef="Gate_ExamPass" />
    <ns0:sequenceFlow id="Flow_ExamYes_Cert" name="Đạt" sourceRef="Gate_ExamPass" targetRef="Task_IssueCert" />
    <ns0:sequenceFlow id="Flow_ExamNo_Retake" name="Không đạt — học lại" sourceRef="Gate_ExamPass" targetRef="Join_Task_Study_1" />
    <ns0:sequenceFlow id="Flow_IssueCert_Update" sourceRef="Task_IssueCert" targetRef="Join_Task_UpdateCert_1" />
    <ns0:sequenceFlow id="Flow_Update_Evaluate" sourceRef="Task_UpdateCert" targetRef="Task_Evaluate" />
    <ns0:sequenceFlow id="Flow_Eval_End" sourceRef="Task_Evaluate" targetRef="EndEvent_Complete" />
    <ns0:sequenceFlow id="Flow_PlanYes_Budget2" name="Phê duyệt" sourceRef="Gate_PlanApproved" targetRef="Task_FinanceReview" />
    <ns0:sequenceFlow id="Flow_Finance_GateBudget" sourceRef="Task_FinanceReview" targetRef="Gate_BudgetOK" />
    <ns0:sequenceFlow id="Flow_BudgetYes_Check" name="Duyệt ngân sách" sourceRef="Gate_BudgetOK" targetRef="Task_CheckCertValidity" />
    <ns0:sequenceFlow id="Flow_BudgetNo_Hold" name="Từ chối — tạm hoãn" sourceRef="Gate_BudgetOK" targetRef="Join_Task_CreatePlan_1" />
    <ns0:sequenceFlow id="Flow_Check_GateCert" sourceRef="Task_CheckCertValidity" targetRef="Gate_CertValid" />
    <ns0:sequenceFlow id="Flow_CertYes_Skip" name="Còn hiệu lực — bỏ qua" sourceRef="Gate_CertValid" targetRef="Join_Task_UpdateCert_1" />
    <ns0:sequenceFlow id="Flow_CertNo_Update" name="Hết hạn — cập nhật mới" sourceRef="Gate_CertValid" targetRef="Join_Task_BuildContent_1" />
    <ns0:sequenceFlow id="Flow_Audit_GateViolation" sourceRef="Task_AuditCompliance" targetRef="Gate_ViolationFound" />
    <ns0:sequenceFlow id="Flow_ViolYes_Severity" name="Có vi phạm" sourceRef="Gate_ViolationFound" targetRef="Gate_SeverityHigh" />
    <ns0:sequenceFlow id="Flow_ViolNo_Clear" name="Không vi phạm" sourceRef="Gate_ViolationFound" targetRef="Join_Task_UpdateCert_1" />
    <ns0:sequenceFlow id="Flow_SeverityHigh_Suspend" name="Nghiêm trọng" sourceRef="Gate_SeverityHigh" targetRef="Task_SuspendSeller" />
    <ns0:sequenceFlow id="Flow_SeverityLow_Enforce" name="Nhẹ — cảnh cáo" sourceRef="Gate_SeverityHigh" targetRef="Task_EnforceAction" />
    <ns0:sequenceFlow id="Flow_Enforce_Log" sourceRef="Task_EnforceAction" targetRef="Join_Task_LogViolation_1" />
    <ns0:sequenceFlow id="Flow_Suspend_Log" sourceRef="Task_SuspendSeller" targetRef="Join_Task_LogViolation_1" />
    <ns0:sequenceFlow id="Flow_Log_EndViolation" sourceRef="Task_LogViolation" targetRef="EndEvent_Violation" />
    <ns0:sequenceFlow id="Flow_Join_Task_CreatePlan_in" sourceRef="Join_Task_CreatePlan_1" targetRef="Task_CreatePlan" />
    <ns0:sequenceFlow id="Flow_Join_Task_UpdateCert_in" sourceRef="Join_Task_UpdateCert_1" targetRef="Task_UpdateCert" />
    <ns0:sequenceFlow id="Flow_Join_Task_LogViolation_in" sourceRef="Join_Task_LogViolation_1" targetRef="Task_LogViolation" />
    <ns0:sequenceFlow id="Flow_Join_Task_BuildContent_in" sourceRef="Join_Task_BuildContent_1" targetRef="Task_BuildContent" />
    <ns0:sequenceFlow id="Flow_Join_Task_Publish_in" sourceRef="Join_Task_Publish_1" targetRef="Task_Publish" />
    <ns0:sequenceFlow id="Flow_Task_Publish_to_Split_Task_Publish_1" sourceRef="Task_Publish" targetRef="Split_Task_Publish_1" />
    <ns0:sequenceFlow id="Flow_Join_Task_Study_in" sourceRef="Join_Task_Study_1" targetRef="Task_Study" />
    <ns0:exclusiveGateway id="Join_Task_CreatePlan_1" name="Gom luồn trước khi Lập kế hoạch">
      <ns0:incoming>Flow_S1_Create</ns0:incoming>
      <ns0:incoming>Flow_PlanNo_Rewrite</ns0:incoming>
      <ns0:incoming>Flow_BudgetNo_Hold</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_CreatePlan_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_UpdateCert_1" name="Gom luồn trước khi Cập nhật chứng chỉ">
      <ns0:incoming>Flow_IssueCert_Update</ns0:incoming>
      <ns0:incoming>Flow_CertYes_Skip</ns0:incoming>
      <ns0:incoming>Flow_ViolNo_Clear</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_UpdateCert_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_LogViolation_1" name="Gom luồn trước khi Ghi nhận vi phạm">
      <ns0:incoming>Flow_Enforce_Log</ns0:incoming>
      <ns0:incoming>Flow_Suspend_Log</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_LogViolation_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_BuildContent_1" name="Gom luồn trước khi Xây dựng nội dung">
      <ns0:incoming>Flow_PlanYes_Budget</ns0:incoming>
      <ns0:incoming>Flow_ContentNo_Revise</ns0:incoming>
      <ns0:incoming>Flow_CertNo_Update</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_BuildContent_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_Task_Publish_1" name="Gom luồn trước khi Publish khóa học">
      <ns0:incoming>Flow_ContentYes_Publish</ns0:incoming>
      <ns0:incoming>Flow_EnrollNo_Wait</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Publish_in</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:parallelGateway id="Split_Task_Publish_1" name="Phân luồn sau khi Publish khóa học">
      <ns0:incoming>Flow_Task_Publish_to_Split_Task_Publish_1</ns0:incoming>
      <ns0:outgoing>Flow_Publish_GateEnroll</ns0:outgoing>
      <ns0:outgoing>Flow_Publish_Compliance</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:exclusiveGateway id="Join_Task_Study_1" name="Gom luồn trước khi Học tập">
      <ns0:incoming>Flow_Reg_Study</ns0:incoming>
      <ns0:incoming>Flow_ExamNo_Retake</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_Study_in</ns0:outgoing>
    </ns0:exclusiveGateway>
  </ns0:process>
