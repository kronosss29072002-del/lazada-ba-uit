<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LogisticsDelivery" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_LogisticsDelivery" name="Quy trình Vận chuyển &amp; Giao nhận" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>StartEvent_OrderConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackageGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkParcel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System">
        <bpmn:flowNodeRef>Task_GenerateAWB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign3PL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_3PLAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3PL" name="LEX / 3PL (GHN, J&amp;T, Grab, NINJAVAN)">
        <bpmn:flowNodeRef>Task_PickupParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_PickupSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SortWarehouse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_SortOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TransitHub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OutForDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_FirstAttempt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipper" name="Shipper (Giao hàng)">
        <bpmn:flowNodeRef>Task_DeliverToBuyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DeliveredOrFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetryDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RetryCount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RescheduleDelivery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_AcceptGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReceive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_OrderConfirmed" name="Đơn hàng đã được xác nhận">
      <bpmn:outgoing>Flow_S1_Prep</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PrepareParcel" name="Seller chuẩn bị hàng hóa đóng gói">
      <bpmn:incoming>Flow_S1_Prep</bpmn:incoming>
      <bpmn:outgoing>Flow_Prep_Package</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PackageGoods" name="Đóng gói hàng hóa &amp; gắn nhãn vận chuyển">
      <bpmn:incoming>Flow_Prep_Package</bpmn:incoming>
      <bpmn:outgoing>Flow_Package_Schedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SchedulePickup" name="Đặt lịch hẹn lấy hàng từ 3PL">
      <bpmn:outgoing>Flow_Schedule_AWB</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_SchedulePickup_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReworkParcel" name="Seller đóng gói lại hàng hóa theo yêu cầu">
      <bpmn:incoming>Flow_Reschedule_Rework</bpmn:incoming>
      <bpmn:outgoing>Flow_Rework_Schedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Rework_Schedule" sourceRef="Task_ReworkParcel" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:userTask id="Task_SendTracking" name="Gửi mã theo dõi vận chuyển cho Buyer">
      <bpmn:incoming>Flow_Create_SendTrack</bpmn:incoming>
      <bpmn:outgoing>Flow_SendTrack_Transit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenerateAWB" name="Tạo vận đơn tự động (AWB)">
      <bpmn:incoming>Flow_Schedule_AWB</bpmn:incoming>
      <bpmn:outgoing>Flow_AWB_Assign</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Assign3PL" name="Phân công 3PL phù hợp (LEX/GHN/J&amp;T)">
      <bpmn:outgoing>Flow_Assign_Gate3PL</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_Assign3PL_in</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_3PLAvailable" name="3PL có slots nhận hàng?">
      <bpmn:incoming>Flow_Assign_Gate3PL</bpmn:incoming>
      <bpmn:outgoing>Flow_3PLYes_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_3PLNo_Reassign</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateShipment" name="Tạo lô hàng vận chuyển trên hệ thống">
      <bpmn:incoming>Flow_SortYes_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_SendTrack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReceiveReturn" name="Nhận hàng hoàn về từ 3PL (giao thất bại 3 lần)">
      <bpmn:outgoing>Flow_Return_End</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ReceiveReturn_in</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateCOD" name="Cập nhật trạng thái COD trên hệ thống">
      <bpmn:incoming>Flow_Confirm_COD</bpmn:incoming>
      <bpmn:outgoing>Flow_COD_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Delivered" name="Đơn hàng đã giao thành công">
      <bpmn:incoming>Flow_COD_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Returned" name="Hàng đã hoàn về Seller">
      <bpmn:incoming>Flow_Return_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PickupParcel" name="3PL nhận hàng từ kho Seller">
      <bpmn:incoming>Flow_3PLYes_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_GatePickup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PickupSuccess" name="3PL nhận hàng thành công?">
      <bpmn:incoming>Flow_Pickup_GatePickup</bpmn:incoming>
      <bpmn:outgoing>Flow_PickupYes_Sort</bpmn:outgoing>
      <bpmn:outgoing>Flow_PickupNo_Reschedule</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SortWarehouse" name="Phân loại hàng tại kho trung tâm 3PL">
      <bpmn:incoming>Flow_PickupYes_Sort</bpmn:incoming>
      <bpmn:outgoing>Flow_Sort_GateSort</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_SortOK" name="Phân loại chính xác (số AWB khớp)?">
      <bpmn:incoming>Flow_Sort_GateSort</bpmn:incoming>
      <bpmn:outgoing>Flow_SortYes_Create</bpmn:outgoing>
      <bpmn:outgoing>Flow_SortNo_Rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_TransitHub" name="Vận chuyển hàng qua các trung tâm phân loại">
      <bpmn:incoming>Flow_SendTrack_Transit</bpmn:incoming>
      <bpmn:outgoing>Flow_Transit_Out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_OutForDelivery" name="Hàng xuất kho — shipper nhận giao">
      <bpmn:incoming>Flow_Transit_Out</bpmn:incoming>
      <bpmn:outgoing>Flow_Out_GateFirst</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_FirstAttempt" name="Lần giao đầu tiên có thể thực hiện?">
      <bpmn:incoming>Flow_Out_GateFirst</bpmn:incoming>
      <bpmn:outgoing>Flow_FirstYes_Deliver</bpmn:outgoing>
      <bpmn:outgoing>Flow_FirstNo_Shipper</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DeliverToBuyer" name="Shipper giao hàng cho Buyer tại địa chỉ">
      <bpmn:incoming>Flow_FirstYes_Deliver</bpmn:incoming>
      <bpmn:outgoing>Flow_Deliver_GateResult</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_DeliveredOrFailed" name="Giao hàng thành công?">
      <bpmn:incoming>Flow_Deliver_GateResult</bpmn:incoming>
      <bpmn:outgoing>Flow_DeliverYes_Receive</bpmn:outgoing>
      <bpmn:outgoing>Flow_DeliverNo_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RetryDelivery" name="Hẹn giao lại lần tiếp theo">
      <bpmn:outgoing>Flow_Retry_GateCount</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_RetryDelivery_in</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_RetryCount" name="Đã thử giao ≥ 3 lần thất bại?">
      <bpmn:incoming>Flow_Retry_GateCount</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryCount_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RetryCount_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RescheduleDelivery" name="Chuyển hoàn hàng về kho Seller">
      <bpmn:incoming>Flow_Join_Task_RescheduleDelivery_in</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RescheduleDelivery_to_Split_Task_RescheduleDelivery_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveGoods" name="Buyer nhận hàng &amp; kiểm tra tại chỗ">
      <bpmn:incoming>Flow_DeliverYes_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_GateAccept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_AcceptGoods" name="Buyer chấp nhận hàng?">
      <bpmn:incoming>Flow_Receive_GateAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accept_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmReceive" name="Buyer xác nhận đã nhận hàng">
      <bpmn:incoming>Flow_Accept_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_COD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RejectGoods" name="Buyer từ chối nhận hàng (lý do)">
      <bpmn:incoming>Flow_Accept_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_Return</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S1_Prep" sourceRef="StartEvent_OrderConfirmed" targetRef="Task_PrepareParcel" />
    <bpmn:sequenceFlow id="Flow_Prep_Package" sourceRef="Task_PrepareParcel" targetRef="Task_PackageGoods" />
    <bpmn:sequenceFlow id="Flow_Package_Schedule" sourceRef="Task_PackageGoods" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:sequenceFlow id="Flow_Schedule_AWB" sourceRef="Task_SchedulePickup" targetRef="Task_GenerateAWB" />
    <bpmn:sequenceFlow id="Flow_AWB_Assign" sourceRef="Task_GenerateAWB" targetRef="Join_Task_Assign3PL_1" />
    <bpmn:sequenceFlow id="Flow_Assign_Gate3PL" sourceRef="Task_Assign3PL" targetRef="Gate_3PLAvailable" />
    <bpmn:sequenceFlow id="Flow_3PLYes_Pickup" name="Có slot" sourceRef="Gate_3PLAvailable" targetRef="Task_PickupParcel" />
    <bpmn:sequenceFlow id="Flow_3PLNo_Reassign" name="Hết slot — phân công lại" sourceRef="Gate_3PLAvailable" targetRef="Join_Task_Assign3PL_1" />
    <bpmn:sequenceFlow id="Flow_Pickup_GatePickup" sourceRef="Task_PickupParcel" targetRef="Gate_PickupSuccess" />
    <bpmn:sequenceFlow id="Flow_PickupYes_Sort" name="Thuận lợi" sourceRef="Gate_PickupSuccess" targetRef="Task_SortWarehouse" />
    <bpmn:sequenceFlow id="Flow_PickupNo_Reschedule" name="Thuận lợi — báo cáo" sourceRef="Gate_PickupSuccess" targetRef="Join_Task_RescheduleDelivery_1" />
    <bpmn:sequenceFlow id="Flow_Sort_GateSort" sourceRef="Task_SortWarehouse" targetRef="Gate_SortOK" />
    <bpmn:sequenceFlow id="Flow_SortYes_Create" name="Chính xác" sourceRef="Gate_SortOK" targetRef="Task_CreateShipment" />
    <bpmn:sequenceFlow id="Flow_SortNo_Rework" name="Sai sót — yêu cầu đóng gói lại" sourceRef="Gate_SortOK" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:sequenceFlow id="Flow_Create_SendTrack" sourceRef="Task_CreateShipment" targetRef="Task_SendTracking" />
    <bpmn:sequenceFlow id="Flow_SendTrack_Transit" sourceRef="Task_SendTracking" targetRef="Task_TransitHub" />
    <bpmn:sequenceFlow id="Flow_Transit_Out" sourceRef="Task_TransitHub" targetRef="Task_OutForDelivery" />
    <bpmn:sequenceFlow id="Flow_Out_GateFirst" sourceRef="Task_OutForDelivery" targetRef="Gate_FirstAttempt" />
    <bpmn:sequenceFlow id="Flow_FirstYes_Deliver" name="Shipper rảnh" sourceRef="Gate_FirstAttempt" targetRef="Task_DeliverToBuyer" />
    <bpmn:sequenceFlow id="Flow_FirstNo_Shipper" name="Shipper bận — xếp lại" sourceRef="Gate_FirstAttempt" targetRef="Join_Task_RetryDelivery_1" />
    <bpmn:sequenceFlow id="Flow_Deliver_GateResult" sourceRef="Task_DeliverToBuyer" targetRef="Gate_DeliveredOrFailed" />
    <bpmn:sequenceFlow id="Flow_DeliverYes_Receive" name="Thành công" sourceRef="Gate_DeliveredOrFailed" targetRef="Task_ReceiveGoods" />
    <bpmn:sequenceFlow id="Flow_DeliverNo_Retry" name="Thất bại" sourceRef="Gate_DeliveredOrFailed" targetRef="Join_Task_RetryDelivery_1" />
    <bpmn:sequenceFlow id="Flow_Retry_GateCount" sourceRef="Task_RetryDelivery" targetRef="Gate_RetryCount" />
    <bpmn:sequenceFlow id="Flow_RetryCount_Yes" name="≥3 lần — hoàn hàng" sourceRef="Gate_RetryCount" targetRef="Join_Task_RescheduleDelivery_1" />
    <bpmn:sequenceFlow id="Flow_RetryCount_No" name="≤2 lần — thử lại" sourceRef="Gate_RetryCount" targetRef="Join_Task_SchedulePickup_1" />
    <bpmn:sequenceFlow id="Flow_Reschedule_Return" name="Hoàn về kho" sourceRef="Split_Task_RescheduleDelivery_1" targetRef="Join_Task_ReceiveReturn_1" />
    <bpmn:sequenceFlow id="Flow_Reschedule_Rework" name="Đóng gói lại" sourceRef="Split_Task_RescheduleDelivery_1" targetRef="Task_ReworkParcel" />
    <bpmn:sequenceFlow id="Flow_Return_End" sourceRef="Task_ReceiveReturn" targetRef="EndEvent_Returned" />
    <bpmn:sequenceFlow id="Flow_Receive_GateAccept" sourceRef="Task_ReceiveGoods" targetRef="Gate_AcceptGoods" />
    <bpmn:sequenceFlow id="Flow_Accept_Yes" name="Chấp nhận" sourceRef="Gate_AcceptGoods" targetRef="Task_ConfirmReceive" />
    <bpmn:sequenceFlow id="Flow_Accept_No" name="Từ chối" sourceRef="Gate_AcceptGoods" targetRef="Task_RejectGoods" />
    <bpmn:sequenceFlow id="Flow_Confirm_COD" sourceRef="Task_ConfirmReceive" targetRef="Task_UpdateCOD" />
    <bpmn:sequenceFlow id="Flow_Reject_Return" sourceRef="Task_RejectGoods" targetRef="Join_Task_ReceiveReturn_1" />
    <bpmn:sequenceFlow id="Flow_COD_End" sourceRef="Task_UpdateCOD" targetRef="EndEvent_Delivered" />
    <bpmn:sequenceFlow id="Flow_Join_Task_SchedulePickup_in" sourceRef="Join_Task_SchedulePickup_1" targetRef="Task_SchedulePickup" />
    <bpmn:sequenceFlow id="Flow_Join_Task_Assign3PL_in" sourceRef="Join_Task_Assign3PL_1" targetRef="Task_Assign3PL" />
    <bpmn:sequenceFlow id="Flow_Join_Task_ReceiveReturn_in" sourceRef="Join_Task_ReceiveReturn_1" targetRef="Task_ReceiveReturn" />
    <bpmn:sequenceFlow id="Flow_Join_Task_RetryDelivery_in" sourceRef="Join_Task_RetryDelivery_1" targetRef="Task_RetryDelivery" />
    <bpmn:sequenceFlow id="Flow_Join_Task_RescheduleDelivery_in" sourceRef="Join_Task_RescheduleDelivery_1" targetRef="Task_RescheduleDelivery" />
    <bpmn:sequenceFlow id="Flow_Task_RescheduleDelivery_to_Split_Task_RescheduleDelivery_1" sourceRef="Task_RescheduleDelivery" targetRef="Split_Task_RescheduleDelivery_1" />
    <bpmn:exclusiveGateway id="Join_Task_SchedulePickup_1" name="Gom luồng trước khi Đặt lịch hẹn lấy hàng từ 3PL">
      <bpmn:incoming>Flow_Package_Schedule</bpmn:incoming>
      <bpmn:incoming>Flow_SortNo_Rework</bpmn:incoming>
      <bpmn:incoming>Flow_Rework_Schedule</bpmn:incoming>
      <bpmn:incoming>Flow_RetryCount_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_SchedulePickup_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_Assign3PL_1" name="Gom luồng trước khi Phân công 3PL phù hợp (LEX/GHN/J&amp;T)">
      <bpmn:incoming>Flow_AWB_Assign</bpmn:incoming>
      <bpmn:incoming>Flow_3PLNo_Reassign</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_Assign3PL_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_ReceiveReturn_1" name="Gom luồng trước khi Nhận hàng hoàn về từ 3PL (giao thất bại 3 lần)">
      <bpmn:incoming>Flow_Reschedule_Return</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ReceiveReturn_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_RetryDelivery_1" name="Gom luồng trước khi Hẹn giao lại lần tiếp theo">
      <bpmn:incoming>Flow_DeliverNo_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_FirstNo_Shipper</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_RetryDelivery_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Join_Task_RescheduleDelivery_1" name="Gom luồng trước khi Chuyển hoàn hàng về kho Seller">
      <bpmn:incoming>Flow_RetryCount_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_PickupNo_Reschedule</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_RescheduleDelivery_in</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Split_Task_RescheduleDelivery_1" name="Phân luồng sau khi Chuyển hoàn hàng về kho Seller">
      <bpmn:outgoing>Flow_Reschedule_Return</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reschedule_Rework</bpmn:outgoing>
      <bpmn:incoming>Flow_Task_RescheduleDelivery_to_Split_Task_RescheduleDelivery_1</bpmn:incoming>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LogisticsDelivery">
      <bpmndi:BPMNShape id="Lane_Seller_di" bpmnElement="Lane_Seller">
        <dc:Bounds x="30" y="0" width="6306" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System">
        <dc:Bounds x="30" y="200" width="6306" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3PL_di" bpmnElement="Lane_3PL">
        <dc:Bounds x="30" y="400" width="6306" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shipper_di" bpmnElement="Lane_Shipper">
        <dc:Bounds x="30" y="600" width="6306" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Buyer_di" bpmnElement="Lane_Buyer">
        <dc:Bounds x="30" y="800" width="6306" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_OrderConfirmed_di" bpmnElement="StartEvent_OrderConfirmed">
        <dc:Bounds x="80" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareParcel_di" bpmnElement="Task_PrepareParcel">
        <dc:Bounds x="300" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PackageGoods_di" bpmnElement="Task_PackageGoods">
        <dc:Bounds x="520" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SchedulePickup_di" bpmnElement="Task_SchedulePickup">
