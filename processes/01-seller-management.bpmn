<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SellerManagement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_SellerManagement" name="Quản lý Nhà bán hàng" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>StartEvent_Register</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Register</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UploadDocs</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FixBankInfo</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FixRejection</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Approved</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Rejected</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_UploadDocs_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_FixRejection_4</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Gate_PhoneVerif</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_VerifyPhone</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ValidateIdentity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BankValid</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_OCRCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_DocValid</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ResubmitLimit</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ScoreRisk</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_RiskDoubt</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_AutoApprove</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ValidateIdentity_2</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_OCRCheck_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_NotifyResult_6</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_NotifyResult_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Compliance" name="Compliance Team">
        <ns0:flowNodeRef>Task_ManualReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Approve</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ManualReview_5</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Legal" name="Legal / Giám sát Vận hành">
        <ns0:flowNodeRef>Task_MonitorViolations</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_ViolationSeverity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Warn</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Suspend</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Ban</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Warned</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Suspended</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Banned</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Register" name="Yêu cầu đăng ký gian hàng">
      <ns0:outgoing>Flow_Register_Submit</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_Register" name="Điền thông tin định danh Seller">
      <ns0:incoming>Flow_Register_Submit</ns0:incoming>
      <ns0:outgoing>Flow_Register_Phone</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_PhoneVerif" name="SĐT đã xác thực?">
      <ns0:incoming>Flow_Register_Phone</ns0:incoming>
      <ns0:outgoing>Flow_Phone_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Phone_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_VerifyPhone" name="Gửi OTP xác thực SĐT">
      <ns0:incoming>Flow_Phone_No</ns0:incoming>
      <ns0:outgoing>Flow_Verify_Upload</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_UploadDocs" name="Upload CMND/CCCD + GPKD + Giấy chứng nhận (LazMall)">
      <ns0:outgoing>Flow_Docs_Validate</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs</ns0:incoming>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ValidateIdentity" name="Validate định danh tự động">
      <ns0:outgoing>Flow_Validate_Bank</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity</ns0:incoming>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_BankValid" name="Tài khoản NH hợp lệ?">
      <ns0:incoming>Flow_Validate_Bank</ns0:incoming>
      <ns0:outgoing>Flow_Bank_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Bank_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_FixBankInfo" name="Cập nhật tài khoản ngân hàng (giải ngân)">
      <ns0:incoming>Flow_Bank_No</ns0:incoming>
      <ns0:outgoing>Flow_FixBank_OCR</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_OCRCheck" name="Quét OCR + kiểm tra giấy tờ giả">
      <ns0:outgoing>Flow_OCR_Gate</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck</ns0:incoming>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_DocValid" name="Giấy tờ hợp lệ?">
      <ns0:incoming>Flow_OCR_Gate</ns0:incoming>
      <ns0:outgoing>Flow_DocValid_Pass</ns0:outgoing>
      <ns0:outgoing>Flow_DocValid_Fail</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_FixRejection" name="Bổ sung / sửa hồ sơ">
      <ns0:outgoing>Flow_Fix_Gate</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_FixRejection_4_to_Task_FixRejection</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_ResubmitLimit" name="Còn lượt sửa hồ sơ?">
      <ns0:incoming>Flow_Fix_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Resubmit_OK</ns0:outgoing>
      <ns0:outgoing>Flow_Resubmit_End</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_ScoreRisk" name="Chấm điểm rủi ro (Risk scoring)">
      <ns0:incoming>Flow_DocValid_Pass</ns0:incoming>
      <ns0:outgoing>Flow_Risk_Doubt</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_RiskDoubt" name="Có nghi vấn rủi ro cao?">
      <ns0:incoming>Flow_Risk_Doubt</ns0:incoming>
      <ns0:outgoing>Flow_Doubt_No</ns0:outgoing>
      <ns0:outgoing>Flow_Doubt_Yes</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_AutoApprove" name="Phân tầng rủi ro?">
      <ns0:incoming>Flow_Doubt_No</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Auto</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Manual</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ManualReview" name="Compliance review thủ công (24-48h)">
      <ns0:outgoing>Flow_Manual_Approve</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ManualReview_5_to_Task_ManualReview</ns0:incoming>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_Approve" name="Kết quả thẩm định?">
      <ns0:incoming>Flow_Manual_Approve</ns0:incoming>
      <ns0:outgoing>Flow_Approve_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_Reject_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_Reject_Fix</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_NotifyResult" name="Thông báo kết quả duyệt Seller Centre">
      <ns0:incoming>Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult</ns0:incoming>
      <ns0:outgoing>Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_MonitorViolations" name="Giám sát điểm đánh giá &amp; vi phạm (auto)">
      <ns0:incoming>Flow_Notify_Monitor</ns0:incoming>
      <ns0:outgoing>Flow_Monitor_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_ViolationSeverity" name="Mức độ vi phạm?">
      <ns0:incoming>Flow_Monitor_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Warn</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Suspend</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Ban</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_Warn" name="Gửi cảnh cáo Seller">
      <ns0:incoming>Flow_Gate_Warn</ns0:incoming>
      <ns0:outgoing>Flow_Warn_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Suspend" name="Tạm khóa gian hàng (7 ngày)">
      <ns0:incoming>Flow_Gate_Suspend</ns0:incoming>
      <ns0:outgoing>Flow_Suspend_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Ban" name="Khóa gian hàng vĩnh viễn">
      <ns0:incoming>Flow_Gate_Ban</ns0:incoming>
      <ns0:outgoing>Flow_Ban_End</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="End_Approved" name="Gian hàng Lazada đã được kích hoạt">
      <ns0:incoming>Flow_Notify_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Rejected" name="Hồ sơ đã bị từ chối vĩnh viễn">
      <ns0:incoming>Flow_Resubmit_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Warned" name="Gian hàng đã bị cảnh cáo">
      <ns0:incoming>Flow_Warn_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Suspended" name="Gian hàng đã bị tạm khóa">
      <ns0:incoming>Flow_Suspend_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Banned" name="Gian hàng đã bị khóa vĩnh viễn">
      <ns0:incoming>Flow_Ban_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Register_Submit" sourceRef="StartEvent_Register" targetRef="Task_Register" />
    <ns0:sequenceFlow id="Flow_Register_Phone" sourceRef="Task_Register" targetRef="Gate_PhoneVerif" />
    <ns0:sequenceFlow id="Flow_Phone_Yes" name="Đã xác thực" sourceRef="Gate_PhoneVerif" targetRef="Join_Task_UploadDocs_1" />
    <ns0:sequenceFlow id="Flow_Phone_No" name="Chưa xác thực" sourceRef="Gate_PhoneVerif" targetRef="Task_VerifyPhone" />
    <ns0:sequenceFlow id="Flow_Verify_Upload" sourceRef="Task_VerifyPhone" targetRef="Join_Task_UploadDocs_1" />
    <ns0:sequenceFlow id="Flow_Docs_Validate" sourceRef="Task_UploadDocs" targetRef="Join_Task_ValidateIdentity_2" />
    <ns0:sequenceFlow id="Flow_Validate_Bank" sourceRef="Task_ValidateIdentity" targetRef="Gate_BankValid" />
    <ns0:sequenceFlow id="Flow_Bank_Yes" name="Hợp lệ" sourceRef="Gate_BankValid" targetRef="Join_Task_OCRCheck_3" />
    <ns0:sequenceFlow id="Flow_Bank_No" name="Không hợp lệ" sourceRef="Gate_BankValid" targetRef="Task_FixBankInfo" />
    <ns0:sequenceFlow id="Flow_FixBank_OCR" sourceRef="Task_FixBankInfo" targetRef="Join_Task_OCRCheck_3" />
    <ns0:sequenceFlow id="Flow_OCR_Gate" sourceRef="Task_OCRCheck" targetRef="Gate_DocValid" />
    <ns0:sequenceFlow id="Flow_DocValid_Pass" name="Đạt chuẩn OCR" sourceRef="Gate_DocValid" targetRef="Task_ScoreRisk" />
    <ns0:sequenceFlow id="Flow_DocValid_Fail" name="Lỗi OCR" sourceRef="Gate_DocValid" targetRef="Join_Task_FixRejection_4" />
    <ns0:sequenceFlow id="Flow_Fix_Gate" sourceRef="Task_FixRejection" targetRef="Gate_ResubmitLimit" />
    <ns0:sequenceFlow id="Flow_Resubmit_OK" name="Còn lượt" sourceRef="Gate_ResubmitLimit" targetRef="Join_Task_ValidateIdentity_2" />
    <ns0:sequenceFlow id="Flow_Resubmit_End" name="Hết lượt (3 lần)" sourceRef="Gate_ResubmitLimit" targetRef="End_Rejected" />
    <ns0:sequenceFlow id="Flow_Risk_Doubt" sourceRef="Task_ScoreRisk" targetRef="Gate_RiskDoubt" />
    <ns0:sequenceFlow id="Flow_Doubt_No" name="Rủi ro thấp/vừa" sourceRef="Gate_RiskDoubt" targetRef="Gate_AutoApprove" />
    <ns0:sequenceFlow id="Flow_Doubt_Yes" name="Nghi vấn cao" sourceRef="Gate_RiskDoubt" targetRef="Join_Task_ManualReview_5" />
    <ns0:sequenceFlow id="Flow_Gate_Auto" name="Điểm tốt (Low-risk)" sourceRef="Gate_AutoApprove" targetRef="Join_Task_NotifyResult_6" />
    <ns0:sequenceFlow id="Flow_Gate_Manual" name="Cần hậu kiểm" sourceRef="Gate_AutoApprove" targetRef="Join_Task_ManualReview_5" />
    <ns0:sequenceFlow id="Flow_Gate_Reject" name="Không đạt" sourceRef="Gate_AutoApprove" targetRef="Join_Task_FixRejection_4" />
    <ns0:sequenceFlow id="Flow_Manual_Approve" sourceRef="Task_ManualReview" targetRef="Gate_Approve" />
    <ns0:sequenceFlow id="Flow_Approve_Notify" name="Chấp thuận" sourceRef="Gate_Approve" targetRef="Join_Task_NotifyResult_6" />
    <ns0:sequenceFlow id="Flow_Reject_Notify" name="Từ chối" sourceRef="Gate_Approve" targetRef="Join_Task_NotifyResult_6" />
    <ns0:sequenceFlow id="Flow_Reject_Fix" name="Yêu cầu bổ sung" sourceRef="Gate_Approve" targetRef="Join_Task_FixRejection_4" />
    <ns0:sequenceFlow id="Flow_Notify_End" sourceRef="Split_Task_NotifyResult_1" targetRef="End_Approved" name="Kích hoạt gian hàng" />
    <ns0:sequenceFlow id="Flow_Notify_Monitor" sourceRef="Split_Task_NotifyResult_1" targetRef="Task_MonitorViolations" name="Giám sát vi phạm" />
    <ns0:sequenceFlow id="Flow_Monitor_Gate" sourceRef="Task_MonitorViolations" targetRef="Gate_ViolationSeverity" />
    <ns0:sequenceFlow id="Flow_Gate_Warn" name="Nhẹ (1-2 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Warn" />
    <ns0:sequenceFlow id="Flow_Gate_Suspend" name="Trung bình (3-5 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Suspend" />
    <ns0:sequenceFlow id="Flow_Gate_Ban" name="Nặng (&gt;6 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Ban" />
    <ns0:sequenceFlow id="Flow_Warn_End" sourceRef="Task_Warn" targetRef="End_Warned" />
    <ns0:sequenceFlow id="Flow_Suspend_End" sourceRef="Task_Suspend" targetRef="End_Suspended" />
    <ns0:sequenceFlow id="Flow_Ban_End" sourceRef="Task_Ban" targetRef="End_Banned" />
    <ns0:exclusiveGateway id="Join_Task_UploadDocs_1" name="Gom luồng trước khi Upload CMND/CCCD + GPKD + Giấy chứng nhận (LazMall)">
      <ns0:incoming>Flow_Phone_Yes</ns0:incoming>
      <ns0:incoming>Flow_Verify_Upload</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs" sourceRef="Join_Task_UploadDocs_1" targetRef="Task_UploadDocs" />
    <ns0:exclusiveGateway id="Join_Task_ValidateIdentity_2" name="Gom luồng trước khi Validate định danh tự động">
      <ns0:incoming>Flow_Docs_Validate</ns0:incoming>
      <ns0:incoming>Flow_Resubmit_OK</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity" sourceRef="Join_Task_ValidateIdentity_2" targetRef="Task_ValidateIdentity" />
    <ns0:exclusiveGateway id="Join_Task_OCRCheck_3" name="Gom luồng trước khi Quét OCR + kiểm tra giấy tờ giả">
      <ns0:incoming>Flow_Bank_Yes</ns0:incoming>
      <ns0:incoming>Flow_FixBank_OCR</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck" sourceRef="Join_Task_OCRCheck_3" targetRef="Task_OCRCheck" />
    <ns0:exclusiveGateway id="Join_Task_FixRejection_4" name="Gom luồng trước khi Bổ sung / sửa hồ sơ">
      <ns0:incoming>Flow_DocValid_Fail</ns0:incoming>
      <ns0:incoming>Flow_Gate_Reject</ns0:incoming>
      <ns0:incoming>Flow_Reject_Fix</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_FixRejection_4_to_Task_FixRejection</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_FixRejection_4_to_Task_FixRejection" sourceRef="Join_Task_FixRejection_4" targetRef="Task_FixRejection" />
    <ns0:exclusiveGateway id="Join_Task_ManualReview_5" name="Gom luồng trước khi Compliance review thủ công (24-48h)">
      <ns0:incoming>Flow_Doubt_Yes</ns0:incoming>
      <ns0:incoming>Flow_Gate_Manual</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ManualReview_5_to_Task_ManualReview</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ManualReview_5_to_Task_ManualReview" sourceRef="Join_Task_ManualReview_5" targetRef="Task_ManualReview" />
    <ns0:exclusiveGateway id="Join_Task_NotifyResult_6" name="Gom luồng trước khi Thông báo kết quả duyệt Seller Centre">
      <ns0:incoming>Flow_Gate_Auto</ns0:incoming>
      <ns0:incoming>Flow_Approve_Notify</ns0:incoming>
      <ns0:incoming>Flow_Reject_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult" sourceRef="Join_Task_NotifyResult_6" targetRef="Task_NotifyResult" />
    <ns0:exclusiveGateway id="Split_Task_NotifyResult_1" name="Phân luồng sau Thông báo kết quả duyệt Seller Centre">
      <ns0:outgoing>Flow_Notify_End</ns0:outgoing>
      <ns0:outgoing>Flow_Notify_Monitor</ns0:outgoing>
      <ns0:incoming>Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1</ns0:incoming>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1" sourceRef="Task_NotifyResult" targetRef="Split_Task_NotifyResult_1" />
  </ns0:process>
