<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ReturnRefund" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_ReturnRefund" name="Hoàn trả &amp; Refund" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Request</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SubmitRequest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_UploadEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_HandoverReturn</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_UploadEvidence_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_HandoverReturn_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_CheckEligibility</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_TriageEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyStatus</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Eligible</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_LowRisk</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_InspectionPass</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_EvidenceQuality</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_RefundMethod</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_CheckEligibility_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_NotifyStatus_4</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_TriageEvidence_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_CS" name="CS Agent">
        <ns0:flowNodeRef>Task_ReviewEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Approve</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReviewEvidence_5</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_ReviewEvidence_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Warehouse" name="3PL/Warehouse">
        <ns0:flowNodeRef>Task_SchedulePickup</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PickupReturn</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_InspectItem</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_PickupReturn_6</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Payment" name="Payment Gateway">
        <ns0:flowNodeRef>Task_ProcessRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ProcessRefund_7</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Request" name="Yêu cầu hoàn trả hàng">
      <ns0:outgoing>Flow_Start_Submit</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_SubmitRequest" name="Gửi yêu cầu đổi trả và lý do">
      <ns0:incoming>Flow_Start_Submit</ns0:incoming>
      <ns0:outgoing>Flow_Submit_Window</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_ReturnWindow" name="Còn trong thời gian hoàn trả?">
      <ns0:incoming>Flow_Submit_Window</ns0:incoming>
      <ns0:outgoing>Flow_Window_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Window_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_HandleLateRequest" name="Xử lý yêu cầu trễ hạn">
      <ns0:incoming>Flow_Window_No</ns0:incoming>
      <ns0:outgoing>Flow_Late_Join</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_UploadEvidence" name="Tải lên bằng chứng ảnh và video">
      <ns0:incoming>Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence</ns0:incoming>
      <ns0:outgoing>Flow_Upload_Triage</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_HandoverReturn" name="Bàn giao hàng trả cho LEX / 3PL">
      <ns0:incoming>Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn</ns0:incoming>
      <ns0:outgoing>Flow_Handover_Schedule</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_CheckEligibility" name="Kiểm tra tính hợp lệ tự động">
      <ns0:incoming>Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility</ns0:incoming>
      <ns0:outgoing>Flow_Eligibility_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_TriageEvidence" name="AI phân loại bằng chứng khiếu nại">
      <ns0:incoming>Flow_Upload_Triage</ns0:incoming>
      <ns0:outgoing>Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyStatus" name="Gửi thông báo cập nhật tiến độ tự động">
      <ns0:incoming>Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus</ns0:incoming>
      <ns0:outgoing>Flow_Notify_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_ReviewEvidence" name="CS thẩm định hồ sơ khiếu nại">
      <ns0:incoming>Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence</ns0:incoming>
      <ns0:outgoing>Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_SchedulePickup" name="Đặt lịch hẹn Shipper đến lấy hàng hoàn">
      <ns0:incoming>Flow_Handover_Schedule</ns0:incoming>
      <ns0:outgoing>Flow_Schedule_Pickup</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:task id="Task_PickupReturn" name="LEX / 3PL pickup hàng trả">
      <ns0:incoming>Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_Gate</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="Gate_PickupRetry" name="3PL pickup thành công?">
      <ns0:incoming>Flow_Pickup_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Pickup_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_ReschedulePickup" name="Đặt lại lịch pickup">
      <ns0:incoming>Flow_Pickup_No</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Pickup</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_InspectItem" name="Kiểm định hàng hoàn tại kho (≤12h)">
      <ns0:incoming>Flow_Pickup_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Inspect_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ProcessRefund" name="Kích hoạt lệnh hoàn tiền">
      <ns0:incoming>Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund</ns0:incoming>
      <ns0:outgoing>Flow_Refund_Method</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_Eligible" name="Hợp lệ?">
      <ns0:incoming>Flow_Eligibility_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Eligible_Upload</ns0:outgoing>
      <ns0:outgoing>Flow_Eligible_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_LowRisk" name="Đơn giá trị &lt;200k &amp; Buyer tín nhiệm cao?">
      <ns0:incoming>Flow_Approve_Gate</ns0:incoming>
      <ns0:outgoing>Flow_LowRisk_Refund</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_Handover</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_EvidenceQuality" name="Bằng chứng khiếu nại đạt yêu cầu?">
      <ns0:incoming>Flow_Triage_Quality</ns0:incoming>
      <ns0:outgoing>Flow_Evidence_Good</ns0:outgoing>
      <ns0:outgoing>Flow_Evidence_Blurry</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_RefundMethod" name="Lựa chọn phương thức hoàn tiền?">
      <ns0:incoming>Flow_Refund_Method</ns0:incoming>
      <ns0:outgoing>Flow_Refund_Original</ns0:outgoing>
      <ns0:outgoing>Flow_Refund_Credit</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_InspectionPass" name="Hàng hoàn đúng hiện trạng &amp; đủ phụ kiện?">
      <ns0:incoming>Flow_Inspect_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Inspect_Refund</ns0:outgoing>
      <ns0:outgoing>Flow_Inspect_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_Approve" name="CS phê duyệt yêu cầu đổi trả?">
      <ns0:incoming>Flow_Review_Approve</ns0:incoming>
      <ns0:incoming>Flow_Review_Reject</ns0:incoming>
      <ns0:outgoing>Flow_Approve_Gate</ns0:outgoing>
      <ns0:outgoing>Flow_Reject_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_Approve_Handover</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <ns0:incoming>Flow_Notify_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:exclusiveGateway id="Join_End_Rejected_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_Eligible_Reject</ns0:incoming>
      <ns0:incoming>Flow_Reject_Notify</ns0:incoming>
      <ns0:incoming>Flow_Inspect_Reject</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_Rejected_1_to_End_Rejected</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Rejected" name="Yêu cầu hoàn trả đã bị từ chối">
      <ns0:incoming>Flow_Join_End_Rejected_1_to_End_Rejected</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_Request" targetRef="Task_SubmitRequest" />
    <ns0:sequenceFlow id="Flow_Submit_Window" sourceRef="Task_SubmitRequest" targetRef="Gate_ReturnWindow" />
    <ns0:sequenceFlow id="Flow_Window_Yes" sourceRef="Gate_ReturnWindow" targetRef="Join_Task_CheckEligibility_3" name="Còn hạn hoàn trả" />
    <ns0:sequenceFlow id="Flow_Window_No" sourceRef="Gate_ReturnWindow" targetRef="Task_HandleLateRequest" name="Hết hạn hoàn trả" />
    <ns0:sequenceFlow id="Flow_Late_Join" sourceRef="Task_HandleLateRequest" targetRef="Join_Task_CheckEligibility_3" />
    <ns0:sequenceFlow id="Flow_Eligibility_Gate" sourceRef="Task_CheckEligibility" targetRef="Gate_Eligible" />
    <ns0:sequenceFlow id="Flow_Eligible_Upload" sourceRef="Gate_Eligible" targetRef="Join_Task_UploadEvidence_1" name="Hồ sơ hợp lệ" />
    <ns0:sequenceFlow id="Flow_Eligible_Reject" sourceRef="Gate_Eligible" targetRef="Join_End_Rejected_1" name="Không hợp lệ" />
    <ns0:sequenceFlow id="Flow_Upload_Triage" sourceRef="Task_UploadEvidence" targetRef="Task_TriageEvidence" />
    <ns0:sequenceFlow id="Flow_Triage_Quality" sourceRef="Split_Task_TriageEvidence_1" targetRef="Gate_EvidenceQuality" name="Chất lượng bằng chứng" />
    <ns0:sequenceFlow id="Flow_Evidence_Good" sourceRef="Gate_EvidenceQuality" targetRef="Join_Task_ReviewEvidence_5" name="Bằng chứng đạt" />
    <ns0:sequenceFlow id="Flow_Evidence_Blurry" sourceRef="Gate_EvidenceQuality" targetRef="Join_Task_UploadEvidence_1" name="Bằng chứng không rõ" />
    <ns0:sequenceFlow id="Flow_Triage_AIReview" sourceRef="Split_Task_TriageEvidence_1" targetRef="Join_Task_ReviewEvidence_5" name="CS thẩm định AI" />
    <ns0:sequenceFlow id="Flow_Review_Approve" sourceRef="Split_Task_ReviewEvidence_2" targetRef="Gate_Approve" name="Phê duyệt" />
    <ns0:sequenceFlow id="Flow_Review_Reject" sourceRef="Split_Task_ReviewEvidence_2" targetRef="Gate_Approve" name="Từ chối" />
    <ns0:sequenceFlow id="Flow_Approve_Gate" sourceRef="Gate_Approve" targetRef="Gate_LowRisk" name="Duyệt — kiểm tra thêm" />
    <ns0:sequenceFlow id="Flow_Reject_Notify" sourceRef="Gate_Approve" targetRef="Join_End_Rejected_1" name="Từ chối yêu cầu" />
    <ns0:sequenceFlow id="Flow_LowRisk_Refund" sourceRef="Gate_LowRisk" targetRef="Join_Task_ProcessRefund_7" name="Rủi ro thấp" />
    <ns0:sequenceFlow id="Flow_Gate_Handover" sourceRef="Gate_LowRisk" targetRef="Join_Task_HandoverReturn_2" name="Rủi ro cao" />
    <ns0:sequenceFlow id="Flow_Approve_Handover" sourceRef="Gate_Approve" targetRef="Join_Task_HandoverReturn_2" name="Duyệt — bàn giao" />
    <ns0:sequenceFlow id="Flow_Handover_Schedule" sourceRef="Task_HandoverReturn" targetRef="Task_SchedulePickup" />
    <ns0:sequenceFlow id="Flow_Schedule_Pickup" sourceRef="Task_SchedulePickup" targetRef="Join_Task_PickupReturn_6" />
    <ns0:sequenceFlow id="Flow_Pickup_Gate" sourceRef="Task_PickupReturn" targetRef="Gate_PickupRetry" />
    <ns0:sequenceFlow id="Flow_Pickup_Yes" sourceRef="Gate_PickupRetry" targetRef="Task_InspectItem" name="Pickup thành công" />
    <ns0:sequenceFlow id="Flow_Pickup_No" sourceRef="Gate_PickupRetry" targetRef="Task_ReschedulePickup" name="Pickup thất bại" />
    <ns0:sequenceFlow id="Flow_Retry_Pickup" sourceRef="Task_ReschedulePickup" targetRef="Join_Task_PickupReturn_6" />
    <ns0:sequenceFlow id="Flow_Inspect_Gate" sourceRef="Task_InspectItem" targetRef="Gate_InspectionPass" />
    <ns0:sequenceFlow id="Flow_Inspect_Refund" sourceRef="Gate_InspectionPass" targetRef="Join_Task_ProcessRefund_7" name="Đạt kiểm định" />
    <ns0:sequenceFlow id="Flow_Inspect_Reject" sourceRef="Gate_InspectionPass" targetRef="Join_End_Rejected_1" name="Không đạt kiểm định" />
    <ns0:sequenceFlow id="Flow_Refund_Method" sourceRef="Task_ProcessRefund" targetRef="Gate_RefundMethod" />
    <ns0:sequenceFlow id="Flow_Refund_Original" sourceRef="Gate_RefundMethod" targetRef="Join_Task_NotifyStatus_4" name="Hoàn về nguồn thanh toán" />
    <ns0:sequenceFlow id="Flow_Refund_Credit" sourceRef="Gate_RefundMethod" targetRef="Join_Task_NotifyStatus_4" name="Hoàn vào Ví/credit" />
    <ns0:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifyStatus" targetRef="End_Refunded" />
    <ns0:exclusiveGateway id="Join_Task_UploadEvidence_1" name="Gom luồng trước khi Tải lên bằng chứng ảnh và video">
      <ns0:incoming>Flow_Eligible_Upload</ns0:incoming>
      <ns0:incoming>Flow_Evidence_Blurry</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence" sourceRef="Join_Task_UploadEvidence_1" targetRef="Task_UploadEvidence" />
    <ns0:exclusiveGateway id="Join_Task_HandoverReturn_2" name="Gom luồng trước khi Bàn giao hàng trả cho LEX / 3PL">
      <ns0:incoming>Flow_Gate_Handover</ns0:incoming>
      <ns0:incoming>Flow_Approve_Handover</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn" sourceRef="Join_Task_HandoverReturn_2" targetRef="Task_HandoverReturn" />
    <ns0:exclusiveGateway id="Join_Task_CheckEligibility_3" name="Gom luồng trước khi Kiểm tra tính hợp lệ tự động">
      <ns0:incoming>Flow_Window_Yes</ns0:incoming>
      <ns0:incoming>Flow_Late_Join</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility" sourceRef="Join_Task_CheckEligibility_3" targetRef="Task_CheckEligibility" />
    <ns0:exclusiveGateway id="Join_Task_NotifyStatus_4" name="Gom luồng trước khi Gửi thông báo cập nhật tiến độ tự động">
      <ns0:incoming>Flow_Refund_Original</ns0:incoming>
      <ns0:incoming>Flow_Refund_Credit</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus" sourceRef="Join_Task_NotifyStatus_4" targetRef="Task_NotifyStatus" />
    <ns0:exclusiveGateway id="Join_Task_ReviewEvidence_5" name="Gom luồng trước khi CS thẩm định hồ sơ khiếu nại">
      <ns0:incoming>Flow_Evidence_Good</ns0:incoming>
      <ns0:incoming>Flow_Triage_AIReview</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence" sourceRef="Join_Task_ReviewEvidence_5" targetRef="Task_ReviewEvidence" />
    <ns0:exclusiveGateway id="Join_Task_PickupReturn_6" name="Gom luồng trước khi LEX / 3PL pickup hàng trả">
      <ns0:incoming>Flow_Schedule_Pickup</ns0:incoming>
      <ns0:incoming>Flow_Retry_Pickup</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn" sourceRef="Join_Task_PickupReturn_6" targetRef="Task_PickupReturn" />
    <ns0:exclusiveGateway id="Join_Task_ProcessRefund_7" name="Gom luồng trước khi Kích hoạt lệnh hoàn tiền">
      <ns0:incoming>Flow_LowRisk_Refund</ns0:incoming>
      <ns0:incoming>Flow_Inspect_Refund</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund" sourceRef="Join_Task_ProcessRefund_7" targetRef="Task_ProcessRefund" />
    <ns0:exclusiveGateway id="Split_Task_TriageEvidence_1" name="Phân luồng sau AI phân loại bằng chứng khiếu nại">
      <ns0:incoming>Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1</ns0:incoming>
      <ns0:outgoing>Flow_Triage_Quality</ns0:outgoing>
      <ns0:outgoing>Flow_Triage_AIReview</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1" sourceRef="Task_TriageEvidence" targetRef="Split_Task_TriageEvidence_1" />
    <ns0:exclusiveGateway id="Split_Task_ReviewEvidence_2" name="Phân luồng sau CS thẩm định hồ sơ khiếu nại">
      <ns0:incoming>Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2</ns0:incoming>
      <ns0:outgoing>Flow_Review_Approve</ns0:outgoing>
      <ns0:outgoing>Flow_Review_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2" sourceRef="Task_ReviewEvidence" targetRef="Split_Task_ReviewEvidence_2" />
    <ns0:sequenceFlow id="Flow_Join_End_Rejected_1_to_End_Rejected" sourceRef="Join_End_Rejected_1" targetRef="End_Rejected" name="" />
  </ns0:process>
