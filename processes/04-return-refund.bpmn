<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ReturnRefund" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_ReturnRefund" name="Hoàn trả &amp; Refund" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_UploadEvidence_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_HandoverReturn_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Automated)">
        <bpmn:flowNodeRef>Task_CheckEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriageEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_LowRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_InspectionPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_EvidenceQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RefundMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_CheckEligibility_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_NotifyStatus_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_TriageEvidence_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="CS Agent">
        <bpmn:flowNodeRef>Task_ReviewEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ReviewEvidence_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_ReviewEvidence_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="3PL/Warehouse">
        <bpmn:flowNodeRef>Task_SchedulePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickupReturn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectItem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_PickupReturn_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Payment" name="Payment Gateway">
        <bpmn:flowNodeRef>Task_ProcessRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ProcessRefund_7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Request" name="Yêu cầu hoàn trả hàng">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Gửi yêu cầu đổi trả và lý do">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Window</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_ReturnWindow" name="Còn trong thời gian hoàn trả?">
      <bpmn:incoming>Flow_Submit_Window</bpmn:incoming>
      <bpmn:outgoing>Flow_Window_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Window_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HandleLateRequest" name="Xử lý yêu cầu trễ hạn">
      <bpmn:incoming>Flow_Window_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Late_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadEvidence" name="Tải lên bằng chứng ảnh và video">
      <bpmn:incoming>Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_Triage</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HandoverReturn" name="Bàn giao hàng trả cho LEX / 3PL">
      <bpmn:incoming>Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_Handover_Schedule</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckEligibility" name="Kiểm tra tính hợp lệ tự động">
      <bpmn:incoming>Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligibility_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TriageEvidence" name="AI phân loại bằng chứng khiếu nại">
      <bpmn:incoming>Flow_Upload_Triage</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyStatus" name="Gửi thông báo cập nhật tiến độ tự động">
      <bpmn:incoming>Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewEvidence" name="CS thẩm định hồ sơ khiếu nại">
      <bpmn:incoming>Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SchedulePickup" name="Đặt lịch hẹn Shipper đến lấy hàng hoàn">
      <bpmn:incoming>Flow_Handover_Schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_Schedule_Pickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_PickupReturn" name="LEX / 3PL pickup hàng trả">
      <bpmn:incoming>Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Gate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gate_PickupRetry" name="3PL pickup thành công?">
      <bpmn:incoming>Flow_Pickup_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pickup_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReschedulePickup" name="Đặt lại lịch pickup">
      <bpmn:incoming>Flow_Pickup_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Pickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InspectItem" name="Kiểm định hàng hoàn tại kho (≤12h)">
      <bpmn:incoming>Flow_Pickup_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_Gate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ProcessRefund" name="Kích hoạt lệnh hoàn tiền">
      <bpmn:incoming>Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_Method</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Eligible" name="Hợp lệ?">
      <bpmn:incoming>Flow_Eligibility_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Upload</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_LowRisk" name="Đơn giá trị &lt;200k &amp; Buyer tín nhiệm cao?">
      <bpmn:incoming>Flow_Approve_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_LowRisk_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Handover</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_EvidenceQuality" name="Bằng chứng khiếu nại đạt yêu cầu?">
      <bpmn:incoming>Flow_Triage_Quality</bpmn:incoming>
      <bpmn:outgoing>Flow_Evidence_Good</bpmn:outgoing>
      <bpmn:outgoing>Flow_Evidence_Blurry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_RefundMethod" name="Lựa chọn phương thức hoàn tiền?">
      <bpmn:incoming>Flow_Refund_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Refund_Original</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refund_Credit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_InspectionPass" name="Hàng hoàn đúng hiện trạng &amp; đủ phụ kiện?">
      <bpmn:incoming>Flow_Inspect_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inspect_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_Approve" name="CS phê duyệt yêu cầu đổi trả?">
      <bpmn:incoming>Flow_Review_Approve</bpmn:incoming>
      <bpmn:incoming>Flow_Review_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Gate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve_Handover</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Join_End_Rejected_1" name="Gom nhánh kết thúc">
      <bpmn:incoming>Flow_Eligible_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Inspect_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_End_Rejected_1_to_End_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Yêu cầu hoàn trả đã bị từ chối">
      <bpmn:incoming>Flow_Join_End_Rejected_1_to_End_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_Request" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_Submit_Window" sourceRef="Task_SubmitRequest" targetRef="Gate_ReturnWindow" />
    <bpmn:sequenceFlow id="Flow_Window_Yes" sourceRef="Gate_ReturnWindow" targetRef="Join_Task_CheckEligibility_3" />
    <bpmn:sequenceFlow id="Flow_Window_No" sourceRef="Gate_ReturnWindow" targetRef="Task_HandleLateRequest" />
    <bpmn:sequenceFlow id="Flow_Late_Join" sourceRef="Task_HandleLateRequest" targetRef="Join_Task_CheckEligibility_3" />
    <bpmn:sequenceFlow id="Flow_Eligibility_Gate" sourceRef="Task_CheckEligibility" targetRef="Gate_Eligible" />
    <bpmn:sequenceFlow id="Flow_Eligible_Upload" sourceRef="Gate_Eligible" targetRef="Join_Task_UploadEvidence_1" />
    <bpmn:sequenceFlow id="Flow_Eligible_Reject" sourceRef="Gate_Eligible" targetRef="Join_End_Rejected_1" />
    <bpmn:sequenceFlow id="Flow_Upload_Triage" sourceRef="Task_UploadEvidence" targetRef="Task_TriageEvidence" />
    <bpmn:sequenceFlow id="Flow_Triage_Quality" sourceRef="Split_Task_TriageEvidence_1" targetRef="Gate_EvidenceQuality" />
    <bpmn:sequenceFlow id="Flow_Evidence_Good" sourceRef="Gate_EvidenceQuality" targetRef="Join_Task_ReviewEvidence_5" />
    <bpmn:sequenceFlow id="Flow_Evidence_Blurry" sourceRef="Gate_EvidenceQuality" targetRef="Join_Task_UploadEvidence_1" />
    <bpmn:sequenceFlow id="Flow_Triage_AIReview" sourceRef="Split_Task_TriageEvidence_1" targetRef="Join_Task_ReviewEvidence_5" />
    <bpmn:sequenceFlow id="Flow_Review_Approve" sourceRef="Split_Task_ReviewEvidence_2" targetRef="Gate_Approve" />
    <bpmn:sequenceFlow id="Flow_Review_Reject" sourceRef="Split_Task_ReviewEvidence_2" targetRef="Gate_Approve" />
    <bpmn:sequenceFlow id="Flow_Approve_Gate" sourceRef="Gate_Approve" targetRef="Gate_LowRisk" />
    <bpmn:sequenceFlow id="Flow_Reject_Notify" sourceRef="Gate_Approve" targetRef="Join_End_Rejected_1" />
    <bpmn:sequenceFlow id="Flow_LowRisk_Refund" sourceRef="Gate_LowRisk" targetRef="Join_Task_ProcessRefund_7" />
    <bpmn:sequenceFlow id="Flow_Gate_Handover" sourceRef="Gate_LowRisk" targetRef="Join_Task_HandoverReturn_2" />
    <bpmn:sequenceFlow id="Flow_Approve_Handover" sourceRef="Gate_Approve" targetRef="Join_Task_HandoverReturn_2" />
    <bpmn:sequenceFlow id="Flow_Handover_Schedule" sourceRef="Task_HandoverReturn" targetRef="Task_SchedulePickup" />
    <bpmn:sequenceFlow id="Flow_Schedule_Pickup" sourceRef="Task_SchedulePickup" targetRef="Join_Task_PickupReturn_6" />
    <bpmn:sequenceFlow id="Flow_Pickup_Gate" sourceRef="Task_PickupReturn" targetRef="Gate_PickupRetry" />
    <bpmn:sequenceFlow id="Flow_Pickup_Yes" sourceRef="Gate_PickupRetry" targetRef="Task_InspectItem" />
    <bpmn:sequenceFlow id="Flow_Pickup_No" sourceRef="Gate_PickupRetry" targetRef="Task_ReschedulePickup" />
    <bpmn:sequenceFlow id="Flow_Retry_Pickup" sourceRef="Task_ReschedulePickup" targetRef="Join_Task_PickupReturn_6" />
    <bpmn:sequenceFlow id="Flow_Inspect_Gate" sourceRef="Task_InspectItem" targetRef="Gate_InspectionPass" />
    <bpmn:sequenceFlow id="Flow_Inspect_Refund" sourceRef="Gate_InspectionPass" targetRef="Join_Task_ProcessRefund_7" />
    <bpmn:sequenceFlow id="Flow_Inspect_Reject" sourceRef="Gate_InspectionPass" targetRef="Join_End_Rejected_1" />
    <bpmn:sequenceFlow id="Flow_Refund_Method" sourceRef="Task_ProcessRefund" targetRef="Gate_RefundMethod" />
    <bpmn:sequenceFlow id="Flow_Refund_Original" sourceRef="Gate_RefundMethod" targetRef="Join_Task_NotifyStatus_4" />
    <bpmn:sequenceFlow id="Flow_Refund_Credit" sourceRef="Gate_RefundMethod" targetRef="Join_Task_NotifyStatus_4" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Task_NotifyStatus" targetRef="End_Refunded" />
    <bpmn:exclusiveGateway id="Join_Task_UploadEvidence_1" name="Gom luồng trước khi Tải lên bằng chứng ảnh và video">
      <bpmn:incoming>Flow_Eligible_Upload</bpmn:incoming>
      <bpmn:incoming>Flow_Evidence_Blurry</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_UploadEvidence_1_to_Task_UploadEvidence" sourceRef="Join_Task_UploadEvidence_1" targetRef="Task_UploadEvidence" />
    <bpmn:exclusiveGateway id="Join_Task_HandoverReturn_2" name="Gom luồng trước khi Bàn giao hàng trả cho LEX / 3PL">
      <bpmn:incoming>Flow_Gate_Handover</bpmn:incoming>
      <bpmn:incoming>Flow_Approve_Handover</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_HandoverReturn_2_to_Task_HandoverReturn" sourceRef="Join_Task_HandoverReturn_2" targetRef="Task_HandoverReturn" />
    <bpmn:exclusiveGateway id="Join_Task_CheckEligibility_3" name="Gom luồng trước khi Kiểm tra tính hợp lệ tự động">
      <bpmn:incoming>Flow_Window_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Late_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_CheckEligibility_3_to_Task_CheckEligibility" sourceRef="Join_Task_CheckEligibility_3" targetRef="Task_CheckEligibility" />
    <bpmn:exclusiveGateway id="Join_Task_NotifyStatus_4" name="Gom luồng trước khi Gửi thông báo cập nhật tiến độ tự động">
      <bpmn:incoming>Flow_Refund_Original</bpmn:incoming>
      <bpmn:incoming>Flow_Refund_Credit</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_NotifyStatus_4_to_Task_NotifyStatus" sourceRef="Join_Task_NotifyStatus_4" targetRef="Task_NotifyStatus" />
    <bpmn:exclusiveGateway id="Join_Task_ReviewEvidence_5" name="Gom luồng trước khi CS thẩm định hồ sơ khiếu nại">
      <bpmn:incoming>Flow_Evidence_Good</bpmn:incoming>
      <bpmn:incoming>Flow_Triage_AIReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ReviewEvidence_5_to_Task_ReviewEvidence" sourceRef="Join_Task_ReviewEvidence_5" targetRef="Task_ReviewEvidence" />
    <bpmn:exclusiveGateway id="Join_Task_PickupReturn_6" name="Gom luồng trước khi LEX / 3PL pickup hàng trả">
      <bpmn:incoming>Flow_Schedule_Pickup</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_PickupReturn_6_to_Task_PickupReturn" sourceRef="Join_Task_PickupReturn_6" targetRef="Task_PickupReturn" />
    <bpmn:exclusiveGateway id="Join_Task_ProcessRefund_7" name="Gom luồng trước khi Kích hoạt lệnh hoàn tiền">
      <bpmn:incoming>Flow_LowRisk_Refund</bpmn:incoming>
      <bpmn:incoming>Flow_Inspect_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ProcessRefund_7_to_Task_ProcessRefund" sourceRef="Join_Task_ProcessRefund_7" targetRef="Task_ProcessRefund" />
    <bpmn:exclusiveGateway id="Split_Task_TriageEvidence_1" name="Phân luồng sau AI phân loại bằng chứng khiếu nại">
      <bpmn:incoming>Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Triage_Quality</bpmn:outgoing>
      <bpmn:outgoing>Flow_Triage_AIReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Task_TriageEvidence_to_Split_Task_TriageEvidence_1" sourceRef="Task_TriageEvidence" targetRef="Split_Task_TriageEvidence_1" />
    <bpmn:exclusiveGateway id="Split_Task_ReviewEvidence_2" name="Phân luồng sau CS thẩm định hồ sơ khiếu nại">
      <bpmn:incoming>Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_Review_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Task_ReviewEvidence_to_Split_Task_ReviewEvidence_2" sourceRef="Task_ReviewEvidence" targetRef="Split_Task_ReviewEvidence_2" />
    <bpmn:sequenceFlow id="Flow_Join_End_Rejected_1_to_End_Rejected" sourceRef="Join_End_Rejected_1" targetRef="End_Rejected" name="" />
  </bpmn:process>
