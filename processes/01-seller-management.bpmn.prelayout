<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SellerManagement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_SellerManagement" name="Quản lý Nhà bán hàng" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>StartEvent_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixBankInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_UploadDocs_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_FixRejection_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Lazada System (Automated)">
        <bpmn:flowNodeRef>Gate_PhoneVerif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateIdentity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_BankValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OCRCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_DocValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ResubmitLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScoreRisk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_RiskDoubt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_AutoApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ValidateIdentity_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_OCRCheck_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_NotifyResult_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split_Task_NotifyResult_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Compliance Team">
        <bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Task_ManualReview_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Legal / Giám sát Vận hành">
        <bpmn:flowNodeRef>Task_MonitorViolations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_ViolationSeverity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Suspend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ban</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Warned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Suspended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Banned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Register" name="Yêu cầu đăng ký gian hàng">
      <bpmn:outgoing>Flow_Register_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Register" name="Điền thông tin định danh Seller">
      <bpmn:incoming>Flow_Register_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_Phone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_PhoneVerif" name="SĐT đã xác thực?">
      <bpmn:incoming>Flow_Register_Phone</bpmn:incoming>
      <bpmn:outgoing>Flow_Phone_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Phone_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyPhone" name="Gửi OTP xác thực SĐT">
      <bpmn:incoming>Flow_Phone_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_Upload</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_UploadDocs" name="Upload CMND/CCCD + GPKD + Giấy chứng nhận (LazMall)">
      <bpmn:outgoing>Flow_Docs_Validate</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateIdentity" name="Validate định danh tự động">
      <bpmn:outgoing>Flow_Validate_Bank</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_BankValid" name="Tài khoản NH hợp lệ?">
      <bpmn:incoming>Flow_Validate_Bank</bpmn:incoming>
      <bpmn:outgoing>Flow_Bank_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Bank_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixBankInfo" name="Cập nhật tài khoản ngân hàng (giải ngân)">
      <bpmn:incoming>Flow_Bank_No</bpmn:incoming>
      <bpmn:outgoing>Flow_FixBank_OCR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_OCRCheck" name="Quét OCR + kiểm tra giấy tờ giả">
      <bpmn:outgoing>Flow_OCR_Gate</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_DocValid" name="Giấy tờ hợp lệ?">
      <bpmn:incoming>Flow_OCR_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_DocValid_Pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocValid_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixRejection" name="Bổ sung / sửa hồ sơ">
      <bpmn:outgoing>Flow_Fix_Gate</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_FixRejection_4_to_Task_FixRejection</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_ResubmitLimit" name="Còn lượt sửa hồ sơ?">
      <bpmn:incoming>Flow_Fix_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmit_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resubmit_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ScoreRisk" name="Chấm điểm rủi ro (Risk scoring)">
      <bpmn:incoming>Flow_DocValid_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_Risk_Doubt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_RiskDoubt" name="Có nghi vấn rủi ro cao?">
      <bpmn:incoming>Flow_Risk_Doubt</bpmn:incoming>
      <bpmn:outgoing>Flow_Doubt_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Doubt_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gate_AutoApprove" name="Phân tầng rủi ro?">
      <bpmn:incoming>Flow_Doubt_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualReview" name="Compliance review thủ công (24-48h)">
      <bpmn:outgoing>Flow_Manual_Approve</bpmn:outgoing>
      <bpmn:incoming>Flow_Join_Task_ManualReview_5_to_Task_ManualReview</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gate_Approve" name="Kết quả thẩm định?">
      <bpmn:incoming>Flow_Manual_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reject_Fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyResult" name="Thông báo kết quả duyệt Seller Centre">
      <bpmn:incoming>Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MonitorViolations" name="Giám sát điểm đánh giá &amp; vi phạm (auto)">
      <bpmn:incoming>Flow_Notify_Monitor</bpmn:incoming>
      <bpmn:outgoing>Flow_Monitor_Gate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_ViolationSeverity" name="Mức độ vi phạm?">
      <bpmn:incoming>Flow_Monitor_Gate</bpmn:incoming>
      <bpmn:outgoing>Flow_Gate_Warn</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Suspend</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gate_Ban</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Warn" name="Gửi cảnh cáo Seller">
      <bpmn:incoming>Flow_Gate_Warn</bpmn:incoming>
      <bpmn:outgoing>Flow_Warn_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Suspend" name="Tạm khóa gian hàng (7 ngày)">
      <bpmn:incoming>Flow_Gate_Suspend</bpmn:incoming>
      <bpmn:outgoing>Flow_Suspend_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ban" name="Khóa gian hàng vĩnh viễn">
      <bpmn:incoming>Flow_Gate_Ban</bpmn:incoming>
      <bpmn:outgoing>Flow_Ban_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Approved" name="Gian hàng Lazada đã được kích hoạt">
      <bpmn:incoming>Flow_Notify_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Hồ sơ đã bị từ chối vĩnh viễn">
      <bpmn:incoming>Flow_Resubmit_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Warned" name="Gian hàng đã bị cảnh cáo">
      <bpmn:incoming>Flow_Warn_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Suspended" name="Gian hàng đã bị tạm khóa">
      <bpmn:incoming>Flow_Suspend_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Banned" name="Gian hàng đã bị khóa vĩnh viễn">
      <bpmn:incoming>Flow_Ban_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Register_Submit" sourceRef="StartEvent_Register" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_Register_Phone" sourceRef="Task_Register" targetRef="Gate_PhoneVerif" />
    <bpmn:sequenceFlow id="Flow_Phone_Yes" name="Đã xác thực" sourceRef="Gate_PhoneVerif" targetRef="Join_Task_UploadDocs_1" />
    <bpmn:sequenceFlow id="Flow_Phone_No" name="Chưa xác thực" sourceRef="Gate_PhoneVerif" targetRef="Task_VerifyPhone" />
    <bpmn:sequenceFlow id="Flow_Verify_Upload" sourceRef="Task_VerifyPhone" targetRef="Join_Task_UploadDocs_1" />
    <bpmn:sequenceFlow id="Flow_Docs_Validate" sourceRef="Task_UploadDocs" targetRef="Join_Task_ValidateIdentity_2" />
    <bpmn:sequenceFlow id="Flow_Validate_Bank" sourceRef="Task_ValidateIdentity" targetRef="Gate_BankValid" />
    <bpmn:sequenceFlow id="Flow_Bank_Yes" name="Hợp lệ" sourceRef="Gate_BankValid" targetRef="Join_Task_OCRCheck_3" />
    <bpmn:sequenceFlow id="Flow_Bank_No" name="Không hợp lệ" sourceRef="Gate_BankValid" targetRef="Task_FixBankInfo" />
    <bpmn:sequenceFlow id="Flow_FixBank_OCR" sourceRef="Task_FixBankInfo" targetRef="Join_Task_OCRCheck_3" />
    <bpmn:sequenceFlow id="Flow_OCR_Gate" sourceRef="Task_OCRCheck" targetRef="Gate_DocValid" />
    <bpmn:sequenceFlow id="Flow_DocValid_Pass" name="Đạt chuẩn OCR" sourceRef="Gate_DocValid" targetRef="Task_ScoreRisk" />
    <bpmn:sequenceFlow id="Flow_DocValid_Fail" name="Lỗi OCR" sourceRef="Gate_DocValid" targetRef="Join_Task_FixRejection_4" />
    <bpmn:sequenceFlow id="Flow_Fix_Gate" sourceRef="Task_FixRejection" targetRef="Gate_ResubmitLimit" />
    <bpmn:sequenceFlow id="Flow_Resubmit_OK" name="Còn lượt" sourceRef="Gate_ResubmitLimit" targetRef="Join_Task_ValidateIdentity_2" />
    <bpmn:sequenceFlow id="Flow_Resubmit_End" name="Hết lượt (3 lần)" sourceRef="Gate_ResubmitLimit" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_Risk_Doubt" sourceRef="Task_ScoreRisk" targetRef="Gate_RiskDoubt" />
    <bpmn:sequenceFlow id="Flow_Doubt_No" name="Rủi ro thấp/vừa" sourceRef="Gate_RiskDoubt" targetRef="Gate_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_Doubt_Yes" name="Nghi vấn cao" sourceRef="Gate_RiskDoubt" targetRef="Join_Task_ManualReview_5" />
    <bpmn:sequenceFlow id="Flow_Gate_Auto" name="Điểm tốt (Low-risk)" sourceRef="Gate_AutoApprove" targetRef="Join_Task_NotifyResult_6" />
    <bpmn:sequenceFlow id="Flow_Gate_Manual" name="Cần hậu kiểm" sourceRef="Gate_AutoApprove" targetRef="Join_Task_ManualReview_5" />
    <bpmn:sequenceFlow id="Flow_Gate_Reject" name="Không đạt" sourceRef="Gate_AutoApprove" targetRef="Join_Task_FixRejection_4" />
    <bpmn:sequenceFlow id="Flow_Manual_Approve" sourceRef="Task_ManualReview" targetRef="Gate_Approve" />
    <bpmn:sequenceFlow id="Flow_Approve_Notify" name="Chấp thuận" sourceRef="Gate_Approve" targetRef="Join_Task_NotifyResult_6" />
    <bpmn:sequenceFlow id="Flow_Reject_Notify" name="Từ chối" sourceRef="Gate_Approve" targetRef="Join_Task_NotifyResult_6" />
    <bpmn:sequenceFlow id="Flow_Reject_Fix" name="Yêu cầu bổ sung" sourceRef="Gate_Approve" targetRef="Join_Task_FixRejection_4" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Split_Task_NotifyResult_1" targetRef="End_Approved" />
    <bpmn:sequenceFlow id="Flow_Notify_Monitor" sourceRef="Split_Task_NotifyResult_1" targetRef="Task_MonitorViolations" />
    <bpmn:sequenceFlow id="Flow_Monitor_Gate" sourceRef="Task_MonitorViolations" targetRef="Gate_ViolationSeverity" />
    <bpmn:sequenceFlow id="Flow_Gate_Warn" name="Nhẹ (1-2 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Warn" />
    <bpmn:sequenceFlow id="Flow_Gate_Suspend" name="Trung bình (3-5 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Suspend" />
    <bpmn:sequenceFlow id="Flow_Gate_Ban" name="Nặng (&gt;6 sao phạt)" sourceRef="Gate_ViolationSeverity" targetRef="Task_Ban" />
    <bpmn:sequenceFlow id="Flow_Warn_End" sourceRef="Task_Warn" targetRef="End_Warned" />
    <bpmn:sequenceFlow id="Flow_Suspend_End" sourceRef="Task_Suspend" targetRef="End_Suspended" />
    <bpmn:sequenceFlow id="Flow_Ban_End" sourceRef="Task_Ban" targetRef="End_Banned" />
    <bpmn:exclusiveGateway id="Join_Task_UploadDocs_1" name="Gom luồng trước khi Upload CMND/CCCD + GPKD + Giấy chứng nhận (LazMall)">
      <bpmn:incoming>Flow_Phone_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Verify_Upload</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_UploadDocs_1_to_Task_UploadDocs" sourceRef="Join_Task_UploadDocs_1" targetRef="Task_UploadDocs" />
    <bpmn:exclusiveGateway id="Join_Task_ValidateIdentity_2" name="Gom luồng trước khi Validate định danh tự động">
      <bpmn:incoming>Flow_Docs_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Resubmit_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ValidateIdentity_2_to_Task_ValidateIdentity" sourceRef="Join_Task_ValidateIdentity_2" targetRef="Task_ValidateIdentity" />
    <bpmn:exclusiveGateway id="Join_Task_OCRCheck_3" name="Gom luồng trước khi Quét OCR + kiểm tra giấy tờ giả">
      <bpmn:incoming>Flow_Bank_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_FixBank_OCR</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_OCRCheck_3_to_Task_OCRCheck" sourceRef="Join_Task_OCRCheck_3" targetRef="Task_OCRCheck" />
    <bpmn:exclusiveGateway id="Join_Task_FixRejection_4" name="Gom luồng trước khi Bổ sung / sửa hồ sơ">
      <bpmn:incoming>Flow_DocValid_Fail</bpmn:incoming>
      <bpmn:incoming>Flow_Gate_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_FixRejection_4_to_Task_FixRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_FixRejection_4_to_Task_FixRejection" sourceRef="Join_Task_FixRejection_4" targetRef="Task_FixRejection" />
    <bpmn:exclusiveGateway id="Join_Task_ManualReview_5" name="Gom luồng trước khi Compliance review thủ công (24-48h)">
      <bpmn:incoming>Flow_Doubt_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Gate_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_ManualReview_5_to_Task_ManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_ManualReview_5_to_Task_ManualReview" sourceRef="Join_Task_ManualReview_5" targetRef="Task_ManualReview" />
    <bpmn:exclusiveGateway id="Join_Task_NotifyResult_6" name="Gom luồng trước khi Thông báo kết quả duyệt Seller Centre">
      <bpmn:incoming>Flow_Gate_Auto</bpmn:incoming>
      <bpmn:incoming>Flow_Approve_Notify</bpmn:incoming>
      <bpmn:incoming>Flow_Reject_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Join_Task_NotifyResult_6_to_Task_NotifyResult" sourceRef="Join_Task_NotifyResult_6" targetRef="Task_NotifyResult" />
    <bpmn:exclusiveGateway id="Split_Task_NotifyResult_1" name="Phân luồng sau Thông báo kết quả duyệt Seller Centre">
      <bpmn:outgoing>Flow_Notify_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Notify_Monitor</bpmn:outgoing>
      <bpmn:incoming>Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Task_NotifyResult_to_Split_Task_NotifyResult_1" sourceRef="Task_NotifyResult" targetRef="Split_Task_NotifyResult_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SellerManagement">
      <bpmndi:BPMNShape id="Lane_Seller_di" bpmnElement="Lane_Seller">
        <dc:Bounds x="30" y="0" width="5646" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System">
        <dc:Bounds x="30" y="200" width="5646" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Compliance_di" bpmnElement="Lane_Compliance">
        <dc:Bounds x="30" y="400" width="5646" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Legal_di" bpmnElement="Lane_Legal">
        <dc:Bounds x="30" y="600" width="5646" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Register_di" bpmnElement="StartEvent_Register">
        <dc:Bounds x="80" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="300" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_PhoneVerif_di" bpmnElement="Gate_PhoneVerif">
        <dc:Bounds x="520" y="277" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyPhone_di" bpmnElement="Task_VerifyPhone">
        <dc:Bounds x="740" y="265" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UploadDocs_di" bpmnElement="Task_UploadDocs">
        <dc:Bounds x="1180" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateIdentity_di" bpmnElement="Task_ValidateIdentity">
