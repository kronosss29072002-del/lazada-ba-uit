<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DisputeManagement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_DisputeManagement" name="Quản lý Tranh chấp" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Dispute</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CreateDispute</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReplyEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_EvidenceComplete</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_RequestMoreEvidence</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReplyEvidence_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_RequestMoreEvidence_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_CollectData</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AuthTriage</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyParties</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SimpleCase</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SLA</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_NotifyParties_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_AuthTriage_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_SellerReply</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_SellerReply_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_CS" name="CS Agent">
        <ns0:flowNodeRef>Task_ReviewCase</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Decide</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BuyerWins</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_Compromise</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReviewCase_4</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_Decide_3</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Escalation" name="Escalation Team">
        <ns0:flowNodeRef>Task_Escalate</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SeniorReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SeniorDecision</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Dispute" name="Yêu cầu giải quyết tranh chấp">
      <ns0:outgoing>Flow_Start_Create</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Task_CreateDispute" name="Tạo tranh chấp + lý do">
      <ns0:incoming>Flow_Start_Create</ns0:incoming>
      <ns0:outgoing>Flow_Create_Collect</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReplyEvidence" name="Bổ sung bằng chứng (nếu có)">
      <ns0:incoming>Flow_Join_Task_ReplyEvidence_1_to_Task_ReplyEvidence</ns0:incoming>
      <ns0:outgoing>Flow_Evidence_Solid</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_EvidenceSolid" name="Có bằng chứng cứng?">
      <ns0:incoming>Flow_Evidence_Solid</ns0:incoming>
      <ns0:outgoing>Flow_Evidence_SolidYes</ns0:outgoing>
      <ns0:outgoing>Flow_Evidence_SoftNo</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_RequestMoreEvidence" name="Yêu cầu bổ sung bằng chứng">
      <ns0:incoming>Flow_Join_Task_RequestMoreEvidence_2_to_Task_RequestMoreEvidence</ns0:incoming>
      <ns0:outgoing>Flow_Request_Evidence</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_CollectData" name="Tự động thu thập dữ liệu đơn hàng">
      <ns0:incoming>Flow_Create_Collect</ns0:incoming>
      <ns0:outgoing>Flow_Collect_Triage</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AuthTriage" name="AI phân loại tranh chấp (Đơn giản/Phức tạp)">
      <ns0:incoming>Flow_Collect_Triage</ns0:incoming>
      <ns0:outgoing>Flow_Task_AuthTriage_to_Split_Task_AuthTriage_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_SellerHistory" name="Seller từng vi phạm SLA?">
      <ns0:incoming>Flow_Triage_History</ns0:incoming>
      <ns0:outgoing>Flow_History_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_History_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_CheckSLAHistory" name="Kiểm tra lịch sử SLA">
      <ns0:incoming>Flow_History_No</ns0:incoming>
      <ns0:outgoing>Flow_Check_Notify</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_NotifyParties" name="Gửi thông báo đối soát đến hai bên">
      <ns0:incoming>Flow_Join_Task_NotifyParties_3_to_Task_NotifyParties</ns0:incoming>
      <ns0:outgoing>Flow_Notify_SLA</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_SellerReply" name="Seller phản hồi (≤48h)">
      <ns0:incoming>Flow_SLA_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Task_SellerReply_to_Split_Task_SellerReply_2</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ReviewCase" name="CS thẩm định toàn bộ hồ sơ tranh chấp">
      <ns0:incoming>Flow_Join_Task_ReviewCase_4_to_Task_ReviewCase</ns0:incoming>
      <ns0:outgoing>Flow_Review_Decide</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Decide" name="CS ban hành quyết định xử lý">
      <ns0:incoming>Flow_Review_Decide</ns0:incoming>
      <ns0:outgoing>Flow_Task_Decide_to_Split_Task_Decide_3</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Escalate" name="Chuyển lên nhóm chuyên trách (Lazada Escalation)">
      <ns0:incoming>Flow_Decide_Escalate</ns0:incoming>
      <ns0:outgoing>Flow_Escalate_Review</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_SeniorReview" name="Hội đồng thẩm định &amp; ra quyết định cuối">
      <ns0:incoming>Flow_Escalate_Review</ns0:incoming>
      <ns0:outgoing>Flow_Senior_Final</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gate_SLA" name="Seller phản hồi trong 48h?">
      <ns0:incoming>Flow_Notify_SLA</ns0:incoming>
      <ns0:outgoing>Flow_SLA_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_SLA_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_EvidenceComplete" name="Bằng chứng đã đầy đủ &amp; hợp lệ?">
      <ns0:incoming>Flow_Evidence_SolidYes</ns0:incoming>
      <ns0:outgoing>Flow_Evidence_Complete</ns0:outgoing>
      <ns0:outgoing>Flow_Evidence_Incomplete</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SimpleCase" name="Vụ việc thuộc nhóm đơn giản?">
      <ns0:incoming>Flow_Triage_simple</ns0:incoming>
      <ns0:outgoing>Flow_Simple_Auto</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_BuyerWins" name="Buyer thắng?">
      <ns0:incoming>Flow_Decide_Wins</ns0:incoming>
      <ns0:outgoing>Flow_Wins_Settle</ns0:outgoing>
      <ns0:outgoing>Flow_Wins_Not</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_Compromise" name="Đồng thuận?">
      <ns0:incoming>Flow_Decide_Compromise</ns0:incoming>
      <ns0:outgoing>Flow_Compromise_Settle</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SeniorDecision" name="Quyết định cuối?">
      <ns0:incoming>Flow_Senior_Final</ns0:incoming>
      <ns0:outgoing>Flow_Senior_Settle</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Join_End_Settled_1" name="Gom nhánh kết thúc">
      <ns0:incoming>Flow_SLA_No</ns0:incoming>
      <ns0:incoming>Flow_Senior_Settle</ns0:incoming>
      <ns0:incoming>Flow_Wins_Settle</ns0:incoming>
      <ns0:incoming>Flow_Compromise_Settle</ns0:incoming>
      <ns0:outgoing>Flow_Join_End_Settled_1_to_End_Settled</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="End_Settled" name="Tranh chấp đã được giải quyết">
      <ns0:incoming>Flow_Join_End_Settled_1_to_End_Settled</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Rejected" name="Tranh chấp đã bị bác bỏ">
      <ns0:incoming>Flow_Wins_Not</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_AIResolved" name="Tranh chấp đã được AI tự giải quyết">
      <ns0:incoming>Flow_Simple_Auto</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Start_Create" sourceRef="StartEvent_Dispute" targetRef="Task_CreateDispute" />
    <ns0:sequenceFlow id="Flow_Create_Collect" sourceRef="Task_CreateDispute" targetRef="Task_CollectData" />
    <ns0:sequenceFlow id="Flow_Collect_Triage" sourceRef="Task_CollectData" targetRef="Task_AuthTriage" />
    <ns0:sequenceFlow id="Flow_Triage_History" sourceRef="Split_Task_AuthTriage_1" targetRef="Gate_SellerHistory" name="Phức tạp (tra SLA)" />
    <ns0:sequenceFlow id="Flow_History_Yes" sourceRef="Gate_SellerHistory" targetRef="Join_Task_NotifyParties_3" name="Đã vi phạm SLA" />
    <ns0:sequenceFlow id="Flow_History_No" sourceRef="Gate_SellerHistory" targetRef="Task_CheckSLAHistory" name="Chưa vi phạm SLA" />
    <ns0:sequenceFlow id="Flow_Check_Notify" sourceRef="Task_CheckSLAHistory" targetRef="Join_Task_NotifyParties_3" />
    <ns0:sequenceFlow id="Flow_Notify_SLA" sourceRef="Task_NotifyParties" targetRef="Gate_SLA" />
    <ns0:sequenceFlow id="Flow_SLA_Yes" sourceRef="Gate_SLA" targetRef="Task_SellerReply" name="Phản hồi đúng hạn" />
    <ns0:sequenceFlow id="Flow_SLA_No" sourceRef="Gate_SLA" targetRef="Join_End_Settled_1" name="Quá hạn 48h" />
    <ns0:sequenceFlow id="Flow_SellerReply_Review" sourceRef="Split_Task_SellerReply_2" targetRef="Join_Task_ReviewCase_4" name="CS thẩm định" />
    <ns0:sequenceFlow id="Flow_SellerReply_Rejoin" sourceRef="Split_Task_SellerReply_2" targetRef="Join_Task_ReplyEvidence_1" name="Bổ sung bằng chứng" />
    <ns0:sequenceFlow id="Flow_Evidence_Solid" sourceRef="Task_ReplyEvidence" targetRef="Gate_EvidenceSolid" />
    <ns0:sequenceFlow id="Flow_Evidence_SolidYes" sourceRef="Gate_EvidenceSolid" targetRef="Gate_EvidenceComplete" name="Có bằng chứng cứng" />
    <ns0:sequenceFlow id="Flow_Evidence_SoftNo" sourceRef="Gate_EvidenceSolid" targetRef="Join_Task_RequestMoreEvidence_2" name="Không/thiếu bằng chứng" />
    <ns0:sequenceFlow id="Flow_Evidence_Complete" sourceRef="Gate_EvidenceComplete" targetRef="Join_Task_ReviewCase_4" name="Bằng chứng đầy đủ" />
    <ns0:sequenceFlow id="Flow_Evidence_Incomplete" sourceRef="Gate_EvidenceComplete" targetRef="Join_Task_RequestMoreEvidence_2" name="Thiếu bằng chứng" />
    <ns0:sequenceFlow id="Flow_Request_Evidence" sourceRef="Task_RequestMoreEvidence" targetRef="Join_Task_ReplyEvidence_1" />
    <ns0:sequenceFlow id="Flow_Review_Decide" sourceRef="Task_ReviewCase" targetRef="Task_Decide" />
    <ns0:sequenceFlow id="Flow_Decide_Wins" sourceRef="Split_Task_Decide_3" targetRef="Gate_BuyerWins" name="Buyer thắng" />
    <ns0:sequenceFlow id="Flow_Decide_Compromise" sourceRef="Split_Task_Decide_3" targetRef="Gate_Compromise" name="Đồng thuận 2 bên" />
    <ns0:sequenceFlow id="Flow_Decide_Escalate" sourceRef="Split_Task_Decide_3" targetRef="Task_Escalate" name="Escalate" />
    <ns0:sequenceFlow id="Flow_Escalate_Review" sourceRef="Task_Escalate" targetRef="Task_SeniorReview" />
    <ns0:sequenceFlow id="Flow_Senior_Final" sourceRef="Task_SeniorReview" targetRef="Gate_SeniorDecision" />
    <ns0:sequenceFlow id="Flow_Senior_Settle" sourceRef="Gate_SeniorDecision" targetRef="Join_End_Settled_1" />
    <ns0:sequenceFlow id="Flow_Wins_Settle" sourceRef="Gate_BuyerWins" targetRef="Join_End_Settled_1" name="Buyer thắng" />
    <ns0:sequenceFlow id="Flow_Wins_Not" sourceRef="Gate_BuyerWins" targetRef="End_Rejected" name="Buyer thua/bác bỏ" />
    <ns0:sequenceFlow id="Flow_Compromise_Settle" sourceRef="Gate_Compromise" targetRef="Join_End_Settled_1" />
    <ns0:sequenceFlow id="Flow_Simple_Auto" sourceRef="Gate_SimpleCase" targetRef="End_AIResolved" />
    <ns0:sequenceFlow id="Flow_Triage_simple" sourceRef="Split_Task_AuthTriage_1" targetRef="Gate_SimpleCase" name="Đơn giản" />
    <ns0:exclusiveGateway id="Join_Task_ReplyEvidence_1" name="Gom luồng trước khi Bổ sung bằng chứng (nếu có)">
      <ns0:incoming>Flow_SellerReply_Rejoin</ns0:incoming>
      <ns0:incoming>Flow_Request_Evidence</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReplyEvidence_1_to_Task_ReplyEvidence</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ReplyEvidence_1_to_Task_ReplyEvidence" sourceRef="Join_Task_ReplyEvidence_1" targetRef="Task_ReplyEvidence" />
    <ns0:exclusiveGateway id="Join_Task_RequestMoreEvidence_2" name="Gom luồng trước khi Yêu cầu bổ sung bằng chứng">
      <ns0:incoming>Flow_Evidence_SoftNo</ns0:incoming>
      <ns0:incoming>Flow_Evidence_Incomplete</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_RequestMoreEvidence_2_to_Task_RequestMoreEvidence</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_RequestMoreEvidence_2_to_Task_RequestMoreEvidence" sourceRef="Join_Task_RequestMoreEvidence_2" targetRef="Task_RequestMoreEvidence" />
    <ns0:exclusiveGateway id="Join_Task_NotifyParties_3" name="Gom luồng trước khi Gửi thông báo đối soát đến hai bên">
      <ns0:incoming>Flow_History_Yes</ns0:incoming>
      <ns0:incoming>Flow_Check_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_NotifyParties_3_to_Task_NotifyParties</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_NotifyParties_3_to_Task_NotifyParties" sourceRef="Join_Task_NotifyParties_3" targetRef="Task_NotifyParties" />
    <ns0:exclusiveGateway id="Join_Task_ReviewCase_4" name="Gom luồng trước khi CS thẩm định toàn bộ hồ sơ tranh chấp">
      <ns0:incoming>Flow_SellerReply_Review</ns0:incoming>
      <ns0:incoming>Flow_Evidence_Complete</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReviewCase_4_to_Task_ReviewCase</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ReviewCase_4_to_Task_ReviewCase" sourceRef="Join_Task_ReviewCase_4" targetRef="Task_ReviewCase" />
    <ns0:exclusiveGateway id="Split_Task_AuthTriage_1" name="Phân luồng sau AI phân loại tranh chấp (Đơn giản/Phức tạp)">
      <ns0:incoming>Flow_Task_AuthTriage_to_Split_Task_AuthTriage_1</ns0:incoming>
      <ns0:outgoing>Flow_Triage_History</ns0:outgoing>
      <ns0:outgoing>Flow_Triage_simple</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_AuthTriage_to_Split_Task_AuthTriage_1" sourceRef="Task_AuthTriage" targetRef="Split_Task_AuthTriage_1" />
    <ns0:exclusiveGateway id="Split_Task_SellerReply_2" name="Phân luồng sau Seller phản hồi (≤48h)">
      <ns0:incoming>Flow_Task_SellerReply_to_Split_Task_SellerReply_2</ns0:incoming>
      <ns0:outgoing>Flow_SellerReply_Review</ns0:outgoing>
      <ns0:outgoing>Flow_SellerReply_Rejoin</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_SellerReply_to_Split_Task_SellerReply_2" sourceRef="Task_SellerReply" targetRef="Split_Task_SellerReply_2" />
    <ns0:exclusiveGateway id="Split_Task_Decide_3" name="Phân luồng sau CS ban hành quyết định xử lý">
      <ns0:incoming>Flow_Task_Decide_to_Split_Task_Decide_3</ns0:incoming>
      <ns0:outgoing>Flow_Decide_Wins</ns0:outgoing>
      <ns0:outgoing>Flow_Decide_Compromise</ns0:outgoing>
      <ns0:outgoing>Flow_Decide_Escalate</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Task_Decide_to_Split_Task_Decide_3" sourceRef="Task_Decide" targetRef="Split_Task_Decide_3" />
    <ns0:sequenceFlow id="Flow_Join_End_Settled_1_to_End_Settled" sourceRef="Join_End_Settled_1" targetRef="End_Settled" name="" />
  </ns0:process>
  <ns1:BPMNDiagram id="BPMNDiagram_1">
