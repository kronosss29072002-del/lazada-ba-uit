<?xml version='1.0' encoding='UTF-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns2="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <ns0:process id="Process_OrderProcessing" name="Xử lý Đơn hàng Online Lazada" isExecutable="true">
    <ns0:laneSet id="LaneSet_1">
      <ns0:lane id="Lane_Buyer" name="Buyer">
        <ns0:flowNodeRef>StartEvent_Checkout</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReviewOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Pay</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ConfirmReceipt</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CancelOrder</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Lazada System (Automated)">
        <ns0:flowNodeRef>Task_ValidateOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LockInventory</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FraudCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CheckInventory</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CreateWaybill</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_TrackDelivery</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_CountRetries</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReleasePayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoCancel</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Notify</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_AutoRefund</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_PaymentMethod</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_FraudCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_InventoryCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_SellerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_CancelRequest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_RetryLimit</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_BuyerConfirm</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gate_CancelSplit</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_LockInventory_1</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_TrackDelivery_2</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_ReleasePayment_3</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_AutoCancel_4</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_Notify_5</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_CreateWaybill_1</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Seller" name="Seller">
        <ns0:flowNodeRef>Task_ConfirmOrder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PackageGoods</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Handover3PL</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_ConfirmOrder_2</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_3PL" name="3PL/Shipper">
        <ns0:flowNodeRef>Task_Pickup</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_DeliverAttempt</ns0:flowNodeRef>
        <ns0:flowNodeRef>Join_Task_DeliverAttempt_6</ns0:flowNodeRef>
        <ns0:flowNodeRef>Split_Task_DeliverAttempt_3</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Payment" name="Payment Gateway">
        <ns0:flowNodeRef>Task_VerifyPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_HoldPayment</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ExecuteRefund</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_Checkout" name="Yêu cầu đặt hàng">
      <ns0:outgoing>Flow_Checkout_Validate</ns0:outgoing>
    </ns0:startEvent>
    <ns0:task id="Task_ReviewOrder" name="Xem lại đơn hàng">
      <ns0:incoming>Flow_Validate_Review</ns0:incoming>
      <ns0:outgoing>Flow_Review_Pay</ns0:outgoing>
    </ns0:task>
    <ns0:userTask id="Task_Pay" name="Thanh toán đơn hàng (COD / Thẻ / Ví / Chuyển khoản)">
      <ns0:incoming>Flow_Review_Pay</ns0:incoming>
      <ns0:outgoing>Flow_Pay_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:task id="Task_ReceiveGoods" name="Nhận hàng từ shipper">
      <ns0:incoming>Flow_Deliver_Success</ns0:incoming>
      <ns0:outgoing>Flow_Receive_Confirm</ns0:outgoing>
    </ns0:task>
    <ns0:userTask id="Task_ConfirmReceipt" name="Xác nhận đã nhận hàng">
      <ns0:incoming>Flow_Receive_Confirm</ns0:incoming>
      <ns0:outgoing>Flow_Confirm_Gate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_CancelOrder" name="Buyer hủy đơn">
      <ns0:incoming>Flow_Cancel_Gate_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Cancel_Notify_Buyer</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_ValidateOrder" name="Validate thông tin đơn">
      <ns0:incoming>Flow_Checkout_Validate</ns0:incoming>
      <ns0:outgoing>Flow_Validate_Review</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LockInventory" name="Khóa tồn kho + tạo đơn">
      <ns0:outgoing>Flow_Lock_Fraud</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_LockInventory_1_to_Task_LockInventory</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_FraudCheck" name="Kiểm tra gian lận (AI)">
      <ns0:incoming>Flow_Lock_Fraud</ns0:incoming>
      <ns0:outgoing>Flow_Fraud_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_CheckInventory" name="Kiểm tra tồn kho">
      <ns0:incoming>Flow_Fraud_Inventory</ns0:incoming>
      <ns0:outgoing>Flow_Inventory_Gate</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_CreateWaybill" name="Tạo vận đơn tự động (LEX / 3PL)">
      <ns0:incoming>Flow_Package_Waybill</ns0:incoming>
      <ns0:outgoing>Flow_Task_CreateWaybill_to_Split_Task_CreateWaybill_1</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_TrackDelivery" name="Cập nhật định vị đơn hàng realtime">
      <ns0:outgoing>Flow_Track_Deliver</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_CountRetries" name="Đếm số lần giao lại">
      <ns0:incoming>Flow_Deliver_Fail</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Count</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoConfirm" name="Auto-confirm (7 ngày)">
      <ns0:incoming>Flow_GateConfirm_Auto</ns0:incoming>
      <ns0:outgoing>Flow_Auto_Release</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_SellerTimeout" name="Hủy đơn do Seller quá hạn 48h">
      <ns0:incoming>Flow_GateSeller_Timeout</ns0:incoming>
      <ns0:outgoing>Flow_Timeout_Cancel</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ReleasePayment" name="Giải ngân cho Seller">
      <ns0:outgoing>Flow_Release_End</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoCancel" name="Auto-cancel đơn">
      <ns0:outgoing>Flow_Cancel_Split</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_AutoCancel_4_to_Task_AutoCancel</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_Notify" name="Thông báo hủy đơn">
      <ns0:outgoing>Flow_Notify_Refund</ns0:outgoing>
      <ns0:incoming>Flow_Join_Task_Notify_5_to_Task_Notify</ns0:incoming>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_AutoRefund" name="Tự động hoàn tiền cho Buyer">
      <ns0:incoming>Flow_Notify_Refund</ns0:incoming>
      <ns0:outgoing>Flow_Refund_Execute</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_ConfirmOrder" name="Seller xác nhận đơn">
      <ns0:incoming>Flow_GateSeller_Confirm</ns0:incoming>
      <ns0:outgoing>Flow_Task_ConfirmOrder_to_Split_Task_ConfirmOrder_2</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_PackageGoods" name="Seller đóng gói">
      <ns0:incoming>Flow_Confirm_Package</ns0:incoming>
      <ns0:outgoing>Flow_Package_Waybill</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_Handover3PL" name="Bàn giao hàng cho 3PL / LEX">
      <ns0:incoming>Flow_Package3PL</ns0:incoming>
      <ns0:outgoing>Flow_3PL_Pickup</ns0:outgoing>
    </ns0:userTask>
    <ns0:task id="Task_Pickup" name="LEX (Lazada Express) lấy hàng &amp; quét barcode tại kho">
      <ns0:incoming>Flow_3PL_Pickup</ns0:incoming>
      <ns0:outgoing>Flow_Pickup_CancelGate</ns0:outgoing>
    </ns0:task>
    <ns0:userTask id="Task_DeliverAttempt" name="Giao hàng (attempt)">
      <ns0:incoming>Flow_Join_Task_DeliverAttempt_6_to_Task_DeliverAttempt</ns0:incoming>
      <ns0:outgoing>Flow_Task_DeliverAttempt_to_Split_Task_DeliverAttempt_3</ns0:outgoing>
    </ns0:userTask>
    <ns0:serviceTask id="Task_VerifyPayment" name="Gateway verify thanh toán">
      <ns0:incoming>Flow_Gate_Online</ns0:incoming>
      <ns0:outgoing>Flow_Verify_Process</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_HoldPayment" name="Giữ tiền tạm thời (COD)">
      <ns0:incoming>Flow_Gate_COD</ns0:incoming>
      <ns0:outgoing>Flow_Hold_Process</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ExecuteRefund" name="Cổng thanh toán xử lý hoàn tiền">
      <ns0:incoming>Flow_Refund_Execute</ns0:incoming>
      <ns0:outgoing>Flow_Refund_End</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gate_PaymentMethod" name="Phương thức thanh toán?">
      <ns0:incoming>Flow_Pay_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Gate_Online</ns0:outgoing>
      <ns0:outgoing>Flow_Gate_COD</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_FraudCheck" name="Gian lận?">
      <ns0:incoming>Flow_Fraud_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Fraud_Inventory</ns0:outgoing>
      <ns0:outgoing>Flow_Fraud_Cancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_InventoryCheck" name="Còn hàng?">
      <ns0:incoming>Flow_Inventory_Gate</ns0:incoming>
      <ns0:outgoing>Flow_Inventory_Seller</ns0:outgoing>
      <ns0:outgoing>Flow_Inventory_Cancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_SellerConfirm" name="Seller phản hồi trong 48h?">
      <ns0:incoming>Flow_Inventory_Seller</ns0:incoming>
      <ns0:outgoing>Flow_GateSeller_Confirm</ns0:outgoing>
      <ns0:outgoing>Flow_GateSeller_Timeout</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_CancelRequest" name="Buyer hủy?">
      <ns0:incoming>Flow_Pickup_CancelGate</ns0:incoming>
      <ns0:outgoing>Flow_Cancel_Gate_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_Cancel_Gate_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_RetryLimit" name="Số lần thử lại ≤ 3 lần?">
      <ns0:incoming>Flow_Retry_Count</ns0:incoming>
      <ns0:outgoing>Flow_Retry_Deliver</ns0:outgoing>
      <ns0:outgoing>Flow_Retry_Cancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_BuyerConfirm" name="Buyer đã confirm?">
      <ns0:incoming>Flow_Confirm_Gate</ns0:incoming>
      <ns0:outgoing>Flow_GateConfirm_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_GateConfirm_Auto</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gate_CancelSplit" name="Đơn đã thanh toán online?">
      <ns0:incoming>Flow_Cancel_Split</ns0:incoming>
      <ns0:outgoing>Flow_Cancel_Notify</ns0:outgoing>
      <ns0:outgoing>Flow_Cancel_End</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:dataObject id="DataObject_RetryCount" name="retryCount">
      <ns0:documentation>Biến đếm số lần giao lại. Khởi tạo = 0, tăng 1 mỗi lần Task_DeliverAttempt thất bại. Gate_RetryLimit kiểm tra retryCount &lt; 3 để quyết định Retry (tăng counter) hoặc AutoCancel. Đảm bảo retry loop là bounded (max 3 attempts).</ns0:documentation>
    </ns0:dataObject>
    <ns0:dataObjectReference id="DataObjectRef_RetryCount" name="retryCount" dataObjectRef="DataObject_RetryCount" />
    <ns0:endEvent id="End_Delivered" name="Đơn hàng đã hoàn tất">
      <ns0:incoming>Flow_Release_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Refunded" name="Đã hoàn tiền cho Buyer">
      <ns0:incoming>Flow_Refund_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:endEvent id="End_Cancelled" name="Đơn hàng đã bị hủy">
      <ns0:incoming>Flow_Cancel_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_Checkout_Validate" sourceRef="StartEvent_Checkout" targetRef="Task_ValidateOrder" />
    <ns0:sequenceFlow id="Flow_Validate_Review" sourceRef="Task_ValidateOrder" targetRef="Task_ReviewOrder" />
    <ns0:sequenceFlow id="Flow_Review_Pay" sourceRef="Task_ReviewOrder" targetRef="Task_Pay" />
    <ns0:sequenceFlow id="Flow_Pay_Gate" sourceRef="Task_Pay" targetRef="Gate_PaymentMethod" />
    <ns0:sequenceFlow id="Flow_Gate_Online" sourceRef="Gate_PaymentMethod" targetRef="Task_VerifyPayment" name="Thanh toán online" />
    <ns0:sequenceFlow id="Flow_Gate_COD" sourceRef="Gate_PaymentMethod" targetRef="Task_HoldPayment" name="Thanh toán COD" />
    <ns0:sequenceFlow id="Flow_Verify_Process" sourceRef="Task_VerifyPayment" targetRef="Join_Task_LockInventory_1" />
    <ns0:sequenceFlow id="Flow_Hold_Process" sourceRef="Task_HoldPayment" targetRef="Join_Task_LockInventory_1" />
    <ns0:sequenceFlow id="Flow_Lock_Fraud" sourceRef="Task_LockInventory" targetRef="Task_FraudCheck" />
    <ns0:sequenceFlow id="Flow_Fraud_Gate" sourceRef="Task_FraudCheck" targetRef="Gate_FraudCheck" />
    <ns0:sequenceFlow id="Flow_Fraud_Inventory" sourceRef="Gate_FraudCheck" targetRef="Task_CheckInventory" name="Không gian lận" />
    <ns0:sequenceFlow id="Flow_Fraud_Cancel" sourceRef="Gate_FraudCheck" targetRef="Join_Task_AutoCancel_4" name="Nghi gian lận" />
    <ns0:sequenceFlow id="Flow_Inventory_Gate" sourceRef="Task_CheckInventory" targetRef="Gate_InventoryCheck" />
    <ns0:sequenceFlow id="Flow_Inventory_Seller" sourceRef="Gate_InventoryCheck" targetRef="Gate_SellerConfirm" name="Còn hàng" />
    <ns0:sequenceFlow id="Flow_Inventory_Cancel" sourceRef="Gate_InventoryCheck" targetRef="Join_Task_AutoCancel_4" name="Hết hàng" />
    <ns0:sequenceFlow id="Flow_GateSeller_Confirm" sourceRef="Gate_SellerConfirm" targetRef="Task_ConfirmOrder" name="Seller xác nhận đúng hạn" />
    <ns0:sequenceFlow id="Flow_GateSeller_Timeout" sourceRef="Gate_SellerConfirm" targetRef="Task_SellerTimeout" name="Seller quá hạn 48h" />
    <ns0:sequenceFlow id="Flow_Timeout_Cancel" sourceRef="Task_SellerTimeout" targetRef="Join_Task_AutoCancel_4" />
    <ns0:sequenceFlow id="Flow_Confirm_Package" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Task_PackageGoods" name="Seller đồng ý đóng gói" />
    <ns0:sequenceFlow id="Flow_Confirm_Refuse" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Join_Task_AutoCancel_4" name="Seller từ chối" />
    <ns0:sequenceFlow id="Flow_Package_Waybill" sourceRef="Task_PackageGoods" targetRef="Task_CreateWaybill" />
    <ns0:sequenceFlow id="Flow_Package3PL" sourceRef="Split_Task_CreateWaybill_1" targetRef="Task_Handover3PL" name="Bàn giao cho 3PL/LEX" />
    <ns0:sequenceFlow id="Flow_3PL_Pickup" sourceRef="Task_Handover3PL" targetRef="Task_Pickup" />
    <ns0:sequenceFlow id="Flow_Pickup_CancelGate" sourceRef="Task_Pickup" targetRef="Gate_CancelRequest" />
    <ns0:sequenceFlow id="Flow_Cancel_Gate_Yes" sourceRef="Gate_CancelRequest" targetRef="Task_CancelOrder" name="Buyer hủy đơn" />
    <ns0:sequenceFlow id="Flow_Cancel_Gate_No" sourceRef="Gate_CancelRequest" targetRef="Join_Task_TrackDelivery_2" name="Không hủy" />
    <ns0:sequenceFlow id="Flow_Waybill_Track" sourceRef="Split_Task_CreateWaybill_1" targetRef="Join_Task_TrackDelivery_2" name="Cập nhật tracking" />
    <ns0:sequenceFlow id="Flow_Track_Deliver" sourceRef="Task_TrackDelivery" targetRef="Join_Task_DeliverAttempt_6" />
    <ns0:sequenceFlow id="Flow_Deliver_Success" sourceRef="Split_Task_DeliverAttempt_3" targetRef="Task_ReceiveGoods" name="Giao thành công" />
    <ns0:sequenceFlow id="Flow_Deliver_Fail" sourceRef="Split_Task_DeliverAttempt_3" targetRef="Task_CountRetries" name="Giao thất bại" />
    <ns0:sequenceFlow id="Flow_Retry_Count" sourceRef="Task_CountRetries" targetRef="Gate_RetryLimit" />
    <ns0:sequenceFlow id="Flow_Retry_Deliver" sourceRef="Gate_RetryLimit" targetRef="Join_Task_DeliverAttempt_6" name="Còn lượt giao lại" />
    <ns0:sequenceFlow id="Flow_Retry_Cancel" sourceRef="Gate_RetryLimit" targetRef="Join_Task_AutoCancel_4" name="Hết lượt giao lại" />
    <ns0:sequenceFlow id="Flow_Receive_Confirm" sourceRef="Task_ReceiveGoods" targetRef="Task_ConfirmReceipt" />
    <ns0:sequenceFlow id="Flow_Confirm_Gate" sourceRef="Task_ConfirmReceipt" targetRef="Gate_BuyerConfirm" />
    <ns0:sequenceFlow id="Flow_GateConfirm_Yes" sourceRef="Gate_BuyerConfirm" targetRef="Join_Task_ReleasePayment_3" name="Buyer đã confirm" />
    <ns0:sequenceFlow id="Flow_GateConfirm_Auto" sourceRef="Gate_BuyerConfirm" targetRef="Task_AutoConfirm" name="Auto-confirm 7 ngày" />
    <ns0:sequenceFlow id="Flow_Auto_Release" sourceRef="Task_AutoConfirm" targetRef="Join_Task_ReleasePayment_3" />
    <ns0:sequenceFlow id="Flow_Release_End" sourceRef="Task_ReleasePayment" targetRef="End_Delivered" />
    <ns0:sequenceFlow id="Flow_Refuse_Cancel" sourceRef="Split_Task_ConfirmOrder_2" targetRef="Join_Task_AutoCancel_4" name="Tự động hủy đơn" />
    <ns0:sequenceFlow id="Flow_Cancel_Split" sourceRef="Task_AutoCancel" targetRef="Gate_CancelSplit" />
    <ns0:sequenceFlow id="Flow_Cancel_Notify" sourceRef="Gate_CancelSplit" targetRef="Join_Task_Notify_5" name="Đã thanh toán online" />
    <ns0:sequenceFlow id="Flow_Cancel_Notify_Buyer" sourceRef="Task_CancelOrder" targetRef="Join_Task_Notify_5" />
    <ns0:sequenceFlow id="Flow_Notify_Refund" sourceRef="Task_Notify" targetRef="Task_AutoRefund" />
    <ns0:sequenceFlow id="Flow_Refund_Execute" sourceRef="Task_AutoRefund" targetRef="Task_ExecuteRefund" />
    <ns0:sequenceFlow id="Flow_Refund_End" sourceRef="Task_ExecuteRefund" targetRef="End_Refunded" />
    <ns0:sequenceFlow id="Flow_Cancel_End" sourceRef="Gate_CancelSplit" targetRef="End_Cancelled" name="Chưa thanh toán (COD)" />
    <ns0:exclusiveGateway id="Join_Task_LockInventory_1" name="Gom luồng trước khi Khóa tồn kho + tạo đơn">
      <ns0:incoming>Flow_Verify_Process</ns0:incoming>
      <ns0:incoming>Flow_Hold_Process</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_LockInventory_1_to_Task_LockInventory</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_LockInventory_1_to_Task_LockInventory" sourceRef="Join_Task_LockInventory_1" targetRef="Task_LockInventory" />
    <ns0:exclusiveGateway id="Join_Task_TrackDelivery_2" name="Gom luồng trước khi Cập nhật định vị đơn hàng realtime">
      <ns0:incoming>Flow_Cancel_Gate_No</ns0:incoming>
      <ns0:incoming>Flow_Waybill_Track</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_TrackDelivery_2_to_Task_TrackDelivery" sourceRef="Join_Task_TrackDelivery_2" targetRef="Task_TrackDelivery" />
    <ns0:exclusiveGateway id="Join_Task_ReleasePayment_3" name="Gom luồng trước khi Giải ngân cho Seller">
      <ns0:incoming>Flow_GateConfirm_Yes</ns0:incoming>
      <ns0:incoming>Flow_Auto_Release</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_ReleasePayment_3_to_Task_ReleasePayment" sourceRef="Join_Task_ReleasePayment_3" targetRef="Task_ReleasePayment" />
    <ns0:exclusiveGateway id="Join_Task_AutoCancel_4" name="Gom luồng trước khi Auto-cancel đơn">
      <ns0:incoming>Flow_Fraud_Cancel</ns0:incoming>
      <ns0:incoming>Flow_Inventory_Cancel</ns0:incoming>
      <ns0:incoming>Flow_Timeout_Cancel</ns0:incoming>
      <ns0:incoming>Flow_Confirm_Refuse</ns0:incoming>
      <ns0:incoming>Flow_Retry_Cancel</ns0:incoming>
      <ns0:incoming>Flow_Refuse_Cancel</ns0:incoming>
      <ns0:outgoing>Flow_Join_Task_AutoCancel_4_to_Task_AutoCancel</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_Join_Task_AutoCancel_4_to_Task_AutoCancel" sourceRef="Join_Task_AutoCancel_4" targetRef="Task_AutoCancel" />
